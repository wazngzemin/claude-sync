.2" height="84.8" as="geometry"/></mxCell><mxCell id="m2_cluster_367" value="二｜决策规划器：Planner 与 Director 是同一个模块" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="8528.7" y="379.0" width="2247.0" height="435.9" as="geometry"/></mxCell><mxCell id="m2_cluster_369" value="2.3｜当前系统提示词：四个输出字段" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="10231.2" y="441.6" width="510.0" height="315.1" as="geometry"/></mxCell><mxCell id="m2_cluster_371" value="2.2｜十二个产品验收检查点" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="9142.2" y="426.7" width="1020.0" height="329.0" as="geometry"/></mxCell><mxCell id="m2_cluster_373" value="2.1｜当前系统提示词：四类输入" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="8563.2" y="407.8" width="510.0" height="378.4" as="geometry"/></mxCell><mxCell id="m2_node_0" value="上下文指标&lt;br&gt;必要事实覆盖率、关键事实保留率、来源／时间／有效期完整率&lt;br&gt;陈旧事实命中率、冲突裁决准确率、跨用户越权率＝0" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E9F8F0;strokeColor=#51A878;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="8484.4" y="1843.3" width="186.0" height="119.2" as="geometry"/></mxCell><mxCell id="m2_node_1" value="理解与计划指标&lt;br&gt;目标识别、必要澄清、任务分类、原子拆解完整率&lt;br&gt;冗余动作率、依赖违规率、非必要串行率" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E9F8F0;strokeColor=#51A878;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="8739.4" y="1851.7" width="186.0" height="102.4" as="geometry"/></mxCell><mxCell id="m2_node_2" value="工具与安全指标&lt;br&gt;工具／参数正确率、能力边界拒绝与确认准确率&lt;br&gt;危险误执行＝0、同名并发错配率、重复下发率" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E9F8F0;strokeColor=#51A878;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="8994.4" y="1851.7" width="186.0" height="102.4" as="geometry"/></mxCell><mxCell id="m2_node_3" value="闭环与稳定指标&lt;br&gt;同例多跑方差、上下文变化后改计划、失败后再规划成功率&lt;br&gt;完整目标成功率、虚假成功率、部分成功恢复率" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E9F8F0;strokeColor=#51A878;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="9249.4" y="1851.7" width="186.0" height="102.4" as="geometry"/></mxCell><mxCell id="m2_node_4" value="你要能独立回答&lt;br&gt;为何选这个工具？为何先后／并行？未知为何问或不问？&lt;br&gt;失败后为何重试／降级？凭什么判断完整目标已完成？" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E9F8F0;strokeColor=#51A878;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="9504.4" y="1851.7" width="186.0" height="102.4" as="geometry"/></mxCell><mxCell id="m2_node_5" value="先拿完整追踪记录&lt;br&gt;原始请求＋上下文快照＋提示词版本＋模型输出&lt;br&gt;动作下发＋工具执行＋回读与反馈" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF7E6;strokeColor=#D6A02E;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5829.8" y="1343.6" width="186.0" height="102.4" as="geometry"/></mxCell><mxCell id="m2_node_6" value="① 是否走对模块？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF7E6;strokeColor=#D6A02E;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6167.7" y="1266.5" width="128.3" height="128.3" as="geometry"/></mxCell><mxCell id="m2_node_7" value="链路／分流问题&lt;br&gt;查拒识、快路、云端升级、输入分类、端云唯一裁决" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6338.7" y="1283.9" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_8" value="② 工具定义、能力和参数是否清楚？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF7E6;strokeColor=#D6A02E;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6431.7" y="1269.7" width="201.8" height="201.8" as="geometry"/></mxCell><mxCell id="m2_node_9" value="工具契约问题&lt;br&gt;修描述、参数、车型能力、前置条件与边界" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6639.4" y="1360.5" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_10" value="③ 必要事实是否采到并进入快照？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF7E6;strokeColor=#D6A02E;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6732.4" y="1346.3" width="201.8" height="201.8" as="geometry"/></mxCell><mxCell id="m2_node_11" value="上下文问题&lt;br&gt;没采到、过期、错过滤、身份串线、冲突裁决错误" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6940.2" y="1437.1" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_12" value="④ 模型看到的事实是否正确且无矛盾？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF7E6;strokeColor=#D6A02E;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7033.2" y="1422.8" width="201.8" height="201.8" as="geometry"/></mxCell><mxCell id="m2_node_13" value="注入／提示词问题&lt;br&gt;动态知识、示例、规则或上下文拼装错误" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7240.9" y="1513.7" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_14" value="⑤ 模型是否理解错目标、动作、工具、参数或依赖？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF7E6;strokeColor=#D6A02E;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7333.9" y="1499.4" width="201.8" height="201.8" as="geometry"/></mxCell><mxCell id="m2_node_15" value="优先判为 AI 决策能力问题&lt;br&gt;再做同例多跑、换上下文、加失败反馈的稳定性验证" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#EAF7EE;strokeColor=#48A36D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7541.7" y="1590.3" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_16" value="⑥ 正确动作是否正确下发、执行、回读并关联？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF7E6;strokeColor=#D6A02E;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7634.7" y="1576.0" width="201.8" height="201.8" as="geometry"/></mxCell><mxCell id="m2_node_17" value="工程／工具／时序问题&lt;br&gt;查校验、调度、安全、超时、竞态、执行器、action_id" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7842.4" y="1666.9" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_18" value="⑦ 新反馈到来后能否正确恢复／收口？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF7E6;strokeColor=#D6A02E;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7935.4" y="1652.6" width="201.8" height="201.8" as="geometry"/></mxCell><mxCell id="m2_node_19" value="AI 再规划能力问题&lt;br&gt;查换工具、补槽、降级、保留部分成功、停止机械重试" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#EAF7EE;strokeColor=#48A36D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="8135.3" y="1743.5" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_20" value="闭环成立&lt;br&gt;用户完整目标有证据；不能只看单轮 JSON 或单个工具成功" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#EAF7EE;strokeColor=#48A36D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="8135.3" y="1863.4" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_21" value="副驾：有点闷，去昨天游泳的地方&lt;br&gt;沿途找 4.5 分川菜，10 分钟后关座椅加热，再放舒缓音乐" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0E8;strokeColor=#E27B45;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6982.5" y="2043.7" width="186.0" height="85.5" as="geometry"/></mxCell><mxCell id="m2_node_22" value="即时并行&lt;br&gt;A 查温度／空调／车窗 → 改善副驾闷热并回读&lt;br&gt;B 播舒缓音乐；与 A 独立，可同时执行" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0E8;strokeColor=#E27B45;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6778.5" y="2216.9" width="186.0" height="102.4" as="geometry"/></mxCell><mxCell id="m2_node_23" value="复合目标状态&lt;br&gt;即时分支分别取证；十分钟任务现在只能说‘已设置’&lt;br&gt;真正执行并回读后才从等待中变为已完成" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0E8;strokeColor=#E27B45;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6982.5" y="2407.0" width="186.0" height="102.4" as="geometry"/></mxCell><mxCell id="m2_node_24" value="导航串行&lt;br&gt;C1 查记忆得到地点 → C2 规划路线并导航&lt;br&gt;→ C3 路线存在后再沿途搜 4.5 分川菜" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0E8;strokeColor=#E27B45;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6982.5" y="2216.9" width="186.0" height="102.4" as="geometry"/></mxCell><mxCell id="m2_node_25" value="十分钟异步&lt;br&gt;D1 保存对象、座位、时间、退出条件 → 等待&lt;br&gt;→ 到时唤醒 → 关闭座椅加热并回读" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0E8;strokeColor=#E27B45;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7186.5" y="2216.9" width="186.0" height="102.4" as="geometry"/></mxCell><mxCell id="m2_node_26" value="① 请求追踪缺口&lt;br&gt;用户请求缺 request_id／trace_id／turn_id&lt;br&gt;多人、多轮、端云竞态难串起同一次请求" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="10848.4" y="57.0" width="186.0" height="102.4" as="geometry"/></mxCell><mxCell id="m2_node_27" value="② 顾问来源缺口&lt;br&gt;advisor 仅文本，缺类型、来源、时间、关联目标、置信度、有效期" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="10848.4" y="228.4" width="186.0" height="85.5" as="geometry"/></mxCell><mxCell id="m2_node_28" value="③ 工具反馈关联缺口&lt;br&gt;仅 tool_name＋文本，缺 action_id；同名并发难确认返回归属" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="10848.4" y="382.9" width="186.0" height="85.5" as="geometry"/></mxCell><mxCell id="m2_node_29" value="④ 事件来源缺口&lt;br&gt;仅描述＋时间，缺类型、传感器来源、置信度、作用域、去重号" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="10848.4" y="537.4" width="186.0" height="85.5" as="geometry"/></mxCell><mxCell id="m2_node_30" value="⑤ 动作依赖缺口&lt;br&gt;有动作号、工具、参数，无 depends_on／并行组／超时／重试／取消" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="10848.4" y="691.9" width="186.0" height="85.5" as="geometry"/></mxCell><mxCell id="m2_node_31" value="⑥ 形象字段矛盾&lt;br&gt;示例使用 listening_music，但可用表情清单未列出&lt;br&gt;‘文字不得用 Emoji’不等于可省略形象字段契约" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="10848.4" y="846.4" width="186.0" height="102.4" as="geometry"/></mxCell><mxCell id="m2_node_32" value="⑦ 长期目标更新缺口&lt;br&gt;goal_list_update 名为更新，参数只定义 add_goal／delete_goal&lt;br&gt;补充、改条件、改频率、暂停恢复缺结构" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="10848.4" y="1017.8" width="186.0" height="119.2" as="geometry"/></mxCell><mxCell id="m2_node_33" value="真正的 AI 产品判断&lt;br&gt;先确认事实与链路，再判断模型能力" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4435.9" y="251.1" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_34" value="① 形成上下文快照" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4464.2" y="388.7" width="129.4" height="42.0" as="geometry"/></mxCell><mxCell id="m2_node_35" value="② 同一决策规划器判断" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4453.0" y="492.6" width="151.9" height="42.0" as="geometry"/></mxCell><mxCell id="m2_node_36" value="③ 核对输入／输出契约" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4453.0" y="596.4" width="151.9" height="42.0" as="geometry"/></mxCell><mxCell id="m2_node_37" value="④ 用复合请求验证计划" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4453.0" y="700.3" width="151.9" height="42.0" as="geometry"/></mxCell><mxCell id="m2_node_38" value="⑤ 用完整追踪记录归因" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4453.0" y="804.2" width="151.9" height="42.0" as="geometry"/></mxCell><mxCell id="m2_node_39" value="⑥ 用用户完整目标量化验收" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4441.7" y="908.1" width="174.4" height="42.0" as="geometry"/></mxCell><mxCell id="m2_node_40" value="检索触发&lt;br&gt;当前请求＋上下文＋车型／环境＋候选任务" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6948.4" y="725.3" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_41" value="① 当前输入&lt;br&gt;请求／建议／反馈／事件" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4792.2" y="370.8" width="159.8" height="51.8" as="geometry"/></mxCell><mxCell id="m2_node_42" value="② 近期对话&lt;br&gt;原话／表达／动作／反馈" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5055.4" y="370.8" width="159.8" height="51.8" as="geometry"/></mxCell><mxCell id="m2_node_43" value="③ 端侧状态&lt;br&gt;车／导航／媒体／应用" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5302.9" y="370.8" width="148.5" height="51.8" as="geometry"/></mxCell><mxCell id="m2_node_44" value="④ 视觉情境&lt;br&gt;场景／观察主题／置信度" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5552.3" y="370.8" width="159.8" height="51.8" as="geometry"/></mxCell><mxCell id="m2_node_45" value="⑤ 事件日志&lt;br&gt;传感／手动／拒识／触发" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5805.4" y="370.8" width="159.8" height="51.8" as="geometry"/></mxCell><mxCell id="m2_node_46" value="⑥ 身份关系&lt;br&gt;账号／人脸／座位／隐私" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6058.5" y="370.8" width="159.8" height="51.8" as="geometry"/></mxCell><mxCell id="m2_node_47" value="⑦ 当前目标／任务&lt;br&gt;状态／进度／等待条件" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4797.8" y="470.5" width="148.5" height="51.8" as="geometry"/></mxCell><mxCell id="m2_node_48" value="⑧ 联网新事实&lt;br&gt;天气／网页／地点／路况" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5055.4" y="470.5" width="159.8" height="51.8" as="geometry"/></mxCell><mxCell id="m2_node_49" value="⑨ 参考知识&lt;br&gt;车书／技巧／车型／规则" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5297.3" y="470.5" width="159.8" height="51.8" as="geometry"/></mxCell><mxCell id="m2_node_50" value="⑩ 可用工具&lt;br&gt;参数／能力／版本／取消" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5552.3" y="470.5" width="159.8" height="51.8" as="geometry"/></mxCell><mxCell id="m2_node_51" value="⑪ 助手自我认知&lt;br&gt;角色／风格／价值边界" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5811.0" y="470.5" width="148.5" height="51.8" as="geometry"/></mxCell><mxCell id="m2_node_52" value="⑫ 时间位置设备&lt;br&gt;日期／位置／车型／网络" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6058.5" y="470.5" width="159.8" height="51.8" as="geometry"/></mxCell><mxCell id="m2_node_53" value="瞬时记忆｜秒到分钟&lt;br&gt;本轮声音、视觉与输入" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E9F8F0;strokeColor=#51A878;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5061.0" y="610.6" width="148.5" height="51.8" as="geometry"/></mxCell><mxCell id="m2_node_54" value="短期记忆｜当前会话&lt;br&gt;近期对话、任务、临时对象、最新反馈" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E9F8F0;strokeColor=#51A878;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5284.2" y="602.2" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_55" value="长期情景记忆｜具体经历&lt;br&gt;地点、同行人、时间与事件关系" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E9F8F0;strokeColor=#51A878;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5539.2" y="602.2" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_56" value="长期语义记忆｜稳定事实&lt;br&gt;偏好、习惯、关系与用户画像" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E9F8F0;strokeColor=#51A878;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5794.2" y="610.6" width="182.2" height="51.8" as="geometry"/></mxCell><mxCell id="m2_node_57" value="共同约束&lt;br&gt;按用户／车辆／会话隔离；读写有权限与来源&lt;br&gt;空结果如实说未找到，不能用猜测补记忆" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E9F8F0;strokeColor=#51A878;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6045.4" y="585.3" width="186.0" height="102.4" as="geometry"/></mxCell><mxCell id="m2_node_58" value="① 来源与身份隔离&lt;br&gt;谁写入，属于哪个用户／车辆／会话／任务" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6403.9" y="462.1" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_59" value="② 新鲜度检查&lt;br&gt;发生时间、写入时间、有效期、是否陈旧" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6658.9" y="462.1" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_60" value="③ 相关性筛选&lt;br&gt;本轮完整目标真正需要哪些事实" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6948.4" y="462.1" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_61" value="④ 冲突裁决&lt;br&gt;最新端态优先旧对话；无法裁决保持未知" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7203.4" y="462.1" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_62" value="⑤ 事实分型&lt;br&gt;事实／建议／结果／假设不能同等可信" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7458.4" y="462.1" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_63" value="⑥ 摘要与预算&lt;br&gt;按人物、场景、任务选择后压缩；关键事实不丢" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7713.4" y="462.1" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_64" value="知识与示例选择&lt;br&gt;专业知识、车型规则、工具技巧、相似正反例" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7203.4" y="725.3" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_65" value="版本与质量门&lt;br&gt;来源、版本、车企×环境、得分、过期、冲突去重" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7458.4" y="683.0" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_66" value="注入系统提示词动态区&lt;br&gt;〈动态专业知识〉＋〈场景示例〉" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7713.4" y="683.0" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_67" value="无命中／低分／冲突&lt;br&gt;允许覆盖面下降；不得编造知识，不得放宽安全规则" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7713.4" y="769.6" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_68" value="本轮上下文快照&lt;br&gt;当前输入＋身份座位＋端侧状态＋视觉情境＋相关记忆&lt;br&gt;目标进度＋工具能力＋参考知识＋最新结果" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="8002.9" y="666.1" width="186.0" height="102.4" as="geometry"/></mxCell><mxCell id="m2_node_69" value="每个动态值必须回答&lt;br&gt;谁写的？何时写？何时过期？属于谁？来源可信度？" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="8257.9" y="683.0" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_70" value="是否说话｜talk_or_not&lt;br&gt;yes／no" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF4D9;strokeColor=#D8A93D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="10283.4" y="462.3" width="150.5" height="51.8" as="geometry"/></mxCell><mxCell id="m2_node_71" value="用户请求｜user_query&lt;br&gt;query、speaker_name、speaker_position、timestamp" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="8597.7" y="424.3" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_72" value="本轮用户提示词&lt;br&gt;近期对话＋当前输入数组＋上下文快照＋目标＋历史反馈" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="8852.7" y="558.5" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_73" value="顾问建议｜advisor&lt;br&gt;一段建议文本；建议不是用户命令" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="8597.7" y="510.9" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_74" value="工具执行反馈｜tool_feedback&lt;br&gt;feedback＋tool_name；到来后开启新一轮判断" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="8597.7" y="597.6" width="186.0" height="85.5" as="geometry"/></mxCell><mxCell id="m2_node_75" value="系统事件｜event&lt;br&gt;事件自然语言描述＋timestamp" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="8597.7" y="701.1" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_76" value="① 输入类型解码｜分清请求、建议、结果、事件&lt;br&gt;② 身份／指代／空间｜人、座位、否定、时间、地点、‘我／他／这边’&lt;br&gt;③ 目标与已知未知｜可推断、可查询、必须追问" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F1EAFE;strokeColor=#8B6CD9;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="9176.7" y="524.7" width="186.0" height="136.1" as="geometry"/></mxCell><mxCell id="m2_node_77" value="④ 能力／安全／拒识｜车型、设备、权限、车速档位；允许／确认／拒绝／降级&lt;br&gt;⑤ 任务类型｜单步、多动作、多步、条件／定时、持续&lt;br&gt;⑥ 原子动作拆解｜不漏目标、不添动作" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F1EAFE;strokeColor=#8B6CD9;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="9431.7" y="524.7" width="186.0" height="136.1" as="geometry"/></mxCell><mxCell id="m2_node_78" value="⑦ 依赖与并发｜独立则并行，有结果依赖才串行，条件动作转长期目标&lt;br&gt;⑧ 工具／任务代理与参数｜选对能力，参数可执行，必要时先查后写&lt;br&gt;⑨ 说话决策｜确认／澄清／进度／最终，不提前承诺结果" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F1EAFE;strokeColor=#8B6CD9;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="9686.7" y="516.3" width="186.0" height="153.0" as="geometry"/></mxCell><mxCell id="m2_node_79" value="⑩ 目标／任务持久化｜保存状态、期限与退出条件&lt;br&gt;⑪ 输出自检与去重｜结构合法、白名单、无冲突、无重复下发&lt;br&gt;⑫ 下一轮策略｜继续、改计划、等待、追问或结束" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F1EAFE;strokeColor=#8B6CD9;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="9941.7" y="524.7" width="186.0" height="136.1" as="geometry"/></mxCell><mxCell id="m2_node_80" value="动作清单只是候选计划&lt;br&gt;不等于已下发、工具成功、真实生效或完整目标完成" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF4D9;strokeColor=#D8A93D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="10520.7" y="554.2" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m2_node_81" value="回复内容｜talk_content&lt;br&gt;本轮要说的话；不说时为空" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF4D9;strokeColor=#D8A93D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="10273.2" y="532.0" width="171.0" height="51.8" as="geometry"/></mxCell><mxCell id="m2_node_82" value="形象表情｜emoji_id&lt;br&gt;可为空；须从可用清单选择" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF4D9;strokeColor=#D8A93D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="10273.2" y="601.8" width="171.0" height="51.8" as="geometry"/></mxCell><mxCell id="m2_node_83" value="动作清单｜action_list&lt;br&gt;action_id＋tool_name＋params" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF4D9;strokeColor=#D8A93D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="10265.7" y="671.5" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell