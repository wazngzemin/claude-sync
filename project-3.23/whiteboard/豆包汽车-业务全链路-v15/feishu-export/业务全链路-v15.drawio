ft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="7536" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="25248" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="7535"><mxGeometry x="26" y="103" width="360" height="30" as="geometry"/></mxCell><mxCell id="v15_6599" parent="v15_6594" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;看不清或没看到时保留不确定性&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="7537" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="25282" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="7535"><mxGeometry x="26" y="137" width="420" height="30" as="geometry"/></mxCell><mxCell id="v15_6600" parent="v15_6594" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;用户确认与实车执行仍是后续步骤&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="7538" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="25316" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="7535"><mxGeometry x="26" y="171" width="450" height="30" as="geometry"/></mxCell><mxCell id="v15_6601" parent="v15_6594" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="7539" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;4746&quot;,&quot;y1&quot;:&quot;25345&quot;,&quot;x2&quot;:&quot;5414&quot;,&quot;y2&quot;:&quot;25345&quot;,&quot;stroke&quot;:&quot;#CAD8E6&quot;,&quot;stroke-width&quot;:&quot;1&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="225" as="sourcePoint"/><mxPoint x="694" y="225" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_6602" parent="v15_6594" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;视觉答案帮助 Director 继续决策，但不能替用户完成确认&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7541" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="25378" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7540"><mxGeometry x="26" y="233" width="930" height="30" as="geometry"/></mxCell><mxCell id="v15_6603" parent="v15_6594" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;。比如看见充电设备后才适合询问是否开盖，没看见或看不&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7542" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="25412" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7540"><mxGeometry x="26" y="267" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_6604" parent="v15_6594" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;清时按场景规则结束本次建议。即使识别成功、用户同意，&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7543" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="25446" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7540"><mxGeometry x="26" y="301" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_6605" parent="v15_6594" value="&lt;span style=&quo