  "headings": [
    {
      "id": "f72-heading-01",
      "level": 2,
      "title": "开篇：想给车加一个“订座”，要过哪几关"
    },
    {
      "id": "f72-heading-02",
      "level": 3,
      "title": "用户只说一句订座，接入方要把前后交接准备好"
    },
    {
      "id": "f72-heading-03",
      "level": 2,
      "title": "一、先判断：这件事该不该做成一个工具"
    },
    {
      "id": "f72-heading-04",
      "level": 3,
      "title": "先看这件事能在哪里办完，再决定怎样接"
    },
    {
      "id": "f72-heading-05",
      "level": 3,
      "title": "准入要回答五个问题，接口能通只是其中一小步"
    },
    {
      "id": "f72-heading-06",
      "level": 3,
      "title": "通用能力守住分工，项目差别放到适配层"
    },
    {
      "id": "f72-heading-07",
      "level": 2,
      "title": "二、工具说明书：写给 Planner 看的那几行字"
    },
    {
      "id": "f72-heading-08",
      "level": 3,
      "title": "工具定义要同时教会 Planner 什么时候选、选了怎样用"
    },
    {
      "id": "f72-heading-09",
      "level": 3,
      "title": "参数要落到具体对象，订座和排队分别约定"
    },
    {
      "id": "f72-heading-10",
      "level": 3,
      "title": "相邻工具要互相写出分界，名字相近也能选对"
    },
    {
      "id": "f72-heading-11",
      "level": 3,
      "title": "写完要检查一致性，数量也要分清在数什么"
    },
    {
      "id": "f72-heading-12",
      "level": 2,
      "title": "三、在平台上登记：同一个工具，哪些车有、由谁来办"
    },
    {
      "id": "f72-heading-13",
      "level": 3,
      "title": "定义讲能办什么，项目实现登记这次交给谁"
    },
    {
      "id": "f72-heading-14",
      "level": 3,
      "title": "测试可以比较多种接法，每个环境只用一个生效版本"
    },
    {
      "id": "f72-heading-15",
      "level": 3,
      "title": "服务先认调用方，账号权限还要由业务另判"
    },
    {
      "id": "f72-heading-16",
      "level": 3,
      "title": "启用要对上定义和服务，下线先限定影响范围"
    },
    {
      "id": "f72-heading-17",
      "level": 2,
      "title": "四、这一轮到底看得见哪些工具"
    },
    {
      "id": "f72-heading-18",
      "level": 3,
      "title": "项目里有这个工具，还要分清本轮可见和执行许可"
    },
    {
      "id": "f72-heading-19",
      "level": 3,
      "title": "场景条件只决定这一轮是否出现，条件本身要能算对"
    },
    {
      "id": "f72-heading-20",
      "level": 3,
      "title": "改好了工具说明，还要让当前 Planner 真正读到"
    },
    {
      "id": "f72-heading-21",
      "level": 2,
      "title": "五、调用约定：每次调用都要说清“这是谁的哪一次”"
    },
    {
      "id": "f72-heading-22",
      "level": 3,
      "title": "下游同时服务很多车，每次调用都要重新交代归属"
    },
    {
      "id": "f72-heading-23",
      "level": 3,
      "title": "公共信息允许选填，具体业务仍要补齐位置和账号"
    },
    {
      "id": "f72-heading-24",
      "level": 3,
      "title": "编号要对上每次交接，才知道参数在哪里变了"
    },
    {
      "id": "f72-heading-25",
      "level": 2,
      "title": "六、流式返回：屏幕、语音、模型各拿各的"
    },
    {
      "id": "f72-heading-26",
      "level": 3,
      "title": "同一次订座结果，要分别告诉屏幕、语音和 Planner"
    },
    {
      "id": "f72-heading-27",
      "level": 3,
      "title": "订座要分四种办理阶段，排队另按自己的结果回"
    },
    {
      "id": "f72-heading-28",
      "level": 3,
      "title": "一帧要标明内容怎么处理，最后一帧要明确收尾"
    },
    {
      "id": "f72-heading-29",
      "level": 3,
      "title": "下游模型反馈、工具反馈、下一轮背景，分别承担一次交接"
    },
    {
      "id": "f72-heading-30",
      "level": 2,
      "title": "七、取消、超时和重试：用户改主意时停的是什么"
    },
    {
      "id": "f72-heading-31",
      "level": 3,
      "title": "先问停的是声音、这次请求，还是已经提交的订座"
    },
    {
      "id": "f72-heading-32",
      "level": 3,
      "title": "超时只说明没等到结果，重试前先查有没有办过"
    },
    {
      "id": "f72-heading-33",
      "level": 3,
      "title": "一句晚到的“确认”，也要重新检查它现在指向什么"
    },
    {
      "id": "f72-heading-34",
      "level": 2,
      "title": "八、出错了：先分清是哪一层"
    },
    {
      "id": "f72-heading-35",
      "level": 3,
      "title": "先找最早失败的那一层，再找负责的人"
    },
    {
      "id": "f72-heading-36",
      "level": 3,
      "title": "没找到、办失败、超时和缺前提，要让 Planner 走不同的路"
    },
    {
      "id": "f72-heading-37",
      "level": 3,
      "title": "查到哪一层偏了，就把修复交给那一层"
    },
    {
      "id": "f72-heading-38",
      "level": 2,
      "title": "九、从申请到上线：一个工具要走哪些步"
    },
    {
      "id": "f72-heading-39",
      "level": 3,
      "title": "先把要接的能力和各方交付物定下来，再开始开发"
    },
    {
      "id": "f72-heading-40",
      "level": 3,
      "title": "快速测试有两条路，测通以后还要看 Planner 会不会用"
    },
    {
      "id": "f72-heading-41",
      "level": 3,
      "title": "订座用了约六周，每一轮测试都在补下一次交接"
    },
    {
      "id": "f72-heading-42",
      "level": 3,
      "title": "发布前定好小范围开放和退路，下线时停对应的项目实现"
    },
    {
      "id": "f72-heading-43",
      "level": 2,
      "title": "十、怎么评测、怎么排查"
    },
    {
      "id": "f72-heading-44",
      "level": 3,
      "title": "先分开看选对、填对和办成，分数才知道该怎么用"
    },
    {
      "id": "f72-heading-45",
      "level": 3,
      "title": "参数要保住用户的限制，改一个工具也要连着其他工具一起测"
    },
    {
      "id": "f72-heading-46",
      "level": 3,
      "title": "沿着同一次调用找第一个偏差，再把问题交给负责的人"
    },
    {
      "id": "f72-heading-47",
      "level": 2,
      "title": "十一、工具边界是怎样一步步定下来的"
    },
    {
      "id": "f72-heading-48",
      "level": 3,
      "title": "先把谁负责什么分清，再决定拆开还是合在一起"
    },
    {
      "id": "f72-heading-49",
      "level": 3,
      "title": "通用工具保持同一套职责，项目差异放到实际接入里"
    },
    {
      "id": "f72-heading-50",
      "level": 3,
      "title": "复用接入办法以后，每个车型仍要把效果走完"
    },
    {
      "id": "f72-heading-51",
      "level": 2,
      "title": "收尾　把一次订座从接入讲到真正订成"
    },
    {
      "id": "f72-heading-52",
      "level": 3,
      "title": "三分钟口述稿：我怎样让 Planner 接住这次订座"
    },
    {
      "id": "f72-heading-53",
      "level": 3,
      "title": "最容易讲错的地方：每个“完成”都要说清完成了什么"
    },
    {
      "id": "f72-heading-54",
      "level": 3,
      "title": "复述路线图：沿交接往下讲，沿第一个偏差找人"
    },
    {
      "id": "f72-heading-55",
      "level": 2,
      "title": "附一　术语表"
    },
    {
      "id": "f72-heading-56",
      "level": 3,
      "title": "把术语放回订座的那一刻，才知道它管哪次交接"
    },
    {
      "id": "f72-heading-57",
      "level": 3,
      "title": "术语混了，就回到实际动作和结果上分开"
    },
    {
      "id": "f72-heading-58",
      "level": 2,
      "title": "附二　历史版本与关键数字"
    },
    {
      "id": "f72-heading-59",
      "level": 3,
      "title": "协议版本、渠道编号和时间，分别管哪一层"
    },
    {
      "id": "f72-heading-60",
      "level": 3,
      "title": "字段英文只用于对接，先认中文含义和所属位置"
    },
    {
      "id": "f72-heading-61",
      "level": 3,
      "title": "工具数量和评测分数，先说清数的是哪一批"
    },
    {
      "id": "f72-heading-62",
      "level": 3,
      "title": "订座、平台和动态工具，各自沿时间看完成了哪一步"
    },
    {
      "id": "f72-heading-63",
      "level": 3,
      "title": "工具输入输出的历史变化，接入时跟着改哪里"
    }
  ],
