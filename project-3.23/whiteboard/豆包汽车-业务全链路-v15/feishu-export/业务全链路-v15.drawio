,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="7187" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="23262" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="7185"><mxGeometry x="26" y="137" width="360" height="30" as="geometry"/></mxCell><mxCell id="v15_6332" parent="v15_6326" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;不拿旧状态补成当前事实&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="7188" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="23296" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="7185"><mxGeometry x="26" y="171" width="330" height="30" as="geometry"/></mxCell><mxCell id="v15_6333" parent="v15_6326" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="7189" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;1226&quot;,&quot;y1&quot;:&quot;23325&quot;,&quot;x2&quot;:&quot;1894&quot;,&quot;y2&quot;:&quot;23325&quot;,&quot;stroke&quot;:&quot;#CAD8E6&quot;,&quot;stroke-width&quot;:&quot;1&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="225" as="sourcePoint"/><mxPoint x="694" y="225" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_6334" parent="v15_6326" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;状态有采样与更新周期，不能永久有效。用户换座或路线改&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7191" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="23358" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7190"><mxGeometry x="26" y="233" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_6335" parent="v15_6326" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;变后，旧位置关系与地点序号可能失效。产品需要明确每类&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7192" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="23392" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7190"><mxGeometry x="26" y="267" width="780" height="30" a