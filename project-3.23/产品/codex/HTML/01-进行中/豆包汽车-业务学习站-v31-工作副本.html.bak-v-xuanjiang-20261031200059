"3\"/><text x=\"704\" y=\"936\" font-size=\"16\" fill=\"#7e8790\" font-weight=\"500\">新目标 + 旧任务</text><rect x=\"699\" y=\"1203\" width=\"74\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"704\" y=\"1220\" font-size=\"16\" fill=\"#7e8790\" font-weight=\"500\">取消指令</text><rect x=\"699\" y=\"1487\" width=\"74\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"704\" y=\"1504\" font-size=\"16\" fill=\"#7e8790\" font-weight=\"500\">取消反馈</text><rect x=\"699\" y=\"1771\" width=\"58\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"704\" y=\"1788\" font-size=\"16\" fill=\"#7e8790\" font-weight=\"500\">已取消</text><rect x=\"129\" y=\"1596\" width=\"139.92000000000002\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"134\" y=\"1613\" font-size=\"16\" fill=\"#7e8790\" font-weight=\"500\">失败/超时/无结果</text><rect x=\"699\" y=\"2055\" width=\"170\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"704\" y=\"2072\" font-size=\"16\" fill=\"#7e8790\" font-weight=\"500\">新临停设置与真实执行</text><rect x=\"129\" y=\"1028\" width=\"186\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"134\" y=\"1045\" font-size=\"16\" fill=\"#7e8790\" font-weight=\"500\">缺少取消接口或尚未接入</text><g data-page=\"DR\" data-flow=\"DR-change-flow\" data-step=\"DR-change-1\" role=\"link\" tabindex=\"0\" aria-label=\"已有指定车位泊入任务\"><rect x=\"356\" y=\"134\" width=\"660\" height=\"184\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"380\" y=\"171\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">已有指定车位泊入任务</text><text x=\"380\" y=\"218\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">当前目标是 D 栋负二层充电车位，记录导航任务与执行进度。</text><text x=\"380\" y=\"245\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"380\" y=\"272\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">先确认泊车目标只是待下发，还是已经被车端受理。</text></g><g data-page=\"DR\" data-flow=\"DR-change-flow\" data-step=\"DR-change-2\" role=\"link\" tabindex=\"0\" aria-label=\"用户改为路边停车\"><rect x=\"356\" y=\"418\" width=\"660\" height=\"184\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"380\" y=\"455\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">用户改为路边停车</text><text x=\"380\" y=\"502\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">用户说“到了靠边停就行”。</text><text x=\"380\" y=\"529\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"380\" y=\"556\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">变更的是原任务停车方式，需要处理旧泊入安排。</text></g><g data-page=\"DR\" data-flow=\"DR-change-flow\" data-step=\"DR-change-3\" role=\"link\" tabindex=\"0\" aria-label=\"Director 关联新旧目标\"><rect x=\"356\" y=\"702\" width=\"660\" height=\"184\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"380\" y=\"739\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">Director 关联新旧目标</text><text x=\"380\" y=\"786\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">专项层使旧版本尚未执行的动作失效。</text><text x=\"380\" y=\"813\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"380\" y=\"840\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">已经被下游接受的任务不能靠更新文本自动撤销，继续检查取消能力。</text></g><g data-page=\"DR\" data-flow=\"DR-change-flow\" data-step=\"DR-change-4\" role=\"link\" tabindex=\"0\" aria-label=\"请求取消旧泊入\"><rect x=\"356\" y=\"986\" width=\"660\" height=\"184\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"380\" y=\"1023\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">请求取消旧泊入</text><text x=\"380\" y=\"1070\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">只有项目已提供适用取消接口时，才能发出真实取消请求。</text><text x=\"380\" y=\"1097\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"380\" y=\"1124\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">现有技术方案将取消 FC 列为缺口；缺少接口时转失败说明，不假装已取消。</text></g><g data-page=\"DR\" data-flow=\"DR-change-flow\" data-step=\"DR-change-5\" role=\"link\" tabindex=\"0\" aria-label=\"系统 App 通知 ADC\"><rect x=\"356\" y=\"1270\" width=\"660\" height=\"184\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"380\" y=\"1307\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">系统 App 通知 ADC</text><text x=\"380\" y=\"1354\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">系统 App 将取消要求交给对应智驾任务。</text><text x=\"380\" y=\"1381\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"380\" y=\"1408\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">保留原任务身份，等待实际取消结果。</text></g><g data-page=\"DR\" data-flow=\"DR-change-flow\" data-step=\"DR-change-6\" role=\"link\" tabindex=\"0\" aria-label=\"确认取消结果\"><rect x=\"356\" y=\"1554\" width=\"660\" height=\"184\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"380\" y=\"1591\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">确认取消结果</text><text x=\"380\" y=\"1638\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">确认旧泊入任务已经取消。</text><text x=\"380\" y=\"1665\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"380\" y=\"1692\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">失败、超时或状态不明时，暂不发布与旧任务冲突的新停车安排。</text></g><g data-page=\"DR\" data-flow=\"DR-change-flow\" data-step=\"DR-change-7\" role=\"link\" tabindex=\"0\" aria-label=\"Navi 设置目的地临停\"><rect x=\"356\" y=\"1838\" width=\"660\" height=\"184\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"380\" y=\"1875\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">Navi 设置目的地临停</text><text x=\"380\" y=\"1922\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">取消确认且新目标可执行后，Navi 为当前目的地设置临停。</text><text x=\"380\" y=\"1949\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"380\" y=\"1976\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">再次核对当前导航任务，防止旧终点参数绑到已经改变的路线。</text></g><g data-page=\"DR\" data-flow=\"DR-change-flow\" data-step=\"DR-change-8\" role=\"link\" tabindex=\"0\" aria-label=\"返回新任务进展\"><rect x=\"356\" y=\"2122\" width=\"660\" height=\"184\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"380\" y=\"2159\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">返回新任务进展</text><text x=\"380\" y=\"2206\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">回报新临停安排是否设好，以及之后实际执行到哪一步。</text><text x=\"380\" y=\"2233\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"380\" y=\"2260\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">后续改口沿新的有效任务继续。</text></g><g data-page=\"DR\" data-flow=\"DR-change-flow\" data-step=\"DR-change-9\" role=\"link\" tabindex=\"0\" aria-label=\"取消尚未成功\"><rect x=\"356\" y=\"2406\" width=\"660\" height=\"187\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"380\" y=\"2443\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">取消尚未成功</text><text x=\"380\" y=\"2490\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">说明缺少取消能力、取消失败或当前结果未确认。</text><text x=\"380\" y=\"2517\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"380\" y=\"2544\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">旧任务真实状态仍保留，不能用一句“好的”覆盖冲突。</text></g></svg>",
