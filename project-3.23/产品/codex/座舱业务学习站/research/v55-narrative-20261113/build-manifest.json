  "headings": [
    {
      "id": "v55-heading-01",
      "level": 2,
      "title": "开篇　Planner 接到一句话之前，已经发生了什么"
    },
    {
      "id": "v55-heading-02",
      "level": 2,
      "title": "一、开口之前　豆包怎样知道该听"
    },
    {
      "id": "v55-heading-03",
      "level": 2,
      "title": "二、先把声音听清　声学前端处理的是声音和说话位置"
    },
    {
      "id": "v55-heading-04",
      "level": 2,
      "title": "三、声音变成文字　在线、离线与过程、最终是两组概念"
    },
    {
      "id": "v55-heading-05",
      "level": 3,
      "title": "名字为什么容易听错，热词在哪一步帮忙"
    },
    {
      "id": "v55-heading-06",
      "level": 2,
      "title": "四、他说完了没有　短暂停顿先准备，正式收尾再交办"
    },
    {
      "id": "v55-heading-07",
      "level": 2,
      "title": "五、是不是在跟豆包说　先让出说话机会，再判断整句话"
    },
    {
      "id": "v55-heading-08",
      "level": 3,
      "title": "同一句话在不同前文里，交互对象会变"
    },
    {
      "id": "v55-heading-09",
      "level": 3,
      "title": "豆包正在播报时，为什么还没听完就要判断"
    },
    {
      "id": "v55-heading-10",
      "level": 3,
      "title": "说完整以后，谁来最后把关"
    },
    {
      "id": "v55-heading-11",
      "level": 3,
      "title": "模型怎样学会这些区别"
    },
    {
      "id": "v55-heading-12",
      "level": 2,
      "title": "六、谁来办　固定说法、本地模型和云端怎样分工"
    },
    {
      "id": "v55-heading-13",
      "level": 3,
      "title": "两边都在处理，为什么还要仲裁"
    },
    {
      "id": "v55-heading-14",
      "level": 3,
      "title": "车上做完以后，怎样让下一句接得上"
    },
    {
      "id": "v55-heading-15",
      "level": 2,
      "title": "七、这些模型分别是谁　职责、规模和部署要分开看"
    },
    {
      "id": "v55-heading-16",
      "level": 2,
      "title": "八、Planner 接手　先补齐“昨天那家”，再把真实结果交给下一句"
    },
    {
      "id": "v55-heading-17",
      "level": 3,
      "title": "Context 带来判断所需的背景，Planner 决定还缺什么"
    },
    {
      "id": "v55-heading-18",
      "level": 3,
      "title": "“昨天那家”没有名字，先查经历，再确定搜索中心"
    },
    {
      "id": "v55-heading-19",
      "level": 3,
      "title": "搜到餐厅以后，要保留用户实际看到的列表和顺序"
    },
    {
      "id": "v55-heading-20",
      "level": 3,
      "title": "动作清单交出去以后，Planner 还要等工具把结果交回来"
    },
    {
      "id": "v55-heading-21",
      "level": 3,
      "title": "座椅指令办完，“第二个”要接回刚才那份餐厅列表"
    },
    {
      "id": "v55-heading-22",
      "level": 2,
      "title": "九、豆包怎样记住　刚才的细节、昨天的经历和长期偏好各放在哪里"
    },
    {
      "id": "v55-heading-23",
      "level": 3,
      "title": "记忆分层，是为了既接住下一句，也找回较早的事"
    },
    {
      "id": "v55-heading-24",
      "level": 3,
      "title": "历史记录留住原话和候选，才能知道“第二个”是谁"
    },
    {
      "id": "v55-heading-25",
      "level": 3,
      "title": "摘要接住较早的约束，不能把“不要预约”压没了"
    },
    {
      "id": "v55-heading-26",
      "level": 3,
      "title": "短期记忆整理当天经历，长期记忆再承接跨天的事"
    },
    {
      "id": "v55-heading-27",
      "level": 3,
      "title": "瞬时记忆强调最近的原始细节，实际交接要看方案"
    },
    {
      "id": "v55-heading-28",
      "level": 3,
      "title": "各层要接住彼此留下的空档，再把所需内容交给 Planner"
    },
    {
      "id": "v55-heading-29",
      "level": 3,
      "title": "关闭记忆后，接得上刚才不等于还在读取长期记忆"
    },
    {
      "id": "v55-heading-30",
      "level": 3,
      "title": "同一辆车里，记住什么还要看是谁说的、现在谁在场"
    },
    {
      "id": "v55-heading-31",
      "level": 2,
      "title": "十、没叫豆包的话　人人对话也可能是下一句的背景"
    },
    {
      "id": "v55-heading-32",
      "level": 3,
      "title": "已唤醒时实时传，未唤醒或断网时先在车上积累"
    },
    {
      "id": "v55-heading-33",
      "level": 3,
      "title": "记录到了，还要在这一轮真正交给 Planner"
    },
    {
      "id": "v55-heading-34",
      "level": 3,
      "title": "能记哪些聊天，先看权限和项目范围"
    },
    {
      "id": "v55-heading-35",
      "level": 2,
      "title": "十一、豆包记忆和车机记忆打通　说着保存和地图手动修改要对得上"
    },
    {
      "id": "v55-heading-36",
      "level": 3,
      "title": "保存之前，先把“是哪一个地点”补清楚"
    },
    {
      "id": "v55-heading-37",
      "level": 3,
      "title": "使用时，把“回家”补成导航可以办理的请求"
    },
    {
      "id": "v55-heading-38",
      "level": 3,
      "title": "先认清是谁的家，再决定改哪一份数据"
    },
    {
      "id": "v55-heading-39",
      "level": 3,
      "title": "关闭记忆和离线，会分别挡住哪一步"
    },
    {
      "id": "v55-heading-40",
      "level": 3,
      "title": "座椅只记用途和位置标识，具体怎么调由车机负责"
    },
    {
      "id": "v55-heading-41",
      "level": 2,
      "title": "十二、AI Launcher　桌面让用户发现能力，点击以后还要把事情交出去"
    },
    {
      "id": "v55-heading-42",
      "level": 3,
      "title": "桌面展示的是可用入口，服务结果要继续往后看"
    },
    {
      "id": "v55-heading-43",
      "level": 3,
      "title": "点击怎样交办，要看这张卡片约定走哪条路"
    },
    {
      "id": "v55-heading-44",
      "level": 3,
      "title": "卡片能看见、点得动，还要核对实际办成了什么"
    },
    {
      "id": "v55-heading-45",
      "level": 2,
      "title": "十三、说出来　TTS 播报与打断恢复，要接着用户真正听到的位置往下讲"
    },
    {
      "id": "v55-heading-46",
      "level": 3,
      "title": "Planner 决定说什么，云端合成声音，车端负责播放"
    },
    {
      "id": "v55-heading-47",
      "level": 3,
      "title": "新话最终被拒识，允许恢复时还要发起一次请求"
    },
    {
      "id": "v55-heading-48",
      "level": 3,
      "title": "新话最终被接住，Planner 要一起处理新要求和没说完的话"
    },
    {
      "id": "v55-heading-49",
      "level": 3,
      "title": "屏幕有字和用户听到了，是需要分别核对的两件事"
    },
    {
      "id": "v55-heading-50",
      "level": 2,
      "title": "收尾　三分钟讲给别人听"
    },
    {
      "id": "v55-heading-51",
      "level": 3,
      "title": "最容易讲错的地方"
    },
    {
      "id": "v55-heading-52",
      "level": 2,
      "title": "附一　术语表：把名字放回它负责的那一步"
    },
