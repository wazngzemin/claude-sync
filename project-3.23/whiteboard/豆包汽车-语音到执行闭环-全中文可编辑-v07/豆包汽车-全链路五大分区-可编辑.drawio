xGeometry relative="1" as="geometry"/></mxCell><mxCell id="m4_cluster_18" value="" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="4891.2" y="4884.5" width="2198.9" height="656.6" as="geometry"/></mxCell><mxCell id="m4_cluster_27" value="H｜四个必须能一眼验收的闭环问题" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="6810.0" y="4992.3" width="258.0" height="441.0" as="geometry"/></mxCell><mxCell id="m4_cluster_42" value="G｜视觉语言模型（VLM）三条链：采样周期 ≠ 用户通知周期" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="4913.3" y="4900.3" width="1852.4" height="625.1" as="geometry"/></mxCell><mxCell id="m4_cluster_49" value="3. 动态长时观察【条件任务链】" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="4944.8" y="4916.0" width="1789.4" height="104.6" as="geometry"/></mxCell><mxCell id="m4_cluster_82" value="2. 默认常驻视觉【当前/需版本验真】" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="5368.5" y="5037.1" width="942.0" height="104.6" as="geometry"/></mxCell><mxCell id="m4_cluster_103" value="1. 本轮按需视觉问答【当前工具链】" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="5321.0" y="5158.3" width="1037.2" height="87.8" as="geometry"/></mxCell><mxCell id="m4_cluster_128" value="" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="3395.8" y="4565.8" width="5189.8" height="293.2" as="geometry"/></mxCell><mxCell id="m4_cluster_137" value="F｜当前目标队列（Goal List）迁移链 + 顾问（Advisor）分工" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="5914.2" y="4581.6" width="2649.2" height="261.7" as="geometry"/></mxCell><mxCell id="m4_cluster_198" value="E｜触发器（Trigger）：只回答“现在是否命中”，不直接执行工具" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="3417.9" y="4623.0" width="2452.1" height="178.8" as="geometry"/></mxCell><mxCell id="m4_cluster_247" value="" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="3443.0" y="4217.7" width="5095.3" height="322.7" as="geometry"/></mxCell><mxCell id="m4_cluster_256" value="D｜一次触发后的运行闭环：防重复、执行前复核、结果事务写回" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="5573.4" y="4241.2" width="2942.8" height="275.6" as="geometry"/></mxCell><mxCell id="m4_cluster_317" value="C｜任务服务目标内核：事件 → 脚本 → 本轮运行 → 原子动作 → 可靠通知【预生产/建设中】" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="3465.1" y="4233.4" width="2064.0" height="291.2" as="geometry"/></mxCell><mxCell id="m4_cluster_364" value="" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="4940.2" y="3199.9" width="2101.0" height="992.2" as="geometry"/></mxCell><mxCell id="m4_cluster_373" value="B｜用户任务先分型，再决定是否进入持久任务" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="6292.8" y="3419.7" width="726.2" height="552.8" as="geometry"/></mxCell><mxCell id="m4_cluster_426" value="A｜当前承接方式 与 预生产环境（PPE）目标边界" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="4962.3" y="3215.7" width="1286.2" height="960.8" as="geometry"/></mxCell><mxCell id="m4_cluster_437" value="预生产/建设中任务服务【不可写成正式生产已上线】" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="5521.1" y="3231.4" width="438.0" height="929.2" as="geometry"/></mxCell><mxCell id="m4_cluster_470" value="当前协议快照【当前】" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="4993.8" y="3289.2" width="419.2" height="813.8" as="geometry"/></mxCell><mxCell id="m4_node_0" value="创建成功？&lt;br&gt;任务落库、规则注册、绑定保存必须同向成功；失败要回滚或补偿" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="6841.5" y="5008.1" width="195.0" height="90.0" as="geometry"/></mxCell><mxCell id="m4_node_1" value="取消干净？&lt;br&gt;关闭任务 + 停规则 + 停视觉 + 取消运行 + 清通知；不能只从列表隐藏" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="6841.5" y="5114.6" width="195.0" height="90.0" as="geometry"/></mxCell><mxCell id="m4_node_2" value="结果可信？&lt;br&gt;工具成功不是完成；必须有执行结果、真实状态和用户目标满足证据" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="6841.5" y="5221.1" width="195.0" height="90.0" as="geometry"/></mxCell><mxCell id="m4_node_3" value="重启可恢复？&lt;br&gt;车辆上下电、断网、服务重启后，靠事实仓库和版本恢复，不靠旧对话猜" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="6841.5" y="5327.6" width="195.0" height="90.0" as="geometry"/></mxCell><mxCell id="m4_node_4" value="动态视觉目标&lt;br&gt;例：观察孩子是否醒来" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4985.7" y="4940.2" width="157.5" height="56.2" as="geometry"/></mxCell><mxCell id="m4_node_5" value="全量观察清单 + 版本&lt;br&gt;覆盖旧清单；结束时重算或下发空清单" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5225.0" y="4931.8" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_6" value="端侧保存任务集并周期取帧" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5501.7" y="4948.6" width="180.0" height="42.0" as="geometry"/></mxCell><mxCell id="m4_node_7" value="客观观察报告&lt;br&gt;任务编号 + 描述 + 置信度 + 时间" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5763.5" y="4931.8" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_8" value="按任务编号恢复原条件和范围" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6040.2" y="4948.6" width="191.2" height="42.0" as="geometry"/></mxCell><mxCell id="m4_node_9" value="触发器语义匹配&lt;br&gt;是 / 否 / 未知" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6313.2" y="4940.2" width="123.8" height="56.2" as="geometry"/></mxCell><mxCell id="m4_node_10" value="是：回调任务服务/目标链&lt;br&gt;否或未知：继续等待" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6518.7" y="4940.2" width="174.7" height="56.2" as="geometry"/></mxCell><mxCell id="m4_node_11" value="默认主题集合" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5409.4" y="5069.8" width="112.5" height="42.0" as="geometry"/></mxCell><mxCell id="m4_node_12" value="端侧周期采样&lt;br&gt;资料示例约10–20秒；非固定服务承诺" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5603.7" y="5052.9" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_13" value="通用场景摘要" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5880.4" y="5069.8" width="112.5" height="42.0" as="geometry"/></mxCell><mxCell id="m4_node_14" value="按来源/时间/有效期进入上下文" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6074.7" y="5061.3" width="195.0" height="56.2" as="geometry"/></mxCell><mxCell id="m4_node_15" value="决策规划器调用视觉问答工具" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5361.8" y="5182.4" width="191.2" height="42.0" as="geometry"/></mxCell><mxCell id="m4_node_16" value="摄像头取帧 / 权限校验" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5634.8" y="5182.4" width="158.9" height="42.0" as="geometry"/></mxCell><mxCell id="m4_node_17" value="视觉模型输出结构化描述&lt;br&gt;内容、置信度、时间、来源" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5875.5" y="5174.0" width="180.0" height="56.2" as="geometry"/></mxCell><mxCell id="m4_node_18" value="工具执行反馈回决策规划器" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6137.3" y="5182.4" width="180.0" height="42.0" as="geometry"/></mxCell><mxCell id="m4_node_19" value="关键禁止路径&lt;br&gt;动态观察报告不得直接进入上下文&lt;br&gt;不得直接触发工具&lt;br&gt;不得把“睁眼”直接说成“已经醒来”" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="5742.0" y="5262.5" width="195.0" height="123.8" as="geometry"/></mxCell><mxCell id="m4_node_20" value="两个周期独立&lt;br&gt;视觉多久采样一次：模型成本与实时性&lt;br&gt;多久通知用户一次：任务策略与打扰控制" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5742.0" y="5402.8" width="195.0" height="106.9" as="geometry"/></mxCell><mxCell id="m4_node_21" value="用户提出条件/定时/持续诉求" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5945.7" y="4679.2" width="191.8" height="42.0" as="geometry"/></mxCell><mxCell id="m4_node_22" value="决策规划器识别需持久化" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6200.5" y="4679.2" width="168.8" height="42.0" as="geometry"/></mxCell><mxCell id="m4_node_23" value="目标队列更新工具&lt;br&gt;创建 / 更新 / 删除" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6432.3" y="4670.8" width="137.9" height="56.2" as="geometry"/></mxCell><mxCell id="m4_node_24" value="目标队列&lt;br&gt;目标编号、条件、范围、状态、进度" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6633.1" y="4662.3" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_25" value="规则/订阅" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6891.1" y="4625.9" width="95.9" height="42.0" as="geometry"/></mxCell><mxCell id="m4_node_26" value="触发等待" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7050.0" y="4625.9" width="90.0" height="42.0" as="geometry"/></mxCell><mxCell id="m4_node_27" value="命中回调" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7203.0" y="4625.9" width="90.0" height="42.0" as="geometry"/></mxCell><mxCell id="m4_node_28" value="执行反馈 + 真实状态" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7868.3" y="4679.2" width="147.7" height="42.0" as="geometry"/></mxCell><mxCell id="m4_node_29" value="推进目标&lt;br&gt;已设置=等待；命中=激活；执行验真后才完成" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="8079.0" y="4662.3" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_30" value="关闭并清理&lt;br&gt;停用触发规则、视觉订阅、运行和残留通知" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="8337.0" y="4662.3" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_31" value="静态顾问&lt;br&gt;舒适 / 出行 / 内容 / 情感&lt;br&gt;按场景给建议，不是最终执行权" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7356.0" y="4631.0" width="195.0" height="90.0" as="geometry"/></mxCell><mxCell id="m4_node_32" value="最终裁决仍由决策规划器&lt;br&gt;除非明确批准的端侧本地策略" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7614.0" y="4701.1" width="191.2" height="56.2" as="geometry"/></mxCell><mxCell id="m4_node_33" value="动态顾问&lt;br&gt;长期目标监控、复盘和建议&lt;br&gt;目标态并入任务管理，不再单列生命周期" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7356.0" y="4737.5" width="195.0" height="90.0" as="geometry"/></mxCell><mxCell id="m4_node_34" value="信号来源&lt;br&gt;时间、车态、导航、驾驶状态、视觉报告、车辆生命周期" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3449.4" y="4678.0" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_35" value="信号治理&lt;br&gt;统一标识、值/单位、时间戳、来源、置信度、有效期" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3707.4" y="4678.0" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_36" value="规则注册&lt;br&gt;任务编号、条件表达式、生效范围、起止时间、版本" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3965.4" y="4678.0" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_37" value="监听与求值&lt;br&gt;数值比较、状态变化、时间窗、组合与语义匹配" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4223.4" y="4678.0" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_38" value="防抖与迟滞&lt;br&gt;连续命中门槛、退出门槛、边沿检测" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4481.4" y="4678.0" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_39" value="去重与频控&lt;br&gt;一次性、冷却期、最大次数、回调编号" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4739.4" y="4678.0" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_40" value="优先级与互斥&lt;br&gt;安全/用户指令优先；同资源冲突串行或丢弃" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4997.4" y="4678.0" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_41" value="命中结果" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5297.6" y="4630.2" width="84.4" height="84.4" as="geometry"/></mxCell><mxCell id="m4_node_42" value="是：生成一次回调&lt;br&gt;证据 + 规则版本 + 任务编号" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5442.4" y="4650.0" width="182.9" height="56.2" as="geometry"/></mxCell><mxCell id="m4_node_43" value="否/未知：继续等待&lt;br&gt;不得触发执行" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5463.4" y="4722.8" width="140.9" height="56.2" as="geometry"/></mxCell><mxCell id="m4_node_44" value="禁止路径&lt;br&gt;触发器→工具 ×&lt;br&gt;触发命中=任务完成 ×" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="5688.3" y="4641.6" width="150.2" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_45" value="触发回调&lt;br&gt;带任务编号、回调编号、规则版本、命中证据、时间" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5604.9" y="4364.8" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_46" value="回到任务入口层&lt;br&gt;恢复任务与当前版本" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5862.9" y="4373.3" width="146.2" height="56.2" as="geometry"/></mxCell><mxCell id="m4_node_47" value="回调是否重复&lt;br&gt;任务是否仍有效？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6145.3" y="4255.2" width="146.2" height="146.2" as="geometry"/></mxCell><mxCell id="m4_node_48" value="激活任务并创建本轮运行&lt;br&gt;相同回调不得重复建运行" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6383.2" y="4336.9" width="168.8" height="56.2" as="geometry"/></mxCell><mxCell id="m4_node_49" value="运行门禁（Run Guard）&lt;br&gt;重新读取最新车态/人物/权限/安全/网络&lt;br&gt;只复核执行前约束，不重判触发条件" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6614.9" y="4311.6" width="195.0" height="106.9" as="geometry"/></mxCell><mxCell id="m4_node_50" value="允许继续？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6920.8" y="4269.4" width="95.6" height="95.6" as="geometry"/></mxCell><mxCell id="m4_node_51" value="拒绝重复/过期回调&lt;br&gt;记录原因，不创建新运行" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6383.2" y="4422.3" width="168.8" height="56.2" as="geometry"/></mxCell><mxCell id="m4_node_52" value="运行调度器&lt;br&gt;通用链路→原决策规划器&lt;br&gt;固定生态链路→指定服务商" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7117.8" y="4283.7" width="180.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_53" value="原主链执行&lt;br&gt;决策→动作→工具/代理→执行器→真实回读" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7368.3" y="4283.7" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_54" value="独立结果钩子&lt;br&gt;接收工具结果或代理观察，不依赖最终话术" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7626.3" y="4283.7" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_55" value="处理运行结果&lt;br&gt;同事务更新动作/运行/任务/事件&lt;br&gt;失败补偿；必要时写发件箱" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7884.3" y="4275.2" width="195.0" height="90.0" as="geometry"/></mxCell><mxCell id="m4_node_56" value="结束策略" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="8184.5" y="4235.8" width="84.4" height="84.4" as="geometry"/></mxCell><mxCell id="m4_node_57" value="一次任务：关闭&lt;br&gt;持续任务：回到等待&lt;br&gt;部分失败：保留待办分支&lt;br&gt;超过失败上限：关闭并说明原因" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="8289.7" y="4266.8" width="195.0" height="106.9" as="geometry"/></mxCell><mxCell id="m4_node_58" value="本轮跳过或等待&lt;br&gt;保留可恢复证据，不伪装成失败或成功" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7110.3" y="4373.3" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_59" value="事件记录（Event）&lt;br&gt;收到用户创建/更新/取消、触发回调、执行结果&lt;br&gt;状态：已接收→已校验→已应用/已拒绝" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3496.6" y="4348.7" width="195.0" height="106.9" as="geometry"/></mxCell><mxCell id="m4_node_60" value="任务规格&lt;br&gt;用户目标、条件、范围、频率、结束策略、版本" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3754.6" y="4365.6" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_61" value="执行脚本（Script）&lt;br&gt;把长期目标展开为可恢复步骤&lt;br&gt;状态：草稿→已发布→已停用/已废弃" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4012.6" y="4357.2" width="195.0" height="90.0" as="geometry"/></mxCell><mxCell id="m4_node_62" value="任务&lt;br&gt;状态：等待→运行→已关闭&lt;br&gt;关闭原因：完成/取消/过期/失败/车辆离线" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4270.6" y="4357.2" width="195.0" height="90.0" as="geometry"/></mxCell><mxCell id="m4_node_63" value="本轮运行（Run）&lt;br&gt;状态：已创建→运行中→成功/失败/跳过/取消&lt;br&gt;阶段：执行中/等用户/等车端/等外部" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4528.6" y="4314.1" width="195.0" height="106.9" as="geometry"/></mxCell><mxCell id="m4_node_64" value="原子动作（Action）&lt;br&gt;状态：待下发→已接收→已调用→已生效→已完成&lt;br&gt;或失败/超时/取消/部分成功" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4786.6" y="4292.2" width="195.0" height="90.0" as="geometry"/></mxCell><mxCell id="m4_node_65" value="可靠发件箱（Outbox）&lt;br&gt;同事务保存待发消息&lt;br&gt;状态：待发送→已发送→已确认&lt;br&gt;失败则重试/转死信并告警" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5044.6" y="4249.2" width="195.0" height="106.9" as="geometry"/></mxCell><mxCell id="m4_node_66" value="任务消息&lt;br&gt;卡片、语音、服务端推送、任务中心刷新" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5302.6" y="4257.6" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_67" value="事实仓库&lt;br&gt;任务 / 运行 / 事件 / 动作 / 绑定&lt;br&gt;用任务编号、运行编号、回调编号、动作编号贯通" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5302.6" y="4402.0" width="195.0" height="106.9" as="geometry"/></mxCell><mxCell id="m4_node_68" value="用户诉求" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6324.3" y="3676.3" width="90.0" height="42.0" as="geometry"/></mxCell><mxCell id="m4_node_69" value="任务类型" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6519.5" y="3611.7" width="84.4" height="84.4" as="geometry"/></mxCell><mxCell id="m4_node_70" value="简单单步&lt;br&gt;例：打开车窗&lt;br&gt;本轮直接执行" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6662.1" y="3435.4" width="112.5" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_71" value="复合单轮&lt;br&gt;例：太热了&lt;br&gt;查询车态 + 多动作并行/串行" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6624.7" y="3525.0" width="187.3" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_72" value="多步依赖&lt;br&gt;例：找昨天地点再导航&lt;br&gt;前一步结果决定后一步参数" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6628.4" y="3614.7" width="180.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_73" value="定时任务&lt;br&gt;例：10分钟后关座椅加热&lt;br&gt;保存时间条件并等待" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6633.7" y="3704.3" width="169.3" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_74" value="条件任务&lt;br&gt;例：宝宝醒了告诉我&lt;br&gt;订阅信号/视觉并等待" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6642.3" y="3793.9" width="152.2" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_75" value="持续任务&lt;br&gt;例：沿途持续讲解&lt;br&gt;多次运行直到结束策略命中" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6628.4" y="3883.5" width="180.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_76" value="不建持久任务" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6875.0" y="3541.9" width="112.5" height="42.0" as="geometry"/></mxCell><mxCell id="m4_node_77" value="建立持久任务" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6875.0" y="3810.8" width="112.5" height="42.0" as="geometry"/></mxCell><mxCell id="m4_node_78" value="任务管理入口&lt;br&gt;任务管理接口 / 图形界面接口" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5643.7" y="3272.3" width="192.7" height="56.2" as="geometry"/></mxCell><mxCell id="m4_node_79" value="任务代理（Task Agent）&lt;br&gt;只做入口和透传，不负责生命周期" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5642.6" y="3410.3" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_80" value="任务入口层&lt;br&gt;解析、绑定、幂等、恢复任务上下文" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5642.6" y="3565.2" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_81" value="任务规格构建器&lt;br&gt;判断创建 / 更新 / 取消 / 查询" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5642.6" y="3720.0" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_82" value="任务服务内的任务管理器（Task Service）&lt;br&gt;唯一维护任务、运行、事件的确定性状态" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5642.6" y="3874.9" width="195.0" height="90.0" as="geometry"/></mxCell><mxCell id="m4_node_83" value="触发适配器&lt;br&gt;复用既有规则，不再造第二套触发器" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5536.8" y="4046.7" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_84" value="运行调度器&lt;br&gt;仍回到原决策规划器 / 工具 / 服务商" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5748.3" y="4046.7" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_85" value="决策规划器判断&lt;br&gt;这是立即动作，还是要长期记住" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5105.9" y="3330.0" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_86" value="一次动作&lt;br&gt;能否完成？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5203.4" y="3428.7" width="112.5" height="112.5" as="geometry"/></mxCell><mxCell id="m4_node_87" value="立即任务&lt;br&gt;仍走原主链：动作清单→工具→执行反馈" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5009.6" y="3696.0" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_88" value="条件/定时/持续任务&lt;br&gt;调用目标队列更新工具" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5221.1" y="3704.5" width="157.5" height="56.2" as="geometry"/></mxCell><mxCell id="m4_node_89" value="弋途持续任务逻辑&lt;br&gt;创建目标 + 触发场景" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5226.0" y="3850.9" width="147.7" height="56.2" as="geometry"/></mxCell><mxCell id="m4_node_90" value="目标 / 动态顾问分散管理&lt;br&gt;触发后再唤醒顾问或决策规划器" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5202.3" y="3988.9" width="195.0" height="73.1" as="geometry"/></mxCell><mxCell id="m4_node_91" value="边界必须守住&lt;br&gt;① 任务代理不是第二个决策规划器&lt;br&gt;② 任务服务不重做触发条件判断&lt;br&gt;③ 运行调度器不自由修改生命周期&lt;br&gt;④ 预生产验证结果不能外推为正式生产事实" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="6022.1" y="3608.8" width="195.0" height="174.4" as="geometry"/></mxCell><mxCell id="m4_node_92" value="04｜任务、主动服务、触发器与视觉闭环&lt;br&gt;先分清当前生产、预生产验证、目标架构；再沿任务编号追到真实结果" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5893.2" y="2918.3" width="195.0" height="106.9" as="geometry"/></mxCell><mxCell id="m4_node_93" value="证据标签：【当前】 已在当前协议或材料中出现　【待链路验真】 需同一条运行记录确认　【预生产/建设中】 仅表示测试或目标设计，不等于正式生产" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="5893.2" y="3050.7" width="195.0" height="123.8" as="geometry"/></mxCell><mxCell id="m4_edge_0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#78909C;fontColor=#475467;fontSize=12;" edge="1" parent="1" source="m4_node_92" target="m4_node_93"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m4_edge_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#78909C;fontColor=#475467;fontSize=12;" edge="1" parent="1" source="m4_node_4" target="m4_node_5"><mxGeometry 