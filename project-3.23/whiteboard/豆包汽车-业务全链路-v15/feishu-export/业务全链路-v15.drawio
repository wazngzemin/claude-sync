DA;strokeWidth=3;" sourceIndex="127" sourceTag="rect" sourceAttributes="{&quot;x&quot;:&quot;3710&quot;,&quot;y&quot;:&quot;7490&quot;,&quot;width&quot;:&quot;2760&quot;,&quot;height&quot;:&quot;6360&quot;,&quot;rx&quot;:&quot;14&quot;,&quot;fill&quot;:&quot;white&quot;,&quot;stroke&quot;:&quot;#9BB8DA&quot;,&quot;stroke-width&quot;:&quot;3&quot;}" vertex="1"><mxGeometry x="0" y="0" width="2760" height="6360" as="geometry"/></mxCell><mxCell id="v15_92" parent="v15_90" value="" style="shape=rectangle;rounded=1;absoluteArcSize=1;arcSize=28;fillColor=#EAF2FF;strokeColor=none;strokeWidth=1;" sourceIndex="128" sourceTag="rect" sourceAttributes="{&quot;x&quot;:&quot;3710&quot;,&quot;y&quot;:&quot;7490&quot;,&quot;width&quot;:&quot;2760&quot;,&quot;height&quot;:&quot;165&quot;,&quot;rx&quot;:&quot;14&quot;,&quot;fill&quot;:&quot;#EAF2FF&quot;}" vertex="1"><mxGeometry x="0" y="0" width="2760" height="165" as="geometry"/></mxCell><mxCell id="v15_93" parent="v15_90" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:39px;font-weight:650;line-height:1;white-space:pre;&quot;&gt;O · 输出与真实结果｜说出来、显示出来，还要真的做到&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=39;fontColor=#163352;fontStyle=1;fontWeight=650;labelPadding=0;" sourceIndex="130" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;3746&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="3746" sourceBaselineY="7549" sourceFontSize="39" sourceFontWeight="650" sourceTextIndex="129"><mxGeometry x="36" y="20" width="1263.6" height="46.8" as="geometry"/></mxCell><mxCell id="v15_94" parent="v15_90" value="&lt;span style=&quot;font-family:-apple