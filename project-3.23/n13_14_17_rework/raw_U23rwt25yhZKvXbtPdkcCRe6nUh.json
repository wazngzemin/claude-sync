      "text": {
        "angle": 0,
        "font_size": 14,
        "font_weight": "regular",
        "horizontal_align": "left",
        "italic": false,
        "line_through": false,
        "rich_text": {
          "paragraphs": [
            {
              "elements": [
                {
                  "element_type": 0,
                  "text_element": {
                    "text": "N13-01 vehicle_communication（TOOL03 车端通讯）",
                    "text_style": {
                      "font_size": 13,
                      "font_weight": "bold",
                      "italic": false,
                      "line_through": false,
                      "text_color": "#111827",
                      "underline": false
                    }
                  }
                }
              ],
              "indent": 0,
              "list_begin_index": 0,
              "paragraph_type": 0,
              "quote": false
            },
            {
              "elements": [
                {
                  "element_type": 0,
                  "text_element": {
                    "text": "要点：车里唯一的通讯工具，打电话/发起视频通话走它。",
                    "text_style": {
                      "font_size": 11,
                      "italic": false,
                      "line_through": false,
                      "text_color": "#374151",
                      "underline": false
                    }
                  }
                }
              ],
              "indent": 0,
              "list_begin_index": 0,
              "paragraph_type": 0,
              "quote": false
            },
            {
              "elements": [
                {
                  "element_type": 0,
                  "text_element": {
                    "text": "讲解①：用户语音\"给张三打视频电话\"→ Director 调本工具。",
                    "text_style": {
                      "font_size": 11,
                      "italic": false,
                      "line_through": false,
                      "text_color": "#374151",
                      "underline": false
                    }
                  }
                }
              ],
              "indent": 0,
              "list_begin_index": 0,
              "paragraph_type": 0,
              "quote": false
            },
            {
              "elements": [
                {
                  "element_type": 0,
                  "text_element": {
                    "text": "讲解②：资料仅见工具表一行，无端云分工、无车型 PRD。",
                    "text_style": {
                      "font_size": 11,
                      "italic": false,
                      "line_through": false,
                      "text_color": "#374151",
                      "underline": false
                    }
