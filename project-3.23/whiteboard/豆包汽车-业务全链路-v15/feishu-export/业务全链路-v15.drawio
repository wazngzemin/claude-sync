/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4382" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;9176&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="9176" sourceBaselineY="2946" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4379"><mxGeometry x="26" y="171" width="390" height="30" as="geometry"/></mxCell><mxCell id="v15_4153" parent="v15_4146" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;具体能力受新链路开关控制&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4383" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;9176&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="9176" sourceBaselineY="2980" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4379"><mxGeometry x="26" y="205" width="360" height="30" as="geometry"/></mxCell><mxCell id="v15_4154" parent="v15_4146" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="4384" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;9176&quot;,&quot;y1&quot;:&quot;3009&quot;,&quot;x2&quot;:&quot;9844&quot;,