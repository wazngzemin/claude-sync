neY="5942" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4185"><mxGeometry x="26" y="137" width="420" height="30" as="geometry"/></mxCell><mxCell id="v15_4000" parent="v15_3994" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;迟到结果只归档，不变成新指令&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4188" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="5976" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4185"><mxGeometry x="26" y="171" width="420" height="30" as="geometry"/></mxCell><mxCell id="v15_4001" parent="v15_3994" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;同时检查重复回复与重复历史&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4189" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="6010" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4185"><mxGeometry x="26" y="205" width="390" height="30" as="geometry"/></mxCell><mxCell id="v15_4002" parent="v15_3994" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="4190" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;4746&quot;,&quot;y1&quot;:&quot;6039&quot;,&quot;x2&quot;:&quot;5414&quot;,&quot;y2&quot;:&quot;6039&quot;,&quot;stroke&quot;:&quot;#CAD8E6&quot;,&quot;stroke-width&quot;:&quot;1&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="259" as="sourcePoint"/><mxPoint x="694" y="259" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_4003" parent="v15_3994" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;本地已因断网或 3 秒超时接手后，旧云端请求仍可能稍后完&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4192" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="6072" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4191"><mxGeometry x="26" y="267" width="840" height="30" as="geometry"/></mxCell><mxCell id="v15_4004" parent="v15_3994" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;成。AIVA 改版明确迟到云端不能再执行；必须依靠同一 &lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4193" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="6106" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4191"><mxGeometry x="26" y="301" width="840" height="30" as="geometry"/></mxCell><mxCell id="v15_4005" parent="v15_3994" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;request_id 和采信记录隔离它，不能只让 UI 隐藏第二次&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4194" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="6140" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4191"><mxGeometry x="26" y="335" width="990" height="30" as="geometry"/></mxCell><mxCell id="v15_4006" parent="v15_3994" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;回复却又做一次动作。例如“车窗再降一点”重复执行会多&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4195" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="6174" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4191"><mxGeometry x="26" y="369" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_4007" parent="v15_3994" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;降一次，风险比重复回答更高。验收应数真实设备变化和历&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4196" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="6208" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4191"><mxGeometry x="26" y="403" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_4008" parent="v15_3994" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;史条数，而不只看日志里是否只展示了一条最终答案。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=now