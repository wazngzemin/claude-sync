=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=23;fontColor=#2463C5;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="10439" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;3740&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="3740" sourceBaselineY="44953" sourceFontSize="23" sourceFontWeight="400" sourceTextIndex="10438"><mxGeometry x="30" y="73" width="441.6" height="27.6" as="geometry"/></mxCell><mxCell id="v15_8816" parent="v15_8812" value="" style="shape=rectangle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F4F8FE;strokeColor=#C3D2E5;strokeWidth=2;" sourceIndex="10440" sourceTag="rect" sourceAttributes="{&quot;x&quot;:&quot;3740&quot;,&quot;y&quot;:&quot;45017&quot;,&quot;width&quot;:&quot;2700&quot;,&quot;height&quot;:&quot;111&quot;,&quot;rx&quot;:&quot;7&quot;,&quot;fill&quot;:&quot;#F4F8FE&quot;,&quot;stroke&quot;:&quot;#C3D2E5&quot;,&quot;stroke-width&quot;:&quot;2&quot;}" vertex="1"><mxGeometry x="30" y="160" width="2700" height="111" as="geometry"/></mxCell><mxCell id="v15_8817" parent="v15_8812" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:21px;font-weight:600;line-height:1;white-space:pre;&quot;&gt;接收什么&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=21;fontColor=#62758A;fontStyle=1;fontWeight=600;labelPadding=0;" sourceIndex="10442" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;3765&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="3765" sourceBaselineY="45050" sourceFontSize="21" sourceFontWeight="600" sourceTextIndex="10441"><mxGeometry x="55" y="172" width="100.8" height="25.2" as="geometry"/></mxCell><mxCell id="v15_8818" parent="v15_8812" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;新增只传目标描述；删除传真实goal_id，多ID用逗号分隔。不是即时聊天/一次性车控工具。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="10444" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;3765&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="3765" sourceBaselineY="45089" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="10443"><mxGeometry x="55" y="207" width="1380" height="30" as="geometry"/></mxCell><mxCell id="v15_8819" parent="v15_8812" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#627E9F;strokeWidth=3;dashed=0;html=0;" sourceIndex="10445" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;5090&quot;,&quot;y1&quot;:&quot;45128&quot;,&quot;x2&quot;:&quot;5090&quot;,&quot;y2&quot;:&quot;45168&quot;,&quot;stroke&quot;:&quot;#627E9F&quot;,&quot;stroke-width&quot;:&quot;3&quot;,&quot;marker-end&quot;:&quot;url(#arr-627E9F)&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1380" y="271" as="sourcePoint"/><mxPoint x="1380" y="311" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_8820" parent="v15_8812" value="" style="shape=triangle;direction=east;rotation=90;fillColor=#627E9F;strokeColor=none;strokeWidth=0;resizable=1;" sourceIndex="10445" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;5090&quot;,&quot;y1&quot;:&quot;45128&quot;,&quot;x2&quot;:&quot;5090&quot;,&quot;y2&quot;:&quot;45168&quot;,&quot;stroke&quot;:&quot;#627E9F&quot;,&quot;stroke-width&quot;:&quot;3&quot;,&quot;marker-end&quot;:&quot;url(#arr-627E9F)&quot;}" vertex="1" sourceMarker="true"><mxGeometry x="1369.5" y="294.5" width="21" height="18" as="geometry"/></mxCell><mxCell id="v15_8821" parent="v15_8812" value="" style="shape=rectangle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F4F8FE;strokeColor=#C3D2E5;strokeWidth=2;" sourceIndex="10446" sourceTag="rect" sourceAttributes="{&quot;x&quot;:&quot;3740&quot;,&quot;y&quot;:&quot;45174&quot;,&quot;width&quot;:&quot;2700&quot;,&quot;height&quot;:&quot;111&quot;,&quot;rx&quot;:&quot;7&quot;,&quot;fill&quot;:&quot;#F4F8FE&quot;,&quot;stroke&quot;:&quot;#C3D2E5&quot;,&quot;stroke-width&quot;:&quot;2&quot;}" vertex="1"><mxGeometry x="30" y="317" width="2700" height="111" as="geometry"/></mxCell><mxCell id="v15_8822" parent="v15_8812" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:21px;font-weight:600;line-height:1;white-space:pre;&quot;&gt;内部处理／能力边界&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=21;fontColor=#62758A;fontStyle=1;fontWeight=600;labelPadding=0;" sourceIndex="10448" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;3765&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="3765" sourceBaselineY="45207" sourceFontSize="21" sourceFontWeight="600" sourceTextIndex="10447"><mxGeometry x="55" y="329" width="226.8" height="25.2" as="geometry"/></mxCell><mxCell id="v15_8823" parent="v15_8812" value="&lt;span style=&quot;font-family:-apple-system,B