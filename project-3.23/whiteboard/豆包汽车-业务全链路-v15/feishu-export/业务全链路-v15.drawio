size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;记录原问题、音区和播放进度&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4767" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="9056" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4764"><mxGeometry x="26" y="171" width="390" height="30" as="geometry"/></mxCell><mxCell id="v15_4450" parent="v15_4443" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;不把任何新声音都视为有效指令&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4768" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="9090" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4764"><mxGeometry x="26" y="205" width="420" height="30" as="geometry"/></mxCell><mxCell id="v15_4451" parent="v15_4443" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="4769" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;2136&quot;,&quot;y1&quot;:&quot;9119&quot;,&quot;x2&quot;:&quot;2804&quot;,&quot;y2&quot;:&quot;9119&quot;,&quot;stroke&quot;:&quot;#CAD8E6&quot;,&quot;stroke-width&quot;:&quot;1&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="259" as="sourcePoint"/><mxPoint x="694" y="259" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_4452" parent="v15_4443" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;用户可能在豆包介绍天气时突然说“先把空调调低”，也可&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4771" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="9152" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4770"><mxGeometry x="26" y="267" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_4453" parent="v15_4443" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;能只是在跟朋友聊天。TTS 是把回复文字合成为声音的能力&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4772" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="9186" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4770"><mxGeometry x="26" y="301" width="840" height="30" as="geometry"/></mxCell><mxCell id="v15_4454" parent="v15_4443" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;；播报期间新声音到达后，系统仍要判断是不是需要接话。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4773" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="9220" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4770"><mxGeometry x="26" y="335" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_4455" parent="v15_4443" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;首先保留旧回答的播报对象、已说部分和剩余内容，后面才&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4774" sourc