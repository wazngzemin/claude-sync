flowchart LR
  subgraph A["① 配好任务"]
    direction TB
    A1["产品定义任务<br/>场景、条件、交互、动作<br/>明确车型与成功标准"]
    A2["配置平台保存并发布<br/>触发规则 + 后续处理"]
    A1 --> A2
  end
  subgraph B["② 用户启用与触发"]
    direction TB
    B1["任务中心<br/>用户开启任务"]
    B2["任务状态承接业务<br/>保存并提供真实开关<br/>按车辆或账号读取"]
    B3["Cloud Trigger<br/>读取开关、配置和上行车况<br/>检查条件、时效与频控"]
    B4["条件满足且未重复<br/>发出一次业务事件"]
    BT["Task Service<br/>状态及生命周期承接<br/>待确认"]
    B1 --> B2 --> B3 --> B4
    B2 -.- BT
  end
  subgraph C["③ 业务处理与交互"]
    direction TB
    C1["业务接事件<br/>按需调用主动推荐<br/>通过 DT / VQA 判断"]
    C2["业务校验识别结果<br/>明确、未过期、属于本次场景<br/>通过后按配置决定是否询问"]
    C3["系统预设任务业务<br/>注册卡片并申请展示<br/>提供文案、按钮、回调及有效期"]
    CV["即时交互卡 / VUI<br/>展示卡片、按钮和 TTS<br/>实际展示后返回展示结果"]
    C4["点击按钮<br/>结果直接回业务"]
    C5["语音交互 → Planner<br/>结合卡片理解回答"]
    C6["业务核对用户选择<br/>属于本次询问且未失效<br/>明确确认才继续"]
    C1 --> C2 -->|本例需要询问| C3
    C3 --> CV
    CV --> C4 --> C6
    CV --> C5 --> C6
    CS["可见即可说<br/>固定词映射按钮<br/>本任务接入待确认"]
    C5 -.- CS
  end
  subgraph D["④ 执行与结果"]
    direction TB
    D1["业务申请执行<br/>端侧复核任务和车况"]
    D2["赛力斯车控<br/>复核通过才执行"]
    D3["端状态回读<br/>确认车辆是否达到目标<br/>成功 / 失败 / 暂不能确认"]
    D4["业务更新卡片和记录<br/>结束本次，等待下次"]
    D1 --> D2 --> D3 --> D4
  end
  A -->|配置生效，任务可用| B
  B -->|任务、车辆、触发原因| C
  C -->|确认后申请车辆动作| D
  classDef config fill:#fff4df,stroke:#c69337,color:#513c19;
  classDef manage fill:#eaf2ff,stroke:#5a84bf,color:#17385e;
  classDef business fill:#f0ebfc,stroke:#9772c1,color:#382550;
  classDef car fill:#e9f5ee,stroke:#5b9e7a,color:#234834;
  class A1,A2 config;
  class B1,B2,B3,B4 manage;
  classDef pending fill:#fafafa,stroke:#a1a8b3,stroke-dasharray:5 4,color:#566174;
  class BT,CS pending;
  class C1,C2,C3,CV,C4,C5,C6 business;
  class D1,D2,D3,D4 car;
