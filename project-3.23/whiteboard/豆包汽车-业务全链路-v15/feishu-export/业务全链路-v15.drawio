"6044"><mxGeometry x="26" y="171" width="360" height="30" as="geometry"/></mxCell><mxCell id="v15_5441" parent="v15_5434" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;匹配成功不能代替执行回执&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="6048" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="17220" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="6044"><mxGeometry x="26" y="205" width="360" height="30" as="geometry"/></mxCell><mxCell id="v15_5442" parent="v15_5434" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="6049" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;2136&quot;,&quot;y1&quot;:&quot;17249&quot;,&quot;x2&quot;:&quot;2804&quot;,&quot;y2&quot;:&quot;17249&quot;,&quot;stroke&quot;:&quot;#CAD8E6&quot;,&quot;stroke-width&quot;:&quot;1&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="259" as="sourcePoint"/><mxPoint x="694" y="259" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_5443" parent="v15_5434" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;操作执行后，业务方将成功或失败等结果及播报内容交回豆&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="6051" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="17282" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="6050"><mxGeometry x="26" y="267" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_5444" parent="v15_5434" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;包。语音识别、候选匹配和控件接收都可能成功，但真实业&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="6052" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="17316" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="6050"><mxGeometry x="26" y="301" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_5445" parent="v15_5434" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;务仍失败，例如卡片目标过期或服务不可用，因此一定要等&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="6053" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="17350" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="6050"><mxGeometry x="26" y="335" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_5446" parent="v15_5434" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;执行回执。混合操作若存在部分成功，不能用一个成功词覆&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="6054" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="17384" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="6050"><mxGeometry x="26" y="369" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_5447" parent="v15_5434" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;盖失败项。具体回执字段应按正式接口核对；本图不虚构字&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="6055" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="17418" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="6050"><mxGeometry x="26" y="403" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_5448" parent="v15_5434" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;段名，重点是让用户可见结果与真正发生的行为一致。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="6056" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="17452" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="6050"><mxGeometry x="26" y="437" width="720" height="30" as="geometry"/></mxCell><mxCell id="v15_5449" parent="v15_5434" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:18px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;交出 → O13&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spaci