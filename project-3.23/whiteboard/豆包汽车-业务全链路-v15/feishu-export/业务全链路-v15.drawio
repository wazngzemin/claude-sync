ple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;态规则。断网、车辆下电、重新登录后，展示与后台任务是&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="9156" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;12696&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="12696" sourceBaselineY="31522" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="9154"><mxGeometry x="26" y="267" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_7860" parent="v15_7850" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;否恢复，要按任务有效期和项目策略检查。不能从“列表还&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="9157" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;12696&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="12696" sourceBaselineY="31556" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="9154"><mxGeometry x="26" y="301" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_7861" parent="v15_7850" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSyste