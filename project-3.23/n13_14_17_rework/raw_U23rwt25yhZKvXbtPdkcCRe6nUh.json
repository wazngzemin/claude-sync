      "z_index": 14
    },
    {
      "angle": 0,
      "height": 97,
      "id": "a1:13",
      "text": {
        "angle": 0,
        "font_size": 14,
        "font_weight": "regular",
        "horizontal_align": "left",
        "italic": false,
        "line_through": false,
        "rich_text": {
          "paragraphs": [
            {
              "elements": [
                {
                  "element_type": 0,
                  "text_element": {
                    "text": "N13-04 后台逐帧\"Special Token\"链路（与用户打不打电话无关）",
                    "text_style": {
                      "font_size": 13,
                      "font_weight": "bold",
                      "italic": false,
                      "line_through": false,
                      "text_color": "#111827",
                      "underline": false
                    }
                  }
                }
              ],
              "indent": 0,
              "list_begin_index": 0,
              "paragraph_type": 0,
              "quote": false
            },
            {
              "elements": [
                {
                  "element_type": 0,
                  "text_element": {
                    "text": "要点：云端视觉触发器 PRD 提到——持续视觉任务复用\"豆包视频通话\"的 Special Token，逐图预测。",
                    "text_style": {
                      "font_size": 11,
                      "italic": false,
                      "line_through": false,
                      "text_color": "#374151",
                      "underline": false
                    }
                  }
                }
              ],
              "indent": 0,
              "list_begin_index": 0,
              "paragraph_type": 0,
              "quote": false
            },
            {
              "elements": [
                {
                  "element_type": 0,
                  "text_element": {
                    "text": "讲解①：Special Token = 逐帧推理时标识\"这是一帧视频\"的特殊标记，后台常驻。",
                    "text_style": {
                      "font_size": 11,
                      "italic": false,
                      "line_through": false,
                      "text_color": "#374151",
                      "underline": false
                    }
                  }
                }
              ],
              "indent": 0,
              "list_begin_index": 0,
              "paragraph_type": 0,
              "quote": false
            },
            {
              "elements": [
                {
                  "element_type": 0,
                  "text_element": {
                    "text": "讲解②：开始=视觉持续任务下发；结束=任务取消或离车；上报=逐图结果给触发器规则判断。",
                    "text_style": {
                      "font_size": 11,
                      "italic": false,
                      "line_through": false,
                      "text_color": "#374151",
                      "underline": false
                    }
                  }
                }
              ],
              "indent": 0,
              "list_begin_index": 0,
              "paragraph_type": 0,
              "quote": false
            },
            {
              "elements": [
                {
                  "element_type": 0,
                  "text_element": {
                    "text": "讲解③：车端算力大户，不占主链；端云分工、车型、耗时均未写。",
                    "text_style": {
                      "font_size": 11,
                      "italic": false,
                      "line_through": false,
                      "text_color": "#374151",
                      "underline": false
                    }
                  }
                }
              ],
              "indent": 0,
              "list_begin_index": 0,
              "paragraph_type": 0,
              "quote": false
            },
            {
              "elements": [
                {
                  "element_type": 0,
                  "text_element": {
                    "text": "【待核】",
                    "text_style": {
                      "font_size": 10,
                      "italic": false,
                      "line_through": false,
                      "text_color": "#6b7280",
                      "underline": false
                    }
                  }
                }
              ],
              "indent": 0,
              "list_begin_index": 0,
              "paragraph_type": 0,
              "quote": false
            }
          ]
        },
        "text": "N13-04 后台逐帧\"Special Token\"链路（与用户打不打电话无关）\n要点：云端视觉触发器 PRD 提到——持续视觉任务复用\"豆包视频通话\"的 Special Token，逐图预测。\n讲解①：Special Token = 逐帧推理时标识\"这是一帧视频\"的特殊标记，后台常驻。\n讲解②：开始=视觉持续任务下发；结束=任务取消或离车；上报=逐图结果给触发器规则判断。\n讲解③：车端算力大户，不占主链；端云分工、车型、耗时均未写。\n【待核】",
        "text_background_color_type": 0,
        "text_color": "#1f2329",
        "text_color_type": 1,
        "theme_text_background_color_code": -1,
        "underline": false,
