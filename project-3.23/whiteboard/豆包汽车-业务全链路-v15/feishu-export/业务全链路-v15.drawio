osoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="8606" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="31426" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="8603"><mxGeometry x="26" y="171" width="390" height="30" as="geometry"/></mxCell><mxCell id="v15_7432" parent="v15_7425" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="8607" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;4746&quot;,&quot;y1&quot;:&quot;31455&quot;,&quot;x2&quot;:&quot;5414&quot;,&quot;y2&quot;:&quot;31455&quot;,&quot;stroke&quot;:&quot;#CAD8E6&quot;,&quot;stroke-width&quot;:&quot;1&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="225" as="sourcePoint"/><mxPoint x="694" y="225" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_7433" parent="v15_7425" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;确认通过后，原业务调用具体车控，再读取实际车辆状态。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="8609" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="31488" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="8608"><mxGeometry x="26" y="233" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_7434" parent="v15_7425" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;例如用户同意开启后雾灯，既要看车控返回，也要看灯是否&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="8610" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="31522" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="8608"><mxGeometry x="26" y="267" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_7435" parent="v15_7425" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;真的开启。接口接收、命令下发和实车状态一致是三个阶段&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="8611" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="31556" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="8608"><mxGeometry x="26" y="301" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_