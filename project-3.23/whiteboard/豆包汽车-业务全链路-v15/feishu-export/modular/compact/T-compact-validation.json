      },
      "renderedTitleLines": [
        "弄清要办哪一件事"
      ],
      "renderedSummaryLines": [
        {
          "sourceLine": 0,
          "text": "Seres：先查询现有 TaskView"
        },
        {
          "sourceLine": 1,
          "text": "Spec Builder 决定增改删查"
        },
        {
          "sourceLine": 2,
          "text": "Task Agent 只做请求入口"
