;font-weight:500;line-height:1;white-space:pre;&quot;&gt;持久化/原子写失败不绕过准入&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4441" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;7356&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="7356" sourceBaselineY="3888" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4440"><mxGeometry x="26" y="103" width="420" height="30" as="geometry"/></mxCell><mxCell id="v15_4198" parent="v15_4193" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;租约过期先恢复合法持有者&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4442" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;7356&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="7356" sourceBaselineY="3922" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4440"><mxGeometry x="26" y="137" width="360" height="30" as="geometry"/></mxCell><mxCell id="v15_4199" parent="v15_4193" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;已发工具的旧请求不重跑&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4443" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;7356&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="7356" sourceBaselineY="3956" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4440"><mxGeometry x="26" y="171" width="330" height="30" as="geometry"/></mxCell><mxCell id="v15_4200" parent="v15_4193" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;分别验收文本、工具、无音频轮&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4444" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;7356&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="7356" sourceBaselineY="3990" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4440"><mxGeometry x="26" y="205" width="420" height="30" as="geometry"/></mxCell><mxCell id="v15_4201" parent="v15_4193" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="4445" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;7356&quot;,&quot;y1&quot;:&quot;4019&quot;,&quot;x2&quot;: