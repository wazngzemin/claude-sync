ent="v15_7907" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;A10 方案范围，不外推全渠道&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="9230" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;10876&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="10876" sourceBaselineY="33514" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="9225"><mxGeometry x="26" y="239" width="450" height="30" as="geometry"/></mxCell><mxCell id="v15_7916" parent="v15_7907" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="9231" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;10876&quot;,&quot;y1&quot;:&quot;33543&quot;,&quot;x2&quot;:&quot;11544&quot;,&quot;y2&quot;:&quot;33543&quot;,&quot;stroke&quot;:&quot;#CAD8E6&quot;,&quot;stroke-width&quot;:&quot;1&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="293" as="sourcePoint"/><mxPoint x="694" y="293" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_7917" parent="v15_7907" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;A10 技术方案明确，任务岛不是任务中心的全部任务列表：&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="9233" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;10876&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="10876" sourceBaselineY="33576" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="9232"><mxGeometry x="26" y="301" width="840" height="30" as="geometry"/></mxCell><mxCell id="v15_7918" parent="v15_7907" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;它聚合有效长时任务和生态长程任务。Task Service 创建&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="9234" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;10876&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="10876" sourceBaselineY="33610" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="9232"><mxGeometry x="26" y="335" width="960" height="30" as="geometry"/></mxCell><mxCell id="v15_7919" parent="v15_7907" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;成功后，按执行类型、触发方式与单次或循环属性选择通知&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="9235" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;10876&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="10876" sourceBaselineY="33644" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="9232"><mxGeometry x="26" y="369" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_7920" parent="v15_7907" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;出口。例如“下午三点提醒”只弹即时卡，“每小时播新闻&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="9236" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;10876&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="10876" sourceBaselineY="33678" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="9232"><mxGeometry x="26" y="403" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_7921" parent="v15_7907" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;”同时更新即时卡与任务岛，“点咖啡送到公司”只进任务&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="9237" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;10876&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="10876" sourceBaselineY="33712" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="9232"><mxGeometry x="26" y="437" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_7922" parent="v15_7907" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;岛。岛上没有单次任务，不等于创建失败；展示矩阵只代表&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="9238" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;10876&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="10876" sourceBaselineY="33746" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="9232"><mxGeometry x="26" y="471" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_7923" parent="v15_7907" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;该方案范围。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSyste