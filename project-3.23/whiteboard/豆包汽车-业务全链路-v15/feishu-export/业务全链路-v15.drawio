mp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;兜底候选为 unsupported 时失败&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4166" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;5656&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="5656" sourceBaselineY="5908" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4165"><mxGeometry x="26" y="103" width="630" height="30" as="geometry"/></mxCell><mxCell id="v15_3983" parent="v15_3978" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;按项目说明网络异常或能力边界&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4167" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;5656&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="5656" sourceBaselineY="5942" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4165"><mxGeometry x="26" y="137" width="420" height="30" as="geometry"/></mxCell><mxCell id="v15_3984" parent="v15_3978" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;同一唤醒周期提示最多一次&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4168" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;5656&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="5656" sourceBaselineY="5976" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4165"><mxGeometry x="26" y="171" width="360" height="30" as="geometry"/></mxCell><mxCell id="v15_3985" parent="v15_3978" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;不把有效需求伪装成无关聊天&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4169" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;5656&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="5656" sourceBaselineY="6010" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4165"><mxGeometry x="26" y="205" width="390" height="30" as="geometry"/></mxCell><mxCell id="v15_3986" parent="v15_3978" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="4170" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;5656&quot;,&quot;y1&quot;:&quot;6039&quot;,&quot;x2&quot;:&quot;6324&quot;,&quot;y2&quot;:&quot;6039&quot;,&quot;stroke&quot;:&quot;#CAD8E6&quot;,&quot;stroke-width&quot;:&quot;1&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="259" as="sourcePoint"/><mxPoint x="694" y="259" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_3987" parent="v15_3978" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;在断网或云端超时后，如果本地候选为 unsupported，说明&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4172" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;5656&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="5656" sourceBaselineY="6072" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4171"><mxGeometry x="26" y="267" width="960" height="30" as="geometry"/></mxCell><mxCell id="v15_3988" parent="v15_3978" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;这次有效需求当前无法完成。AIVA 本地对话需求约定提示&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4173" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;5656&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="5656" sourceBaselineY="6106" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4171"><mxGeometry x="26" y="301" width="840" height="30" as="geometry"/></mxCell><mxCell id="v15_3989" parent="v15_3978" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;“网络异常，请稍后再试”，同一个唤醒周期最多播一次，&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4174" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;5656&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="5656" sourceBaselineY="6140" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4171"><mxGeometry x="26" y="335" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_3990" parent="v15_3978" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;避免用户连续尝试时反复被打扰。不能用静默拒识冒充处理&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4175" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;5656&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="5656" sourceBaselineY="6174" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4171"><mxGeometry x="26" y="369" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_3991" parent="v15_3978" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;，也不能让本地生成一个没有执行依据的答案。恢复网络是&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4176" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;5656&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="5656" sourceBaselineY="6208" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4171"><mxGeometry x="26" y="403" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_3992" parent="v15_3978" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;否重试、是否重同步上下文要按产品规则确认，而不是后台&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4177" sourceTag="tspan" sourceAttri