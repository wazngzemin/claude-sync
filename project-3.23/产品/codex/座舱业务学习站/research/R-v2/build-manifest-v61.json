  "removedComments": [],
  "headings": [
    {
      "id": "r61-heading-01",
      "level": 2,
      "title": "开篇、同一句话，先决定接不接，再决定由谁办"
    },
    {
      "id": "r61-heading-02",
      "level": 3,
      "title": "用户只说了一次，系统要把几次判断接成一次办理"
    },
    {
      "id": "r61-heading-03",
      "level": 3,
      "title": "先找最早的偏差，再看车辆有没有真正办成"
    },
    {
      "id": "r61-heading-04",
      "level": 2,
      "title": "一、一句话要过几道门"
    },
    {
      "id": "r61-heading-05",
      "level": 3,
      "title": "提前上云与提前停播，分别为后面争取时间"
    },
    {
      "id": "r61-heading-06",
      "level": 3,
      "title": "接话判断交互对象，能力判断车上能不能办"
    },
    {
      "id": "r61-heading-07",
      "level": 3,
      "title": "采用、显示和执行接在后面，各自保留自己的结果"
    },
    {
      "id": "r61-heading-08",
      "level": 2,
      "title": "二、对话状态决定这句话走哪条路"
    },
    {
      "id": "r61-heading-09",
      "level": 3,
      "title": "对话状态机先管现在在做什么，再决定怎样接新话"
    },
    {
      "id": "r61-heading-10",
      "level": 3,
      "title": "播完以后留 30 秒，让下一句自然接上"
    },
    {
      "id": "r61-heading-11",
      "level": 3,
      "title": "开关和授权先决定入口是否开放，唤醒方式再决定从哪一态进入"
    },
    {
      "id": "r61-heading-12",
      "level": 3,
      "title": "四音区要保留说话位置，后仰修正要跟着同一个人走"
    },
    {
      "id": "r61-heading-13",
      "level": 3,
      "title": "禁用先挡住语音入口，同时让用户知道怎样恢复"
    },
    {
      "id": "r61-heading-14",
      "level": 2,
      "title": "三、该不该接：拒识规则的全貌"
    },
    {
      "id": "r61-heading-15",
      "level": 3,
      "title": "三种拒识在不同时间判断，结论也有不同效力"
    },
    {
      "id": "r61-heading-16",
      "level": 3,
      "title": "先看硬规则，命中后就直接给接话资格"
    },
    {
      "id": "r61-heading-17",
      "level": 3,
      "title": "车上只拒明确的话，已经上云的交给云端作最终决定"
    },
    {
      "id": "r61-heading-18",
      "level": 3,
      "title": "用前后文接住省略话，漏接后还要找回原来的对象"
    },
    {
      "id": "r61-heading-19",
      "level": 2,
      "title": "四、由谁来办：端云采信规则"
    },
    {
      "id": "r61-heading-20",
      "level": 3,
      "title": "两边都处理，最后由车上的端云仲裁选一份结果"
    },
    {
      "id": "r61-heading-21",
      "level": 3,
      "title": "只有不依赖前后文的固定说法，才适合放进抢跑规则"
    },
    {
      "id": "r61-heading-22",
      "level": 3,
      "title": "从允许模型抢跑改为只兜底，是为了减少误执行"
    },
    {
      "id": "r61-heading-23",
      "level": 2,
      "title": "五、断网、弱网和超时"
    },
    {
      "id": "r61-heading-24",
      "level": 3,
      "title": "网络图标、链路心跳、这次请求有没有结果，要分别判断"
    },
    {
      "id": "r61-heading-25",
      "level": 3,
      "title": "断网保住基础操作，弱网重试要先看这件事还值不值得办"
    },
    {
      "id": "r61-heading-26",
      "level": 3,
      "title": "网络恢复要补的是历史，用户刚才办过的动作不重做"
    },
    {
      "id": "r61-heading-27",
      "level": 2,
      "title": "六、只办一次"
    },
    {
      "id": "r61-heading-28",
      "level": 3,
      "title": "先认出同一轮，再挡住已经办过的迟到结果"
    },
    {
      "id": "r61-heading-29",
      "level": 3,
      "title": "新话通过接话判断后，以 Planner 首字为界合并或打断"
    },
    {
      "id": "r61-heading-30",
      "level": 3,
      "title": "三道防线仍有边界，重试和取消要一直管到执行出口"
    },
    {
      "id": "r61-heading-31",
      "level": 2,
      "title": "七、屏幕显示要和真正生效的那一边一致"
    },
    {
      "id": "r61-heading-32",
      "level": 3,
      "title": "过程文字让用户看到在听，最终文字解释实际办了什么"
    },
    {
      "id": "r61-heading-33",
      "level": 3,
      "title": "同侧共用一个胶囊，多屏还要保留各自的任务"
    },
    {
      "id": "r61-heading-34",
      "level": 3,
      "title": "等待、出结果和播报，要表达同一件事的真实进度"
    },
    {
      "id": "r61-heading-35",
      "level": 2,
      "title": "八、回写：把实际发生的事记下来"
    },
    {
      "id": "r61-heading-36",
      "level": 3,
      "title": "本地办完，要把用户原话、回答和实际结果一起交给云端"
    },
    {
      "id": "r61-heading-37",
      "level": 3,
      "title": "乘客聊天保留为背景，手动操作要补上真实变化"
    },
    {
      "id": "r61-heading-38",
      "level": 3,
      "title": "网络恢复后补的是历史，还要能查出最终采用了谁"
    },
    {
      "id": "r61-heading-39",
      "level": 2,
      "title": "九、不同车型的设计选项"
    },
    {
      "id": "r61-heading-40",
      "level": 3,
      "title": "先按硬件和使用场景选路径，再看属于哪个车型"
    },
    {
      "id": "r61-heading-41",
      "level": 3,
      "title": "连续对话、禁用场景和声音位置，要按整段体验选择"
    },
    {
      "id": "r61-heading-42",
      "level": 3,
      "title": "换车型时，要把谁负责识别、显示和执行一起交接"
    },
    {
      "id": "r61-heading-43",
      "level": 2,
      "title": "十、怎么评估、怎么排查"
    },
    {
      "id": "r61-heading-44",
      "level": 3,
      "title": "先说分母，再说准确率，才能知道改好的是哪一步"
    },
    {
      "id": "r61-heading-45",
      "level": 3,
      "title": "沿六次交接找第一个偏差，再决定改哪个环节"
    },
    {
      "id": "r61-heading-46",
      "level": 3,
      "title": "同样是没回应，用三个问题练习把修复交给正确的人"
    },
    {
      "id": "r61-heading-47",
      "level": 2,
      "title": "收尾、把一句话从接住讲到办完"
    },
    {
      "id": "r61-heading-48",
      "level": 3,
      "title": "三分钟口述稿：我怎样让两边处理，最后只办一次"
    },
    {
      "id": "r61-heading-49",
      "level": 3,
      "title": "最容易讲错的地方：把每一步交出的结果分开"
    },
    {
      "id": "r61-heading-50",
      "level": 3,
      "title": "复述路线图：每走一步，问一句谁把什么交给了谁"
    },
    {
      "id": "r61-heading-51",
      "level": 2,
      "title": "附一、术语表"
    },
    {
      "id": "r61-heading-52",
      "level": 3,
      "title": "查词时，把它的位置和交出的结果一起找出来"
    },
    {
      "id": "r61-heading-53",
      "level": 2,
      "title": "附二　历史版本与关键数字"
    },
    {
      "id": "r61-heading-54",
      "level": 3,
      "title": "历史数字要连着版本、任务和硬件一起读"
    }
  ],
