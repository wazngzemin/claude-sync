;line-height:1;white-space:pre;&quot;&gt;成功Goal卡直达；失败回Planner&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="6838" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;12696&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="12696" sourceBaselineY="16176" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="6835"><mxGeometry x="26" y="171" width="600" height="30" as="geometry"/></mxCell><mxCell id="v15_6061" parent="v15_6054" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;创建卡≠触发≠实际执行&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="6839" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;12696&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="12696" sourceBaselineY="16210" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="6835"><mxGeometry x="26" y="205" width="330" height="30" as="geometry"/></mxCell><mxCell id="v15_6062" parent="v15_6054" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="6840" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;12696