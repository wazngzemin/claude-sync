r></defs><g class=\"business-edge\"><title>DR-poi-10 保留失败所在步骤 → 结果交回 Director；失败原因</title><polyline points=\"381,2890 86,2890 86,2474 372,2474\" fill=\"none\" stroke=\"#fff\" stroke-width=\"7\"/><polyline points=\"381,2890 86,2890 86,2474 372,2474\" fill=\"none\" stroke=\"#446cb1\" stroke-width=\"2.2\" marker-end=\"url(#m-DR-poi-flow-10)\"/></g><rect x=\"727\" y=\"351\" width=\"132.88\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"732\" y=\"368\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">本轮 + 前序任务</text><rect x=\"727\" y=\"635\" width=\"122\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"732\" y=\"652\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">改写后专项诉求</text><rect x=\"727\" y=\"919\" width=\"58\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"732\" y=\"936\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">先导航</text><rect x=\"727\" y=\"1203\" width=\"106\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"732\" y=\"1220\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">读取添加结果</text><rect x=\"727\" y=\"1487\" width=\"122\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"732\" y=\"1504\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">成功后才设临停</text><rect x=\"157\" y=\"1312\" width=\"130.96\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"162\" y=\"1329\" font-size=\"16\" fill=\"#28716f\" font-weight=\"500\">失败/无成功证据</text><rect x=\"727\" y=\"1771\" width=\"106\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"732\" y=\"1788\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">属性设置成功</text><rect x=\"157\" y=\"1596\" width=\"170\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"162\" y=\"1613\" font-size=\"16\" fill=\"#a16b20\" font-weight=\"500\">属性失败不能说已设好</text><rect x=\"727\" y=\"2055\" width=\"154\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"732\" y=\"2072\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">同步路线和停靠意图</text><rect x=\"727\" y=\"2339\" width=\"106\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"732\" y=\"2356\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">真实执行状态</text><rect x=\"157\" y=\"2864\" width=\"74\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"162\" y=\"2881\" font-size=\"16\" fill=\"#446cb1\" font-weight=\"500\">失败原因</text><g data-page=\"DR\" data-flow=\"DR-poi-flow\" data-step=\"DR-poi-1\" role=\"link\" tabindex=\"0\" aria-label=\"用户说明路线与停靠\"><rect x=\"384\" y=\"134\" width=\"660\" height=\"184\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"408\" y=\"171\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">用户说明路线与停靠</text><text x=\"408\" y=\"218\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">用户说“先到幼儿园接人，再回家”。</text><text x=\"408\" y=\"245\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"408\" y=\"272\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">幼儿园是途经点，家是终点；接人要求归属幼儿园。</text></g><g data-page=\"DR\" data-flow=\"DR-poi-flow\" data-step=\"DR-poi-2\" role=\"link\" tabindex=\"0\" aria-label=\"Director 保留完整路线\"><rect x=\"384\" y=\"418\" width=\"660\" height=\"184\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"408\" y=\"455\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">Director 保留完整路线</text><text x=\"408\" y=\"502\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">保留现有路线、未经过的点以及已有停靠要求。</text><text x=\"408\" y=\"529\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"408\" y=\"556\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">将新增或修改条件交专项层，不能只传后半句“再去一下”。</text></g><g data-page=\"DR\" data-flow=\"DR-poi-flow\" data-step=\"DR-poi-3\" role=\"link\" tabindex=\"0\" aria-label=\"拆出两个连续任务\"><rect x=\"384\" y=\"702\" width=\"660\" height=\"184\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"408\" y=\"739\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">拆出两个连续任务</text><text x=\"408\" y=\"786\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">先完成算路或添加途经点，