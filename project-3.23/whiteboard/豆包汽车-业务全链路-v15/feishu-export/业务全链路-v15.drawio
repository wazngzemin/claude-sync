315" parent="v15_7306" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;一个场景完成配置后，应按同一测试case验证结构合法、注&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="8455" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;316&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="316" sourceBaselineY="32532" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="8454"><mxGeometry x="26" y="267" width="840" height="30" as="geometry"/></mxCell><mxCell id="v15_7316" parent="v15_7306" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;册成功、目标范围准确、真实信号唤醒、判断正确、下游接&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="8456" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;316&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="316" sourceBaselineY="32566" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="8454"><mxGeometry x="26" y="301" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_7317" parent="v15_7306" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;受、终端曝光或车辆结果。Mock可以验证消息通道，但不能&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="8457" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;316&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="316" sourceBaselineY="32600" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="8454"><mxGeometry x="26" y="335" width="840" height="30" as="geometry"/></mxCell><mxCell id="v15_7318" parent="v15_7306" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;验视觉识别与真实条件。停用或复制新版本后还要测试旧规&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="8458" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;316&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="316" sourceBaselineY="32634" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="8454"><mxGeometry x="26" y="369" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_7319" parent="v15_7306" value="&lt;span style=&quot;font-famil