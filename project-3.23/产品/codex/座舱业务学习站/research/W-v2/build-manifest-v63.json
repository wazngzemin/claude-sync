  "headings": [
    {
      "id": "w63-heading-01",
      "level": 2,
      "title": "开篇、屏幕上看得到，就该说得到"
    },
    {
      "id": "w63-heading-02",
      "level": 3,
      "title": "用户说的是屏幕上的东西，系统还得找对这次操作"
    },
    {
      "id": "w63-heading-03",
      "level": 3,
      "title": "先看对象从哪里来，再沿交接找偏差"
    },
    {
      "id": "w63-heading-04",
      "level": 2,
      "title": "一、说屏幕上的东西，有三条路"
    },
    {
      "id": "w63-heading-05",
      "level": 3,
      "title": "话能直接对上当前按钮，就在车上拦下来办"
    },
    {
      "id": "w63-heading-06",
      "level": 3,
      "title": "用户换了说法，云端要先拿到当前选项再选按钮"
    },
    {
      "id": "w63-heading-07",
      "level": 3,
      "title": "“第二个”也可能直接接上轮列表，先认路径再查错"
    },
    {
      "id": "w63-heading-08",
      "level": 2,
      "title": "二、页面先登记“我有哪些按钮”"
    },
    {
      "id": "w63-heading-09",
      "level": 3,
      "title": "页面交给语音的，是可说的词和对应目标"
    },
    {
      "id": "w63-heading-10",
      "level": 3,
      "title": "主动注册靠业务说清楚，自动扫描靠页面能被读出来"
    },
    {
      "id": "w63-heading-11",
      "level": 3,
      "title": "更新页面词，要同时照顾当前页面和正在识别的这一句"
    },
    {
      "id": "w63-heading-12",
      "level": 2,
      "title": "三、识别出的文字怎样对上按钮"
    },
    {
      "id": "w63-heading-13",
      "level": 3,
      "title": "页面匹配等最终文字，避免把半句话变成点击"
    },
    {
      "id": "w63-heading-14",
      "level": 3,
      "title": "归一化和前后缀只放宽写法，白名单仍然决定边界"
    },
    {
      "id": "w63-heading-15",
      "level": 3,
      "title": "命中要拦住这句，多命中要先把目标分清"
    },
    {
      "id": "w63-heading-16",
      "level": 2,
      "title": "四、对上以后，谁来点"
    },
    {
      "id": "w63-heading-17",
      "level": 3,
      "title": "找到按钮以后，还要交给真正能操作它的一方"
    },
    {
      "id": "w63-heading-18",
      "level": 3,
      "title": "匹配成功、选中按钮、执行成功，要分别检查"
    },
    {
      "id": "w63-heading-19",
      "level": 3,
      "title": "本地已经接手，云端迟到的结果要收住"
    },
    {
      "id": "w63-heading-20",
      "level": 2,
      "title": "五、没对上，交给云端理解"
    },
    {
      "id": "w63-heading-21",
      "level": 3,
      "title": "当前有可操作对象，才把对应工具交给 Planner"
    },
    {
      "id": "w63-heading-22",
      "level": 3,
      "title": "云端选出按钮名称，车机接手真正的点击"
    },
    {
      "id": "w63-heading-23",
      "level": 3,
      "title": "“第二个”走哪条路，取决于对象怎样交过来"
    },
    {
      "id": "w63-heading-24",
      "level": 2,
      "title": "六、卡片上的按钮"
    },
    {
      "id": "w63-heading-25",
      "level": 3,
      "title": "先看卡片承载什么，再决定按钮怎么接"
    },
    {
      "id": "w63-heading-26",
      "level": 3,
      "title": "用嘴选择要先接住这句话，手点直接交给业务"
    },
    {
      "id": "w63-heading-27",
      "level": 3,
      "title": "追问还在谈同一件事，就保住原来的选择入口"
    },
    {
      "id": "w63-heading-28",
      "level": 3,
      "title": "两块屏各自展示，选择仍要落到具体卡片"
    },
    {
      "id": "w63-heading-29",
      "level": 3,
      "title": "展示数据、推荐卡、任务状态和执行指令，各交各的结果"
    },
    {
      "id": "w63-heading-30",
      "level": 2,
      "title": "七、点完以后，下一轮还要接得上"
    },
    {
      "id": "w63-heading-31",
      "level": 3,
      "title": "车上直接点了按钮，也要留下这次办理经过"
    },
    {
      "id": "w63-heading-32",
      "level": 3,
      "title": "上报成功以后，还要看下一轮实际读到了什么"
    },
    {
      "id": "w63-heading-33",
      "level": 3,
      "title": "端状态说明现在怎样，事件说明刚才做了什么"
    },
    {
      "id": "w63-heading-34",
      "level": 2,
      "title": "八、不同车型的分工"
    },
    {
      "id": "w63-heading-35",
      "level": 3,
      "title": "先定页面和执行归谁，再选接入方式"
    },
    {
      "id": "w63-heading-36",
      "level": 3,
      "title": "换车型以后，要重新走完一次交接"
    },
    {
      "id": "w63-heading-37",
      "level": 2,
      "title": "九、怎么评估、怎么排查"
    },
    {
      "id": "w63-heading-38",
      "level": 3,
      "title": "听写正确、点对对象和办成事情，要分别计算"
    },
    {
      "id": "w63-heading-39",
      "level": 3,
      "title": "沿七次交接往前找，先找到第一处偏差"
    },
    {
      "id": "w63-heading-40",
      "level": 3,
      "title": "按钮没动和点错对象，要走不同的排查分支"
    },
    {
      "id": "w63-heading-41",
      "level": 2,
      "title": "收尾、从一句话进来，到只办一次、回写完成"
    },
    {
      "id": "w63-heading-42",
      "level": 3,
      "title": "三分钟，把三条操作路线讲成一段完整交接"
    },
    {
      "id": "w63-heading-43",
      "level": 3,
      "title": "最容易讲错的地方"
    },
    {
      "id": "w63-heading-44",
      "level": 3,
      "title": "复述路线图：先认路，再看执行，最后接下一句"
    },
    {
      "id": "w63-heading-45",
      "level": 2,
      "title": "附一　术语表"
    },
    {
      "id": "w63-heading-46",
      "level": 3,
      "title": "查术语时，把名字放回它负责的那次交接"
    },
    {
      "id": "w63-heading-47",
      "level": 2,
      "title": "附二　历史版本与关键数字"
    },
    {
      "id": "w63-heading-48",
      "level": 3,
      "title": "日期说明哪一步完成，数字说明哪一个对象"
    },
    {
      "id": "w63-heading-49",
      "level": 3,
      "title": "四条通道的编号，只用来辨认交接类型"
    }
