136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="22416" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7153"><mxGeometry x="26" y="301" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_6309" parent="v15_6298" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;不能当成确定未发生。模型还不负责替业务决定“满足条件&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7157" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="22450" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7153"><mxGeometry x="26" y="335" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_6310" parent="v15_6298" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;多久才触发”“播完是否重置”。验收时应加入看不清与看&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7158" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&qu