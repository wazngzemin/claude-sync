 width="900" height="30" as="geometry"/></mxCell><mxCell id="v15_6270" parent="v15_6253" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7105" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;12696&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="12696" sourceBaselineY="20584" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7097"><mxGeometry x="26" y="539" width="30" height="30" as="geometry"/></mxCell><mxCell id="v15_6271" parent="v15_6253" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:18px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;交出 → E6 / U01&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=18;fontColor=#2463C5;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7107" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;12696&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="12696" sourceBaselineY="20776" sourceFontSize="18" sourceFontWeight="400" sourceTextIndex="7106"><mxGeometry x="26" y="738" width="280.8" height="21.6" as="geometry"/></mxCell><mxCell id=