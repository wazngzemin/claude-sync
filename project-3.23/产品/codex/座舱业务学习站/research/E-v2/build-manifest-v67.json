  "headings": [
    {
      "id": "e67-heading-01",
      "level": 2,
      "title": "开篇、Planner 交出四个动作以后"
    },
    {
      "id": "e67-heading-02",
      "level": 3,
      "title": "四个动作交给不同的人办，还要带着各自的结果回来"
    },
    {
      "id": "e67-heading-03",
      "level": 3,
      "title": "收到一句成功，还要问它成功的是哪件事"
    },
    {
      "id": "e67-heading-04",
      "level": 2,
      "title": "一、动作交出去以后，谁接手"
    },
    {
      "id": "e67-heading-05",
      "level": 3,
      "title": "云端编排管这一批动作，单次调用层管其中一项"
    },
    {
      "id": "e67-heading-06",
      "level": 3,
      "title": "返回格式可以统一，业务结果仍要由各工具说具体"
    },
    {
      "id": "e67-heading-07",
      "level": 3,
      "title": "查有没有执行，要看工具记录，单听回答会漏掉第一道分叉"
    },
    {
      "id": "e67-heading-08",
      "level": 2,
      "title": "二、同一个工具名，怎样找到这辆车的实现"
    },
    {
      "id": "e67-heading-09",
      "level": 3,
      "title": "工具定义讲能干什么，项目实现决定这次交给谁"
    },
    {
      "id": "e67-heading-10",
      "level": 3,
      "title": "每个环境只用一个生效版本，改说明也要改到运行时读取的地方"
    },
    {
      "id": "e67-heading-11",
      "level": 3,
      "title": "执行器负责把调用送出去，连接正常还不代表业务能办完"
    },
    {
      "id": "e67-heading-12",
      "level": 3,
      "title": "先认提供方，再数当前能用的工具"
    },
    {
      "id": "e67-heading-13",
      "level": 2,
      "title": "三、按工具家族，看清谁在干活、各回什么"
    },
    {
      "id": "e67-heading-14",
      "level": 3,
      "title": "车控、系统设置和通讯分别办事，查状态另走查询"
    },
    {
      "id": "e67-heading-15",
      "level": 3,
      "title": "地点、路线和地图控制，返回的是三个不同阶段"
    },
    {
      "id": "e67-heading-16",
      "level": 3,
      "title": "媒体要交回实际内容，节目安排和播放控制也要分开"
    },
    {
      "id": "e67-heading-17",
      "level": 3,
      "title": "记忆和人脸先对上人，查空、缺信息和没权限分别返回"
    },
    {
      "id": "e67-heading-18",
      "level": 3,
      "title": "查询工具按问题取结果，看画面还要先拿到对应的图"
    },
    {
      "id": "e67-heading-19",
      "level": 3,
      "title": "生活服务返回的是办理阶段，付款和商家确认还在后面"
    },
    {
      "id": "e67-heading-20",
      "level": 3,
      "title": "生成类先受理再交成果，要查成果是否真的可用"
    },
    {
      "id": "e67-heading-21",
      "level": 3,
      "title": "任务和反馈都有后续步骤，收到请求以后还要交回办理进展"
    },
    {
      "id": "e67-heading-22",
      "level": 2,
      "title": "四、车控：一句话怎样变成车能执行的函数，以及不经过 Planner 的快路"
    },
    {
      "id": "e67-heading-23",
      "level": 3,
      "title": "Planner 说要做什么，车控模型再翻成这款车的函数"
    },
    {
      "id": "e67-heading-24",
      "level": 3,
      "title": "自定义名称要取自这辆车，参数上报和动作执行分开看"
    },
    {
      "id": "e67-heading-25",
      "level": 3,
      "title": "地图操作也要翻函数，追问后的短句更要保住对象"
    },
    {
      "id": "e67-heading-26",
      "level": 3,
      "title": "云端车控干预用规则直出函数，先过拒识再走快路"
    },
    {
      "id": "e67-heading-27",
      "level": 2,
      "title": "五、下发到车，车上回话"
    },
    {
      "id": "e67-heading-28",
      "level": 3,
      "title": "函数要带着车辆、座位和本次请求的身份一起下发"
    },
    {
      "id": "e67-heading-29",
      "level": 3,
      "title": "已推送、车收到、回执成功、目标达成，要一层层往下看"
    },
    {
      "id": "e67-heading-30",
      "level": 3,
      "title": "已下发 10 秒没回执，就把排查交给车端"
    },
    {
      "id": "e67-heading-31",
      "level": 2,
      "title": "六、回执怎样变成 Planner 读到的那句话"
    },
    {
      "id": "e67-heading-32",
      "level": 3,
      "title": "Planner 读到的成功提示，可能是云端补出来的"
    },
    {
      "id": "e67-heading-33",
      "level": 3,
      "title": "结果写出实际对象，才能看见办错地方的成功"
    },
    {
      "id": "e67-heading-34",
      "level": 3,
      "title": "失败要解释业务前提，近似办理要交代改变了什么"
    },
    {
      "id": "e67-heading-35",
      "level": 3,
      "title": "结构化结果要带实际值，长结果先完整交回来"
    },
    {
      "id": "e67-heading-36",
      "level": 2,
      "title": "七、一批结果怎样收齐，超时和重复怎么办"
    },
    {
      "id": "e67-heading-37",
      "level": 3,
      "title": "收齐的是这一轮的结果，成功和失败都要留下"
    },
    {
      "id": "e67-heading-38",
      "level": 3,
      "title": "一项超时，只补这一项的失败结果"
    },
    {
      "id": "e67-heading-39",
      "level": 3,
      "title": "不自动重试，打断以后也要收回原来的结果"
    },
    {
      "id": "e67-heading-40",
      "level": 2,
      "title": "八、谁来说结果：车控播报和不支持的指令"
    },
    {
      "id": "e67-heading-41",
      "level": 3,
      "title": "简单成功交给车上模板，复杂或失败交给云端"
    },
    {
      "id": "e67-heading-42",
      "level": 3,
      "title": "没有这个功能，和有功能但要手动，是两种结果"
    },
    {
      "id": "e67-heading-43",
      "level": 3,
      "title": "车书负责怎么用，控制失败仍要交代这次结果"
    },
    {
      "id": "e67-heading-44",
      "level": 2,
      "title": "九、执行这一侧的假成功"
    },
    {
      "id": "e67-heading-45",
      "level": 3,
      "title": "从已推送到目标达成，中间还隔着三次交接"
    },
    {
      "id": "e67-heading-46",
      "level": 3,
      "title": "回执缺了实际结果，Planner 就失去核对的依据"
    },
    {
      "id": "e67-heading-47",
      "level": 3,
      "title": "回执先写实际结果，再让 Planner 对照目标"
    },
    {
      "id": "e67-heading-48",
      "level": 2,
      "title": "十、问题反馈工具：一个要走好几步的应用工具"
    },
    {
      "id": "e67-heading-49",
      "level": 3,
      "title": "反馈先留住现场，追问交给专门的工具"
    },
    {
      "id": "e67-heading-50",
      "level": 3,
      "title": "总结让用户核对，提交结果按阶段判断"
    },
    {
      "id": "e67-heading-51",
      "level": 3,
      "title": "服务端认领同一件反馈，重复确认也只办一次"
    },
    {
      "id": "e67-heading-52",
      "level": 3,
      "title": "错误决定怎样继续，点踩走另一条路"
    },
    {
      "id": "e67-heading-53",
      "level": 2,
      "title": "十一、怎么排查"
    },
    {
      "id": "e67-heading-54",
      "level": 3,
      "title": "先把同一次办理串起来，再判断谁出错"
    },
    {
      "id": "e67-heading-55",
      "level": 3,
      "title": "车控按七关往下查，找到最早偏离的交接"
    },
    {
      "id": "e67-heading-56",
      "level": 3,
      "title": "查到正确调用，还要对上这辆车和这个环境"
    },
    {
      "id": "e67-heading-57",
      "level": 3,
      "title": "成功率分层看，核心场景回到实车验"
    },
    {
      "id": "e67-heading-58",
      "level": 2,
      "title": "收尾、沿着四个动作，把执行这一侧讲给别人听"
    },
    {
      "id": "e67-heading-59",
      "level": 3,
      "title": "三分钟口述稿：从交出动作，一直讲到用户真正得到结果"
    },
    {
      "id": "e67-heading-60",
      "level": 3,
      "title": "最容易讲错的地方"
    },
    {
      "id": "e67-heading-61",
      "level": 3,
      "title": "复述路线图：每到一个交接，就问结果能证明到哪里"
    },
    {
      "id": "e67-heading-62",
      "level": 2,
      "title": "附一　术语表"
    },
    {
      "id": "e67-heading-63",
      "level": 3,
      "title": "先认出它是模型、调度规则，还是实际执行的一方"
    },
    {
      "id": "e67-heading-64",
      "level": 2,
      "title": "附二　历史版本与关键数字"
    },
    {
      "id": "e67-heading-65",
      "level": 3,
      "title": "工具家族和项目编号，分别回答能力归谁、这次为谁办理"
    },
    {
      "id": "e67-heading-66",
      "level": 3,
      "title": "几种时间各管一段，缓存时间也要另算"
    },
    {
      "id": "e67-heading-67",
      "level": 3,
      "title": "设备返回码与车控字段，要对着所在层读"
    },
    {
      "id": "e67-heading-68",
      "level": 3,
      "title": "问题反馈的状态和错误码，只解释这件反馈办到哪一步"
    },
    {
      "id": "e67-heading-69",
      "level": 3,
      "title": "模型数字先看测了什么，再看能说明哪一层"
    },
    {
      "id": "e67-heading-70",
      "level": 3,
      "title": "工具会拆分和扩充，版本变化要跟着执行范围看"
    }
  ],
