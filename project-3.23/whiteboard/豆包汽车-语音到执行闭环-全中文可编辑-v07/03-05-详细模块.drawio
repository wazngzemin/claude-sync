l=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2096.8" y="2557.0" width="1715.0" height="1281.0" as="geometry"/></mxCell><mxCell id="m2_cluster_437" value="预生产/建设中任务服务【不可写成正式生产已上线】" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2841.8" y="2578.0" width="584.0" height="1239.0" as="geometry"/></mxCell><mxCell id="m2_cluster_470" value="当前协议快照【当前】" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2138.8" y="2655.0" width="559.0" height="1085.0" as="geometry"/></mxCell><mxCell id="m2_node_0" value="创建成功？&lt;br&gt;任务落库、规则注册、绑定保存必须同向成功；失败要回滚或补偿" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="4602.3" y="4946.9" width="260.0" height="120.0" as="geometry"/></mxCell><mxCell id="m2_node_1" value="取消干净？&lt;br&gt;关闭任务 + 停规则 + 停视觉 + 取消运行 + 清通知；不能只从列表隐藏" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="4602.3" y="5088.9" width="260.0" height="120.0" as="geometry"/></mxCell><mxCell id="m2_node_2" value="结果可信？&lt;br&gt;工具成功不是完成；必须有执行结果、真实状态和用户目标满足证据" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="4602.3" y="5230.9" width="260.0" height="120.0" as="geometry"/></mxCell><mxCell id="m2_node_3" value="重启可恢复？&lt;br&gt;车辆上下电、断网、服务重启后，靠事实仓库和版本恢复，不靠旧对话猜" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="4602.3" y="5372.9" width="260.0" height="120.0" as="geometry"/></mxCell><mxCell id="m2_node_4" value="动态视觉目标&lt;br&gt;例：观察孩子是否醒来" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2128.0" y="4856.4" width="210.0" height="75.0" as="geometry"/></mxCell><mxCell id="m2_node_5" value="全量观察清单 + 版本&lt;br&gt;覆盖旧清单；结束时重算或下发空清单" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2447.0" y="4845.1" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_6" value="端侧保存任务集并周期取帧" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2816.0" y="4867.6" width="240.0" height="52.5" as="geometry"/></mxCell><mxCell id="m2_node_7" value="客观观察报告&lt;br&gt;任务编号 + 描述 + 置信度 + 时间" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3165.0" y="4845.1" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_8" value="按任务编号恢复原条件和范围" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3534.0" y="4867.6" width="255.0" height="52.5" as="geometry"/></mxCell><mxCell id="m2_node_9" value="触发器语义匹配&lt;br&gt;是 / 否 / 未知" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3898.0" y="4856.4" width="165.0" height="75.0" as="geometry"/></mxCell><mxCell id="m2_node_10" value="是：回调任务服务/目标链&lt;br&gt;否或未知：继续等待" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4172.0" y="4856.4" width="232.9" height="75.0" as="geometry"/></mxCell><mxCell id="m2_node_11" value="默认主题集合" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2692.9" y="5029.1" width="150.0" height="52.5" as="geometry"/></mxCell><mxCell id="m2_node_12" value="端侧周期采样&lt;br&gt;资料示例约10–20秒；非固定服务承诺" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2951.9" y="5006.6" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_13" value="通用场景摘要" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3320.9" y="5029.1" width="150.0" height="52.5" as="geometry"/></mxCell><mxCell id="m2_node_14" value="按来源/时间/有效期进入上下文" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3579.9" y="5017.9" width="260.0" height="75.0" as="geometry"/></mxCell><mxCell id="m2_node_15" value="决策规划器调用视觉问答工具" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2629.4" y="5179.4" width="255.0" height="52.5" as="geometry"/></mxCell><mxCell id="m2_node_16" value="摄像头取帧 / 权限校验" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2993.4" y="5179.4" width="211.9" height="52.5" as="geometry"/></mxCell><mxCell id="m2_node_17" value="视觉模型输出结构化描述&lt;br&gt;内容、置信度、时间、来源" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3314.3" y="5168.1" width="240.0" height="75.0" as="geometry"/></mxCell><mxCell id="m2_node_18" value="工具执行反馈回决策规划器" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3663.3" y="5179.4" width="240.0" height="52.5" as="geometry"/></mxCell><mxCell id="m2_node_19" value="关键禁止路径&lt;br&gt;动态观察报告不得直接进入上下文&lt;br&gt;不得直接触发工具&lt;br&gt;不得把“睁眼”直接说成“已经醒来”" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="3136.4" y="5286.1" width="260.0" height="165.0" as="geometry"/></mxCell><mxCell id="m2_node_20" value="两个周期独立&lt;br&gt;视觉多久采样一次：模型成本与实时性&lt;br&gt;多久通知用户一次：任务策略与打扰控制" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3136.4" y="5473.1" width="260.0" height="142.5" as="geometry"/></mxCell><mxCell id="m2_node_21" value="用户提出条件/定时/持续诉求" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3408.0" y="4508.4" width="255.7" height="52.5" as="geometry"/></mxCell><mxCell id="m2_node_22" value="决策规划器识别需持久化" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3747.7" y="4508.4" width="225.0" height="52.5" as="geometry"/></mxCell><mxCell id="m2_node_23" value="目标队列更新工具&lt;br&gt;创建 / 更新 / 删除" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4056.7" y="4497.1" width="183.8" height="75.0" as="geometry"/></mxCell><mxCell id="m2_node_24" value="目标队列&lt;br&gt;目标编号、条件、范围、状态、进度" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4324.5" y="4485.9" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_25" value="规则/订阅" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4668.5" y="4437.4" width="127.9" height="52.5" as="geometry"/></mxCell><mxCell id="m2_node_26" value="触发等待" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4880.4" y="4437.4" width="120.0" height="52.5" as="geometry"/></mxCell><mxCell id="m2_node_27" value="命中回调" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5084.4" y="4437.4" width="120.0" height="52.5" as="geometry"/></mxCell><mxCell id="m2_node_28" value="执行反馈 + 真实状态" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5971.4" y="4508.4" width="196.9" height="52.5" as="geometry"/></mxCell><mxCell id="m2_node_29" value="推进目标&lt;br&gt;已设置=等待；命中=激活；执行验真后才完成" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6252.3" y="4485.9" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_30" value="关闭并清理&lt;br&gt;停用触发规则、视觉订阅、运行和残留通知" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6596.3" y="4485.9" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_31" value="静态顾问&lt;br&gt;舒适 / 出行 / 内容 / 情感&lt;br&gt;按场景给建议，不是最终执行权" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5288.4" y="4444.1" width="260.0" height="120.0" as="geometry"/></mxCell><mxCell id="m2_node_32" value="最终裁决仍由决策规划器&lt;br&gt;除非明确批准的端侧本地策略" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5632.4" y="4537.6" width="255.0" height="75.0" as="geometry"/></mxCell><mxCell id="m2_node_33" value="动态顾问&lt;br&gt;长期目标监控、复盘和建议&lt;br&gt;目标态并入任务管理，不再单列生命周期" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5288.4" y="4586.1" width="260.0" height="120.0" as="geometry"/></mxCell><mxCell id="m2_node_34" value="信号来源&lt;br&gt;时间、车态、导航、驾驶状态、视觉报告、车辆生命周期" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="79.5" y="4506.8" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_35" value="信号治理&lt;br&gt;统一标识、值/单位、时间戳、来源、置信度、有效期" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="423.5" y="4506.8" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_36" value="规则注册&lt;br&gt;任务编号、条件表达式、生效范围、起止时间、版本" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="767.5" y="4506.8" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_37" value="监听与求值&lt;br&gt;数值比较、状态变化、时间窗、组合与语义匹配" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1111.5" y="4506.8" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_38" value="防抖与迟滞&lt;br&gt;连续命中门槛、退出门槛、边沿检测" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1455.5" y="4506.8" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_39" value="去重与频控&lt;br&gt;一次性、冷却期、最大次数、回调编号" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1799.5" y="4506.8" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_40" value="优先级与互斥&lt;br&gt;安全/用户指令优先；同资源冲突串行或丢弃" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2143.5" y="4506.8" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_41" value="命中结果" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2543.8" y="4443.0" width="112.5" height="112.5" as="geometry"/></mxCell><mxCell id="m2_node_42" value="是：生成一次回调&lt;br&gt;证据 + 规则版本 + 任务编号" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2736.9" y="4469.5" width="243.8" height="75.0" as="geometry"/></mxCell><mxCell id="m2_node_43" value="否/未知：继续等待&lt;br&gt;不得触发执行" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2764.8" y="4566.5" width="187.9" height="75.0" as="geometry"/></mxCell><mxCell id="m2_node_44" value="禁止路径&lt;br&gt;触发器→工具 ×&lt;br&gt;触发命中=任务完成 ×" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="3064.7" y="4458.2" width="200.3" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_45" value="触发回调&lt;br&gt;带任务编号、回调编号、规则版本、命中证据、时间" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2953.5" y="4089.2" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_46" value="回到任务入口层&lt;br&gt;恢复任务与当前版本" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3297.5" y="4100.5" width="195.0" height="75.0" as="geometry"/></mxCell><mxCell id="m2_node_47" value="回调是否重复&lt;br&gt;任务是否仍有效？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3674.0" y="3943.0" width="195.0" height="195.0" as="geometry"/></mxCell><mxCell id="m2_node_48" value="激活任务并创建本轮运行&lt;br&gt;相同回调不得重复建运行" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3991.3" y="4052.0" width="225.0" height="75.0" as="geometry"/></mxCell><mxCell id="m2_node_49" value="运行门禁（Run Guard）&lt;br&gt;重新读取最新车态/人物/权限/安全/网络&lt;br&gt;只复核执行前约束，不重判触发条件" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4300.3" y="4018.2" width="260.0" height="142.5" as="geometry"/></mxCell><mxCell id="m2_node_50" value="允许继续？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4708.0" y="3962.0" width="127.5" height="127.5" as="geometry"/></mxCell><mxCell id="m2_node_51" value="拒绝重复/过期回调&lt;br&gt;记录原因，不创建新运行" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3991.3" y="4165.9" width="225.0" height="75.0" as="geometry"/></mxCell><mxCell id="m2_node_52" value="运行调度器&lt;br&gt;通用链路→原决策规划器&lt;br&gt;固定生态链路→指定服务商" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4970.8" y="3981.0" width="240.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_53" value="原主链执行&lt;br&gt;决策→动作→工具/代理→执行器→真实回读" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5304.8" y="3981.0" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_54" value="独立结果钩子&lt;br&gt;接收工具结果或代理观察，不依赖最终话术" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5648.8" y="3981.0" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_55" value="处理运行结果&lt;br&gt;同事务更新动作/运行/任务/事件&lt;br&gt;失败补偿；必要时写发件箱" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5992.8" y="3969.8" width="260.0" height="120.0" as="geometry"/></mxCell><mxCell id="m2_node_56" value="结束策略" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6393.0" y="3917.2" width="112.5" height="112.5" as="geometry"/></mxCell><mxCell id="m2_node_57" value="一次任务：关闭&lt;br&gt;持续任务：回到等待&lt;br&gt;部分失败：保留待办分支&lt;br&gt;超过失败上限：关闭并说明原因" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6533.3" y="3958.5" width="260.0" height="142.5" as="geometry"/></mxCell><mxCell id="m2_node_58" value="本轮跳过或等待&lt;br&gt;保留可恢复证据，不伪装成失败或成功" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4960.8" y="4100.5" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_59" value="事件记录（Event）&lt;br&gt;收到用户创建/更新/取消、触发回调、执行结果&lt;br&gt;状态：已接收→已校验→已应用/已拒绝" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="142.5" y="4067.8" width="260.0" height="142.5" as="geometry"/></mxCell><mxCell id="m2_node_60" value="任务规格&lt;br&gt;用户目标、条件、范围、频率、结束策略、版本" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="486.5" y="4090.2" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_61" value="执行脚本（Script）&lt;br&gt;把长期目标展开为可恢复步骤&lt;br&gt;状态：草稿→已发布→已停用/已废弃" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="830.5" y="4079.0" width="260.0" height="120.0" as="geometry"/></mxCell><mxCell id="m2_node_62" value="任务&lt;br&gt;状态：等待→运行→已关闭&lt;br&gt;关闭原因：完成/取消/过期/失败/车辆离线" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1174.5" y="4079.0" width="260.0" height="120.0" as="geometry"/></mxCell><mxCell id="m2_node_63" value="本轮运行（Run）&lt;br&gt;状态：已创建→运行中→成功/失败/跳过/取消&lt;br&gt;阶段：执行中/等用户/等车端/等外部" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1518.5" y="4021.6" width="260.0" height="142.5" as="geometry"/></mxCell><mxCell id="m2_node_64" value="原子动作（Action）&lt;br&gt;状态：待下发→已接收→已调用→已生效→已完成&lt;br&gt;或失败/超时/取消/部分成功" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1862.5" y="3992.4" width="260.0" height="120.0" as="geometry"/></mxCell><mxCell id="m2_node_65" value="可靠发件箱（Outbox）&lt;br&gt;同事务保存待发消息&lt;br&gt;状态：待发送→已发送→已确认&lt;br&gt;失败则重试/转死信并告警" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2206.5" y="3935.0" width="260.0" height="142.5" as="geometry"/></mxCell><mxCell id="m2_node_66" value="任务消息&lt;br&gt;卡片、语音、服务端推送、任务中心刷新" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2550.5" y="3946.2" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_67" value="事实仓库&lt;br&gt;任务 / 运行 / 事件 / 动作 / 绑定&lt;br&gt;用任务编号、运行编号、回调编号、动作编号贯通" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2550.5" y="4138.8" width="260.0" height="142.5" as="geometry"/></mxCell><mxCell id="m2_node_68" value="用户诉求" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3912.8" y="3171.2" width="120.0" height="52.5" as="geometry"/></mxCell><mxCell id="m2_node_69" value="任务类型" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4173.0" y="3085.0" width="112.5" height="112.5" as="geometry"/></mxCell><mxCell id="m2_node_70" value="简单单步&lt;br&gt;例：打开车窗&lt;br&gt;本轮直接执行" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4363.1" y="2850.0" width="150.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_71" value="复合单轮&lt;br&gt;例：太热了&lt;br&gt;查询车态 + 多动作并行/串行" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4313.2" y="2969.5" width="249.8" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_72" value="多步依赖&lt;br&gt;例：找昨天地点再导航&lt;br&gt;前一步结果决定后一步参数" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4318.1" y="3089.0" width="240.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_73" value="定时任务&lt;br&gt;例：10分钟后关座椅加热&lt;br&gt;保存时间条件并等待" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4325.3" y="3208.5" width="225.7" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_74" value="条件任务&lt;br&gt;例：宝宝醒了告诉我&lt;br&gt;订阅信号/视觉并等待" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4336.7" y="3328.0" width="202.9" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_75" value="持续任务&lt;br&gt;例：沿途持续讲解&lt;br&gt;多次运行直到结束策略命中" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4318.1" y="3447.5" width="240.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_76" value="不建持久任务" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4647.0" y="2992.0" width="150.0" height="52.5" as="geometry"/></mxCell><mxCell id="m2_node_77" value="建立持久任务" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4647.0" y="3350.5" width="150.0" height="52.5" as="geometry"/></mxCell><mxCell id="m2_node_78" value="任务管理入口&lt;br&gt;任务管理接口 / 图形界面接口" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3005.3" y="2632.5" width="256.9" height="75.0" as="geometry"/></mxCell><mxCell id="m2_node_79" value="任务代理（Task Agent）&lt;br&gt;只做入口和透传，不负责生命周期" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3003.8" y="2816.5" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_80" value="任务入口层&lt;br&gt;解析、绑定、幂等、恢复任务上下文" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3003.8" y="3023.0" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_81" value="任务规格构建器&lt;br&gt;判断创建 / 更新 / 取消 / 查询" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3003.8" y="3229.5" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_82" value="任务服务内的任务管理器（Task Service）&lt;br&gt;唯一维护任务、运行、事件的确定性状态" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3003.8" y="3436.0" width="260.0" height="120.0" as="geometry"/></mxCell><mxCell id="m2_node_83" value="触发适配器&lt;br&gt;复用既有规则，不再造第二套触发器" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2862.8" y="3665.0" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_84" value="运行调度器&lt;br&gt;仍回到原决策规划器 / 工具 / 服务商" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3144.8" y="3665.0" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_85" value="决策规划器判断&lt;br&gt;这是立即动作，还是要长期记住" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2288.2" y="2709.5" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_86" value="一次动作&lt;br&gt;能否完成？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2418.2" y="2841.0" width="150.0" height="150.0" as="geometry"/></mxCell><mxCell id="m2_node_87" value="立即任务&lt;br&gt;仍走原主链：动作清单→工具→执行反馈" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2159.8" y="3197.5" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_88" value="条件/定时/持续任务&lt;br&gt;调用目标队列更新工具" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2441.8" y="3208.8" width="210.0" height="75.0" as="geometry"/></mxCell><mxCell id="m2_node_89" value="弋途持续任务逻辑&lt;br&gt;创建目标 + 触发场景" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2448.3" y="3404.0" width="196.9" height="75.0" as="geometry"/></mxCell><mxCell id="m2_node_90" value="目标 / 动态顾问分散管理&lt;br&gt;触发后再唤醒顾问或决策规划器" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2416.8" y="3588.0" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m2_node_91" value="边界必须守住&lt;br&gt;① 任务代理不是第二个决策规划器&lt;br&gt;② 任务服务不重做触发条件判断&lt;br&gt;③ 运行调度器不自由修改生命周期&lt;br&gt;④ 预生产验证结果不能外推为正式生产事实" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="3509.8" y="3081.2" width="260.0" height="232.5" as="geometry"/></mxCell><mxCell id="m2_node_92" value="04｜任务、主动服务、触发器与视觉闭环&lt;br&gt;先分清当前生产、预生产验证、目标架构；再沿任务编号追到真实结果" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3337.9" y="2160.5" width="260.0" height="142.5" as="geometry"/></mxCell><mxCell id="m2_node_93" value="证据标签：【当前】 已在当前协议或材料中出现　【待链路验真】 需同一条运行记录确认　【预生产/建设中】 仅表示测试或目标设计，不等于正式生产" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="3337.9" y="2337.0" width="260.0" height="165.0" as="geometry"/></mxCell><mxCell id="m2_edge_0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#78909C;fontColor=#475467;fontSize=12;" edge="1" parent="1" source="m2_node_92" target="m2_node_93"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m2_edge_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#78909C;fontColor=#475467;fontSize=12;" edge="1" parent="1" source="m2_node_4" target="m2_node_5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m2_edge_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#78909C;fontColor=#475467;fontSize=12;" edge="1" parent="1" source="m2_node_5" target="m2_node_6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m2_edge_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#78909C;fontColor=#475467;fontSize=12;" edge="1" parent="1" source="m2_node_6" target="m2_node_7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m2_edge_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#78909C;fontColor=#475467;fontSize=12;" edge="1" parent="1" source="m2_node_7" target="m2_node_8"><mxGeometry re