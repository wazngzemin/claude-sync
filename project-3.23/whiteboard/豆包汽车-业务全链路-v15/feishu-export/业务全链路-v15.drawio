3352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7882" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;9176&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="9176" sourceBaselineY="25514" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7878"><mxGeometry x="26" y="369" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_6867" parent="v15_6854" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;周期取消、车辆下电后是否保留必须按 EndPolicy 核对，&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7883" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;9176&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="9176" sourceBaselineY="25548" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7878"><mxGeometry x="26" y="403" width="930" height="30" as="geometry"/></mxCell><mxCell id="v15_6868" parent="v15_6854" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;不能从“支持定时器”推定所有类型都能跨行程长期运行。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWe