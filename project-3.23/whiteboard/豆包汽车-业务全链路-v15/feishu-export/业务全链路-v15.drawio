36" y="20" width="1450.8" height="46.8" as="geometry"/></mxCell><mxCell id="v15_9" parent="v15_5" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:24px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;先有可用麦克风与音区，再由 ASR/VAD 并行处理；OnePager 300/600 ms 不代表全车型统一配置&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=24;fontColor=#62758A;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="13" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;226&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="226" sourceBaselineY="481" sourceFontSize="24" sourceFontWeight="400" sourceTextIndex="12"><mxGeometry x="36" y="87" width="1641.6" height="28.8" as="geometry"/></mxCell><mxCell id="v15_10" parent="1" value="" style="group;connectable=0;recursiveResize=0;collapsible=0;" sourceIndex="14" sourceTag="g" sourceAttributes="{&quot;class&quot;:&quot;module-frame&quot;,&quot;data-module&quot;:&quot;R&quot;}" vertex="1" connectable="0"><mxGeometry x="3710" y="370" width="2760" height="6360" as="geometry"/></mxCell><mxCell id="v15_11" parent="v15_10" value="" style="shape=rectangle;rounded=1;absoluteArcSize=1;arcSize=28;fillColor=white;strokeColor=#9BB8DA;strokeWidth=3;" sourceIndex="15" sourceTag="rect" sourceAttributes="{&quot;x&quot;:&quot;3710&quot;,&quot;y&quot;:&quot;370&quot;,&quot;width&quot;:&quot;2760&quot;,&quot;height&quot;:&quot;6360&quot;,&quot;rx&quot;:&quot;14&quot;,&quot;fill&quot;:&quot;white&quot;,&quot;stroke&quot;:&quot;#9BB8DA&quot;,&quot;stroke-width&quot;:&quot;3&quot;}" vertex="1"><mxGeometry x="0" y="0" width="2760" height="6360" as="geometry"/></mxCell><mxCell id="v15_12" parent="v15_10" value="" style="shape=rectangle;rounded=1;absoluteArcSize=1;arcSize=28;fillColor=#EAF2FF;strokeColor=none;strokeWidth=1;" sourceIndex="16" sourceTag="rect" sourceAttributes="{&quot;x&quot;:&quot;3710&quot;,&quot;y&quot;:&quot;370&quot;,&quot;width&quot;:&quot;2760&quot;,&quot;height&quot;:&quot;165&quot;,&quot;rx&quot;:&quot;14&quot;,&quot;fill&quot;:&quot;#EAF2FF&quot;}" vertex="1"><mxGeometry x="0" y="0" width="2760" height="165" as="geometry"/></mxCell><mxCell id="v15_13" parent="v15_10" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:39px;font-weight:650;line-height:1;white-space:pre;&quot;&gt;R · 入口与端云采信：有效请求交给谁，只允许一次真实执行&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=39;fontColor=#163352;fontStyle=1;fontWeight=650;labelPadding=0;" sourceIndex="18" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;3746&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="3746" sourceBaselineY="429" sourceFontSize="39" sourceFontWeight="650" sourceTextIndex="17"><mxGeometry x="36" y="20" width="1357.2" height="46.8" as="geometry"/></mxCell><mxCell id="v15_14" parent="v15_10" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:24px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;AIVA 9 月 30 日：确定性本地缓存优先；常规联网用云端；本地 LLM 仅断网或云端 3 秒超时兜底。免唤醒上传另有前置规则&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=24;fontColor=#62758A;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="20" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;3746&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="3746" sourceBaselineY="481" sourceFontSize="24" sourceFontWeight="400" sourceTextIndex="19"><mxGeometry x="36" y="87" width="1872" height="28.8" as="geometry"/></mxCell><mxCell id="v15_15" parent="1" value="" style="group;connectable=0;recursiveResize=0;collapsible=0;" sourceIndex="21" sourceTag="g" sourceAttributes="{&quot;class&quot;:&quot;module-frame&quot;,&quot;data-module&quot;:&quot;I&quot;}" vertex="1" connectable="0"><mxGeometry x="190" y="7490" width="2760" height="6360" as="geometry"/></mxCell><mxCell id="v15_16" parent="v15_15" value="" style="shape=rectangle;rounded=1;absoluteArcSize=1;arcSize=28;fillColor=white;strokeColor=#9BB8DA;strokeWidth=3;" sourceIndex="22" sourceTag="rect" sourceAttributes="{&quot;x&quot;:&quot;190&quot;,&quot;y&quot;:&quot;7490&quot;,&quot;width&quot;:&quot;2760&quot;,&quot;height&quot;:&quot;6360&quot;,&quot;rx&quot;:&quot;14&quot;,&quot;fill&quot;:&quot;white&quot;,&quot;stroke&quot;:&quot;#9BB8DA&quot;,&quot;stroke-width&quot;:&quot;3&quot;}" vertex="1"><mxGeometry x="0" y="0" width="2760" height="6360" as="geometry"/></mxCell><mxCell id="v15_17" parent="v15_15" value="" style="shape=rectangle;rounded=1;absoluteArcSize=1;arcSize=28;fillColor=#EAF2FF;strokeColor=none;strokeWidth=1;" sourceIndex="23" sourceTag="rect" sourceAttributes="{&quot;x&quot;:&quot;190&quot;,&quot;y&quot;:&quot;7490&quot;,&quot;width&quot;:&quot;2760&quot;,&quot;height&quot;:&quot;165&quot;,&quot;rx&quot;:&quot;14&quot;,&quot;fill&quot;:&quot;#EAF2FF&quot;}" vertex="1"><mxGeometry x="0" y="0" width="2760" height="165" as="geometry"/></mxCell><mxCell id="v15_18" parent="v15_15" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:39px;font-weight:650;line-height:1;white-space:pre;&quot;&gt;I · 多人插话、打断与恢复：分清停声、停推理、取消和真实结果&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=39;fontColor=#163352;fontStyle=1;fontWeight=650;labelPadding=0;" sourceIndex="25" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;226&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="226" sourceBaselineY="7549" sourceFontSize="39" sourceFontWeight="650" sourceTextIndex="24"><mxGeometry x="36" y="20" width="1450.8" height="46.8" as="geometry"/></mxCell><mxCell id="v15_19" parent="v15_15" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:24px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;输入合并有时间窗口；工具一旦下发仍需收回真实反馈。OnePager 与 AIVA 最终拒识后的恢复规则不同，不能混成全车型统一策略&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=24;fontColor=#62758A;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="27" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;226&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="226" sourceBaselineY="7601" sourceFontSize="24" sourceFontWeight="400" sourceTextIndex="26"><mxGeometry x="36" y="87" width="1872" height="28.8" as="geometry"/></mxCell><mxCell id="v15_20" parent="1" value="" style="group;connectable=0;recursiveResize=0;collapsible=0;" sourceIndex="28" sourceTag="g" sourceAttributes="{&quot;class&quot;:&quot;module-frame&quot;,&quot;data-module&quot;:&quot;W&quot;}" vertex="1" connectable="0"><mxGeometry x="190" y="14610" width="2760" height="6360" as="geometry"/></mxCell><mxCell id="v15_21" parent="v15_20" value="" style="shape=rectangle;rounded=1;absoluteArcSize=1;arcSize=28;fillColor=white;strokeColor=#9BB8DA;strokeWidth=3;" sourceIndex="29" sourceTag="rect" sourceAttributes="{&quot;x&quot;:&quot;190&quot;,&quot;y&quot;:&quot;14610&quot;,&quot;width&quot;:&quot;2760&quot;,&quot;height&quot;:&quot;6360&quot;,&quot;rx&quot;:&quot;14&quot;,&quot;fill&quot;:&quot;white&quot;,&quot;stroke&quot;:&quot;#9BB8DA&quot;,&quot;stroke-width&quot;:&quot;3&quot;}" vertex="1"><mxGeometry x="0" y="0" width="2760" height="6360" as="geometry"/></mxCell><mxCell id="v15_22" parent="v15_20" value="" style="shape=rectangle;rounded=1;absoluteArcSize=1;arcSize=28;fillColor=#EAF2FF;strokeColor=none;strokeWidth=1;" sourceIndex="30" sourceTag="rect" sourceAttributes="{&quot;x&quot;:&quot;190&quot;,&quot;y&quot;:&quot;14610&quot;,&quot;width&quot;:&quot;2760&quot;,&quot;height&quot;:&quot;165&quot;,&quot;rx&quot;:&quot;14&quot;,&quot;fill&quot;:&quot;#EAF2FF&quot;}" vertex="1"><mxGeometry x="0" y="0" width="2760" height="165" as="geometry"/></mxCell><mxCell id="v15_23" parent="v15_20" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:39px;font-weight:650;line-height:1;white-space:pre;&quot;&gt;W · 可见即可说：从页面注册到真实点击，再回到对话历史&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=39;fontColor=#163352;fontStyle=1;fontWeight=650;labelPadding=0;" sourceIndex="32" sourceTag="t