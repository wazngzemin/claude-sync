;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4468" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;10876&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="10876" sourceBaselineY="1090" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4465"><mxGeometry x="26" y="335" width="870" height="30" as="geometry"/></mxCell><mxCell id="v15_4220" parent="v15_4208" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;再查记忆的一条长队。比如“开主驾车窗”可能不需查网上&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4469" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;10876&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="10876" sourceBaselineY="1124" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4465"><mxGeometry x="26" y="369" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_4221" parent="v15_4208" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;天气；“去昨天那家店”则需要身份与记忆。V2 把高频预注&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overf