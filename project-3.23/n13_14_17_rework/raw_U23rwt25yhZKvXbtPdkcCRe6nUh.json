        "italic": false,
        "line_through": false,
        "rich_text": {
          "paragraphs": [
            {
              "elements": [
                {
                  "element_type": 0,
                  "text_element": {
                    "text": "图例",
                    "text_style": {
                      "font_size": 13,
                      "font_weight": "bold",
                      "italic": false,
                      "line_through": false,
                      "text_color": "#111827",
                      "underline": false
                    }
                  }
                }
              ],
              "indent": 0,
              "list_begin_index": 0,
              "paragraph_type": 0,
              "quote": false
            },
            {
              "elements": [
                {
                  "element_type": 0,
                  "text_element": {
                    "text": "蓝底=工具入口｜绿底=结果回流/案例｜灰底=待核或职责引用（灰虚线连线=跨模块引用）",
                    "text_style": {
                      "font_size": 11,
                      "italic": false,
                      "line_through": false,
                      "text_color": "#374151",
                      "underline": false
                    }
                  }
                }
              ],
              "indent": 0,
              "list_begin_index": 0,
              "paragraph_type": 0,
              "quote": false
            },
            {
              "elements": [
                {
                  "element_type": 0,
                  "text_element": {
                    "text": "状态角标：【已落地-待核】工具存在但细节未展开；【待核】仅有间接来源；本篇不写成现网事实。",
                    "text_style": {
                      "font_size": 11,
                      "italic": false,
                      "line_through": false,
                      "text_color": "#374151",
                      "underline": false
                    }
                  }
                }
              ],
              "indent": 0,
              "list_begin_index": 0,
              "paragraph_type": 0,
              "quote": false
            },
            {
              "elements": [],
              "indent": 0,
              "list_begin_index": 0,
              "paragraph_type": 0,
              "quote": false
            }
          ]
        },
        "text": "图例\n蓝底=工具入口｜绿底=结果回流/案例｜灰底=待核或职责引用（灰虚线连线=跨模块引用）\n状态角标：【已落地-待核】工具存在但细节未展开；【待核】仅有间接来源；本篇不写成现网事实。\n",
        "text_background_color_type": 0,
        "text_color": "#1f2329",
        "text_color_type": 1,
        "theme_text_background_color_code": -1,
        "underline": false,
        "vertical_align": "top"
      },
      "type": "text_shape",
      "width": 1020,
      "x": 40,
