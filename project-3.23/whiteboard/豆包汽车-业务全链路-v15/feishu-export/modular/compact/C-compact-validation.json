      "renderedSummaryLines": [
        {
          "sourceLine": 0,
          "text": "当前乘客姓名、座位和可信身份"
        },
        {
          "sourceLine": 1,
          "text": "人名→此刻座位，不用旧记忆猜"
        },
        {
          "sourceLine": 2,
          "text": "未知/冲突交 K 身份链处理"
        },
        {
