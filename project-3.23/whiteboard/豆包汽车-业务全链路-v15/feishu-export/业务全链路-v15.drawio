<mxfile host="app.diagrams.net" version="26.0.0" type="device"><diagram id="doubao-v15" name="豆包汽车业务全链路 v15"><mxGraphModel dx="0" dy="0" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="13700" pageHeight="48466" background="#F8FAFD"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v15_1" parent="1" value="" style="shape=rectangle;rounded=0;absoluteArcSize=1;arcSize=0;fillColor=#F8FAFD;strokeColor=none;strokeWidth=1;" sourceIndex="0" sourceTag="rect" sourceAttributes="{&quot;width&quot;:&quot;13700&quot;,&quot;height&quot;:&quot;48466&quot;,&quot;fill&quot;:&quot;#F8FAFD&quot;}" vertex="1"><mxGeometry x="0" y="0" width="13700" height="48466" as="geometry"/></mxCell><mxCell id="v15_2" parent="1" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:58px;font-weight:650;line-height:1;white-space:pre;&quot;&gt;豆包汽车｜从一句话到真实执行的业务全链路&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=58;fontColor=#163352;fontStyle=1;fontWeight=650;labelPadding=0;" sourceIndex="2" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;190&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="190" sourceBaselineY="90" sourceFontSize="58" sourceFontWeight="650" sourceTextIndex="1"><mxGeometry x="190" y="32" width="1392" height="69.6" as="geometry"/></mxCell><mxCell id="v15_3" parent="1" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:34px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;语音 → 有效请求／端云采信 → 输入管理 → 相关背景 → Director 决策 → 工具执行 → 结果回流再判断&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=34;fontColor=#2463C5;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;190&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="190" sourceBaselineY="160" sourceFontSize="34" sourceFontWeight="500" sourceTextIndex="3"><mxGeometry x="190" y="126" width="2407.2" height="40.8" as="geometry"/></mxCell><mxCell id="v15_4" parent="1" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:27px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;蓝：请求与动作　绿：结果回流　金：任务与触发　红：打断　虚线：规划或职责引用&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=27;fontColor=#62758A;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="6" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;190&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="190" sourceBaselineY="228" sourceFontSize="27" sourceFontWeight="400" sourceTextIndex="5"><mxGeometry x="190" y="201" width="1231.2" height="32.4" as="geometry"/></mxCell><mxCell id="v15_5" parent="1" value="" style="group;connectable=0;recursiveResize=0;collapsible=0;" sourceIndex="7" sourceTag="g" sourceAttributes="{&quot;class&quot;:&quot;module-frame&quot;,&quot;data-module&quot;:&quot;V&quot;}" vertex="1" connectable="0"><mxGeometry x="190" y="370" width="2760" height="6360" as=