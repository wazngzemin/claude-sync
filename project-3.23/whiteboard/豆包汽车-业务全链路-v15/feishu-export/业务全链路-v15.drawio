去手动设置，不能与记忆内容删除混成同一个能力，更不能把人脸注册当声纹鉴权。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="9923" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;245&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="245" sourceBaselineY="41014" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="9922"><mxGeometry x="55" y="364" width="2580" height="30" as="geometry"/></mxCell><mxCell id="v15_8433" parent="v15_8421" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#627E9F;strokeWidth=3;dashed=0;html=0;" sourceIndex="9924" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;1570&quot;,&quot;y1&quot;:&quot;41053&quot;,&quot;x2&quot;:&quot;1570&quot;,&quot;y2&quot;:&quot;41093&quot;,&quot;stroke&quot;:&quot;#627E9F&quot;,&quot;stroke-width&quot;:&quot;3&quot;,&quot;marker-end&quot;:&quot;url(#arr-627E9F)&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1380" y="428" as="sourcePoint"/><mxPoint x="1380" y="468" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_8434" parent="v15_8421" value="" style="shape=triangle;direction=east;rotation=90;fillColor=#627E9F;strokeColor=none;strokeWidth=0;resizable=1;" sourceIndex="9924" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;1570&quot;,&quot;y1&quot;:&quot;41053&quot;,&quot;x2&quot;:&quot;1570&quot;,&quot;y2&quot;:&quot;41093&quot;,&quot;stroke&quot;:&quot;#627E9F&quot;,&quot;stroke-width&quot;:&quot;3&quot;,&quot;marker-end&quot;:&quot;url(#arr-627E9F)&quot;}" vertex="1" sourceMarker="true"><mxGeometry x="1369.5" y="451.5" width="21" height="18" as="geometry"/></mxCell><mxCell id="v15_84