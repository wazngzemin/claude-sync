e_72" target="m2_node_76"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m2_edge_79" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#78909C;fontColor=#475467;fontSize=12;" edge="1" parent="1" source="m2_node_79" target="m2_node_70"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m2_edge_80" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#78909C;fontColor=#475467;fontSize=12;" edge="1" parent="1" source="m2_node_79" target="m2_node_81"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m2_edge_81" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#78909C;fontColor=#475467;fontSize=12;" edge="1" parent="1" source="m2_node_79" target="m2_node_82"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m2_edge_82" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#78909C;fontColor=#475467;fontSize=12;" edge="1" parent="1" source="m2_node_79" target="m2_node_83"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m3_cluster_16" value="七｜版本边界与动态能力｜看见工具名不等于知道了完整能力" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1074.4" y="4174.9" width="921.0" height="167.6" as="geometry"/></mxCell><mxCell id="m3_cluster_37" value="工具矩阵｜搜索即执行、私有写入、异步任务与交易" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="121.1" y="3865.9" width="2827.5" height="283.5" as="geometry"/></mxCell><mxCell id="m3_cluster_46" value="六｜其余 7 个专用工具｜身份/记忆写入、长期目标、异步生成、有状态录音与交易" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1183.5" y="3881.7" width="1743.0" height="252.0" as="geometry"/></mxCell><mxCell id="m3_cluster_79" value="五｜4 个搜索即执行工具｜一次调用里既找内容/路线，也可能自动启动导航或播放" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="143.2" y="3890.1" width="996.0" height="235.1" as="geometry"/></mxCell><mxCell id="m3_cluster_100" value="工具矩阵｜车辆、系统、查询与事实获取" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="392.2" y="3339.0" width="2285.2" height="501.4" as="geometry"/></mxCell><mxCell id="m3_cluster_107" value="三｜9 个只读工具｜只取事实，不应偷偷改变车辆、内容、订单或用户数据" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="414.4" y="3354.8" width="2241.0" height="218.2" as="geometry"/></mxCell><mxCell id="m3_cluster_148" value="四｜7 个直接控制写工具｜会改变车辆、系统、通话、导航或当前媒体状态" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="663.4" y="3589.5" width="1743.0" height="235.1" as="geometry"/></mxCell><mxCell id="m3_cluster_181" value="运行闭环与完成口径" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="6.0" y="3063.0" width="3057.8" height="250.5" as="geometry"/></mxCell><mxCell id="m3_cluster_190" value="二｜四层成功语义｜上一层成功，不能自动证明下一层成功" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2064.4" y="3078.8" width="977.2" height="219.0" as="geometry"/></mxCell><mxCell id="m3_cluster_215" value="一｜所有工具共用的运行机制｜工具不是模型能力清单，而是一份可校验、可追踪、可回流的执行契约" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="28.1" y="3109.3" width="1992.0" height="158.0" as="geometry"/></mxCell><mxCell id="m3_node_0" value="当前工具数口径&lt;br&gt;本图按 9 月工具配置表（DNA）统计：共 27 个&lt;br&gt;7 直接控制写＋9 只读＋4 搜索即执行＋2 身份记忆写&lt;br&gt;＋1 目标＋2 异步生成＋1 有状态录音＋1 交易" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F8FAFC;strokeColor=#98A2B3;fontColor=#172033;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="1096.5" y="4190.7" width="186.0" height="136.1" as="geometry"/></mxCell><mxCell id="m3_node_1" value="7 月版本冲突&lt;br&gt;旧快照第 27 个是餐厅订座（restaurant_reserve）&lt;br&gt;与 9 月工具配置表（DNA）的停车缴费冲突&lt;br&gt;仅保留为版本脚注，不计作第 28 个工具" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F8FAFC;strokeColor=#98A2B3;fontColor=#172033;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="1326.8" y="4190.7" width="186.0" height="136.1" as="geometry"/></mxCell><mxCell id="m3_node_2" value="其他动态注册任务代理（Agent）&lt;br&gt;复杂地图、行程、生态服务等可能运行时注册&lt;br&gt;不属于本张 27 工具静态表&lt;br&gt;仍必须经过字段/安全/幂等门禁，并回传统一反馈" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F8FAFC;strokeColor=#98A2B3;fontColor=#172033;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="1557.0" y="4190.7" width="186.0" height="136.1" as="geometry"/></mxCell><mxCell id="m3_node_3" value="验收一个工具必须能回答&lt;br&gt;谁能调、何时调、输入字段、是否读写、真实执行方&lt;br&gt;成功证据、失败码、超时/重试/取消、是否自播/自带界面&lt;br&gt;以及如何让下一轮规划器知道它到底做成了什么" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F8FAFC;strokeColor=#98A2B3;fontColor=#172033;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="1787.2" y="4190.7" width="186.0" height="136.1" as="geometry"/></mxCell><mxCell id="m3_node_4" value="21 人脸身份注册&lt;br&gt;（face_id_register）&lt;br&gt;入：明确姓名＋明确座位＋注册意图&lt;br&gt;机：采集→质量校验→人脸与身份绑定&lt;br&gt;出：注册/更新结果或重试原因&lt;br&gt;门：姓名、位置缺一不可；防止错人和误注册" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF4D9;strokeColor=#D8A93D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1215.0" y="3914.3" width="186.0" height="186.8" as="geometry"/></mxCell><mxCell id="m3_node_5" value="22 用户记忆写入&lt;br&gt;（user_memory_operate）&lt;br&gt;入：客观事实、偏好、纠正或删除请求&lt;br&gt;机：不确定先确认；纠正覆盖旧记录；按身份写入&lt;br&gt;出：新增/更新/删除结果&lt;br&gt;门：写错用户接近零容忍；推断和临时状态不得当事实存储" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF4D9;strokeColor=#D8A93D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1464.0" y="3922.7" width="186.0" height="169.9" as="geometry"/></mxCell><mxCell id="m3_node_6" value="23 持续目标管理&lt;br&gt;（goal_list_update）&lt;br&gt;入：新增或删除持续/条件/定时目标&lt;br&gt;机：查重→创建目标编号/更新状态→后续轮次重新注入&lt;br&gt;出：目标编号、状态或删除结果&lt;br&gt;门：目标队列是共享看板，不是执行器；顾问建议不能擅自建目标" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E9F8F0;strokeColor=#51A878;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1713.0" y="3905.8" width="186.0" height="203.6" as="geometry"/></mxCell><mxCell id="m3_node_7" value="24 人工智能播客生成&lt;br&gt;（ai_broadcast_generate）&lt;br&gt;入：主题、风格、长度等生成要求&lt;br&gt;机：受理→排队/生成→完成或失败&lt;br&gt;出：状态与可播放音频产物&lt;br&gt;门：受理成功不能说生成完成；必须等产物或完成回调" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F4ECFF;strokeColor=#9B6BCE;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1962.0" y="3922.7" width="186.0" height="169.9" as="geometry"/></mxCell><mxCell id="m3_node_8" value="25 图片生成与编辑&lt;br&gt;（image_generate）&lt;br&gt;入：文生图/图生图类型＋描述或编辑指令&lt;br&gt;机：受理→生成→产物保存/推送&lt;br&gt;出：图片、地址和生成状态&lt;br&gt;门：输入协议必须统一；无产物不能报完成；隐私图片需授权" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F4ECFF;strokeColor=#9B6BCE;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2211.0" y="3914.3" width="186.0" height="186.8" as="geometry"/></mxCell><mxCell id="m3_node_9" value="26 录音纪要&lt;br&gt;（audio_record）&lt;br&gt;入：开始/停止/查看录音纪要&lt;br&gt;机：空闲→录音中→停止→纪要生成→可查看&lt;br&gt;出：录音状态与纪要产物&lt;br&gt;门：麦克风权限、隐私提示、中断恢复；录音开始≠纪要完成" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5F7F6;strokeColor=#3B9C98;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2460.0" y="3922.7" width="186.0" height="169.9" as="geometry"/></mxCell><mxCell id="m3_node_10" value="27 停车缴费&lt;br&gt;（parking_fee_pay）&lt;br&gt;入：缴费请求、车牌/车辆信息&lt;br&gt;机：确认车牌→注册或续费→查询订单→返回金额与付款地址→车端展示二维码/H5 页面&lt;br&gt;出：订单、应付金额、付款地址与展示状态&lt;br&gt;门：车牌和金额须确认；订单幂等防重复支付；支付成功回调证据待补" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFE9EC;strokeColor=#C94B68;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2709.0" y="3897.4" width="186.0" height="220.5" as="geometry"/></mxCell><mxCell id="m3_node_11" value="17 路线规划与发起导航&lt;br&gt;（route_planning）&lt;br&gt;入：精确目的地、多目的地、途经点、路线偏好&lt;br&gt;机：地点确认→规划路线→选择方案→发起导航&lt;br&gt;出：路线、预计时间、导航启动状态&lt;br&gt;门：与地点搜索/导航控制串行；地址模糊先补清；失败重试有上限" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F1EAFE;strokeColor=#8B6CD9;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="174.8" y="3905.8" width="186.0" height="203.6" as="geometry"/></mxCell><mxCell id="m3_node_12" value="18 视频搜索并播放&lt;br&gt;（video_search）&lt;br&gt;入：视频名称、主题、类型或平台范围&lt;br&gt;机：平台搜索→候选匹配→启动播放&lt;br&gt;出：当前视频与播放状态&lt;br&gt;门：内容匹配成功≠播放成功；平台覆盖和版权需区分" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F1EAFE;strokeColor=#8B6CD9;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="423.8" y="3922.7" width="186.0" height="169.9" as="geometry"/></mxCell><mxCell id="m3_node_13" value="19 音乐搜索并播放&lt;br&gt;（music_search）&lt;br&gt;入：歌曲/歌手/情绪/场景/类型要求&lt;br&gt;机：搜索并默认播放第一条匹配结果&lt;br&gt;出：实际首播曲目与播放状态&lt;br&gt;门：复杂典故/关系推理先联网查；不要再重复调用媒体播放" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F1EAFE;strokeColor=#8B6CD9;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="672.8" y="3914.3" width="186.0" height="186.8" as="geometry"/></mxCell><mxCell id="m3_node_14" value="20 播客搜索并播放&lt;br&gt;（broadcast_search）&lt;br&gt;入：播客、有声资源、节目名称或控制要求&lt;br&gt;机：搜索现有内容→选择→播放/控制&lt;br&gt;出：节目、集数和当前播放状态&lt;br&gt;门：与‘生成新播客’严格分开；候选和首播结果均应回传" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F1EAFE;strokeColor=#8B6CD9;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="921.8" y="3914.3" width="186.0" height="186.8" as="geometry"/></mxCell><mxCell id="m3_node_15" value="08 车辆实时状态查询&lt;br&gt;（vehicle_status_search）&lt;br&gt;入：温度/门窗/胎压/车速/续航/媒体等事实项&lt;br&gt;机：读取当前车辆最新状态快照&lt;br&gt;出：值、时间戳、不可用原因&lt;br&gt;门：校验车辆与新鲜度；历史对话不能冒充当前状态" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#EAF4FF;strokeColor=#5A91D8;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="445.9" y="3379.0" width="186.0" height="169.9" as="geometry"/></mxCell><mxCell id="m3_node_16" value="09 天气查询&lt;br&gt;（weather_search）&lt;br&gt;入：地点×时间，当前/目的地/沿途天气&lt;br&gt;机：在线天气服务查询与预警关联&lt;br&gt;出：对应地点和时段的天气事实&lt;br&gt;门：位置和时间必须明确；陈旧结果不可复用" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#EAF4FF;strokeColor=#5A91D8;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="694.9" y="3370.5" width="186.0" height="186.8" as="geometry"/></mxCell><mxCell id="m3_node_17" value="10 地点与商家搜索&lt;br&gt;（poi_search）&lt;br&gt;入：附近/中点/顺路、品类和筛选条件&lt;br&gt;机：搜索→过滤→排序→返回多个候选&lt;br&gt;出：地点、距离、营业/评分等结构化属性&lt;br&gt;门：不直接完成精确导航；沿途搜索依赖已有路线" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#EAF4FF;strokeColor=#5A91D8;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="943.9" y="3370.5" width="186.0" height="186.8" as="geometry"/></mxCell><mxCell id="m3_node_18" value="11 联网信息搜索&lt;br&gt;（web_search）&lt;br&gt;入：新闻、日期、开放域实时事实问题&lt;br&gt;机：联网检索→打开来源→提取可核验事实&lt;br&gt;出：事实、来源与时间&lt;br&gt;门：搜索摘要只是线索；无原始证据不得补写事实" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#EAF4FF;strokeColor=#5A91D8;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1192.9" y="3379.0" width="186.0" height="169.9" as="geometry"/></mxCell><mxCell id="m3_node_19" value="12 用车报告查询&lt;br&gt;（car_log）&lt;br&gt;入：明确时间窗、行程或报告类型&lt;br&gt;机：检索能耗、通勤和历史行程记录&lt;br&gt;出：周期用车报告与统计&lt;br&gt;门：不是实时车况；时间、车辆归属必须明确" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#EAF4FF;strokeColor=#5A91D8;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1441.9" y="3379.0" width="186.0" height="169.9" as="geometry"/></mxCell><mxCell id="m3_node_20" value="13 车辆说明书问答&lt;br&gt;（vehicle_manual_qa）&lt;br&gt;入：功能、硬件操作、教程和用车技巧&lt;br&gt;机：检索车型说明与操作知识&lt;br&gt;出：说明、步骤和适用边界&lt;br&gt;门：不能替代实时车况；车型/版本不匹配要提示" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#EAF4FF;strokeColor=#5A91D8;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1690.9" y="3387.4" width="186.0" height="153.0" as="geometry"/></mxCell><mxCell id="m3_node_21" value="14 车况维养问答&lt;br&gt;（car_care_qa）&lt;br&gt;入：保养、保险、权益、维修信息&lt;br&gt;机：按当前绑定车辆查询长期车务数据&lt;br&gt;出：单车维养或权益结果&lt;br&gt;门：车辆绑定必须正确；实时车辆状态不走这里" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#EAF4FF;strokeColor=#5A91D8;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1939.9" y="3379.0" width="186.0" height="169.9" as="geometry"/></mxCell><mxCell id="m3_node_22" value="15 当前视觉问答&lt;br&gt;（visual_qa）&lt;br&gt;入：车内/车外当前可见的人、物、场景问题&lt;br&gt;机：选择摄像头视角→视觉识别→结构化结果&lt;br&gt;出：目标、位置、描述、置信信息&lt;br&gt;门：只说视角内事实；屏幕理解/外部知识需走其他工具" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#EAF4FF;strokeColor=#5A91D8;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2188.9" y="3370.5" width="186.0" height="186.8" as="geometry"/></mxCell><mxCell id="m3_node_23" value="16 用户记忆查询&lt;br&gt;（user_memory_search）&lt;br&gt;入：用户事实、偏好或过往经历问题&lt;br&gt;机：按身份、范围和隐私边界检索记忆&lt;br&gt;出：命中内容或明确空结果&lt;br&gt;门：身份不确定限制读取；未找到不能臆造" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#EAF4FF;strokeColor=#5A91D8;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2437.9" y="3379.0" width="186.0" height="169.9" as="geometry"/></mxCell><mxCell id="m3_node_24" value="01 基础车控&lt;br&gt;（vehicle_basic_control）&lt;br&gt;入：车窗/空调/座椅/灯/锁等对象与目标值&lt;br&gt;机：结合座位和最新车况→协议适配→车端执行&lt;br&gt;出：执行结果；物理状态应回读&lt;br&gt;门：车型能力、权限、档位/车速、参数范围；不支持开关车门" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0E8;strokeColor=#E27B45;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="694.9" y="3605.3" width="186.0" height="203.6" as="geometry"/></mxCell><mxCell id="m3_node_25" value="02 车载系统设置&lt;br&gt;（vehicle_system_settings）&lt;br&gt;入：蓝牙/网络/屏幕/声音/账号/应用设置&lt;br&gt;机：定位设置项→修改或打开对应页面&lt;br&gt;出：设置值或页面状态&lt;br&gt;门：系统权限与当前模式；K 歌设置走这里，不走媒体控制" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0E8;strokeColor=#E27B45;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="943.9" y="3622.2" width="186.0" height="169.9" as="geometry"/></mxCell><mxCell id="m3_node_26" value="03 车载通信&lt;br&gt;（vehicle_communication）&lt;br&gt;入：拨打/接听/挂断电话或视频通话&lt;br&gt;机：联系人解析→歧义补问→调用通信服务&lt;br&gt;出：拨号、接通、挂断或失败原因&lt;br&gt;门：仅主驾；联系人不清必须确认；当前不支持短信" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0E8;strokeColor=#E27B45;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1192.9" y="3613.7" width="186.0" height="186.8" as="geometry"/></mxCell><mxCell id="m3_node_27" value="04 辅助驾驶控制&lt;br&gt;（auto_drive）&lt;br&gt;入：泊入/泊出/贴边/循迹/巡航/变道要求&lt;br&gt;机：安全前置检查→智驾服务→端侧状态呈现&lt;br&gt;出：可用性、执行阶段和终态&lt;br&gt;门：运行设计域、车速、档位、驾驶员确认与功能可用性" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0E8;strokeColor=#E27B45;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1441.9" y="3622.2" width="186.0" height="169.9" as="geometry"/></mxCell><mxCell id="m3_node_28" value="05 氛围灯控制&lt;br&gt;（ambient_light_control）&lt;br&gt;入：开关、颜色、亮度、模式或参考物颜色&lt;br&gt;机：解析颜色/区域→灯光服务→状态回读&lt;br&gt;出：实际灯光状态&lt;br&gt;门：车型能力、区域和模式冲突；视觉取色由本工具内部处理" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0E8;strokeColor=#E27B45;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1690.9" y="3613.7" width="186.0" height="186.8" as="geometry"/></mxCell><mxCell id="m3_node_29" value="06 导航过程控制&lt;br&gt;（navi_basic_control）&lt;br&gt;入：开始/结束、视图、播报、偏好等操作&lt;br&gt;机：操作当前已有导航会话&lt;br&gt;出：导航操作结果与当前阶段&lt;br&gt;门：不负责找新地点；不与地点搜索、路线规划并发" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0E8;strokeColor=#E27B45;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1939.9" y="3630.6" width="186.0" height="153.0" as="geometry"/></mxCell><mxCell id="m3_node_30" value="07 当前媒体控制&lt;br&gt;（media_basic_control）&lt;br&gt;入：暂停/切歌/收藏/倍速/清晰度/评论等&lt;br&gt;机：操作当前媒体会话，不重新搜索内容&lt;br&gt;出：播放或界面状态&lt;br&gt;门：必须有可操作媒体；K 歌模式/预约/点播不走这里" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0E8;strokeColor=#E27B45;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2188.9" y="3622.2" width="186.0" height="169.9" as="geometry"/></mxCell><mxCell id="m3_node_31" value="第一层｜请求被接收&lt;br&gt;工具节点收到合法请求" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2095.9" y="3154.0" width="148.5" height="51.8" as="geometry"/></mxCell><mxCell id="m3_node_32" value="第二层｜服务调用成功&lt;br&gt;接口或执行服务返回成功" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2307.4" y="3154.0" width="159.8" height="51.8" as="geometry"/></mxCell><mxCell id="m3_node_33" value="第三层｜真实状态生效&lt;br&gt;设备、播放、路线、订单或产物有证据" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2575.1" y="3094.5" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m3_node_34" value="第四层｜用户完整目标完成&lt;br&gt;所有必要子目标有证据，且没有必需待办" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2824.1" y="3094.5" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m3_node_35" value="常见假成功&lt;br&gt;接口返回成功就说‘已经完成’&lt;br&gt;搜索到内容却没有真的播放&lt;br&gt;生成任务已受理却没有产物&lt;br&gt;出现付款页却说‘缴费成功’" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="2578.5" y="3179.7" width="179.3" height="102.4" as="geometry"/></mxCell><mxCell id="m3_node_36" value="① 规划器生成动作&lt;br&gt;完整目标、工具字段、参数、作用对象" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="59.6" y="3158.5" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m3_node_37" value="② 字段与参数校验&lt;br&gt;白名单、必填项、类型、枚举、范围" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="308.6" y="3125.1" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m3_node_38" value="③ 能力与风险门禁&lt;br&gt;车型/版本、身份、权限、安全、确认" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="557.6" y="3125.1" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m3_node_39" value="④ 依赖与幂等编排&lt;br&gt;动作编号、串并行、去重、重试、取消" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="806.6" y="3125.1" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m3_node_40" value="⑤ 路由到真实执行方&lt;br&gt;车端服务、云端服务、生态服务或任务代理" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1055.6" y="3125.1" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m3_node_41" value="⑥ 执行并回读&lt;br&gt;受理、运行、超时、原始结果、真实状态/产物" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1304.6" y="3125.1" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m3_node_42" value="⑦ 统一工具执行反馈&lt;br&gt;状态、数据、错误、能否重试、真实状态、产物" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1553.6" y="3158.5" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m3_node_43" value="⑧ 下一轮规划器判断&lt;br&gt;继续、换工具、补问、等待、降级、取消或完成" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1802.6" y="3158.5" width="186.0" height="68.6" as="geometry"/></mxCell><mxCell id="m3_node_44" value="27 个当前工具（9 月配置表 DNA 口径）｜从一次动作到真实完成的能力矩阵&lt;br&gt;中文名帮助业务理解；括号内保留系统字段，便于查日志和对协议" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1441.9" y="2918.3" width="186.0" height="119.2" as="geometry"/></mxCell><mxCell id="m3_edge_0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#78909C;fontColor=#475467;fontSize=12;" edge="1" parent="1" source="m3_node_0" target="m3_node_1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m3_edge_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#78909C;fontColor=#475467;fontSize=12;" edge="1" parent="1" source="m3_node_1" target="m3_node_2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m3_edge_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#78909C;fontColor=#475467;fontSize=12;" edge="1" parent="1" source="m3_node_2" target="m3_node_3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m3_edge_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#78909C;fontColor=#475467;fontSize=12;" edge="1" parent="1" source="m3_node_4" target="m3_node_5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m3_edge_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#78909C;fontColor=#475467;fontSize=12;" edge="1" parent="1" source="m3_node_5" target="m3_node_6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m3_edge_5" v