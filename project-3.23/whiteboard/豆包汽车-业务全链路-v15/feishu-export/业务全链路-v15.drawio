" sourceTextIndex="4270"><mxGeometry x="26" y="335" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_4067" parent="v15_4055" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;车辆和会话维护，不能让另一辆车或过期会话的回包占住当&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4274" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;9176&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="9176" sourceBaselineY="1124" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4270"><mxGeometry x="26" y="369" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_4068" parent="v15_4055" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;前窗口。输入状态与整场对话状态也需分开，排队不是任务&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4275" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;9176&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="9176" sourceBaselineY="1158" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4270"><mxGe