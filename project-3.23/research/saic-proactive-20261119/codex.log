from collections import defaultdict
from pathlib import Path

transcript = Path('src/meeting-saic-20261111.md').read_text()
spoken = defaultdict(list)
for stamp, speech in re.findall(r'<text color=\"gray\">(\\d\\d:\\d\\d:\\d\\d)</text>\\s*\\n\\n(["'^'"\\n]+)', transcript):
    spoken[stamp].append(re.sub(r'<["'^>]+>'"', '', speech))
evidence = json.loads(Path('changes.json').read_text())
texts = {'plan.md': Path('plan.md').read_text(), 'changes.json': '\\n'.join(x['evidence'] for k in ('update', 'create') for x in evidence[k])}
