osoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;一张去……”很可能还没讲完。OnePager 提到 Soft、&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="3817" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="6106" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="3815"><mxGeometry x="26" y="301" width="930" height="30" as="geometry"/></mxCell><mxCell id="v15_3710" parent="v15_3699" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;Hard 与语义 VAD 配合，但没有展开具体门控顺序和延长上&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="3818" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="6140" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="3815"><mxGeometry x="26" y="335" width="930" height="30" as="geometry"/></mxCell><mxCell id="v15_3711" parent="v15_3699" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;限。旧 PRD 的 500 / 1000 ms 又标有暂定，因此图上保&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="3819" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="6174" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="3815"><mxGeometry x="26" y="369" width="1050" height="30" as="geometry"/></mxCell><mxCell id="v15_3712" parent="v15_3699" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;留这项判断及待确认边界，不把多个版本拼成一套已经上线&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="3820" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="6208" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="3815"><mxGeometry x="26" y="403" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_3713" parent="v15_3699" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;的计时规则。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="3821" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="6242" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="3815"><mxGeometry x="26" y="437" width="180" height="30" as="geometry"/></mxCell><mxCell id="v15_3714" parent="1" value="" style="group;connectable=0;recursiveResize=0;collapsible=0;" sourceIndex="3822" sourceTag="g" sourceAttributes="{&quot;class&quot;:&quot;node&quot;,&quot;data-node&quot;:&quot;V11&quot;,&quot;role&quot;:&quot;button&quot;,&quot;tabindex&quot;:&quot;0&quot;,&quot;aria-label&quot;:&quot;不匹配：按最终文字重新准备&quot;}" vertex="1" connectable="0"><mxGeometry x="1200" y="5780" width="720" height="780" as="geometry"/></mxCell><mxCell id="v15_3715" parent="v15_3714" value="" style="shape=rectangle;rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#F4F8FE;strokeColor=#ABC2E0;strokeWidth=2;" sourceIndex="3823" sourceTag="rect" sourceAttributes="{&quot;x&quot;:&quot;1200&quot;,&quot;y&quot;:&quot;5780&quot;,&quot;width&quot;:&quot;720&quot;,&quot;height&quot;:&quot;780&quot;,&quot;rx&quot;:&quot;9&quot;,&quot;fill&quot;:&quot;#F4F8FE&quot;,&quot;stroke&quot;:&quot;#ABC2E0&quot;,&quot;stroke-width&quot;:&quot;2&quot;}" vertex="1"><mxGeometry x="0" y="0" width="720" height="780" as="geometry"/></mxCell><mxCell id="v15_3716" parent="v15_3714" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-