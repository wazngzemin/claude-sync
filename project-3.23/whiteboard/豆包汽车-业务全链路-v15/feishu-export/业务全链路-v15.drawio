6" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;10876&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="10876" sourceBaselineY="20346" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7055"><mxGeometry x="26" y="301" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_6231" parent="v15_6220" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;关闭目标、清理规则并停止后续触发；已发生车控不会因删&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7057" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;10876&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="10876" sourceBaselineY="20380" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7055"><mxGeometry x="26" y="335" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_6232" parent="v15_6220" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;卡自动撤销。当前普通取消尚未覆盖直接创建的 GUI 任务&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7058" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;10876&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="10876" sourceBaselineY="20414" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7055"><mxGeometry x="26" y="369" width="840" height="30" as="geometry"/></mxCell><mxCell id="v15_6233" parent="v15_6220" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;，不能承诺所有生态在途执行都能停止。GUI 正式多用户、&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7059" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;10876&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="10876" sourceBaselineY="20448" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7055"><mxGeometry x="26" y="403" width="840" height="30" as="geometry"/></mxCell><mxCell id="v15_6234" parent="v15_6220" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;并发重试和用户取消仍待验证。任务中心一期支持删除我的&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7060" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;10876&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="10876" sourceBaselineY="20482" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7055"><mxGeometry x="26" y="437" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_6235" parent="v15_6220" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;任务和 AI 服务、暂停场景预设，循环定时/条件任务暂停&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7061" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;10876&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="10876" sourceBaselineY="20516" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7055"><mxGeometry x="26" y="471" width="840" height="30" as="geometry"/></mxCell><mxCell id="v15_6236" parent="v15_6220" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;列为二期；服务支持修改不等于全部 UI 已落地。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7062" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;10876&quo