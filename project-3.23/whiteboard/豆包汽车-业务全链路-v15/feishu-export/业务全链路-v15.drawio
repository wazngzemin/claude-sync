pan&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="8565" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;3836&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="3836" sourceBaselineY="30382" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="8563"><mxGeometry x="26" y="137" width="330" height="30" as="geometry"/></mxCell><mxCell id="v15_7401" parent="v15_7395" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;点按/本地可见即可说回原业务&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="8566" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;3836&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="3836" sourceBaselineY="30416" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="8563"><mxGeometry x="26" y="171" width="420" height="30" as="geometry"/></mxCell><mxCell id="v15_7402" parent="v15_7395" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;不是云端 Director 即时卡同一协议&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="8567" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;3836&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="3836" sourceBaselineY="30450" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="8563"><mxGeometry x="26" y="205" width="630" height="30" as="geometry"/></mxCell><mxCell id="v15_7403" parent="v15_7395" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="8568" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;3836&quot;,&quot;y1&quot;:&quot;30479&quot;,&quot;x2&quot;:&quot;4504&quot;,&quot;y2&quot;:&quot;30479&quot;,&quot;stroke&quot;:&quot;#CAD8E6&quot;,&quot;stroke-width&quot;:&quot;1&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="259" as="sourcePoint"/><mxPoint x="694" y="259" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_7404" parent="v15_7395" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;需要用户确认时，原业务准备卡片正文、语音、确认和取消&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="8570" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;3836&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="3836" sourceBaselineY="30512" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="8569"><mxGeometry x="26" y="267" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_7405" parent="v15_7395" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;按钮、有效期及回调，再交即时交互卡展示。例如“检测到&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="8571" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;3836&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="3836" sourceBaselineY="30546" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="8569"><mxGeometry x="26" y="301" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_7406" parent="v15_7395" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;路面湿滑，要切换模式吗”，按钮对应这一项具体动作。卡&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="8572" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;3836&quot;,&quot;dy&quot;:&quot;3