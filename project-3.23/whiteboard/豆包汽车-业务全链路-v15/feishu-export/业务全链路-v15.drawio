acingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7266" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="24402" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7264"><mxGeometry x="26" y="267" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_6391" parent="v15_6381" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;是从一句“好的”推测结果。回包与状态采样可能有先后差&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7267" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="24436" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7264"><mxGeometry x="26" y="301" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_6392" parent="v15_6381" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;异，验收要检查两者时间线，区分真实失败、状态尚未刷新&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7268" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="24470" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7264"><mxGeometry x="26" y="335" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_6393" parent="v15_6381" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;和错误关联，不能机械把短暂不一致都判为模型错误。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7269" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="24504" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7264"><mxGeometry x="26" y="369" width="720" height="30" as="geometry"/></mxCell><mxCell id="v15_6394" parent="v15_6381" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:18px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;接入 ← L08 / E6&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;