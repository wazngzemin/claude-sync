=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4266" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;9176&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="9176" sourceBaselineY="892" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4264"><mxGeometry x="26" y="137" width="360" height="30" as="geometry"/></mxCell><mxCell id="v15_4061" parent="v15_4055" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;后台任务继续不等于前台忙&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4267" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;9176&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="9176" sourceBaselineY="926" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4264"><mxGeometry x="26" y="171" width="360" height="30" as="geometry"/></mxCell><mxCell id="v15_4062" parent="v15_4055" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;同车同会话的状态隔离&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4268" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;9176&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="9176" sourceBaselineY="960" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4264"><mxGeometry x="26" y="205" width="300" height="30" as="geometry"/></mxCell><mxCell id="v15_4063" parent="v15_4055" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="4269" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;9176&quot;,&quot;y1&quot;:&quot;989&quot;,&quot;x2&quot;:&quot;9844&quot;,&quot;y2&quot;:&quot;989&quot;,&quot;stroke&quot;:&quot;#CAD8E6&quot;,&quot;stroke-width&quot;:&quot;1&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="259" as="sourcePoint"/><mxPoint x="694" y="259" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_4064" parent="v15_4055" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;这里的空闲是当前前台交互没有未完成计算和占用输出的播&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4271" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;9176&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="9176" sourceBaselineY="1022" sourceFontS