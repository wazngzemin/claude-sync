s><marker id=\"m-EL-store-use-10\" markerWidth=\"11\" markerHeight=\"11\" refX=\"9\" refY=\"5.5\" orient=\"auto\"><path d=\"M0,1 L9,5.5 L0,10\" fill=\"none\" stroke=\"#5f7b42\" stroke-width=\"1.5\"/></marker></defs><g class=\"business-edge\"><title>ls7 在整理周期里进入个人经历 → 分别核对本轮与以后产生的结果；后续查询采用，不是即时</title><polyline points=\"465,2321 170,2321 170,2997 456,2997\" fill=\"none\" stroke=\"#fff\" stroke-width=\"7\"/><polyline points=\"465,2321 170,2321 170,2997 456,2997\" fill=\"none\" stroke=\"#5f7b42\" stroke-width=\"2.2\" marker-end=\"url(#m-EL-store-use-10)\"/></g><defs><marker id=\"m-EL-store-use-11\" markerWidth=\"11\" markerHeight=\"11\" refX=\"9\" refY=\"5.5\" orient=\"auto\"><path d=\"M0,1 L9,5.5 L0,10\" fill=\"none\" stroke=\"#44657f\" stroke-width=\"1.5\"/></marker></defs><g class=\"business-edge\"><title>ls8 订阅方处理自己关注的变化 → 分别核对本轮与以后产生的结果；业务实际处理结果</title><polyline points=\"798,2767 798,2851\" fill=\"none\" stroke=\"#fff\" stroke-width=\"7\"/><polyline points=\"798,2767 798,2851\" fill=\"none\" stroke=\"#44657f\" stroke-width=\"2.2\" marker-end=\"url(#m-EL-store-use-11)\"/></g><rect x=\"811\" y=\"430\" width=\"90\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"816\" y=\"447\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">按合同上报</text><rect x=\"811\" y=\"768\" width=\"138\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"816\" y=\"785\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">资源格式校验通过</text><rect x=\"241\" y=\"539\" width=\"74\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"246\" y=\"556\" font-size=\"16\" fill=\"#28716f\" font-weight=\"500\">校验失败</text><rect x=\"811\" y=\"1106\" width=\"74\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"816\" y=\"1123\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">忠实事实</text><rect x=\"811\" y=\"1444\" width=\"106\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"816\" y=\"1461\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">可查询或通知</text><rect x=\"241\" y=\"1215\" width=\"74\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"246\" y=\"1232\" font-size=\"16\" fill=\"#a16b20\" font-weight=\"500\">写入失败</text><rect x=\"811\" y=\"1782\" width=\"90\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"816\" y=\"1799\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">对应白名单</text><rect x=\"241\" y=\"1553\" width=\"106\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"246\" y=\"1570\" font-size=\"16\" fill=\"#446cb1\" font-weight=\"500\">允许进入记忆</text><rect x=\"241\" y=\"1619\" width=\"90\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"246\" y=\"1636\" font-size=\"16\" fill=\"#85659d\" font-weight=\"500\">已注册订阅</text><rect x=\"241\" y=\"1891\" width=\"122\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"246\" y=\"1908\" font-size=\"16\" fill=\"#b45858\" font-weight=\"500\">本轮实际采用后</text><rect x=\"241\" y=\"2295\" width=\"186\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"246\" y=\"2312\" font-size=\"16\" fill=\"#5f7b42\" font-weight=\"500\">后续查询采用，不是即时</text><rect x=\"811\" y=\"2796\" width=\"138\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"816\" y=\"2813\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">业务实际处理结果</text><g data-page=\"EL\" data-flow=\"EL-store-use\" data-step=\"ls1\" role=\"link\" tabindex=\"0\" aria-label=\"事件服务收到主驾调温记录\"><rect x=\"468\" y=\"159\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"492\" y=\"196\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">事件服务收到主驾调温记录</text><text x=\"492\" y=\"243\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">收到“主驾 20 度变 25 度”的定义编号、结构化字段、事件时间和车辆账</text><text x=\"492\" y=\"270\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">号范围。</text><text x=\"492\" y=\"297\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"492\" y=\"324\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">客户端直接操作、Trigger 状态变化和云端业务各按自己的事件定义上报；</text><text x=\"492\" y=\"351\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">不能把不同来源混成一条未经区分的用户操作。</text></g><g data-page=\"EL\" data-flow=\"EL-store-use\" data-step=\"ls2\" role=\"link\" tabindex=\"0\" aria-label=\"用定义核对对象、字段和范围\"><rect x=\"468\" y=\"497\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"492\" y=\"534\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">用定义核对对象、字段和范围</text><text x=\"492\" y=\"581\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">按 resource_id 对应定义核对 resource_info：这条是否确为温度事件，</text><text x=\"492\" y=\"608\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">位置和前后值是否符合格式。</text><text x=\"492\" y=\"635\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"492\" y=\"662\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">类型错误或必要数据缺失就返回校验原因。来自另一车辆或身份范围的数据不</text><text x=\"492\" y=\"689\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">能为了补齐本条记录而直接拼入。</text></g><g data-page=\"EL\" data-flow=\"EL-store-use\" data-step=\"ls3\" role=\"link\" tabindex=\"0\" aria-label=\"让中文描述与字段讲同一件事\"><rect x=\"468\" y=\"835\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"492\" y=\"872\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">让中文描述与字段讲同一件事</text><text x=\"492\" y=\"919\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">结构化字段是主驾 20→25 度，中文也必须写主驾由 20 度变为 25 度，不</text><text x=\"492\" y=\"946\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">能写成副驾或反向变化。</text><text x=\"492\" y=\"973\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"492\" y=\"1000\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">模板只表达已有事实，不补“用户觉得冷”等动机。操作来源若不明确，保留</text><text x=\"492\" y=\"1027\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">为状态变化。</text></g><g data-page=\"EL\" data-flow=\"EL-store-use\" data-step=\"ls4\" role=\"link\" tabindex=\"0\" aria-label=\"保存发生时间，并找当时乘员\"><rect x=\"468\" y=\"1173\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"492\" y=\"1210\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">保存发生时间，并找当时乘员</text><text x=\"492\" y=\"1257\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">保存事件时间和实际写入时间，便于发现网络晚到；Trigger 事件时间按规</text><text x=\"492\" y=\"1284\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">则匹配时刻定义。</text><text x=\"492\" y=\"1311\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"492\" y=\"1338\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">事件服务按该时刻查询在场人员。下午新上车的人不能被补到上午的调温记录</text><text x=\"492\" y=\"1365\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">里；缺失身份明确保留缺失。</text></g><g data-page=\"EL\" data-flow=\"EL-store-use\" data-step=\"ls5\" role=\"link\" tabindex=\"0\" aria-label=\"按本次用途查询或通知\"><rect x=\"468\" y=\"1511\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"492\" y=\"1548\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">按本次用途查询或通知</text><text x=\"492\" y=\"1595\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">Context 查询近期允许事件，记忆按整理周期查询素材，订阅业务则等待自</text><text x=\"492\" y=\"1622\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">身关注的事件通知。</text><text x=\"492\" y=\"1649\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"492\" y=\"1676\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">查询范围包括时间、类型和数量等条件。后台今天查得到这条记录，只证明现</text><text x=\"492\" y=\"1703\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">在可查，不证明此前模型已经拿到。</text></g><g data-page=\"EL\" data-flow=\"EL-store-use\" data-step=\"ls6\" role=\"link\" tabindex=\"0\" aria-label=\"核对调温事实是否进入当轮输入\"><rect x=\"468\" y=\"1849\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#fff8eb\" stroke=\"#bc9154\" stroke-width=\"1.4\"/><text x=\"492\" y=\"1886\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">核对调温事实是否进入当轮输入</text><text x=\"492\" y=\"1933\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">Context 把相关事件放入背景，对话历史按白名单把事件插在实际发生的先</text><text x=\"492\" y=\"1960\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">后位置。</text><text x=\"492\" y=\"1987\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"492\" y=\"2014\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">再查看模型当时收到的内容：是否包含主驾新温度、发生时间及原目标。只看</text><text x=\"492\" y=\"2041\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">到查询接口成功仍不足以证明注入完整。</text></g><g data-page=\"EL\" data-flow=\"EL-store-use\" data-step=\"ls7\" role=\"link\" tabindex=\"0\" aria-label=\"在整理周期里进入个人经历\"><rect x=\"468\" y=\"2187\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"492\" y=\"2224\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">在整理周期里进入个人经历</text><text x=\"492\" y=\"2271\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">记忆取得允许素材后，结合当时同乘范围和对话整理经历，再经过保存与以后</text><text x=\"492\" y=\"2298\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">召回。</text><text x=\"492\" y=\"2325\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"492\" y=\"2352\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">单条 25 度设置不自动变成长期偏好；如果用户明确表达喜欢，仍要确认这</text><text x=\"492\" y=\"2379\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">项内容归给谁、何时可以被使用。</text></g><g data-page=\"EL\" data-flow=\"EL-store-use\" data-step=\"ls8\" role=\"link\" tabindex=\"0\" aria-label=\"订阅方处理自己关注的变化\"><rect x=\"468\" y=\"2525\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"492\" y=\"2562\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">订阅方处理自己关注的变化</text><text x=\"492\" y=\"2609\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">比如授权状态变化通知对应音频业务，由它更新可用状态；没有订阅就不额外</text><text x=\"492\" y=\"2636\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">推给不相关服务。</text><text x=\"492\" y=\"2663\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"492\" y=\"2690\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">收到通知、业务采用和产生实际结果分别记录。事件服务不代替订阅方完成登</text><text x=\"492\" y=\"2717\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">录、授权或设备操作。</text></g><g data-page=\"EL\" data-flow=\"EL-store-use\" data-step=\"ls9\" role=\"link\" tabindex=\"0\" aria-label=\"分别核对本轮与以后产生的结果\"><rect x=\"468\" y=\"2863\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"492\" y=\"2900\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">分别核对本轮与以后产生的结果</text><text x=\"492\" y=\"2947\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">本轮模型看到新温度后，是否避免无故改回 20 度；以后记忆被召回时，是</text><text x=\"492\" y=\"2974\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">否仍属于同一人和可用范围。</text><text x=\"492\" y=\"3001\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"492\" y=\"3028\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">这些结果都晚于日志写入。记录存在、模型用到、用户目标办成是连续的不同</text><text x=\"492\" y=\"3055\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">阶段，不能只用入库成功作最终判定。</text></g><g data-page=\"EL\" data-flow=\"EL-store-use\" data-step=\"ls10\" role=\"link\" tabindex=\"0\" aria-label=\"把校验或写入失败交回生产方\"><rect x=\"468\" y=\"3201\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"492\" y=\"3238\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">把校验或写入失败交回生产方</text><text x=\"492\" y=\"3285\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">事件定义不匹配、字段格式错误或保存失败时，保留原对象、时间和失败原因</text><text x=\"492\" y=\"3312\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">供生产方修复。</text><text x=\"492\" y=\"3339\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"492\" y=\"3366\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">不能向消费链提供一条伪装成功的事实，也不能把未知数值填成默认温度；补</text><text x=\"492\" y=\"3393\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">送要对应原事件，避免制造重复变化。</text></g></svg>",
