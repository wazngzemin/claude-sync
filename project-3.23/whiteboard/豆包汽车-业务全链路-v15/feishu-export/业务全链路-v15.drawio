dth="330" height="30" as="geometry"/></mxCell><mxCell id="v15_3617" parent="v15_3611" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;停顿达到不同阈值，做不同处理&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="3700" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="3956" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="3697"><mxGeometry x="26" y="171" width="420" height="30" as="geometry"/></mxCell><mxCell id="v15_3618" parent="v15_3611" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="3701" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;2136&quot;,&quot;y1&quot;:&quot;3985&quot;,&quot;x2&quot;:&quot;2804&quot;,&quot;y2&quot;:&quot;3985&quot;,&quot;stroke&quot;:&quot;#CAD8E6&quot;,&quot;stroke-width&quot;:&quot;1&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="225" as="sourcePoint"/><mxPoint x="694" y="225" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_3619" parent="v15_3611" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;VAD 负责观察用户是否仍在说话、停顿了多久，帮助决定继&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="3703" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="4018" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="3702"><mxGeometry x="26" y="233" width="840" height="30" as="geometry"/></mxCell><mxCell id="v15_3620" parent="v15_3611" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;续等待还是让这一段收尾。它与 ASR 的职责不同：ASR 给&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="3704" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="4052" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="3702"><mxGeometry x="26" y="267" width="900" height="30" as="geometry"/></mxCell><mxCell id="v15_3621" parent="v15_3611" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;文字，VAD 给说话活动和停顿信号。例如“我想去……”停&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="3705" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="4086" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="3702"><mxGeometry x="26" y="301" width="840" height="30" as="geometry"/></mxCell><mxCell id="v15_3622" parent="v15_3611" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;了一会儿，已有文字不代表意思完整。300 ms 和 600 ms &lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="3706" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="4120" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="3702"><mxGeometry x="26" y="335" width="990" height="30" as="geometry"/></mxCell><mxCell id="v15_3623" parent="v15_3611" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;都是同一次停顿的阈值，不能相加成 900 ms，也不是从开&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="3707" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="4154" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="3702"><mxGeometry x="26" y="369" width="870" height="30" as="geometry"/></mxCell><mxCell id="v15_3624" parent="v15_3611" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;口第一字开始计时。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="3708" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="4188" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="3702"><mxGeometry x="26" y="403" width="270" height="30" as="geometry"/></mxCell><mxCell id="v15_3625" parent="1" value="" style="group;connectable=0;recursiveResize=0;collapsible=0;" sourceIndex="3709" sourceTag="g" sourceAttributes="{&quot;class&quot;:&quot;node&quot;,&quot;data-node&quot;:&quot;V5&quot;,&quot;role&quot;:&quot;button&quot;,&quot;tabindex&quot;:&quot;0&quot;,&quot;aria-label&quot;:&quot;短停顿 300 ms：先做准备&quot;}" vertex="1" connectable="0"><mxGeometry x="1200" y="3760" width="720" height="780" as="geometry"/></mxCell><mxCell id="v15_3626" parent="v15_3625" value="" style="shape=rectangle;rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#FFF8E8;strokeColor=#D6B577;strokeWidth=2;" sourceIndex="3710" sourceTag="rect" sourceAttributes="{&quot;x&quot;:&quot;1200&quot;,&quot;y&quot;:&quot;3760&quot;,&quot;width&quot;:&quot;720&quot;,&quot;height&quot;:&quot;780&quot;,&quot;rx&quot;:&quot;9&quot;,&quot;fill&quot;:&quot;#FFF8E8&quot;,&quot;stroke&quot;:&quot;#D6B577&quot;,&quot;stroke-width&quot;:&quot;2&quot;}" vertex="1"><mxGeometry x="0" y="0" width="720" height="780" as="geometry"/></mxCell><mxCell id="v15_3627" parent="v15_3625" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:18px;font-weight:600;line-height:1;white-space:pre;&quot;&gt;V5&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=18;fontColor=#62758A;fontStyle=1;fontWeight=600;labelPadding=0;" sourceIndex="3712" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="3792" sourceFontSize="18" sourceFontWeight="600" sourceTextIndex="3711"><mxGeometry x="26" y="14" width="43.2" height="21.6" as="geometry"/></mxCell><mxCell id="v15_3628" parent="v15_3625" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:30px;font-weight:600;line-height:1;white-space:pre;&quot;&gt;短停顿 300 ms：先做准备&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=30;fontColor=#775319;fontStyle=1;fontWeight=600;labelPadding=0;" sourceIndex="3714" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="3836" sourceFontSize="30" sourceFontWeight="600" sourceTextIndex="3713"><mxGeometry x="26" y="46" width="540" height="36" as="geometry"/></mxCell><mxCell id="v15_3629" parent="v15_3625" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;停顿到 300 ms：触发 Soft VAD&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="3716" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="3888" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="3715"><mxGeometry x="26" y="103" width="660" height="30" as="geometry"/></mxCell><mxCell id="v15_3630" parent="v15_3625" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;带当前文字发起一轮预请求&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="3717" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="3922" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="3715"><mxGeometry x="26" y="137" width="360" height="30" as="geometry"/></mxCell><mxCell id="v15_3631" parent="v15_3625" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;继续收音，不能结束 ASR&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="3718" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="3956" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="3715"><mxGeometry x="26" y="171" width="390" height="30" as="geometry"/></mxCell><mxCell id="v15_3632" parent="v15_3625" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;再开口再停顿，可再次触发&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="3719" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="3990" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="3715"><mxGeometry x="26" y="205" width="360" height="30" as="geometry"/></mxCell><mxCell id="v15_3633" parent="v15_3625" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="3720" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;1226&quot;,&quot;y1&quot;:&quot;4019&quot;,&quot;x2&quot;:&quot;1894&quot;,&quot;y2&quot;:&quot;4019&quot;,&quot;stroke&quot;:&quot;#CAD8E6&quot;,&quot;stroke-width&quot;:&quot;1&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="259" as="sourcePoint"/><mxPoint x="694" y="259" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_3634" parent="v15_3625" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;按 OnePager，停顿达到 Soft VAD 的 300 ms 阈值时，&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="3722" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="4052" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="3721"><mxGeometry x="26" y="267" width="1140" height="30" as="geometry"/></mxCell><mxCell id="v15_3635" parent="v15_3625" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;系统拿当前文字先准备。比如“去昨天那家游泳馆”已暂时&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="3723" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="4086" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="3721"><mxGeometry x="26" y="301" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_3636" parent="v15_3625" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;成句，可以先查前置上下文。此时仍继续听，用户还可能补&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="3724" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="4120" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="3721"><mxGeometry x="26" y="335" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_3637" parent="