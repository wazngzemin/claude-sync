  "headings": [
    {
      "id": "k70-heading-01",
      "level": 2,
      "title": "开篇、同一句“回家”，先要知道是谁说的"
    },
    {
      "id": "k70-heading-02",
      "level": 3,
      "title": "先认清说话的人，再判断哪些过去能带进这一轮"
    },
    {
      "id": "k70-heading-03",
      "level": 2,
      "title": "一、账号：车登录的是谁，和说话的人不是一回事"
    },
    {
      "id": "k70-heading-04",
      "level": 3,
      "title": "车、登录账号和自然人，分别回答不同的问题"
    },
    {
      "id": "k70-heading-05",
      "level": 3,
      "title": "一份记忆按“这辆车 × 这个豆包账号”划定"
    },
    {
      "id": "k70-heading-06",
      "level": 3,
      "title": "登录通过以后，每个动作还要按角色和当时条件核权限"
    },
    {
      "id": "k70-heading-07",
      "level": 2,
      "title": "二、认人：音区、人脸和声纹各说明什么"
    },
    {
      "id": "k70-heading-08",
      "level": 3,
      "title": "音区告诉我们坐哪，人脸才把座位对到具体的人"
    },
    {
      "id": "k70-heading-09",
      "level": 3,
      "title": "人脸注册绑定眼前的人，同名只说明称呼相同"
    },
    {
      "id": "k70-heading-10",
      "level": 3,
      "title": "共享乘客能被再认出，记忆仍要各守账号边界"
    },
    {
      "id": "k70-heading-11",
      "level": 2,
      "title": "三、记忆分几层"
    },
    {
      "id": "k70-heading-12",
      "level": 3,
      "title": "最近历史保留对话细节，摘要接住移出窗口的内容"
    },
    {
      "id": "k70-heading-13",
      "level": 3,
      "title": "经历记“发生过什么”，语义记忆记“说过什么事实”，画像再作推断"
    },
    {
      "id": "k70-heading-14",
      "level": 3,
      "title": "事件日志存原料，生成、取回和用上还要分别走一步"
    },
    {
      "id": "k70-heading-15",
      "level": 2,
      "title": "四、记忆怎样产生"
    },
    {
      "id": "k70-heading-16",
      "level": 3,
      "title": "明确交代的事即时写，平常聊过的事每天抽取"
    },
    {
      "id": "k70-heading-17",
      "level": 3,
      "title": "别人说他喜欢，只能先记成别人说过"
    },
    {
      "id": "k70-heading-18",
      "level": 3,
      "title": "情景记忆先按同行人和场景分组，再合成一段经历"
    },
    {
      "id": "k70-heading-19",
      "level": 3,
      "title": "标签帮助查找，画像多走了一步推断"
    },
    {
      "id": "k70-heading-20",
      "level": 2,
      "title": "五、记忆怎样被用"
    },
    {
      "id": "k70-heading-21",
      "level": 3,
      "title": "常用背景先带上，缺具体事实再查"
    },
    {
      "id": "k70-heading-22",
      "level": 3,
      "title": "先筛适用场景，再比较哪条记忆最相关"
    },
    {
      "id": "k70-heading-23",
      "level": 3,
      "title": "没查到、无权读取和服务异常，要给用户不同的解释"
    },
    {
      "id": "k70-heading-24",
      "level": 3,
      "title": "取到了以后，还要判断这次值不值得用"
    },
    {
      "id": "k70-heading-25",
      "level": 2,
      "title": "六、记忆怎样被改和删"
    },
    {
      "id": "k70-heading-26",
      "level": 3,
      "title": "明确纠正覆盖旧事实，新增偏好保留原来的喜欢"
    },
    {
      "id": "k70-heading-27",
      "level": 3,
      "title": "删除要说清对象和范围，画像也要跟着更新"
    },
    {
      "id": "k70-heading-28",
      "level": 3,
      "title": "关闭记忆是冻结使用，清空记忆是删除内容"
    },
    {
      "id": "k70-heading-29",
      "level": 3,
      "title": "改称呼、删人脸和删记忆，是三个要分别办完的操作"
    },
    {
      "id": "k70-heading-30",
      "level": 2,
      "title": "七、车里有别人时：隐私和在场的人"
    },
    {
      "id": "k70-heading-31",
      "level": 3,
      "title": "同车让人能听见回答，也就改变了记忆能说到哪一步"
    },
    {
      "id": "k70-heading-32",
      "level": 3,
      "title": "共同经历要对照两次在场人，页面展示还有自己的范围"
    },
    {
      "id": "k70-heading-33",
      "level": 3,
      "title": "新人上车时，摘要也要跟着收紧"
    },
    {
      "id": "k70-heading-34",
      "level": 3,
      "title": "别人说过什么，要和本人认可了什么分开"
    },
    {
      "id": "k70-heading-35",
      "level": 2,
      "title": "八、记忆落到车上：家、公司和座椅"
    },
    {
      "id": "k70-heading-36",
      "level": 3,
      "title": "地址统一存完整地点，地图使用同一份结果"
    },
    {
      "id": "k70-heading-37",
      "level": 3,
      "title": "先找说话人的家，再把具体地点交给导航"
    },
    {
      "id": "k70-heading-38",
      "level": 3,
      "title": "座椅位置留在车上，豆包记的是这个人拿它做什么"
    },
    {
      "id": "k70-heading-39",
      "level": 3,
      "title": "离线看已有副本，保存成功要看后续能否真正使用"
    },
    {
      "id": "k70-heading-40",
      "level": 2,
      "title": "九、怎么评测、怎么排查"
    },
    {
      "id": "k70-heading-41",
      "level": 3,
      "title": "同一组测试，既要证明记得住，也要证明守得住范围"
    },
    {
      "id": "k70-heading-42",
      "level": 3,
      "title": "服务准确率、等待时间和实车能否办成，要分别看"
    },
    {
      "id": "k70-heading-43",
      "level": 3,
      "title": "用户说“你又忘了”，先找最早断掉的那次交接"
    },
    {
      "id": "k70-heading-44",
      "level": 3,
      "title": "找到记忆以后，还要看 Planner 有没有按它办"
    },
    {
      "id": "k70-heading-45",
      "level": 2,
      "title": "收尾、从“这句话是谁说的”讲到车上真正办成"
    },
    {
      "id": "k70-heading-46",
      "level": 3,
      "title": "三分钟口述稿：沿着老周回家，把身份和记忆接起来"
    },
    {
      "id": "k70-heading-47",
      "level": 3,
      "title": "最容易讲错的地方：八句话守住人物、授权和结果"
    },
    {
      "id": "k70-heading-48",
      "level": 3,
      "title": "复述路线图：每次交接只追问一句"
    },
    {
      "id": "k70-heading-49",
      "level": 2,
      "title": "附一、术语表"
    },
    {
      "id": "k70-heading-50",
      "level": 3,
      "title": "看见一个词，先判断它指人、记忆，还是某次处理结果"
    },
    {
      "id": "k70-heading-51",
      "level": 2,
      "title": "附二　历史版本与关键数字"
    },
    {
      "id": "k70-heading-52",
      "level": 3,
      "title": "窗口与保留期：先分轮数、事件数、长度和时间"
    },
    {
      "id": "k70-heading-53",
      "level": 3,
      "title": "版本演进：先能生成和查询，再补归属、管理与监控"
    },
    {
      "id": "k70-heading-54",
      "level": 3,
      "title": "评测与性能：每个数字先说清测的是哪一步"
    },
    {
      "id": "k70-heading-55",
      "level": 3,
      "title": "摘要清理的八类内容：按信息本身判断敏感性"
    },
    {
      "id": "k70-heading-56",
      "level": 3,
      "title": "赛力斯四个座椅接口：存位置、改名字、恢复各办各的事"
    },
    {
      "id": "k70-heading-57",
      "level": 3,
      "title": "记忆实体与参数：先限定对象，再查生成和检索"
    }
  ],
