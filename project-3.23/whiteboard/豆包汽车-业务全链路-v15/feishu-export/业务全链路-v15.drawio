="500" sourceTextIndex="3968"><mxGeometry x="26" y="171" width="420" height="30" as="geometry"/></mxCell><mxCell id="v15_3830" parent="v15_3823" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;“暂停/继续/就选它”不能泛化缓存&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="3972" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;3836&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="3836" sourceBaselineY="1970" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="3968"><mxGeometry x="26" y="205" width="510" height="30" as="geometry"/></mxCell><mxCell id="v15_3831" parent="v15_3823" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="3973" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;3836&quot;,&quot;y1&quot;:&quot;1999&quot;,&quot;x2&quot;:&quot;4504&quot;,&quot;y2&quot;:&quot;1999&quot;,&quot;stroke&quot;:&quot;#CAD8E6&quot;,&quot;stroke-width&quot;:&quot;1&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="259" as="sourcePoint"/><mxPoint x="694" y="259" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_3832" parent="v15_3823" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;AIVA 9 月 30 日保留本地正则缓存优先，命中后可跳过本&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="3975" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;3836&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="3836" sourceBaselineY="2032" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="3974"><mxGeometry x="26" y="267" width="930" height="30" as="geometry"/></mxCell><mxCell id="v15_3833" parent="v15_3823" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;地模型。离线解析 PRD 要求缓存指令单轮、上下文无关、&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="3976" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;3836&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="3836" sourceBaselineY="2066" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="3974"><mxGeometry x="26" y="301" width="840" height="30" as="geometry"/></mxCell><mxCell id="v15_3834" parent="v15_3823" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;意图与槽位唯一，例如明确设备的开关；“暂停”“继续”&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="3977" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;3836&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="3836" sourceBaselineY="2100" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="3974"><mxGeometry x="26" y="335" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_3835" parent="v15_3823" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;“就选它”依赖历史对象，不能仅因常见就设成安全缓存。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="3978" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;3836&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="3836" sourceBaselineY="2134" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="3974"><mxGeometry x="26" y="369" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_3836" parent="v15_3823" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;命中只是提供明确调用，仍要按车辆能力和状态执行。命中&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="3979" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;3836&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="3836" sourceBaselineY="2168" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="3974"><mxGeometry x="26" y="403" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_3837" parent="v15_3823" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;率不是唯一目标，一次错误优先执行就可能破坏整个对话体&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="3980" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;3836&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="3836" sourceBaselineY="2202" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="3974"><mxGeometry x="26" y="437" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_3838" parent="v15_3823" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;验。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0