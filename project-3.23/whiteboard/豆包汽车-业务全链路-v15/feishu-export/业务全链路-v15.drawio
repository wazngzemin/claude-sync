ne-height:1;white-space:pre;&quot;&gt;检索相应车型/版本说明书，不负责直接执行。另有技术方案将常用2000条QA前置Context：多轮改写→车型过滤→TOP3→低置信过滤→knowledge注入，并明确禁用旧车书工具；与当前PRD必选需分项目确认。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="9675" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;245&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="245" sourceBaselineY="38898" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="9674"><mxGeometry x="55" y="364" width="3180" height="30" as="geometry"/></mxCell><mxCell id="v15_8249" parent="v15_8237" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#627E9F;strokeWidth=3;dashed=0;html=0;" sourceIndex="9676" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;1570&quot;,&quot;y1&quot;:&quot;38937&quot;,&quot;x2&quot;:&quot;1570&quot;,&quot;y2&quot;:&quot;38977&quot;,&quot;stroke&quot;:&quot;#627E9F&quot;,&quot;stroke-width&quot;:&quot;3&quot;,&quot;marker-end&quot;:&quot;url(#arr-627E9F)&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1380" y="428" as="sourcePoint"/><mxPoint x="1380" y="468" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_8250" parent="v15_8237" value="" style="shape=triangle;direction=east;rotation=90;fillColor=#627E9F;strokeColor=none;strokeWidth=0;resizable=1;" sourceIndex="9676" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;1570&quot;,&quot;y1&quot;:&quot;38937&quot;,&quot;x2&quot;:&quot;1570&quot;,&quot;y2&quot;:&quot;38977&quot;,&quot;stroke&quot;:&quot;#627E9F&quot;,&quot;stroke-width&quot;:&quot;3&quot;,&quot;marker-end&quot;:&quot;url(#arr-627E9F)&quot;}" vertex="1" sourceMarke