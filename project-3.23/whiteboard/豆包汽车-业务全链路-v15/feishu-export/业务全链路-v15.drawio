"16306" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="6521"><mxGeometry x="26" y="301" width="900" height="30" as="geometry"/></mxCell><mxCell id="v15_5813" parent="v15_5802" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;数据。记忆 PRD 规定摘要从第3轮起每新增一轮压缩，最多&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="6524" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;8266&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="8266" sourceBaselineY="16340" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="6521"><mxGeometry x="26" y="335" width="870" height="30" as="geometry"/></mxCell><mxCell id="v15_5814" parent="v15_5802" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;22轮、最长500 token，具体需按项目实现验收。生成有延&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="6525" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;8266&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="8266" sourceBaselineY="16374" sourceFontSi