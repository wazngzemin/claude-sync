="tspan" sourceAttributes="{&quot;x&quot;:&quot;12696&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="12696" sourceBaselineY="10956" sourceFontSize="30" sourceFontWeight="600" sourceTextIndex="5811"><mxGeometry x="26" y="46" width="540" height="36" as="geometry"/></mxCell><mxCell id="v15_5257" parent="v15_5253" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;简单查询/车控可不说首轮空话&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="5814" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;12696&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="12696" sourceBaselineY="11008" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="5813"><mxGeometry x="26" y="103" width="420" height="30" as="geometry"/></mxCell><mxCell id="v15_5258" parent="v15_5253" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;执行前只说准备，不说已完成&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="5815" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;12696&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="12696" sourceBaselineY="11042" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="5813"><mxGeometry x="26" y="137" width="390" height="30" as="geometry"/></mxCell><mxCell id="v15_5259" parent="v15_5253" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;等齐结果后统一说关键结论&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="5816" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;12696&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="12696" sourceBaselineY="11076" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="5813"><mxGeometry x="26" y="171" width="360" height="30" as="geometry"/></mxCell><mxCell id="v15_5260" parent="v15_5253" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;续说看信息价值与用户新意图&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="5817" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;12696&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="12696" sourceBaselineY="11110" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="5813"><mxGeometry x="26" y="205" width="390" height="30" as="geometry"/></mxCell><mxCell id="v15_5261" parent="v15_5253" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="5818" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;12696&quot;,&quot;y1&quot;:&quot;11139&quot;,&quot;x2&quot;:&quot;13364&quot;,&quot;y2&quot;:&quot;11139&quot;,&quot;stroke&quot;:&quot;#CAD8E6&quot;,&quot;stroke-width&quot;:&quot;1&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="259" as="sourcePoint"/><mxPoint x="694" y="259" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_5262" parent="v15_5253" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;Director 自己决定 talk_or_not，不是每轮都必须先说&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="5820" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;12696&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="12696" sourceBaselineY="11172" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="5819"><mxGeometry x="26" y="267" width="1050" height="30" as="geometry"/></mxCell><mxCell id="v15_5263" parent="v15_5253" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;“好的我来帮你”。简单状态查询和单次车控可以拿到结果&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="5821" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;12696&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="12696" sourceBaselineY="11206" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="5819"><mxGeometry x="26" y="301" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_5264" parent="v15_5253" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;后简短确认；等待较长时可自然说明正在处理，但不能提前&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="5822" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;12696&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="12696" sourceBaselineY="11240" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="5819"><mxGeometry x="26" y="335" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_5265" parent="v15_5253" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;宣称成功。打断恢复也不是逐字补完：无意义尾音、用户不&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="5823" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;12696&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="12696" sourceBaselineY="11274" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="5819"><mxGeometry x="26" y="369" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_5266" parent="v15_5253" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;想听或仅操作确认可跳过，相关问题合并回答，长内容提炼&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="5824" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;12696&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="12696" sourceBaselineY="11308" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="5819"><mxGeometry x="26" y="403" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_5267" parent="v15_5253" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&