"v15_3973" parent="v15_3961" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;多个子动作要区分已完成和失败项，状态名以正式协议为准&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4153" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;5656&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="5656" sourceBaselineY="5164" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4149"><mxGeometry x="26" y="369" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_3974" parent="v15_3961" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;。此结果既用于统一播报或界面，也用于本地历史同步；否&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4154" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;5656&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="5656" sourceBaselineY="5198" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4149"><mxGeometry x="26" y="403" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_3975" parent="v15_3961" v