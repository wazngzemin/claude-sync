quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7208" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;316&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="316" sourceBaselineY="23358" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7207"><mxGeometry x="26" y="233" width="900" height="30" as="geometry"/></mxCell><mxCell id="v15_6348" parent="v15_6339" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;里闷，空调已开、正在下雨、后排有宝宝，会改变合适的动&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7209" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;316&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="316" sourceBaselineY="23392" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7207"><mxGeometry x="26" y="267" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_6349" parent="v15_6339" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;作组合。数据中心提供事实，Director 作本轮业务决策，&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7210" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;316&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="316" sourceBaselineY="23426" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7207"><mxGeometry x="26" y="301" width="900" height="30" as="geometry"/></mxCell><mxCell id="v15_6350" parent="v15_6339" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;两者不要合并成同一职责。若关键事实没进上下文，应先排&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7211" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;316&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="316" sourceBaselineY="23460" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7207"><mxGeometry x="26" y="335" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_6351" parent="v15_6339" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;查供给与选择，不要直接归咎模型能力。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSiz