" sourceAttributes="{&quot;x&quot;:&quot;7260&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="7260" sourceBaselineY="39663" sourceFontSize="23" sourceFontWeight="400" sourceTextIndex="9849"><mxGeometry x="30" y="73" width="496.8" height="27.6" as="geometry"/></mxCell><mxCell id="v15_8379" parent="v15_8375" value="" style="shape=rectangle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F4F8FE;strokeColor=#C3D2E5;strokeWidth=2;" sourceIndex="9851" sourceTag="rect" sourceAttributes="{&quot;x&quot;:&quot;7260&quot;,&quot;y&quot;:&quot;39727&quot;,&quot;width&quot;:&quot;2700&quot;,&quot;height&quot;:&quot;111&quot;,&quot;rx&quot;:&quot;7&quot;,&quot;fill&quot;:&quot;#F4F8FE&quot;,&quot;stroke&quot;:&quot;#C3D2E5&quot;,&quot;stroke-width&quot;:&quot;2&quot;}" vertex="1"><mxGeometry x="30" y="160" width="2700" height="111" as="geometry"/></mxCell><mxCell id="v15_8380" parent="v15_8375" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:21px;font-weight:600;line-height:1;white-space:pre;&quot;&gt;接收什么&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=21;fontColor=#62758A;fontStyle=1;fontWeight=600;labelPadding=0;" sourceIndex="9853" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;7285&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="7285" sourceBaselineY="39760" sourceFontSize="21" sourceFontWeight="600" sourceTextIndex="9852"><mxGeometry x="55" y="172" width="100.8" height="25.2" as="geometry"/></mxCell><mxCell id="v15_8381" parent="v15_8375" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;需要查谁的什么记忆，给具体姓名和必要关键词/时间；例如合法范围内查询昨天去的地点。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="9855" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;7285&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="7285" sourceBaselineY="39799" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="9854"><mxGeometry x="55" y="207" width="1230" height="30" as="geometry"/></mxCell><mxCell id="v15_8382" parent="v15_8375" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#627E9F;strokeWidth=3;dashed=0;html=0;" sourceIndex="9856" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;8610&quot;,&quot;y1&quot;:&quot;39838&quot;,&quot;x2&quot;:&quot;8610&quot;,&quot;y2&quot;:&quot;39878&quot;,&quot;stroke&quot;:&quot;#627E9F&quot;,&quot;stroke-width&quot;:&quot;3&quot;,&quot;marker-end&quot;:&quot;url(#arr-627E9F)&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1380" y="271" as="sourcePoint"/><mxPoint x="1380" y="311" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_8383" parent="v15_8375" value="" style="shape=triangle;direction=east;rotation=90;fillColor=#627E9F;strokeColor=none;strokeWidth=0;resizable=1;" sourceIndex="9856" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;8610&quot;,&quot;y1&quot;:&quot;39838&quot;,&quot;x2&quot;:&quot;8610&quot;,&quot;y2&quot;:&quot;39878&quot;,&quot;stroke&quot;:&quot;#627E9F&quot;,&quot;stroke-width&quot;:&quot;3&quot;,&quot;marker-end&quot;:&quot;url(#arr-627E9F)&quot;}" vertex="1" sourceMarker="true"><mxGeometry x="1369.5" y="294.5" width="21" height="18" as="geometry"/></mxCell><mxCell id="v15_8384" parent="v15_8375" value="" style="shape=rectangle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F4F8FE;strokeColor=#C3D2E5;strokeWidth=2;" sourceIndex="9857" sourceTag="rect" sourceAttributes="{&quot;x&quot;:&quot;7260&quot;,&quot;y&quot;:&quot;39884&quot;,&quot;width&quot;:&quot;2700&quot;,&quot;height&quot;:&quot;111&quot;,&quot;rx&quot;:&quot;7&quot;,&quot;fill&quot;:&quot;#F4F8FE&quot;,&quot;stroke&quot;:&quot;#C3D2E5&quot;,&quot;stroke-width&quot;:&quot;2&quot;}" vertex="1"><mxGeometry x="30" y="317" width="2700" height="111" as="geometry"/></mxCell><mxCell id="v15_8385" parent="v15_8375" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:21px;font-weight:600;line-height:1;white-space:pre;&quot;&gt;内部处理／能力边界&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=21;fontColor=#62758A;fontStyle=1;fontWeight=600;labelPadding=0;" sourceIndex="9859" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;7285&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="7285" sourceBaselineY="39917" sourceFontSize="21" sourceFontWeight="600" sourceTextIndex="9858"><mxGeometry x="55" y="329" width="226.8" height="25.2" as="geometry"/></mxCell><mxCell id="v15_8386" parent="v15_8375" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;先核FaceID与账号/在场人范围，再检索候选并按相关性过滤。它是Context预取之外的显式补查路线，不是每轮必调；结果经feedback回Director，不能由检索层直接执行导航。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="9861" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;7285&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="7285" sourceBaselineY="39956" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="9860"><mxGeometry x="55" y="364" width="2790" height="30" as="geometry"/></mxCell><mxCell id="v15_8387" parent="v15_8375" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#627E9F;strokeWidth=3;dashed=0;html=0;" sourceIndex="9862" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;8610&quot;,&quot;y1&quot;:&quot;39995&quot;,&quot;x2&quot;:&quot;8610&quot;,&quot;y2&quot;:&quot;40035&quot;,&quot;stroke&quot;:&quot;#627E9F&quot;,&quot;stroke-width&quot;:&quot;3&quot;,&quot;marker-end&quot;:&quot;url(#arr-627E9F)&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1380" y="428" as="sourcePoint"/><mxPoint x="1380" y="468" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_8388" parent="v15_8375" value="" style="shape=triangle;direction=east;rotation=90;fillColor=#627E9F;strokeColor=none;strokeWidth=0;resizable=1;" sourceIndex="9862" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;8610&quot;,&quot;y1&quot;:&quot;39995&quot;,&quot;x2&quot;:&quot;8610&quot;,&quot;y2&quot;:&quot;40035&quot;,&quot;stroke&quot;:&quot;#627E9F&quot;,&quot;stroke-width&quot;:&quot;3&quot;,&quot;marker-end&quot;:&quot;url(#arr-627E9F)&quot;}" vertex="1" sourceMarker="true"><mxGeometry x="1369.5" y="451.5" width="21" height="18" as="geometry"/></mxCell><mxCell id="v15_8389" parent="v15_8375" value="" style="shape=rectangle;rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#EFF8F4;strokeColor=#C3D2E5;strokeWidth=2;" sourceIndex="9863" sourceTag="rect" sourceAttributes="{&quot;x&quot;:&quot;7260&quot;,&quot;y&quot;:&quot;40041&quot;,&quot;width&quot;:&quot;2700&quot;,&quot;height&quot;:&quot;111&quot;,&quot;rx&quot;:&quot;7&quot;,&quot;fill&quot;:&quot;#EFF8F4&quot;,&quot;stroke&quot;:&quot;#C3D2E5&quot;,&quot;stroke-width&quot;:&quot;2&quot;}" vertex="1"><mxGeometry x="30" y="474" width="2700" height="111" as="geometry"/></mxCell><mxCell id="v15_8390" parent="v15_8375" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:21px;font-weight:600;line-height:1;white-space:pre;&quot;&gt;交回什么结果&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=21;fontColor=#62758A;fontStyle=1;fontWeight=600;labelPadding=0;" sourceIndex="9865" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;7285&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="7285" sourceBaselineY="40074" sourceFontSize="21" sourceFontWeight="600" sourceTextIndex="9864"><mxGeometry x="55" y="486" width="151.2" height="25.2" as="geometry"/></mxCell><mxCell id="v15_8391" parent="v15_8375" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;已识别人时返回具体记忆或明确没查到；身份未知不能查私人记忆。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;f