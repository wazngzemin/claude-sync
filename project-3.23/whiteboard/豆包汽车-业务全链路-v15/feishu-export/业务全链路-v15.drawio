" sourceBaselineY="15200" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="6169"><mxGeometry x="26" y="205" width="390" height="30" as="geometry"/></mxCell><mxCell id="v15_5539" parent="v15_5531" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="6174" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;5656&quot;,&quot;y1&quot;:&quot;15229&quot;,&quot;x2&quot;:&quot;6324&quot;,&quot;y2&quot;:&quot;15229&quot;,&quot;stroke&quot;:&quot;#CAD8E6&quot;,&quot;stroke-width&quot;:&quot;1&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="259" as="sourcePoint"/><mxPoint x="694" y="259" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_5540" parent="v15_5531" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;工具可见只是模型知道有此能力，当前用户是否有权使用、&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="6176" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;5656&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="5656" sourceBaselineY="15262" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="6175"><mxGeometry x="26" y="267" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_5541" parent="v15_5531" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;车辆状态是否允许，还要在调用前校验。比如修改账号、操&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="6177" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;5656&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="5656" sourceBaselineY="15296" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="6175"><mxGeometry x="26" y="301" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_5542" parent="v15_5531" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;作某些车辆功能需要角色与项目策略，不能由模型自己推断&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="6178" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;5656&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="5656" sourceBaselineY="15330" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="6175"><mxGeometry x="26" y="335" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_5543" parent="v15_5531" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;一个“应该允许”。权限从可信账号链路取得；设备没有、&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="6179" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;5656&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="5656" sourceBaselineY="15364" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="6175"><mxGeometry x="26" y="369" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_5544" parent="v15_5531" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;语音不支持和当前不满足执行条件要分开。被拒绝时给出真&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="6180" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;5656&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="5656" sourceBaselineY="15398" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="6175"><mxGeometry x="26" y="403" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_5545" parent="v15_5531" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;实原因，方便 Director 解释或提供安全的手动替代。&lt;/s