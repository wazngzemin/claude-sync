text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="7816" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;7356&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="7356" sourceBaselineY="24272" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="7814"><mxGeometry x="26" y="137" width="480" height="30" as="geometry"/></mxCell><mxCell id="v15_6816" parent="v15_6810" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;触发成功不代表已提醒或已控车&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="7817" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;7356&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="7356" sourceBaselineY="24306" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="7814"><mxGeometry x="26" y="171" width="420" height="30" as="geometry"/></mxCell><mxCell id="v15_6817" parent="v15_6810" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="7818" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;7356&quot;,&quot;y1&quot;:&quot;24335&quot;,&quot;x2&quot;:&quot;8024&quot;,&quot;y2&quot;:&quot;24335&quot;,&quot;stroke&quot;:&quot;#CAD8E6&quot;,&quot;stroke-width&quot;:&quot;1&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="225" as="sourcePoint"/><mxPoint x="694" y="225" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_6818" parent="v15_6810" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;用户创建的定时、条件任务命中后，触发器回调原任务系统&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7820" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;7356&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="7356" sourceBaselineY="24368" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7819"><mxGeometry x="26" y="233" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_6819" parent="v15_6810" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;，由其检查有效性并继续推进。例如“宝宝哭了告诉我”的&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7821" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;7356&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="7356" sourceBaselineY="24402" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7819"><mxGeometry x="26" y="267" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_6820" parent="v15_6810" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;条件命中，只能证明观察目标达成；任务系统还要把提醒建&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7822" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;7356&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="7356" sourceBaselineY="24436" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7819"><mxGeometry x="26" y="301" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_6821" parent="v15_6810" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;议交回 Director，经输入管理安排交互。触发器不直接把&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7823" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;7356&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="7356" sourceBaselineY="24470" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7819"><mxGeometry x="26" y="335" width="900" height="30" as="geometry"/></mxCell><mxCell id="v15_6822" parent="v15_6810" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;整条任务标为完成，也不替代工具实际执行结果。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7824" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;7356&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="7356" sourceBaselineY="24504" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7819"><mxGeometry x="26" y="369" width="660" height="30" as="geometry"/></mxCell><mxCell id="v15_6823" parent="v15_6810" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:18px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;交出 → T07&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=18;fontColor=#2463C5;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7826" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;7356&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="7356" sourceBaseline