<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" modified="2026-09-03T00:00:00.000Z" agent="Codex" version="26.0.0"><diagram id="driver-agent-v07" name="02-05 详细链路"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="m1_cluster_26" value="07｜工具结果回流、目标完成与用户输出" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1048.5" y="1498.0" width="873.0" height="919.5" as="geometry"/></mxCell><mxCell id="m1_cluster_77" value="06｜工具节点、能力服务与真实执行" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="3618.3" y="919.5" width="444.0" height="859.5" as="geometry"/></mxCell><mxCell id="m1_cluster_108" value="05｜决策结果校验与执行调度【闭环必需，统一服务归属待验真】" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="3052.8" y="551.6" width="444.0" height="859.5" as="geometry"/></mxCell><mxCell id="m1_cluster_143" value="04｜对话推理中枢（Planner 与 Director 同一模块）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2493.0" y="876.4" width="444.0" height="954.8" as="geometry"/></mxCell><mxCell id="m1_cluster_178" value="03｜四类输入与本轮事实快照" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2154.0" y="953.7" width="229.5" height="800.2" as="geometry"/></mxCell><mxCell id="m1_cluster_203" value="02｜云网关、登录与真实分流顺序" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1003.5" y="6.0" width="963.0" height="1469.5" as="geometry"/></mxCell><mxCell id="m1_cluster_264" value="01｜用户与车端语音入口" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="235.5" y="338.0" width="658.5" height="805.5" as="geometry"/></mxCell><mxCell id="m1_node_0" value="形成工具执行反馈&lt;br&gt;它是新的输入事件，不是原模型推理里的隐藏返回值" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1286.2" y="1526.2" width="192.0" height="75.0" as="geometry"/></mxCell><mxCell id="m1_node_1" value="写回历史、任务、动作、端状态、目标进度和已呈现内容" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1286.2" y="1657.4" width="192.0" height="75.0" as="geometry"/></mxCell><mxCell id="m1_node_2" value="用户完整目标真正完成？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1382.2" y="1703.2" width="171.0" height="171.0" as="geometry"/></mxCell><mxCell id="m1_node_3" value="继续调用｜换工具｜补槽｜追问&lt;br&gt;等待条件｜降级｜取消" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1067.2" y="2033.9" width="192.0" height="75.0" as="geometry"/></mxCell><mxCell id="m1_node_4" value="完成条件&lt;br&gt;所有必要子目标有证据&lt;br&gt;无必需待办、无待等条件" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1398.0" y="2033.9" width="174.0" height="75.0" as="geometry"/></mxCell><mxCell id="m1_node_5" value="语音：回复→语音合成→扬声器" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1067.2" y="2165.2" width="192.0" height="57.0" as="geometry"/></mxCell><mxCell id="m1_node_6" value="界面：回复/进度→即时卡、智能条、任务中心" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1281.8" y="2165.2" width="192.0" height="57.0" as="geometry"/></mxCell><mxCell id="m1_node_7" value="形象：表情/动作→圆屏、云台、口型" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1496.2" y="2165.2" width="192.0" height="57.0" as="geometry"/></mxCell><mxCell id="m1_node_8" value="实体：工具→协议→车辆/应用/外部服务真实生效" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1710.8" y="2165.2" width="192.0" height="57.0" as="geometry"/></mxCell><mxCell id="m1_node_9" value="用户最终感知&lt;br&gt;听到、看到、车辆/服务真的发生&lt;br&gt;三者一致，不能只靠一句‘搞定’" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1491.8" y="2278.4" width="192.0" height="111.0" as="geometry"/></mxCell><mxCell id="m1_node_10" value="工具节点接收一次调用" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0E8;strokeColor=#E27B45;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3652.0" y="947.7" width="162.0" height="42.0" as="geometry"/></mxCell><mxCell id="m1_node_11" value="执行服务按能力目录路由&lt;br&gt;豆包能力｜车端能力｜生态能力｜对话服务能力" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0E8;strokeColor=#E27B45;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3637.0" y="1042.9" width="192.0" height="75.0" as="geometry"/></mxCell><mxCell id="m1_node_12" value="协议适配与真实执行器&lt;br&gt;车控、导航、媒体、系统界面、联网、生成、身份记忆、交易" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0E8;strokeColor=#E27B45;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3637.0" y="1174.2" width="192.0" height="93.0" as="geometry"/></mxCell><mxCell id="m1_node_13" value="原始结果&lt;br&gt;受理、端侧指令、外部结果/产物、错误" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0E8;strokeColor=#E27B45;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3637.0" y="1323.4" width="192.0" height="75.0" as="geometry"/></mxCell><mxCell id="m1_node_14" value="真实状态回读【逐工具验真】&lt;br&gt;设备最终值、导航阶段、实际播放、订单终态、生成产物" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3637.0" y="1454.7" width="192.0" height="111.0" as="geometry"/></mxCell><mxCell id="m1_node_15" value="结果格式统一【统一实现需验真】&lt;br&gt;成功｜失败｜部分成功｜超时｜取消｜需补信息&lt;br&gt;错误、可否重试、真实状态、产物、已自播内容" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3637.0" y="1621.9" width="192.0" height="129.0" as="geometry"/></mxCell><mxCell id="m1_node_16" value="四层成功语义&lt;br&gt;被接收 ≠ 服务调用成功 ≠ 真实生效 ≠ 用户完整目标完成" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="3851.5" y="1648.9" width="192.0" height="75.0" as="geometry"/></mxCell><mxCell id="m1_node_17" value="字段与结构校验&lt;br&gt;四个输出、必填参数、枚举、类型、工具白名单" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF4D9;strokeColor=#D8A93D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3178.8" y="579.7" width="192.0" height="75.0" as="geometry"/></mxCell><mxCell id="m1_node_18" value="能力与安全门禁&lt;br&gt;车型/版本、座位、权限、档位、车速、运行设计域、确认" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF4D9;strokeColor=#D8A93D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3085.0" y="711.0" width="192.0" height="93.0" as="geometry"/></mxCell><mxCell id="m1_node_19" value="依赖与并发&lt;br&gt;独立动作可并行；依赖动作等上一结果后下一轮再做" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF4D9;strokeColor=#D8A93D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3071.5" y="887.2" width="192.0" height="75.0" as="geometry"/></mxCell><mxCell id="m1_node_20" value="幂等与竞态&lt;br&gt;请求/轮次/动作关联、去重、端云唯一执行、迟到保护" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF4D9;strokeColor=#D8A93D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3071.5" y="1027.5" width="192.0" height="93.0" as="geometry"/></mxCell><mxCell id="m1_node_21" value="调用生命周期&lt;br&gt;下发、运行、超时、重试、取消、部分成功、结果聚合" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF4D9;strokeColor=#D8A93D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3071.5" y="1176.7" width="192.0" height="75.0" as="geometry"/></mxCell><mxCell id="m1_node_22" value="可执行工具调用&lt;br&gt;工具、参数、作用对象、关联编号、回传地址" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF4D9;strokeColor=#D8A93D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3071.5" y="1308.0" width="192.0" height="75.0" as="geometry"/></mxCell><mxCell id="m1_node_23" value="门禁失败也必须形成结果&lt;br&gt;缺参数、能力不可用、未授权、安全拦截&lt;br&gt;回规划器追问、降级或拒绝" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="3286.0" y="878.2" width="192.0" height="93.0" as="geometry"/></mxCell><mxCell id="m1_node_24" value="输入&lt;br&gt;固定规则包+本轮四类输入之一+事实快照" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F1EAFE;strokeColor=#8B6CD9;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2511.8" y="904.5" width="192.0" height="75.0" as="geometry"/></mxCell><mxCell id="m1_node_25" value="理解&lt;br&gt;谁在说、指什么、完整目标、多个子目标" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F1EAFE;strokeColor=#8B6CD9;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2511.8" y="1035.8" width="192.0" height="75.0" as="geometry"/></mxCell><mxCell id="m1_node_26" value="判断未知&lt;br&gt;已有事实｜可以查询｜必须追问｜不能做" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F1EAFE;strokeColor=#8B6CD9;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2511.8" y="1167.0" width="192.0" height="75.0" as="geometry"/></mxCell><mxCell id="m1_node_27" value="任务分类&lt;br&gt;单步｜并行动作｜多步依赖｜定时/条件｜持续" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F1EAFE;strokeColor=#8B6CD9;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2511.8" y="1298.3" width="192.0" height="75.0" as="geometry"/></mxCell><mxCell id="m1_node_28" value="计划&lt;br&gt;拆动作、识别依赖、选工具/任务代理、填参数" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F1EAFE;strokeColor=#8B6CD9;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2511.8" y="1429.5" width="192.0" height="75.0" as="geometry"/></mxCell><mxCell id="m1_node_29" value="表达与下一轮&lt;br&gt;先回应、追问、进度、最终&lt;br&gt;继续、改计划、等待、结束" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F1EAFE;strokeColor=#8B6CD9;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2514.8" y="1560.8" width="186.0" height="75.0" as="geometry"/></mxCell><mxCell id="m1_node_30" value="本轮输出【当前协议】&lt;br&gt;是否说话｜回复内容｜形象动作｜动作清单&lt;br&gt;动作：动作编号、工具、参数" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F1EAFE;strokeColor=#8B6CD9;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2511.8" y="1692.0" width="192.0" height="111.0" as="geometry"/></mxCell><mxCell id="m1_node_31" value="模型风险&lt;br&gt;非法格式、漏/多动作、错工具、错参数、错误依赖&lt;br&gt;车控幻觉、说做不一、提前承诺" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="2726.2" y="1692.0" width="192.0" height="111.0" as="geometry"/></mxCell><mxCell id="m1_node_32" value="四类输入【当前协议】&lt;br&gt;用户请求｜顾问建议｜工具执行反馈｜系统事件" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E9F8F0;strokeColor=#51A878;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2172.8" y="981.8" width="192.0" height="75.0" as="geometry"/></mxCell><mxCell id="m1_node_33" value="输入冲突与排队【统一实现需验真】&lt;br&gt;类型、优先级、打断、合并、排队、过期丢弃&lt;br&gt;用户请求优先；主动建议/语音合成（TTS）相关仍有兼容旁路" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E9F8F0;strokeColor=#51A878;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2172.8" y="1113.0" width="192.0" height="147.0" as="geometry"/></mxCell><mxCell id="m1_node_34" value="身份与权限视图&lt;br&gt;账号、人脸、说话人、座位、车辆、会话&lt;br&gt;身份不等于授权；不确定保持未知" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E9F8F0;strokeColor=#51A878;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2172.8" y="1316.3" width="192.0" height="111.0" as="geometry"/></mxCell><mxCell id="m1_node_35" value="上下文选择&lt;br&gt;归属→新鲜度→相关性→冲突裁决→压缩" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E9F8F0;strokeColor=#51A878;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2172.8" y="1483.5" width="192.0" height="75.0" as="geometry"/></mxCell><mxCell id="m1_node_36" value="本轮最小充分事实快照&lt;br&gt;当前输入、端状态、情境、历史、记忆、目标/任务&lt;br&gt;工具能力、参考知识、最新结果" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E9F8F0;strokeColor=#51A878;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2172.8" y="1614.8" width="192.0" height="111.0" as="geometry"/></mxCell><mxCell id="m1_node_37" value="车企协议→统一对话请求" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1119.0" y="34.1" width="174.0" height="42.0" as="geometry"/></mxCell><mxCell id="m1_node_38" value="登录/身份通过？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF4D9;strokeColor=#D8A93D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1206.0" y="64.7" width="129.3" height="129.3" as="geometry"/></mxCell><mxCell id="m1_node_39" value="认证提示并结束" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="1034.2" y="386.9" width="126.0" height="42.0" as="geometry"/></mxCell><mxCell id="m1_node_40" value="指定专用执行模块？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF4D9;strokeColor=#D8A93D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1285.5" y="259.4" width="147.0" height="147.0" as="geometry"/></mxCell><mxCell id="m1_node_41" value="按注册能力直接路由" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0E8;strokeColor=#E27B45;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1107.8" y="620.2" width="150.0" height="42.0" as="geometry"/></mxCell><mxCell id="m1_node_42" value="句法规则命中明确快路？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF4D9;strokeColor=#D8A93D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1451.2" y="468.7" width="171.0" height="171.0" as="geometry"/></mxCell><mxCell id="m1_node_43" value="简单流程/工具快路&lt;br&gt;高置信、明确、低风险" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0E8;strokeColor=#E27B45;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1196.2" y="1363.4" width="162.0" height="57.0" as="geometry"/></mxCell><mxCell id="m1_node_44" value="准备阶段并行预取&lt;br&gt;上下文、历史、目标、知识、工具能力&lt;br&gt;同时预启动决策规划器降低等待" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF4D9;strokeColor=#D8A93D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1449.0" y="799.4" width="192.0" height="111.0" as="geometry"/></mxCell><mxCell id="m1_node_45" value="意图与拒识并行判断" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF4D9;strokeColor=#D8A93D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1470.0" y="966.7" width="150.0" height="42.0" as="geometry"/></mxCell><mxCell id="m1_node_46" value="推荐结果回流" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF4D9;strokeColor=#D8A93D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1488.0" y="1079.9" width="114.0" height="42.0" as="geometry"/></mxCell><mxCell id="m1_node_47" value="最终仲裁" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF4D9;strokeColor=#D8A93D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1545.0" y="1131.7" width="87.0" height="87.0" as="geometry"/></mxCell><mxCell id="m1_node_48" value="拒识/忽略/仅记录事件&lt;br&gt;给出原因、追问/降级、误拒识监控" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="1380.8" y="1354.4" width="192.0" height="75.0" as="geometry"/></mxCell><mxCell id="m1_node_49" value="进入对话推理中枢" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F1EAFE;strokeColor=#8B6CD9;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1595.2" y="1372.4" width="138.0" height="42.0" as="geometry"/></mxCell><mxCell id="m1_node_50" value="端云唯一裁决【风险】&lt;br&gt;同一请求一轮只采纳一个执行结果&lt;br&gt;快路命中后拒绝迟到云结果，禁止双执行" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="1755.8" y="1336.4" width="192.0" height="111.0" as="geometry"/></mxCell><mxCell id="m1_node_51" value="用户发声&lt;br&gt;原始声音、说话人候选、座位/声区" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="361.5" y="366.1" width="192.0" height="75.0" as="geometry"/></mxCell><mxCell id="m1_node_52" value="麦克风与唤醒门【链路待验真】&lt;br&gt;权限、唤醒/免唤醒、会话状态" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="361.5" y="497.4" width="192.0" height="93.0" as="geometry"/></mxCell><mxCell id="m1_node_53" value="声学前处理【需语音链路验真】&lt;br&gt;回声消除、降噪、波束定位" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="304.1" y="646.6" width="192.0" height="75.0" as="geometry"/></mxCell><mxCell id="m1_node_54" value="人声起止与打断&lt;br&gt;起点、终点、插话、尾噪" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="313.1" y="777.9" width="174.0" height="57.0" as="geometry"/></mxCell><mxCell id="m1_node_55" value="语音转文字&lt;br&gt;当前确认最终文字；在线增量/离线来源按链路验真" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="254.2" y="891.1" width="192.0" height="75.0" as="geometry"/></mxCell><mxCell id="m1_node_56" value="当前用户请求字段【已确认】&lt;br&gt;文字、说话人、座位、时间" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="254.2" y="1031.4" width="192.0" height="75.0" as="geometry"/></mxCell><mxCell id="m1_node_57" value="异常&lt;br&gt;无权限、未唤醒、早截断、尾噪、否定词丢失、多说话人冲突" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="468.8" y="1022.4" width="192.0" height="93.0" as="geometry"/></mxCell><mxCell id="m1_node_58" value="建议补充的工程包络【非当前提示词字段】&lt;br&gt;请求编号、会话编号、识别来源、置信度" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="683.2" y="1022.4" width="192.0" height="93.0" as="geometry"/></mxCell><mxCell id="m1_node_59" value="豆包汽车｜语音用户请求到真实结果的完整主链&lt;br&gt;粗实线只看主流程；虚线看异常和下一轮回流｜2026-09-03 资料基线" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;ali