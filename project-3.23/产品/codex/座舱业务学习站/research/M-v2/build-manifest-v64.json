  "h3": 45,
  "headings": [
    {
      "id": "m64-heading-01",
      "level": 2,
      "title": "开篇、车里只有一个豆包"
    },
    {
      "id": "m64-heading-02",
      "level": 3,
      "title": "好几路话一起到，先要决定这一轮接住哪些"
    },
    {
      "id": "m64-heading-03",
      "level": 3,
      "title": "把顺序管住以后，还要让 Planner 选对要说的内容"
    },
    {
      "id": "m64-heading-04",
      "level": 2,
      "title": "一、为什么要单独一层输入管理"
    },
    {
      "id": "m64-heading-05",
      "level": 3,
      "title": "各处都能叫 Planner，局部合理也会拼出一段乱话"
    },
    {
      "id": "m64-heading-06",
      "level": 3,
      "title": "一条交互流要统一生效顺序，也要保住已经发生的事"
    },
    {
      "id": "m64-heading-07",
      "level": 3,
      "title": "输入管理决定交接顺序，理解任务仍交给 Planner"
    },
    {
      "id": "m64-heading-08",
      "level": 2,
      "title": "二、四路输入先报上名来"
    },
    {
      "id": "m64-heading-09",
      "level": 3,
      "title": "接入适配层先把不同消息整理成同一种输入"
    },
    {
      "id": "m64-heading-10",
      "level": 3,
      "title": "判重复要认这一次，不能只认这句话或这个建议方"
    },
    {
      "id": "m64-heading-11",
      "level": 3,
      "title": "播完和车上办完，要直接通知调度往下走"
    },
    {
      "id": "m64-heading-12",
      "level": 2,
      "title": "三、看对话现在在干什么"
    },
    {
      "id": "m64-heading-13",
      "level": 3,
      "title": "云端三态决定怎样调度，车机状态告诉用户正在做什么"
    },
    {
      "id": "m64-heading-14",
      "level": 3,
      "title": "处理中还要多问一句：工具已经获准执行了吗"
    },
    {
      "id": "m64-heading-15",
      "level": 3,
      "title": "一条输入结束了，这段对话仍然可以继续"
    },
    {
      "id": "m64-heading-16",
      "level": 2,
      "title": "四、谁先进 Planner：准入"
    },
    {
      "id": "m64-heading-17",
      "level": 3,
      "title": "先看当前这一轮，再决定新输入怎么进"
    },
    {
      "id": "m64-heading-18",
      "level": 3,
      "title": "建议可以一起处理，忙的时候仍要等"
    },
    {
      "id": "m64-heading-19",
      "level": 3,
      "title": "每次提醒先留下来，晚了是否还说再判断"
    },
    {
      "id": "m64-heading-20",
      "level": 2,
      "title": "五、动作发出去了，旧话就不能重来"
    },
    {
      "id": "m64-heading-21",
      "level": 3,
      "title": "合并旧话之前，先过工具和起播两道门"
    },
    {
      "id": "m64-heading-22",
      "level": 3,
      "title": "放行、登记和禁止重放，要一起生效"
    },
    {
      "id": "m64-heading-23",
      "level": 3,
      "title": "停掉旧推理以后，已经发生的动作仍要留下来"
    },
    {
      "id": "m64-heading-24",
      "level": 2,
      "title": "六、这一轮交给 Planner 的是什么"
    },
    {
      "id": "m64-heading-25",
      "level": 3,
      "title": "一起交进去，每条话仍然保留自己的来历"
    },
    {
      "id": "m64-heading-26",
      "level": 3,
      "title": "多人各自准入，组装时再把他们放在一起"
    },
    {
      "id": "m64-heading-27",
      "level": 3,
      "title": "中断上下文交代刚才发生了什么，不重新交办旧事"
    },
    {
      "id": "m64-heading-28",
      "level": 3,
      "title": "工具结果单独排队，已进入当前续轮的结果随补话保留"
    },
    {
      "id": "m64-heading-29",
      "level": 3,
      "title": "混在一批里的建议，不会因此变成用户授权"
    },
    {
      "id": "m64-heading-30",
      "level": 2,
      "title": "七、谁的话能放出去：执行身份与许可"
    },
    {
      "id": "m64-heading-31",
      "level": 3,
      "title": "每次推理领一个身份，晚到的结果才找得到归属"
    },
    {
      "id": "m64-heading-32",
      "level": 3,
      "title": "下一轮可以先算，发出去还要再拿一次许可"
    },
    {
      "id": "m64-heading-33",
      "level": 3,
      "title": "拦住失效执行的新输出，留下已经发生的工具结果"
    },
    {
      "id": "m64-heading-34",
      "level": 2,
      "title": "八、播完才算完"
    },
    {
      "id": "m64-heading-35",
      "level": 3,
      "title": "有语音等车上报播完，没有语音按各自的路径结束"
    },
    {
      "id": "m64-heading-36",
      "level": 3,
      "title": "收不到播完回执，先保留未知，再按超时解除阻塞"
    },
    {
      "id": "m64-heading-37",
      "level": 3,
      "title": "车上已经接手，只结束对应请求，保留其他等待输入"
    },
    {
      "id": "m64-heading-38",
      "level": 3,
      "title": "状态存不下来先停住，升级先让服务端接得住新回执"
    },
    {
      "id": "m64-heading-39",
      "level": 2,
      "title": "九、演进与灰度"
    },
    {
      "id": "m64-heading-40",
      "level": 3,
      "title": "多人合并先上线，统一调度由串话问题推动"
    },
    {
      "id": "m64-heading-41",
      "level": 3,
      "title": "规则的四次变化，都在区分准备、执行与真实完成"
    },
    {
      "id": "m64-heading-42",
      "level": 3,
      "title": "按车分批切换，避免新旧两套规则同时指挥"
    },
    {
      "id": "m64-heading-43",
      "level": 2,
      "title": "十、怎么评估、怎么排查"
    },
    {
      "id": "m64-heading-44",
      "level": 3,
      "title": "五项观测，要连着输入、发声和实际恢复一起看"
    },
    {
      "id": "m64-heading-45",
      "level": 3,
      "title": "沿八次交接往下查，找到最早发生偏差的位置"
    },
    {
      "id": "m64-heading-46",
      "level": 3,
      "title": "补播旧餐厅，先分清是谁又把它说了出来"
    },
    {
      "id": "m64-heading-47",
      "level": 3,
      "title": "主动招呼后接不上，先查用户的话有没有进入调度"
    },
    {
      "id": "m64-heading-48",
      "level": 3,
      "title": "BAB 要逐段追声音归属，真实旧结果与旧发声资格分开查"
    },
    {
      "id": "m64-heading-49",
      "level": 2,
      "title": "收尾、用找充电站，把这一章讲给别人听"
    },
    {
      "id": "m64-heading-50",
      "level": 3,
      "title": "三分钟口述稿：从几路输入到下一次开口"
    },
    {
      "id": "m64-heading-51",
      "level": 3,
      "title": "最容易讲错的地方"
    },
    {
      "id": "m64-heading-52",
      "level": 3,
      "title": "复述路线图：每一步都接着问，谁把什么交给下一步"
    },
    {
      "id": "m64-heading-53",
      "level": 2,
      "title": "附一　术语表"
    },
    {
      "id": "m64-heading-54",
      "level": 3,
      "title": "查输入与调度：先找到这条内容为什么进入这一轮"
    },
    {
      "id": "m64-heading-55",
      "level": 3,
      "title": "查执行与结束：把已经算好、已经做过、已经听完分开"
    },
    {
      "id": "m64-heading-56",
      "level": 2,
      "title": "附二　历史版本与关键数字"
    },
    {
      "id": "m64-heading-57",
      "level": 3,
      "title": "旧数字各管一层，查问题先认清它属于哪个时期"
    },
    {
      "id": "m64-heading-58",
      "level": 3,
      "title": "把功能发版与方案修订分开记，才能选对复测范围"
    },
    {
      "id": "m64-heading-59",
      "level": 3,
      "title": "协议名只用于对上同一件事，编号本身不授予执行资格"
    }
  ],
