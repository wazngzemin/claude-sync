ourceIndex="7562" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;3836&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="3836" sourceBaselineY="25446" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7560"><mxGeometry x="26" y="301" width="990" height="30" as="geometry"/></mxCell><mxCell id="v15_6619" parent="v15_6608" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;和动效属于两条并行消息，可独立成功或失败。10/15会议&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7563" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;3836&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="3836" sourceBaselineY="25480" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7560"><mxGeometry x="26" y="335" width="840" height="30" as="geometry"/></mxCell><mxCell id="v15_6620" parent="v15_6608" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;仍说视觉条件真实链路未通、10/20只做Mock；10/21技术&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7564" so