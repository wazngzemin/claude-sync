;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="5835" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;11786&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="11786" sourceBaselineY="11076" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="5832"><mxGeometry x="26" y="171" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_5275" parent="v15_5268" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;动作去 E，语音/表情走呈现链&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="5836" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;11786&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="11786" sourceBaselineY="11110" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="5832"><mxGeometry x="26" y="205" width="450" height="30" as="geometry"/></mxCell><mxCell id="v15_5276" parent="v15_5268" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="5837" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;11786&quot;,&quot;y1&quot;:&quot;11139&quot;,&quot;x2&quot;:&quot;12454&quot;,&quot;y2&quot;:&quot;11139&q