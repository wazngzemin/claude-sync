nt-weight:400;line-height:1;white-space:pre;&quot;&gt;频控拦截”单独记录。具体间隔与优先级取已发布配置，不&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7806" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;7356&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="7356" sourceBaselineY="23460" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7802"><mxGeometry x="26" y="335" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_6809" parent="v15_6797" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;把早期文档的示例秒数当作所有项目统一规则。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7807" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;7356&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="7356" sourceBaselineY="23494" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7802"><mxGeometry x="26" y="369" width="630" height="30" as="geometry"/></mxCell><mxCell id="v15_6810" parent="1" value="" style="group;connectable=0;recursiveResize=0;collapsible=0;" sourceIndex="7808" sourceTag="g" sourceAttributes="{&quot;class&quot;:&quot;node&quot;,&quot;data-node&quot;:&quot;G07&quot;,&quot;role&quo