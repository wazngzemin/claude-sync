ight="600" sourceTextIndex="3634"><mxGeometry x="26" y="14" width="43.2" height="21.6" as="geometry"/></mxCell><mxCell id="v15_3568" parent="v15_3565" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:30px;font-weight:600;line-height:1;white-space:pre;&quot;&gt;一遍 ASR：边听边写出文字&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=30;fontColor=#163352;fontStyle=1;fontWeight=600;labelPadding=0;" sourceIndex="3637" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;316&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="316" sourceBaselineY="2826" sourceFontSize="30" sourceFontWeight="600" sourceTextIndex="3636"><mxGeometry x="26" y="46" width="504" height="36" as="geometry"/></mxCell><mxCell id="v15_3569" parent="v15_3565" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;ASR 负责把声音写成文字&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="3639" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;316&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="316" sourceBaselineY="2878" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="3638"><mxGeometry x="26" y="103" width="390" height="30" as="geometry"/></mxCell><mxCell id="v15_3570" parent="v15_3565" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;一边接收音频，一边返回识别&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="3640" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;316&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="316" sourceBaselineY="2912" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="3638"><mxGeometry x="26" y="137" width="390" height="30" as="geometry"/></mxCell><mxCell id="v15_3571" parent="v15_3565" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;先追求及时得到过程文字&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="3641" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;316&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="316" sourceBaselineY="2946" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="3638"><mxGeometry x="26" y="171" width="330" height="30" as="geometry"/></mxCell><mxCell id="v15_3572" parent="v15_3565" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;同时另一支 VAD 在观察停顿&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="3642" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;316&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="316" sourceBaselineY="2980" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="3638"><mxGeometry x="26" y="205" width="450" height="30" as="geometry"/></mxCell><mxCell id="v15_3573" parent="v15_3565" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="3643" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;316&quot;,&quot;y1&quot;:&quot;3009&quot;,&quot;x2&quot;:&quot;984&quot;,&quot;y2&quot;:&quot;3009&quot;,&quot;stroke&quot;:&quot;#CAD8E6&quot;,&quot;stroke-width&quot;:&quot;1&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="259" as="sourcePoint"/><mxPoint x="694" y="259" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_3574" parent="v15_3565" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;ASR 是语音识别，负责回答“刚才说了哪些字”。识别服务&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="3645" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;316&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="316" sourceBaselineY="3042" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="3644"><mxGeometry x="26" y="267" width="840" height="30" as="geometry"/></mxCell><mxCell id="v15_3575" parent="v15_3565" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;收到音频后，陆续返回当前结果，例如先有“去”，再有“&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="3646" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;316&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="316" sourceBaselineY="3076" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="3644"><mxGeometry x="26" y="301" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_3576" parent="v15_3565" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;去昨天那家游泳馆”。这叫一遍流式识别。它让系统能尽早&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="3647" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;316&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="316" sourceBaselineY="3110" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="3644"><mxGeometry x="26" y="335" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_3577" parent="v15_3565" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;做流式拒识和前置准备，但文字仍可能修正。这里不判断应&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="3648" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;316&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="316" sourceBaselineY="3144" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="3644"><mxGeometry x="26" y="369" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_3578" parent="v15_3565" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;该导航到哪里，也不等用户把整句话讲完才开始工作。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-sys