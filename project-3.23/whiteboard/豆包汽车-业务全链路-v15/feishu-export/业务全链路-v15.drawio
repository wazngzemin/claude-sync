mp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;有数据依赖：分轮执行&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="5796" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;12696&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="12696" sourceBaselineY="10032" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="5794"><mxGeometry x="26" y="137" width="300" height="30" as="geometry"/></mxCell><mxCell id="v15_5244" parent="v15_5238" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;导航互斥工具不可同轮争抢&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="5797" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;12696&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="12696" sourceBaselineY="10066" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="5794"><mxGeometry x="26" y="171" width="360" height="30" as="geometry"/></mxCell><mxCell id="v15_5245" parent="v15_5238" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;同轮顺序写在数组里不算串行&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="5798" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;12696&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="12696" sourceBaselineY="10100" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="5794"><mxGeometry x="26" y="205" width="390" height="30" as="geometry"/></mxCell><mxCell id="v15_5246" parent="v15_5238" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="5799" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;12696&quot;,&quot;y1&quot;:&quot;10129&quot;,&quot;x2&quot;:&quot;13364&quot;,&quot;y2&quot;:&quot;10129&quot;,&quot;stroke&quot;:&quot;#CAD8E6&quot;,&quot;stroke-width&quot;:&quot;1&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="259" as="sourcePoint"/><mxPoint x="694" y="259" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_5247" parent="v15_5238" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;模型生成的一个 action_list 默认同时下发，不能靠数组&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="5801" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;12696&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="12696" sourceBaselineY="10162" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="5800"><mxGeometry x="26" y="267" width="960" height="30" as="geometry"/></mxCell><mxCell id="v15_5248" parent="v15_5238" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;先后表示真实执行顺序。调空调和播歌可在资源允许时并行&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="5802" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;12696&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="12696" sourceBaselineY="10196" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="5800"><mxGeometry x="26" y="301" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_5249" parent="v15_5238" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;，先查歌名再播歌必须跨轮。导航规划、导航交互、部分基&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="5803" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;12696&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="12696" sourceBaselineY="10230" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="5800"><mxGeometry x="26" y="335" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_5250" parent="v15_5238" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;础控制互斥，即使没有数据依赖也不能一起改同一导航状态&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="5804" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;12696&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="12696" sourceBaselineY="10264" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="5800"><mxGeometry x="26" y="369" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_5251" parent="v15_5238" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;。评审要画清数据依赖和资源互斥两种原因，否则表面一步&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="5805" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;12696&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="12696" sourceBaselineY="10298" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="5800"><mxGeometry x="26" y="403" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_5252" parent="v15_5238" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;搞定，实际会发生结果覆盖和乱导航。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="5806" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;12696&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="12696" sourceBaselineY="10332" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="5800"><mxGeometry x="26" y="437" width="510" height="30" as="geometry"/></mxCell><mxCell id="v15_5253" parent="1" value="" style="group;connectable=0;recursiveResize=0;collapsible=0;" sourceIndex="5807" sourceTag="g" sourceAttributes="{&quot;class&quot;:&quot;node&quot;,&quot;data-node&quot;:&quot;D10&quot;,&quot;role&quot;:&quot;button&quot;,&quot;tabindex&quot;:&quot;0&quot;,&quot;aria-label&quot;:&quot;决定是否说话，避免空话与预承诺&quot;}" vertex="1" connectable="0"><mxGeometry x="12670" y="10880" width="720" height="780" as="geometry"/></mxCell><mxCell id="v15_5254" parent="v15_5253" value="" style="shape=rectangle;rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#F4F8FE;strokeColor=#ABC2E0;strokeWidth=2;" sourceIndex="5808" sourceTag="rect" sourceAttributes="{&quot;x&quot;: