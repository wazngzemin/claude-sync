  "removedComments": [],
  "headings": [
    {
      "id": "v58-heading-01",
      "level": 2,
      "title": "开篇　Planner 接到一句话之前，已经发生了什么"
    },
    {
      "id": "v58-heading-02",
      "level": 3,
      "title": "先沿着一段对话，分清每一步负责什么"
    },
    {
      "id": "v58-heading-03",
      "level": 3,
      "title": "Planner 接到的是请求，前后还各有一段接力"
    },
    {
      "id": "v58-heading-04",
      "level": 2,
      "title": "一、开口之前　豆包怎样知道该听"
    },
    {
      "id": "v58-heading-05",
      "level": 3,
      "title": "先看能不能用，再看用户怎样叫醒豆包"
    },
    {
      "id": "v58-heading-06",
      "level": 3,
      "title": "连续对话接住续说，全时聆听判断自然开口"
    },
    {
      "id": "v58-heading-07",
      "level": 3,
      "title": "屏幕出字和座位开关，分别告诉我们什么"
    },
    {
      "id": "v58-heading-08",
      "level": 3,
      "title": "没有反应，先查入口是不是开放"
    },
    {
      "id": "v58-heading-09",
      "level": 2,
      "title": "二、先把声音听清　声学前端处理的是声音和说话位置"
    },
    {
      "id": "v58-heading-10",
      "level": 3,
      "title": "先处理噪声和回声，才有条件听清插话"
    },
    {
      "id": "v58-heading-11",
      "level": 3,
      "title": "从哪里说、谁在说、要控制哪里，是三个问题"
    },
    {
      "id": "v58-heading-12",
      "level": 3,
      "title": "人数靠乘员感知，故障沿音频往后找"
    },
    {
      "id": "v58-heading-13",
      "level": 2,
      "title": "三、声音变成文字　在线、离线与过程、最终是两组概念"
    },
    {
      "id": "v58-heading-14",
      "level": 3,
      "title": "在线和离线，区别在声音送到哪里识别"
    },
    {
      "id": "v58-heading-15",
      "level": 3,
      "title": "过程和最终，区别在这次听写有没有定稿"
    },
    {
      "id": "v58-heading-16",
      "level": 3,
      "title": "热词把可能出现的名字，提前交给识别"
    },
    {
      "id": "v58-heading-17",
      "level": 3,
      "title": "写对名字、改写文字、点中按钮，分别由谁负责"
    },
    {
      "id": "v58-heading-18",
      "level": 2,
      "title": "四、他说完了没有　短暂停顿先准备，正式收尾再交办"
    },
    {
      "id": "v58-heading-19",
      "level": 3,
      "title": "停顿 300 毫秒先准备，600 毫秒再收尾"
    },
    {
      "id": "v58-heading-20",
      "level": 3,
      "title": "提前准备可以多次，正式办理只认最后那句话"
    },
    {
      "id": "v58-heading-21",
      "level": 3,
      "title": "回应快不快，要从听完一直看到结果"
    },
    {
      "id": "v58-heading-22",
      "level": 3,
      "title": "对话节奏管理，把收尾、插话和回复接成一段交谈"
    },
    {
      "id": "v58-heading-23",
      "level": 2,
      "title": "五、是不是在跟豆包说　先让出说话机会，再判断整句话"
    },
    {
      "id": "v58-heading-24",
      "level": 3,
      "title": "同一句话，前后文决定它是在问谁"
    },
    {
      "id": "v58-heading-25",
      "level": 3,
      "title": "先停餐厅播报，是为了让用户把插话说完"
    },
    {
      "id": "v58-heading-26",
      "level": 3,
      "title": "整句话说完，再决定是不是交给豆包办"
    },
    {
      "id": "v58-heading-27",
      "level": 3,
      "title": "训练既要教它判对，也要教它在合适的时候决定"
    },
    {
      "id": "v58-heading-28",
      "level": 2,
      "title": "六、谁来办　固定说法、本地模型和云端怎样分工"
    },
    {
      "id": "v58-heading-29",
      "level": 3,
      "title": "常用指令先在车上理解，复杂任务交给云端"
    },
    {
      "id": "v58-heading-30",
      "level": 3,
      "title": "本地的三种结果，要通向三种后续处理"
    },
    {
      "id": "v58-heading-31",
      "level": 3,
      "title": "两边都算可以，车辆动作只执行一次"
    },
    {
      "id": "v58-heading-32",
      "level": 3,
      "title": "本地办完要同步事实，让下一句接得上"
    },
    {
      "id": "v58-heading-33",
      "level": 2,
      "title": "七、这些模型分别是谁　职责、规模和部署要分开看"
    },
    {
      "id": "v58-heading-34",
      "level": 3,
      "title": "先问它交出什么结果，再看它有多大"
    },
    {
      "id": "v58-heading-35",
      "level": 3,
      "title": "同样是 30B，看懂画面和安排任务仍是两件事"
    },
    {
      "id": "v58-heading-36",
      "level": 2,
      "title": "八、Planner 接手　先补齐“昨天那家”，再把真实结果交给下一句"
    },
    {
      "id": "v58-heading-37",
      "level": 3,
      "title": "背景先送进来，Planner 再判断还缺什么"
    },
    {
      "id": "v58-heading-38",
      "level": 3,
      "title": "先找回泳馆，才能围绕它搜索餐厅"
    },
    {
      "id": "v58-heading-39",
      "level": 3,
      "title": "把用户看到的餐厅和顺序一起留下"
    },
    {
      "id": "v58-heading-40",
      "level": 3,
      "title": "交出动作列表，再根据工具结果决定下一步"
    },
    {
      "id": "v58-heading-41",
      "level": 3,
      "title": "座椅加热办完，再把“第二个”接回餐厅"
    },
    {
      "id": "v58-heading-42",
      "level": 2,
      "title": "九、豆包怎样记住　刚才的细节、昨天的经历和长期偏好各放在哪里"
    },
    {
      "id": "v58-heading-43",
      "level": 3,
      "title": "分层保存，让刚才的细节和昨天的经历都能接上"
    },
    {
      "id": "v58-heading-44",
      "level": 3,
      "title": "历史记录保住候选，下一句才能选“第二个”"
    },
    {
      "id": "v58-heading-45",
      "level": 3,
      "title": "摘要压短原话，仍要保住“不要预约”"
    },
    {
      "id": "v58-heading-46",
      "level": 3,
      "title": "当天经历先整理，跨天经历再按人找回来"
    },
    {
      "id": "v58-heading-47",
      "level": 3,
      "title": "最近事件先保留细节，给当前判断及时使用"
    },
    {
      "id": "v58-heading-48",
      "level": 3,
      "title": "各层及时接力，再把本轮所需内容交给 Planner"
    },
    {
      "id": "v58-heading-49",
      "level": 3,
      "title": "关闭记忆后，刚才的对话仍有自己的承接范围"
    },
    {
      "id": "v58-heading-50",
      "level": 3,
      "title": "查对经历之前，先确保查的是正确的人"
    },
    {
      "id": "v58-heading-51",
      "level": 2,
      "title": "十、没叫豆包的话　人人对话也可能是下一句的背景"
    },
    {
      "id": "v58-heading-52",
      "level": 3,
      "title": "已经唤醒就实时传，暂时传不上去就先攒在车上"
    },
    {
      "id": "v58-heading-53",
      "level": 3,
      "title": "聊天送到了，还要赶上这一轮理解"
    },
    {
      "id": "v58-heading-54",
      "level": 3,
      "title": "先划清允许记的范围，再让背景参与理解"
    },
    {
      "id": "v58-heading-55",
      "level": 2,
      "title": "十一、豆包记忆和车机记忆打通　说着保存和地图手动修改要对得上"
    },
    {
      "id": "v58-heading-56",
      "level": 3,
      "title": "保存地点前，先找到唯一的那一家"
    },
    {
      "id": "v58-heading-57",
      "level": 3,
      "title": "使用地址时，把“回家”补成明确的导航动作"
    },
    {
      "id": "v58-heading-58",
      "level": 3,
      "title": "先认清是谁的家，再决定更新哪一份"
    },
    {
      "id": "v58-heading-59",
      "level": 3,
      "title": "记忆开关管能否保存，联网状态管能否补新地址"
    },
    {
      "id": "v58-heading-60",
      "level": 3,
      "title": "座椅记住用途和位置编号，实际姿态留在车上"
    },
    {
      "id": "v58-heading-61",
      "level": 2,
      "title": "十二、AI Launcher　桌面让用户发现能力，点击以后还要把事情交出去"
    },
    {
      "id": "v58-heading-62",
      "level": 3,
      "title": "桌面先让用户发现能力，结果页再交代办得怎样"
    },
    {
      "id": "v58-heading-63",
      "level": 3,
      "title": "一次点击走哪条路，要提前约好"
    },
    {
      "id": "v58-heading-64",
      "level": 3,
      "title": "看得见、点得动之后，还要看事情是否办成"
    },
    {
      "id": "v58-heading-65",
      "level": 2,
      "title": "十三、说出来　TTS 播报与打断恢复，要接着用户真正听到的位置往下讲"
    },
    {
      "id": "v58-heading-66",
      "level": 3,
      "title": "Planner 决定说什么，云端合成声音，车端负责播放"
    },
    {
      "id": "v58-heading-67",
      "level": 3,
      "title": "插话最终没有交给豆包，先看能否恢复原播报"
    },
    {
      "id": "v58-heading-68",
      "level": 3,
      "title": "插话确实交给豆包，新任务和没讲完的话一起处理"
    },
    {
      "id": "v58-heading-69",
      "level": 3,
      "title": "屏幕和声音各有进度，用交互状态把体验串起来"
    },
    {
      "id": "v58-heading-70",
      "level": 2,
      "title": "收尾　三分钟讲给别人听"
    },
    {
      "id": "v58-heading-71",
      "level": 3,
      "title": "最容易讲错的地方"
    },
    {
      "id": "v58-heading-72",
