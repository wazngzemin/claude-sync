Index="5546" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;8266&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="8266" sourceBaselineY="10196" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="5544"><mxGeometry x="26" y="301" width="900" height="30" as="geometry"/></mxCell><mxCell id="v15_5049" parent="v15_5038" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;则处理，不能工具回包直接抢占用户。E 区只收集和交接，&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="5547" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;8266&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="8266" sourceBaselineY="10230" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="5544"><mxGeometry x="26" y="335" width="810" height="30" as="geometry"/></mxCell><mxCell id="v15_5050" parent="v15_5038" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;不在内部再自行规划新动作；新的 action_list 仍从 D11&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="5548" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;8266&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="8266" sourceBaselineY="10264" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="5544"><mxGeometry x="26" y="369" width="1020" height="30" as="geometry"/></mxCell><mxCell id="v15_5051" parent="v15_5038" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt; 发出。这样一条主回路可追踪谁做决策，也避免图上 E 自&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="5549" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;8266&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="8266" sourceBaselineY="10298" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="5544"><mxGeometry x="26" y="403" width="840" height="30" as="geometry"/></mxCell><mxCell id="v15_5052" parent="v15_5038" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;循环和 D 自循环重复表示同一轮推理。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="5550" sourceTag="tspan" sourceAttributes="{&