flowchart LR
  subgraph L["入口｜场景管理列表"]
    direction TB
    L1["沿用现有场景列表<br/>名称、状态、编辑入口"]
    L2["新增列表信息<br/>关联任务、配置版本、生效状态"]
    L3["点击新建 / 编辑<br/>场景用途选择：系统预设任务"]
    L1 --> L2 --> L3
  end
  subgraph E["核心改造｜同一个新建 / 编辑页面"]
    direction TB
    E1["① 基本信息区：扩展<br/>保留车型版本；新增任务关联、承接业务"]
    E2["② 条件区：扩展<br/>保留条件组；新增数据时效、停车去重"]
    E3["③ 动作区：扩展为业务处理<br/>承接业务、判断能力、结果分支"]
    E4["④ 新增交互与后续动作区<br/>卡片、TTS、按钮；确认后动作与回读"]
    E5["⑤ 运行策略区：扩展<br/>保留次数间隔；新增失效、关闭和重试策略"]
    E1 --> E2 --> E3 --> E4 --> E5
  end
  subgraph R["出口｜发布与查看结果"]
    direction TB
    R1["检查配置<br/>缺项定位回填；完整后允许发布"]
    R2["发布版本并确认生效<br/>Trigger 读规则，业务读后续处理"]
    R3["扩展触发记录 / 单次详情<br/>触发、识别、卡片、回答、车辆真实结果"]
    R1 --> R2 -->|运行后查看记录| R3
  end
  L -->|进入编辑页| E
  E -->|填写完成| R
  classDef keep fill:#edf3fa,stroke:#7c98b7,color:#284359;
  classDef add fill:#fff3df,stroke:#cb9644,color:#593e18;
  classDef out fill:#eaf5ed,stroke:#659975,color:#294931;
  class L1 keep;
  class L2,L3,E1,E2,E3,E4,E5 add;
  class R1,R2,R3 out;
