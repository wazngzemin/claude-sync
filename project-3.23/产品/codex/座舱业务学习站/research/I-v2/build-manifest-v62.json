    "I": {
      "sourceSha256": "bd5b5bede686dc5c3780d00daa0133340b6a4823c55adbabd3fc014789a682ee",
      "headings": [
        {
          "id": "i62-heading-01",
          "level": 2,
          "title": "开篇、车里不是一问一答"
        },
        {
          "id": "i62-heading-02",
          "level": 3,
          "title": "用户插话时，旧事和新话会同时留在系统里"
        },
        {
          "id": "i62-heading-03",
          "level": 3,
          "title": "沿着先停、再排、后接回，追完一次插话"
        },
        {
          "id": "i62-heading-04",
          "level": 2,
          "title": "一、插话以后，到底停了什么"
        },
        {
          "id": "i62-heading-05",
          "level": 3,
          "title": "第一层停声，让用户说完，保留接回的机会"
        },
        {
          "id": "i62-heading-06",
          "level": 3,
          "title": "第二层停推理，让旧回答失去继续对外输出的资格"
        },
        {
          "id": "i62-heading-07",
          "level": 3,
          "title": "第三层拦住未下发动作，先查动作过没过执行出口"
        },
        {
          "id": "i62-heading-08",
          "level": 3,
          "title": "第四层保留已执行事实，改变车辆要再办一次明确操作"
        },
        {
          "id": "i62-heading-09",
          "level": 2,
          "title": "二、要不要停：打断的判断"
        },
        {
          "id": "i62-heading-10",
          "level": 3,
          "title": "明确叫豆包先停，模糊插话再看过程文字"
        },
        {
          "id": "i62-heading-11",
          "level": 3,
          "title": "其他座位也能插话，接住以后保留各自归属"
        },
        {
          "id": "i62-heading-12",
          "level": 3,
          "title": "乘客聊天和机器声音，要从进入文字之前就分开查"
        },
        {
          "id": "i62-heading-13",
          "level": 3,
          "title": "车内外同时听见唤醒词，先分入口，再谈打断"
        },
        {
          "id": "i62-heading-14",
          "level": 3,
          "title": "判断准不准和整段打断顺不顺，要分别衡量"
        },
        {
          "id": "i62-heading-15",
          "level": 2,
          "title": "三、新话来了：合并、打断还是排队"
        },
        {
          "id": "i62-heading-16",
          "level": 3,
          "title": "输入管理先安排谁进场，再由 Planner 理解要办什么"
        },
        {
          "id": "i62-heading-17",
          "level": 3,
          "title": "合并边界往后放，是给晚一点开口的人留机会"
        },
        {
          "id": "i62-heading-18",
          "level": 3,
          "title": "多人合并要保留谁说了什么，先后说也看处理进度"
        },
        {
          "id": "i62-heading-19",
          "level": 3,
          "title": "主动建议等待，工具反馈按原来的调用单独处理"
        },
        {
          "id": "i62-heading-20",
          "level": 3,
          "title": "下一轮可以先算，发出去要等前一轮结束"
        },
        {
          "id": "i62-heading-21",
          "level": 2,
          "title": "四、旧话说到哪了：播放进度"
        },
        {
          "id": "i62-heading-22",
          "level": 3,
          "title": "车机上报真正播到哪里，云端才知道还有什么要接"
        },
        {
          "id": "i62-heading-23",
          "level": 3,
          "title": "开始、进度、播完和永久中止，各自交代一件事"
        },
        {
          "id": "i62-heading-24",
          "level": 3,
          "title": "用打轴切开已说和未说，缺少进度时保留未知"
        },
        {
          "id": "i62-heading-25",
          "level": 2,
          "title": "五、怎么接回来：三种恢复方式"
        },
        {
          "id": "i62-heading-26",
          "level": 3,
          "title": "新话被拒识，先从原来的暂停处接着播"
        },
        {
          "id": "i62-heading-27",
          "level": 3,
          "title": "新话被接住，把新要求和没说完的内容一起回答"
        },
        {
          "id": "i62-heading-28",
          "level": 3,
          "title": "恢复价值判断决定补什么、补多少、接给谁"
        },
        {
          "id": "i62-heading-29",
          "level": 3,
          "title": "先检查停止原因，属于不恢复的分支就结束旧播报"
        },
        {
          "id": "i62-heading-30",
          "level": 2,
          "title": "六、接回来以后：历史和真实结果对得上"
        },
        {
          "id": "i62-heading-31",
          "level": 3,
          "title": "先把生成、听到、显示和执行分开记"
        },
        {
          "id": "i62-heading-32",
          "level": 3,
          "title": "旧推理失效，已经发生的工具结果仍要回来"
        },
        {
          "id": "i62-heading-33",
          "level": 3,
          "title": "卡片跟着业务结果走，相关追问要留住选择入口"
        },
        {
          "id": "i62-heading-34",
          "level": 3,
          "title": "多屏各管呈现，任务状态还要跟真实步骤同步"
        },
        {
          "id": "i62-heading-35",
          "level": 2,
          "title": "七、不同车型和场景的设计选项"
        },
        {
          "id": "i62-heading-36",
          "level": 3,
          "title": "主逻辑相近，部署位置和呈现容器要分别选择"
        },
        {
          "id": "i62-heading-37",
          "level": 3,
          "title": "连续听多久，与哪些场景允许听，是两项选择"
        },
        {
          "id": "i62-heading-38",
          "level": 3,
          "title": "途经点删了，先判断用户目标还在不在"
        },
        {
          "id": "i62-heading-39",
          "level": 3,
          "title": "系统通知怎样插进来，要单独配置"
        },
        {
          "id": "i62-heading-40",
          "level": 2,
          "title": "八、怎么评估、怎么排查"
        },
        {
          "id": "i62-heading-41",
          "level": 3,
          "title": "打断通过与恢复正确，要分别算"
        },
        {
          "id": "i62-heading-42",
          "level": 3,
          "title": "首字快了，用户真正听到的回答也要快"
        },
        {
          "id": "i62-heading-43",
          "level": 3,
          "title": "遇到故障，沿六次交接找第一个偏差"
        },
        {
          "id": "i62-heading-44",
          "level": 2,
          "title": "收尾、把一次插话从头讲到尾"
        },
        {
          "id": "i62-heading-45",
          "level": 3,
          "title": "三分钟口述稿：从一句话进来，讲到只办一次、回写完成"
        },
        {
          "id": "i62-heading-46",
          "level": 3,
          "title": "最容易讲错的地方"
        },
        {
          "id": "i62-heading-47",
          "level": 3,
          "title": "复述路线图：每一站都说出收到什么、交出什么"
        },
        {
          "id": "i62-heading-48",
          "level": 2,
          "title": "附一　术语表"
        },
        {
          "id": "i62-heading-49",
          "level": 3,
          "title": "查输入与调度：先分谁在理解，谁在安排顺序"
        },
        {
          "id": "i62-heading-50",
          "level": 3,
          "title": "查播放与结果：按实际听到和实际办成分别找词"
        },
        {
          "id": "i62-heading-51",
          "level": 2,
          "title": "附二　历史版本与关键数字"
        },
        {
          "id": "i62-heading-52",
          "level": 3,
          "title": "版本怎样演进：把停声前移，把接回做实"
        },
        {
          "id": "i62-heading-53",
          "level": 3,
          "title": "关键数字看哪一步：模型耗时、等待上限与界面计时分别读"
        }
