e;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="6877" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;11786&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="11786" sourceBaselineY="17152" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="6875"><mxGeometry x="26" y="137" width="600" height="30" as="geometry"/></mxCell><mxCell id="v15_6092" parent="v15_6086" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;保存任务与回调关联&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="6878" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;11786&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="11786" sourceBaselineY="17186" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="6875"><mxGeometry x="26" y="171" width="270" height="30" as="geometry"/></mxCell><mxCell id="v15_6093" parent="v15_6086" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;注册失败不可宣告正常等待&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;