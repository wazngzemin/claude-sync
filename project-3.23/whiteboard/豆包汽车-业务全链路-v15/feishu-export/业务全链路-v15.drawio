&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=24;fontColor=#62758A;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="111" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;226&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="226" sourceBaselineY="28961" sourceFontSize="24" sourceFontWeight="400" sourceTextIndex="110"><mxGeometry x="36" y="87" width="1497.6" height="28.8" as="geometry"/></mxCell><mxCell id="v15_80" parent="1" value="" style="group;connectable=0;recursiveResize=0;collapsible=0;" sourceIndex="112" sourceTag="g" sourceAttributes="{&quot;class&quot;:&quot;module-frame&quot;,&quot;data-module&quot;:&quot;A&quot;}" vertex="1" connectable="0"><mxGeometry x="3710" y="21730" width="2760" height="6360" as="geometry"/></mxCell><mxCell id="v15_81" parent="v15_80" value="" style="shape=rectangle;rounded=1;absoluteArcSize=1;arcSize=28;fillColor=white;strokeColor=#9BB8DA;strokeWidth=3;" sourceIndex="113" sourceTag="rect" sourceAttributes="{&quot;x&quot;:&quot;3710&quot;,&quot;y&quot;:&quot;21730&quot;,&quot;width&quot;:&quot;2760&quot;,&quot;height&quot;:&quot;6360&quot;,&quot;rx&quot;:&quot;14&quot;,&quot;fill&quot;:&quot;white&quot;,&quot;stroke&quot;:&quot;#9BB8DA&quot;,&quot;stroke-width&quot;:&quot;3&quot;}" vertex="1"><mxGeometry x="0" y="0" width="2760" height="6360" as="geometry"/></mxCell><mxCell id="v15_82" parent="v15_80" value="" style="shape=rectangle;rounded=1;absoluteArcSize=1;arcSize=28;fillColor=#EAF2FF;strokeColor=none;strokeWidth=1;" sourceIndex="114" sourceTag="rect" sourceAttributes="{&quot;x&quot;:&quot;3710&quot;,&quot;y&quot;:&quot;21730&quot;,&quot;width&quot;:&quot;2760&quot;,&quot;height&quot;:&quot;165&quot;,&quot;rx&quot;:&quot;14&quot;,&quot;fill&quot;