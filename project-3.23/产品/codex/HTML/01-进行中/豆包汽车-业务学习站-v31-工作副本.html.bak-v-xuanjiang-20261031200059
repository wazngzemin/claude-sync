 344,1216\" fill=\"none\" stroke=\"#fff\" stroke-width=\"7\"/><polyline points=\"353,540 30,540 30,1216 344,1216\" fill=\"none\" stroke=\"#28716f\" stroke-width=\"2.2\" marker-end=\"url(#m-SE-knowledge-load-detail-2)\"/></g><defs><marker id=\"m-SE-knowledge-load-detail-3\" markerWidth=\"11\" markerHeight=\"11\" refX=\"9\" refY=\"5.5\" orient=\"auto\"><path d=\"M0,1 L9,5.5 L0,10\" fill=\"none\" stroke=\"#44657f\" stroke-width=\"1.5\"/></marker></defs><g class=\"business-edge\"><title>KL3 场景不清楚时，不强行新增知识 → 返回新增、移除的知识编号；新增为空，按本轮知识清单继续</title><polyline points=\"686,1052 686,1136\" fill=\"none\" stroke=\"#fff\" stroke-width=\"7\"/><polyline points=\"686,1052 686,1136\" fill=\"none\" stroke=\"#44657f\" stroke-width=\"2.2\" marker-end=\"url(#m-SE-knowledge-load-detail-3)\"/></g><defs><marker id=\"m-SE-knowledge-load-detail-4\" markerWidth=\"11\" markerHeight=\"11\" refX=\"9\" refY=\"5.5\" orient=\"auto\"><path d=\"M0,1 L9,5.5 L0,10\" fill=\"none\" stroke=\"#44657f\" stroke-width=\"1.5\"/></marker></defs><g class=\"business-edge\"><title>KL4 返回新增、移除的知识编号 → 按编号取正文，更新本轮知识内容；知识编号与增删动作</title><polyline points=\"686,1390 686,1474\" fill=\"none\" stroke=\"#fff\" stroke-width=\"7\"/><polyline points=\"686,1390 686,1474\" fill=\"none\" stroke=\"#44657f\" stroke-width=\"2.2\" marker-end=\"url(#m-SE-knowledge-load-detail-4)\"/></g><defs><marker id=\"m-SE-knowledge-load-detail-5\" markerWidth=\"11\" markerHeight=\"11\" refX=\"9\" refY=\"5.5\" orient=\"auto\"><path d=\"M0,1 L9,5.5 L0,10\" fill=\"none\" stroke=\"#44657f\" stroke-width=\"1.5\"/></marker></defs><g class=\"business-edge\"><title>KL5 按编号取正文，更新本轮知识内容 → 把具体做法写入本轮 knowledge；选中的实际知识正文</title><polyline points=\"686,1728 686,1812\" fill=\"none\" stroke=\"#fff\" stroke-width=\"7\"/><polyline points=\"686,1728 686,1812\" fill=\"none\" stroke=\"#44657f\" stroke-width=\"2.2\" marker-end=\"url(#m-SE-knowledge-load-detail-5)\"/></g><defs><marker id=\"m-SE-knowledge-load-detail-6\" markerWidth=\"11\" markerHeight=\"11\" refX=\"9\" refY=\"5.5\" orient=\"auto\"><path d=\"M0,1 L9,5.5 L0,10\" fill=\"none\" stroke=\"#44657f\" stroke-width=\"1.5\"/></marker></defs><g class=\"business-edge\"><title>KL6 把具体做法写入本轮 knowledge → Director 按当前需求选择下一步；本轮 SP 中的 knowledge</title><polyline points=\"686,2066 686,2150\" fill=\"none\" stroke=\"#fff\" stroke-width=\"7\"/><polyline points=\"686,2066 686,2150\" fill=\"none\" stroke=\"#44657f\" stroke-width=\"2.2\" marker-end=\"url(#m-SE-knowledge-load-detail-6)\"/></g><defs><marker id=\"m-SE-knowledge-load-detail-7\" markerWidth=\"11\" markerHeight=\"11\" refX=\"9\" refY=\"5.5\" orient=\"auto\"><path d=\"M0,1 L9,5.5 L0,10\" fill=\"none\" stroke=\"#44657f\" stroke-width=\"1.5\"/></marker></defs><g class=\"business-edge\"><title>KL7 Director 按当前需求选择下一步 → 工具返回结果，再判断要不要继续；需要动作时下发 action_list</title><polyline points=\"686,2404 686,2488\" fill=\"none\" stroke=\"#fff\" stroke-width=\"7\"/><polyline points=\"686,2404 686,2488\" fill=\"none\" stroke=\"#44657f\" stroke-width=\"2.2\" marker-end=\"url(#m-SE-knowledge-load-detail-7)\"/></g><defs><marker id=\"m-SE-knowledge-load-detail-8\" markerWidth=\"11\" markerHeight=\"11\" refX=\"9\" refY=\"5.5\" orient=\"auto\"><path d=\"M0,1 L9,5.5 L0,10\" fill=\"none\" stroke=\"#28716f\" stroke-width=\"1.5\"/></marker></defs><g class=\"business-edge\"><title>KL8 工具返回结果，再判断要不要继续 → Director 按当前需求选择下一步；tool_feedback 支撑下一步判断</title><polyline points=\"353,2568 30,2568 30,2230 344,2230\" fill=\"none\" stroke=\"#fff\" stroke-width=\"7\"/><polyline points=\"353,2568 30,2568 30,2230 344,2230\" fill=\"none\" stroke=\"#28716f\" stroke-width=\"2.2\" marker-end=\"url(#m-SE-knowledge-load-detail-8)\"/></g><defs><marker id=\"m-SE-knowledge-load-detail-9\" markerWidth=\"11\" markerHeight=\"11\" refX=\"9\" refY=\"5.5\" orient=\"auto\"><path d=\"M0,1 L9,5.5 L0,10\" fill=\"none\" stroke=\"#a16b20\" stroke-width=\"1.5\"/></marker></defs><g class=\"business-edge\"><title>KL7 Director 按当前需求选择下一步 → 先澄清或直接答复，本轮不发工具；需澄清，或已有事实足以答复</title><polyline points=\"353,2296 58,2296 58,2906 344,2906\" fill=\"none\" stroke=\"#fff\" stroke-width=\"7\"/><polyline points=\"353,2296 58,2296 58,2906 344,2906\" fill=\"none\" stroke=\"#a16b20\" stroke-width=\"2.2\" marker-end=\"url(#m-SE-knowledge-load-detail-9)\"/></g><rect x=\"699\" y=\"405\" width=\"218\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"704\" y=\"422\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">交付本轮事实与已有知识清单</text><rect x=\"699\" y=\"743\" width=\"106\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"704\" y=\"760\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">场景信息不足</text><rect x=\"129\" y=\"514\" width=\"138\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"134\" y=\"531\" font-size=\"16\" fill=\"#28716f\" font-weight=\"500\">能够判定相关知识</text><rect x=\"699\" y=\"1081\" width=\"234\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"704\" y=\"1098\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">新增为空，按本轮知识清单继续</text><rect x=\"699\" y=\"1419\" width=\"154\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"704\" y=\"1436\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">知识编号与增删动作</text><rect x=\"699\" y=\"1757\" width=\"154\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"704\" y=\"1774\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">选中的实际知识正文</text><rect x=\"699\" y=\"2095\" width=\"199.44000000000008\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"704\" y=\"2112\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">本轮 SP 中的 knowledge</text><rect x=\"699\" y=\"2433\" width=\"229.5200000000001\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"704\" y=\"2450\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">需要动作时下发 action_list</text><rect x=\"129\" y=\"2531\" width=\"199.44000000000005\" height=\"51\" fill=\"#fff\" rx=\"3\"/><text x=\"134\" y=\"2548\" font-size=\"16\" fill=\"#28716f\" font-weight=\"500\">tool_feedback 支撑下一</text><text x=\"134\" y=\"2571\" font-size=\"16\" fill=\"#28716f\" font-weight=\"500\">步判断</text><rect x=\"129\" y=\"2259\" width=\"202\" height=\"51\" fill=\"#fff\" rx=\"3\"/><text x=\"134\" y=\"2276\" font-size=\"16\" fill=\"#a16b20\" font-weight=\"500\">需澄清，或已有事实足以答</text><text x=\"134\" y=\"2299\" font-size=\"16\" fill=\"#a16b20\" font-weight=\"500\">复</text><g data-page=\"SE\" data-flow=\"SE-knowledge-load-detail\" data-step=\"KL1\" role=\"link\" tabindex=\"0\" aria-label=\"接机途中，用户又说“放一首歌”\"><rect x=\"356\" y=\"134\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"380\" y=\"171\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">接机途中，用户又说“放一首歌”</text><text x=\"380\" y=\"218\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">输入包括本句需求、最近 10 轮说话历史、仍在进行的接机目标、最新车辆</text><text x=\"380\" y=\"245\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">状态和已加载知识编号。</text><text x=\"380\" y=\"272\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"380\" y=\"299\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">接机尚未结束是本轮已有背景；不能仅因用户临时点歌，就把接机目标和相关</text><text x=\"380\" y=\"326\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">知识一起丢掉。</text></g><g data-page=\"SE\" data-flow=\"SE-knowledge-load-detail\" data-step=\"KL2\" role=\"link\" tabindex=\"0\" aria-label=\"判断要补音乐知识，还是保留原有内容\"><rect x=\"356\" y=\"472\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#fff8eb\" stroke=\"#bc9154\" stroke-width=\"1.4\"/><text x=\"380\" y=\"509\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">判断要补音乐知识，还是保留原有内容</text><text x=\"380\" y=\"556\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">知识筛选结合当前点歌要求和目标队列，对照已有知识，决定需要新增、保留</text><text x=\"380\" y=\"583\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">和移除的条目。</text><text x=\"380\" y=\"610\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"380\" y=\"637\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">最新车况优先于历史中的旧状态；如果用户明确取消接机，再判断接机知识是</text><text x=\"380\" y=\"664\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">否已无保留必要。</text></g><g data-page=\"SE\" data-flow=\"SE-knowledge-load-detail\" data-step=\"KL3\" role=\"link\" tabindex=\"0\" aria-label=\"场景不清楚时，不强行新增知识\"><rect x=\"356\" y=\"810\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"380\" y=\"847\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">场景不清楚时，不强行新增知识</text><text x=\"380\" y=\"894\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">例如只说“按刚才的来”，而已有历史不足以确定所指，筛选结果可以不新增，</text><text x=\"380\" y=\"921\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">不能凭空认定新的场景。</text><text x=\"380\" y=\"948\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"380\" y=\"975\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">已有知识是否保留仍根据当前目标判断；新增为空不等于清空所有知识，也不</text><text x=\"380\" y=\"1002\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">等于取消本次请求。</text></g><g data-page=\"SE\" data-flow=\"SE-knowledge-load-detail\" data-step=\"KL4\" role=\"link\" tabindex=\"0\" aria-label=\"返回新增、移除的知识编号\"><rect x=\"356\" y=\"1148\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"380\" y=\"1185\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">返回新增、移除的知识编号</text><text x=\"380\" y=\"1232\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">add_knowledge_ids 表示要补哪些条目，remove_knowledge_ids 表示哪</text><text x=\"380\" y=\"1259\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">些条目不再适用。未移除且仍需使用的知识继续保留。</text><text x=\"380\" y=\"1286\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"380\" y=\"1313\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">附带理由解释为什么选这些条目。这里交付的是装载清单，还不是能指导音乐</text><text x=\"380\" y=\"1340\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">搜索或接机的完整正文。</text></g><g data-page=\"SE\" data-flow=\"SE-knowledge-load-detail\" data-step=\"KL5\" role=\"link\" tabindex=\"0\" aria-label=\"按编号取正文，更新本轮知识内容\"><rect x=\"356\" y=\"1486\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"380\" y=\"1523\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">按编号取正文，更新本轮知识内容</text><text x=\"380\" y=\"1570\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">接收方按照新增编号读取正文，移除指定旧条目，再与保留内容拼接。音乐技</text><text x=\"380\" y=\"1597\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">巧可以和仍有用的接机知识共存。</text><text x=\"380\" y=\"1624\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"380\" y=\"1651\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">必须检查实际取得了什么内容；只拿到一个知识编号，不能让 Director 自</text><text x=\"380\" y=\"1678\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">动知道该条知识的步骤和限制。</text></g><g data-page=\"SE\" data-flow=\"SE-knowledge-load-detail\" data-step=\"KL6\" role=\"link\" tabindex=\"0\" aria-label=\"把具体做法写入本轮 knowledge\"><rect x=\"356\" y=\"1824\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"380\" y=\"1861\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">把具体做法写入本轮 knowledge</text><text x=\"380\" y=\"1908\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">knowledge 是这份方案在提示词中放知识正文的位置。这里应能看到什么时</text><text x=\"380\" y=\"1935\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">候直接搜歌、什么情况下先补线索等可执行原则。</text><text x=\"380\" y=\"1962\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"380\" y=\"1989\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">用户、车辆、航班和可用工具仍取自本轮输入与真实查询；知识示例里的地点</text><text x=\"380\" y=\"2016\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">和时间不是当前事实。</text></g><g data-page=\"SE\" data-flow=\"SE-knowledge-load-detail\" data-step=\"KL7\" role=\"link\" tabindex=\"0\" aria-label=\"Director 按当前需求选择下一步\"><rect x=\"356\" y=\"2162\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#fff8eb\" stroke=\"#bc9154\" stroke-width=\"1.4\"/><text x=\"380\" y=\"2199\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">Director 按当前需求选择下一步</text><text x=\"380\" y=\"2246\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">用户明确说“播放王菲的红豆”，便依据音乐工具能力找可播资源；表达不足</text><text x=\"380\" y=\"2273\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">时先补必要线索，不能机械执行知识里的固定例子。</text><text x=\"380\" y=\"2300\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"380\" y=\"2327\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">action_list 是本轮交给工具的动作清单。接机目标是否继续监控，要由对</text><text x=\"380\" y=\"2354\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">应任务机制承担，知识本身不会定时唤起模型。</text></g><g data-page=\"SE\" data-flow=\"SE-knowledge-load-detail\" data-step=\"KL8\" role=\"link\" tabindex=\"0\" aria-label=\"工具返回结果，再判断要不要继续\"><rect x=\"356\" y=\"2500\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#fff8eb\" stroke=\"#bc9154\" stroke-width=\"1.4\"/><text x=\"380\" y=\"2537\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">工具返回结果，再判断要不要继续</text><text x=\"380\" y=\"2584\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">音乐工具实际找到并播放资源后，返回办理结果；没有版权、无匹配或调用失</text><text x=\"380\" y=\"2611\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">败，要分别处理，不能因为知识写了“播放”就宣布成功。</text><text x=\"380\" y=\"2638\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"380\" y=\"2665\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">tool_feedback 是交回 Director 的工具结果。下一轮以它和更新后的状</text><text x=\"380\" y=\"2692\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">态为依据，决定补查、澄清或结束本次点歌。</text></g><g data-page=\"SE\" data-flow=\"SE-knowledge-load-detail\" data-step=\"KL9\" role=\"link\" tabindex=\"0\" aria-label=\"先澄清或直接答复，本轮不发工具\"><rect x=\"356\" y=\"2838\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"380\" y=\"2875\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">先澄清或直接答复，本轮不发工具</text><text x=\"380\" y=\"2922\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">如果用户只说“按刚才的来”而对象仍不明确，Director 先询问需要确认</text><text x=\"380\" y=\"2949\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">的信息；如果只需解释已有事实，可以直接组织答复。</text><text x=\"380\" y=\"2976\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"380\" y=\"3003\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">这条出口不经过工具回执。用户补充后形成新的输入，再结合更新的背景继续</text><text x=\"380\" y=\"3030\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">判断。</text></g></svg>",
 "SE-dynamic-example-detail": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1092\" height=\"2818\" viewBox=\"0 0 1092 2818\" font-family=\"-apple-system,BlinkMacSystemFont,PingFang SC,Microsoft YaHei,sans-serif\" role=\"img\" aria-label=\"动态示例从维护到使用的流程\"><rect width=\"100%\" height=\"100%\" fill=\"#fff\"/><text x=\"384\" y=\"40\" font-size=\"25\" fill=\"#203949\" font-weight=\"650\">动态示例从维护到使用的流程</text><text x=\"384\" y=\"76\" font-size=\"17\" fill=\"#526775\" font-weight=\"400\">以“结束录音纪要”为例；车企、环境、场景过滤及审核范围属于二期设计，按项目实</text><text x=\"384\" y=\"101\" font-size=\"17\" fill=\"#526775\" font-weight=\"400\">际接入使用。</text><defs><marker id=\"m-SE-dynamic-example-detail-0\" markerWidth=\"11\" markerHeight=\"11\" refX=\"9\" refY=\"5.5\" orient=\"auto\"><path d=\"M0,1 L9,5.5 L0,10\" fill=\"none\" stroke=\"#44657f\" stroke-width=\"1.5\"/></marker></defs><g class=\"business-edge\"><title>DX1 保存“结束录音纪要”的正确处理示例 → 用户下一次提出结束录音的请求；示例已维护，等待新的实际请求</title><polyline points=\"714,401 714,485\" fill=\"none\" stroke=\"#fff\" stroke-width=\"7\"/><polyline points=\"714,401 714,485\" fill=\"none\" stroke=\"#44657f\" stroke-width=\"2.2\" marker-end=\"url(#m-SE-dynamic-example-detail-0)\"/></g><defs><marker id=\"m-SE-dynamic-example-detail-1\" markerWidth=\"11\" markerHeight=\"11\" refX=\"9\" refY=\"5.5\" orient=\"auto\"><path d=\"M0,1 L9,5.5 L0,10\" fill=\"none\" stroke=\"#44657f\" stroke-width=\"1.5\"/></marker></defs><g class=\"business-edge\"><title>DX2 用户下一次提出结束录音的请求 → 在适用候选中检索相似表达；当前用户 Query</title><polyline points=\"714,739 714,823\" fill=\"none\" stroke=\"#fff\" stroke-width=\"7\"/><polyline points=\"714,739 714,823\" fill=\"none\" stroke=\"#44657f\" stroke-width=\"2.2\" marker-end=\"url(#m-SE-dynamic-example-detail-1)\"/></g><defs><marker id=\"m-SE-dynamic-example-detail-2\" markerWidth=\"11\" markerHeight=\"11\" refX=\"9\" refY=\"5.5\" orient=\"auto\"><path d=\"M0,1 L9,5.5 L0,10\" fill=\"none\" stroke=\"#44657f\" stroke-width=\"1.5\"/></marker></defs><g class=\"business-edge\"><title>DX3 在适用候选中检索相似表达 → 把选中的决策分析注入本轮提示词；检索得到适用的相关示例</title><polyline points=\"714,1077 714,1161\" fill=\"none\" stroke=\"#fff\" stroke-width=\"7\"/><polyline points=\"714,1077 714,1161\" fill=\"none\" stroke=\"#44657f\" stroke-width=\"2.2\" marker-end=\"url(#m-SE-dynamic-example-detail-2)\"/></g><defs><marker id=\"m-SE-dynamic-example-detail-3\" markerWidth=\"11\" markerHeight=\"11\" refX=\"9\" refY=\"5.5\" orient=\"auto\"><path d=\"M0,1 L9,5.5 L0,10\" fill=\"none\" stroke=\"#44657f\" stroke-width=\"1.5\"/></marker></defs><g class=\"business-edge\"><title>DX4 把选中的决策分析注入本轮提示词 → Director 根据当前录音状态作决定；scenario_sample 与本轮 Context</title><polyline points=\"714,1415 714,1499\" fill=\"none\" stroke=\"#fff\" stroke-width=\"7\"/><polyline points=\"714,1415 714,1499\" fill=\"none\" stroke=\"#44657f\" stroke-width=\"2.2\" marker-end=\"url(#m-SE-dynamic-example-detail-3)\"/></g><defs><marker id=\"m-SE-dynamic-example-detail-4\" markerWidth=\"11\" markerHeight=\"11\" refX=\"9\" refY=\"5.5\" orient=\"auto\"><path d=\"M0,1 L9,5.5 L0,10\" fill=\"none\" stroke=\"#44657f\" stroke-width=\"1.5\"/></marker></defs><g class=\"business-edge\"><title>DX5 Director 根据当前录音状态作决定 → 把结束操作交给真实录音工具；选择的工具及参数</title><polyline points=\"714,1753 714,1837\" fill=\"none\" stroke=\"#fff\" stroke-width=\"7\"/><polyline points=\"714,1753 714,1837\" fill=\"none\" stroke=\"#44657f\" stroke-width=\"2.2\" marker-end=\"url(#m-SE-dynamic-example-detail-4)\"/></g><defs><marker id=\"m-SE-dynamic-example-detail-5\" markerWidth=\"11\" markerHeight=\"11\" refX=\"9\" refY=\"5.5\" orient=\"auto\"><path d=\"M0,1 L9,5.5 L0,10\" fill=\"none\" stroke=\"#44657f\" stroke-width=\"1.5\"/></marker></defs><g class=\"business-edge\"><title>DX6 把结束操作交给真实录音工具 → 读回结果，按真实进度答复；执行方返回的真实结果</title><polyline points=\"714,2091 714,2175\" fill=\"none\" stroke=\"#fff\" stroke-width=\"7\"/><polyline points=\"714,2091 714,2175\" fill=\"none\" stroke=\"#44657f\" stroke-width=\"2.2\" marker-end=\"url(#m-SE-dynamic-example-detail-5)\"/></g><defs><marker id=\"m-SE-dynamic-example-detail-6\" markerWidth=\"11\" markerHeight=\"11\" refX=\"9\" refY=\"5.5\" orient=\"auto\"><path d=\"M0,1 L9,5.5 L0,10\" fill=\"none\" stroke=\"#28716f\" stroke-width=\"1.5\"/></marker></defs><g class=\"business-edge\"><title>DX7 读回结果，按真实进度答复 → Director 根据当前录音状态作决定；依据结果继续当前推理</title><polyline points=\"381,2255 30,2255 30,1579 372,1579\" fill=\"none\" stroke=\"#fff\" stroke-width=\"7\"/><polyline points=\"381,2255 30,2255 30,1579 372,1579\" fill=\"none\" stroke=\"#28716f\" stroke-width=\"2.2\" marker-end=\"url(#m-SE-dynamic-example-detail-6)\"/></g><defs><marker id=\"m-SE-dynamic-example-detail-7\" markerWidth=\"11\" markerHeight=\"11\" refX=\"9\" refY=\"5.5\" orient=\"auto\"><path d=\"M0,1 L9,5.5 L0,10\" fill=\"none\" stroke=\"#a16b20\" stroke-width=\"1.5\"/></marker></defs><g class=\"business-edge\"><title>DX3 在适用候选中检索相似表达 → 没有适用结果，本轮不加动态示例；目标候选池为空</title><polyline points=\"381,903 58,903 58,2593 372,2593\" fill=\"none\" stroke=\"#fff\" stroke-width=\"7\"/><polyline points=\"381,903 58,903 58,2593 372,2593\" fill=\"none\" stroke=\"#a16b20\" stroke-width=\"2.2\" marker-end=\"url(#m-SE-dynamic-example-detail-7)\"/></g><defs><marker id=\"m-SE-dynamic-example-detail-8\" markerWidth=\"11\" markerHeight=\"11\" refX=\"9\" refY=\"5.5\" orient=\"auto\"><path d=\"M0,1 L9,5.5 L0,10\" fill=\"none\" stroke=\"#446cb1\" stroke-width=\"1.5\"/></marker></defs><g class=\"business-edge\"><title>DX8 没有适用结果，本轮不加动态示例 → Director 根据当前录音状态作决定；保留已有输入，不新增动态示例</title><polyline points=\"381,2659 86,2659 86,1645 372,1645\" fill=\"none\" stroke=\"#fff\" stroke-width=\"7\"/><polyline points=\"381,2659 86,2659 86,1645 372,1645\" fill=\"none\" stroke=\"#446cb1\" stroke-width=\"2.2\" marker-end=\"url(#m-SE-dynamic-example-detail-8)\"/></g><rect x=\"727\" y=\"430\" width=\"234\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"732\" y=\"447\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">示例已维护，等待新的实际请求</text><rect x=\"727\" y=\"768\" width=\"127.76000000000005\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"732\" y=\"785\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">当前用户 Query</text><rect x=\"727\" y=\"1106\" width=\"186\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"732\" y=\"1123\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">检索得到适用的相关示例</text><rect x=\"727\" y=\"1444\" width=\"273.04000000000013\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"732\" y=\"1461\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">scenario_sample 与本轮 Context</text><rect x=\"727\" y=\"1782\" width=\"138\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"732\" y=\"1799\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">选择的工具及参数</text><rect x=\"727\" y=\"2120\" width=\"170\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"732\" y=\"2137\" font-size=\"16\" fill=\"#44657f\" font-weight=\"500\">执行方返回的真实结果</text><rect x=\"157\" y=\"2229\" width=\"170\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"162\" y=\"2246\" font-size=\"16\" fill=\"#28716f\" font-weight=\"500\">依据结果继续当前推理</text><rect x=\"157\" y=\"877\" width=\"122\" height=\"28\" fill=\"#fff\" rx=\"3\"/><text x=\"162\" y=\"894\" font-size=\"16\" fill=\"#a16b20\" font-weight=\"500\">目标候选池为空</text><rect x=\"157\" y=\"2622\" width=\"202\" height=\"51\" fill=\"#fff\" rx=\"3\"/><text x=\"162\" y=\"2639\" font-size=\"16\" fill=\"#446cb1\" font-weight=\"500\">保留已有输入，不新增动态</text><text x=\"162\" y=\"2662\" font-size=\"16\" fill=\"#446cb1\" font-weight=\"500\">示例</text><g data-page=\"SE\" data-flow=\"SE-dynamic-example-detail\" data-step=\"DX1\" role=\"link\" tabindex=\"0\" aria-label=\"保存“结束录音纪要”的正确处理示例\"><rect x=\"384\" y=\"159\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"408\" y=\"196\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">保存“结束录音纪要”的正确处理示例</text><text x=\"408\" y=\"243\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">维护人员填写用户表达，以及“交 recording_minutes 结束当前录音”的</text><text x=\"408\" y=\"270\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">决策分析，先检查有无冲突旧条目。</text><text x=\"408\" y=\"297\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"408\" y=\"324\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">Query 改变后要重建检索索引；二期设计中草稿未审核不参加线上检索。后</text><text x=\"408\" y=\"351\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">台保存只是维护完成。</text></g><g data-page=\"SE\" data-flow=\"SE-dynamic-example-detail\" data-step=\"DX2\" role=\"link\" tabindex=\"0\" aria-label=\"用户下一次提出结束录音的请求\"><rect x=\"384\" y=\"497\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"408\" y=\"534\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">用户下一次提出结束录音的请求</text><text x=\"408\" y=\"581\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">本轮保留完整表达、当前录音状态、身份及请求所属环境。不要把“结束纪要”</text><text x=\"408\" y=\"608\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">误读为让模型重新总结内容。</text><text x=\"408\" y=\"635\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"408\" y=\"662\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">二期范围过滤还需要车企或渠道、环境、舱内外场景标识，这些决定允许从哪</text><text x=\"408\" y=\"689\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">一组示例中查找。</text></g><g data-page=\"SE\" data-flow=\"SE-dynamic-example-detail\" data-step=\"DX3\" role=\"link\" tabindex=\"0\" aria-label=\"在适用候选中检索相似表达\"><rect x=\"384\" y=\"835\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"408\" y=\"872\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">在适用候选中检索相似表达</text><text x=\"408\" y=\"919\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">二期方案先过滤生效范围，再在候选池做语义检索；赛力斯舱外记录不能给舱</text><text x=\"408\" y=\"946\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">内请求兜底。</text><text x=\"408\" y=\"973\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"408\" y=\"1000\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">有合适记录才走注入；目标池为空就返回空动态示例。过滤字段和运行时检索</text><text x=\"408\" y=\"1027\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">必须一起生效。</text></g><g data-page=\"SE\" data-flow=\"SE-dynamic-example-detail\" data-step=\"DX4\" role=\"link\" tabindex=\"0\" aria-label=\"把选中的决策分析注入本轮提示词\"><rect x=\"384\" y=\"1173\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"408\" y=\"1210\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">把选中的决策分析注入本轮提示词</text><text x=\"408\" y=\"1257\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">scenario_sample 是提示词中装动态示例的位置，Director 要在这里实际</text><text x=\"408\" y=\"1284\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">读到“结束当前录音”的处理方法。</text><text x=\"408\" y=\"1311\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"408\" y=\"1338\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">核查本轮注入正文才能证明模型看到了新示例；后台存在记录、检索列表出现</text><text x=\"408\" y=\"1365\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">候选，都不等于完成注入。</text></g><g data-page=\"SE\" data-flow=\"SE-dynamic-example-detail\" data-step=\"DX5\" role=\"link\" tabindex=\"0\" aria-label=\"Director 根据当前录音状态作决定\"><rect x=\"384\" y=\"1511\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"408\" y=\"1548\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">Director 根据当前录音状态作决定</text><text x=\"408\" y=\"1595\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">示例提供工具选择方法，本轮状态决定操作哪件任务。当前正在录音才有对应</text><text x=\"408\" y=\"1622\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">的结束对象，不能把示例里的对象直接复制过来。</text><text x=\"408\" y=\"1649\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"408\" y=\"1676\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">没有动态示例时仍依据现有指令、上下文和真实工具能力判断；缺少必要信息</text><text x=\"408\" y=\"1703\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">时再澄清，不拿其他项目示例补位。</text></g><g data-page=\"SE\" data-flow=\"SE-dynamic-example-detail\" data-step=\"DX6\" role=\"link\" tabindex=\"0\" aria-label=\"把结束操作交给真实录音工具\"><rect x=\"384\" y=\"1849\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"408\" y=\"1886\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">把结束操作交给真实录音工具</text><text x=\"408\" y=\"1933\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">动作清单中的 recording_minutes 负责办理结束录音，参数必须指向当前</text><text x=\"408\" y=\"1960\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">业务所要求的操作和对象。</text><text x=\"408\" y=\"1987\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"408\" y=\"2014\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">已经结束、没有录音或执行失败，均应由真实状态与返回结果确定；不能只因</text><text x=\"408\" y=\"2041\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">工具选对就认为录音已停。</text></g><g data-page=\"SE\" data-flow=\"SE-dynamic-example-detail\" data-step=\"DX7\" role=\"link\" tabindex=\"0\" aria-label=\"读回结果，按真实进度答复\"><rect x=\"384\" y=\"2187\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"408\" y=\"2224\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">读回结果，按真实进度答复</text><text x=\"408\" y=\"2271\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">tool_feedback 将结束成功、失败或缺少条件交回 Director。下一轮据此</text><text x=\"408\" y=\"2298\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">回复，或补必要查询后继续。</text><text x=\"408\" y=\"2325\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"408\" y=\"2352\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">复测同时看录音状态和用户听到的答复。示例已正确注入却选错工具，和工具</text><text x=\"408\" y=\"2379\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">选对但没执行成功，修复位置不同。</text></g><g data-page=\"SE\" data-flow=\"SE-dynamic-example-detail\" data-step=\"DX8\" role=\"link\" tabindex=\"0\" aria-label=\"没有适用结果，本轮不加动态示例\"><rect x=\"384\" y=\"2525\" width=\"660\" height=\"238\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"408\" y=\"2562\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">没有适用结果，本轮不加动态示例</text><text x=\"408\" y=\"2609\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">目标候选池为空时返回空结果，保留没有召回的原因，禁止跨车企、跨舱内外</text><text x=\"408\" y=\"2636\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">场景补一条不相容示例。</text><text x=\"408\" y=\"2663\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"408\" y=\"2690\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">空召回不会制造新的工具能力，也不直接判定任务失败；交回本轮已有输入，</text><text x=\"408\" y=\"2717\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">让 Director 继续判断。</text></g></svg>"
