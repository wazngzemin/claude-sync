  "h3": 50,
  "headings": [
    {
      "id": "d66-heading-01",
      "level": 2,
      "title": "开篇　同一句话，Planner 要同时决定说什么和做什么"
    },
    {
      "id": "d66-heading-02",
      "level": 3,
      "title": "用户听到一句答应，背后应有一套办事安排"
    },
    {
      "id": "d66-heading-03",
      "level": 2,
      "title": "一、一次调用：收什么、交什么"
    },
    {
      "id": "d66-heading-04",
      "level": 3,
      "title": "四类输入各有用途，先认清它在告诉我什么"
    },
    {
      "id": "d66-heading-05",
      "level": 3,
      "title": "一次决策交出四种产品结果，各自有接收方"
    },
    {
      "id": "d66-heading-06",
      "level": 3,
      "title": "决定暂时不说话，也要让任务有下一步"
    },
    {
      "id": "d66-heading-07",
      "level": 2,
      "title": "二、先想清楚再动手"
    },
    {
      "id": "d66-heading-08",
      "level": 3,
      "title": "先说清办成什么，才知道该选哪些动作"
    },
    {
      "id": "d66-heading-09",
      "level": 3,
      "title": "当前车况、天气和乘员信息，要真正改变动作"
    },
    {
      "id": "d66-heading-10",
      "level": 3,
      "title": "缺事实先查，缺选择先问，再看本车能办哪一步"
    },
    {
      "id": "d66-heading-11",
      "level": 2,
      "title": "三、四类任务怎么分"
    },
    {
      "id": "d66-heading-12",
      "level": 3,
      "title": "四类任务按什么时候办来分，多步只是办事方法"
    },
    {
      "id": "d66-heading-13",
      "level": 3,
      "title": "一个动作、同时几个动作、依次几步，都可以是即时任务"
    },
    {
      "id": "d66-heading-14",
      "level": 3,
      "title": "登记以前过五项检查，避免设好一个永远办不了的任务"
    },
    {
      "id": "d66-heading-15",
      "level": 3,
      "title": "修改原任务先找原对象，别把一句补充重新登记"
    },
    {
      "id": "d66-heading-16",
      "level": 2,
      "title": "四、同一轮一起发，有依赖的下一轮再发"
    },
    {
      "id": "d66-heading-17",
      "level": 3,
      "title": "能同时交出去，要看下一步的参数现在有没有"
    },
    {
      "id": "d66-heading-18",
      "level": 3,
      "title": "三轮走完主例，每一轮都重新对照用户要什么"
    },
    {
      "id": "d66-heading-19",
      "level": 3,
      "title": "用户指定的先后，也是一种必须保留的顺序"
    },
    {
      "id": "d66-heading-20",
      "level": 3,
      "title": "等齐再判断，让循环有明确的停止处"
    },
    {
      "id": "d66-heading-21",
      "level": 2,
      "title": "五、边说边办：话术、表情和语气"
    },
    {
      "id": "d66-heading-22",
      "level": 3,
      "title": "先说明正在做什么，有结果以后再说明做成了什么"
    },
    {
      "id": "d66-heading-23",
      "level": 3,
      "title": "早点说出有用的一句，比每轮都加铺垫更重要"
    },
    {
      "id": "d66-heading-24",
      "level": 3,
      "title": "语气给声音，表情给形象，两者都要贴合这一刻"
    },
    {
      "id": "d66-heading-25",
      "level": 2,
      "title": "六、不越界、不假装办成"
    },
    {
      "id": "d66-heading-26",
      "level": 3,
      "title": "能力判断要落到这辆车、这个动作、此刻的条件"
    },
    {
      "id": "d66-heading-27",
      "level": 3,
      "title": "“办成了”要对应实际动作，近似动作也要如实区分"
    },
    {
      "id": "d66-heading-28",
      "level": 3,
      "title": "失败和部分成功都能推进，前提是把缺口留在回答里"
    },
    {
      "id": "d66-heading-29",
      "level": 3,
      "title": "用户口头转述同意，不能代替可信的授权动作"
    },
    {
      "id": "d66-heading-30",
      "level": 2,
      "title": "七、输出出了岔子怎么兜"
    },
    {
      "id": "d66-heading-31",
      "level": 3,
      "title": "固定格式要靠调用约束守住，格式对了还要看业务对不对"
    },
    {
      "id": "d66-heading-32",
      "level": 3,
      "title": "触发内容风控，要安全收尾，还要保护下一次正常交谈"
    },
    {
      "id": "d66-heading-33",
      "level": 3,
      "title": "翻译和复述也可能在套取内部指令，要按对象判断"
    },
    {
      "id": "d66-heading-34",
      "level": 3,
      "title": "报错以后要换办法或收口，道歉本身不会推动任务"
    },
    {
      "id": "d66-heading-35",
      "level": 2,
      "title": "八、说明书、示例和训练，各修什么"
    },
    {
      "id": "d66-heading-36",
      "level": 3,
      "title": "先找教错的地方，再决定要不要换模型"
    },
    {
      "id": "d66-heading-37",
      "level": 3,
      "title": "共性规则改说明书，具体问法补示例，成类错误再训练"
    },
    {
      "id": "d66-heading-38",
      "level": 3,
      "title": "训练要教完整的处理过程，也要检查样本有没有教歪"
    },
    {
      "id": "d66-heading-39",
      "level": 2,
      "title": "九、怎么评测、什么时候能上线"
    },
    {
      "id": "d66-heading-40",
      "level": 3,
      "title": "能上线看各项达标，平均分会藏住严重错误"
    },
    {
      "id": "d66-heading-41",
      "level": 3,
      "title": "关键场景要看完整过程，格式对了也可能办错"
    },
    {
      "id": "d66-heading-42",
      "level": 3,
      "title": "盲测看体验偏好，也要守住事实和办事边界"
    },
    {
      "id": "d66-heading-43",
      "level": 2,
      "title": "十、速度、成本和路由"
    },
    {
      "id": "d66-heading-44",
      "level": 3,
      "title": "模型开始交答案、用户听到声音、事情办完，是三个时间"
    },
    {
      "id": "d66-heading-45",
      "level": 3,
      "title": "成本按整件事算，少一轮和少几个字的收益不同"
    },
    {
      "id": "d66-heading-46",
      "level": 3,
      "title": "两种方案可以同时服务，路由先看健康度"
    },
    {
      "id": "d66-heading-47",
      "level": 2,
      "title": "十一、怎么排查"
    },
    {
      "id": "d66-heading-48",
      "level": 3,
      "title": "第一步先查链路，这句话到底有没有交给 Planner"
    },
    {
      "id": "d66-heading-49",
      "level": 3,
      "title": "第二步查工具描述，模型是否知道选谁、怎样填"
    },
    {
      "id": "d66-heading-50",
      "level": 3,
      "title": "第三步查背景，是缺了、旧了，还是带多带偏了"
    },
    {
      "id": "d66-heading-51",
      "level": 3,
      "title": "第四步才看模型能力，修完还要回到同一条任务"
    },
    {
      "id": "d66-heading-52",
      "level": 2,
      "title": "收尾　把一次交办从头讲到真正办成"
    },
    {
      "id": "d66-heading-53",
      "level": 3,
      "title": "三分钟口述稿：我怎样让这句话办得对、说得准"
    },
    {
      "id": "d66-heading-54",
      "level": 3,
      "title": "最容易讲错的地方：别把中间进展讲成最终完成"
    },
    {
      "id": "d66-heading-55",
      "level": 3,
      "title": "复述路线图：从用户目标走到修复位置"
    },
    {
      "id": "d66-heading-56",
      "level": 2,
      "title": "附一　术语表"
    },
    {
      "id": "d66-heading-57",
      "level": 3,
      "title": "查一个词时，也看它由谁负责、在哪一步起作用"
    },
    {
      "id": "d66-heading-58",
      "level": 2,
      "title": "附二　历史版本与关键数字"
    },
    {
      "id": "d66-heading-59",
      "level": 3,
      "title": "工具和示例随版本变化，数量要连同车型一起读"
    },
    {
      "id": "d66-heading-60",
      "level": 3,
      "title": "输出字段和结构约束，分别约定交什么、怎样读取"
    },
    {
      "id": "d66-heading-61",
      "level": 3,
      "title": "风控有两种结束标记，模型拦截与整轮状态各记一层"
    },
    {
      "id": "d66-heading-62",
      "level": 3,
      "title": "准出指标从分散推理项，演进到统一能力门槛"
    },
    {
      "id": "d66-heading-63",
      "level": 3,
      "title": "负载均衡参数管健康切换，和产品准出线分别使用"
    },
    {
      "id": "d66-heading-64",
      "level": 3,
      "title": "性能数字要带上批次、计时对象和有效样本"
    },
    {
      "id": "d66-heading-65",
      "level": 3,
      "title": "单轮变短以后，还要看整项任务总共算了多少"
    }
  ],
