&quot;,&quot;height&quot;:&quot;111&quot;,&quot;rx&quot;:&quot;7&quot;,&quot;fill&quot;:&quot;#FFF8E8&quot;,&quot;stroke&quot;:&quot;#C3D2E5&quot;,&quot;stroke-width&quot;:&quot;2&quot;}" vertex="1"><mxGeometry x="30" y="631" width="2700" height="111" as="geometry"/></mxCell><mxCell id="v15_8602" parent="v15_8582" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:21px;font-weight:600;line-height:1;white-space:pre;&quot;&gt;异常、限制与用户下一步&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=21;fontColor=#62758A;fontStyle=1;fontWeight=600;labelPadding=0;" sourceIndex="10150" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;10805&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="10805" sourceBaselineY="42347" sourceFontSize="21" sourceFontWeight="600" sourceTextIndex="10149"><mxGeometry x="55" y="643" width="277.2" height="25.2" as="geometry"/></mxCell><mxCell id="v15_8603" parent="v15_8582" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;一期端上传图尚未覆盖；端方案同用户1任务，超时仍写X秒，不能编统一值。部分失败展示成功图及失败占位；网络异常要明确。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="10152" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;10805&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="10805" sourceBaselineY="42386" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="10151"><mxGeometry x="55" y="678" width="1740" height="30" as="geometry"/></mxCell><mxCell id="v15_8604" parent="v15_8582" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:22px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;适用范围与状态：标准化PRD可选；多图/图生图/多轮范围要按期次核实，不由能力调研结论推全上线。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=22;fontColor=#775319;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="10154" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;10782&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="10782" sourceBaselineY="42481" sourceFontSize="22" sourceFontWeight="400" sourceTextIndex="10153"><mxGeometry x="32" y="776" width="1267.2" height="26.4" as="geometry"/></mxCell><mxCell id="v15_8605" parent="1" value="" style="group;connectable=0;recursiveResize=0;collapsible=0;" sourceIndex="10155" sourceTag="g" sourceAttributes="{&quot;class&quot;:&quot;tool-node&quot;,&quot;data-tool&quot;:&quot;TOOL29&quot;,&quot;role&quot;:&quot;button&quot;,&quot;tabindex&quot;:&quot;0&quot;}" vertex="1" connectable="0"><mxGeometry x="190" y="42741" width="2760" height="908" as="geometry"/></mxCell><mxCell id="v15_8606" parent="v15_8605" value="" style="shape=rectangle;rounded=1;absoluteArcSize=1;arcSize=24;fillColor=white;strokeColor=#9BB8DA;strokeWidth=3;" sourceIndex="10156" sourceTag="rect" sourceAttributes="{&quot;x&quot;:&quot;190&quot;,&quot;y&quot;:&quot;42741&quot;,&quot;widt