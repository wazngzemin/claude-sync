etry"/></mxCell><mxCell id="m2_edge_77" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#78909C;fontColor=#475467;fontSize=12;" edge="1" parent="1" source="m2_node_81" target="m2_node_82"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m2_edge_78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#78909C;fontColor=#475467;fontSize=12;" edge="1" parent="1" source="m2_node_82" target="m2_node_83"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m2_edge_79" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#78909C;fontColor=#475467;fontSize=12;" edge="1" parent="1" source="m2_node_82" target="m2_node_84"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m2_edge_80" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#78909C;fontColor=#475467;fontSize=12;" edge="1" parent="1" source="m2_node_85" target="m2_node_86"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m2_edge_81" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#78909C;fontColor=#475467;fontSize=12;" edge="1" parent="1" source="m2_node_86" target="m2_node_87"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m2_edge_82" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#78909C;fontColor=#475467;fontSize=12;" edge="1" parent="1" source="m2_node_86" target="m2_node_88"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m2_edge_83" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#78909C;fontColor=#475467;fontSize=12;" edge="1" parent="1" source="m2_node_88" target="m2_node_89"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m2_edge_84" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#78909C;fontColor=#475467;fontSize=12;" edge="1" parent="1" source="m2_node_89" target="m2_node_90"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m3_cluster_18" value="" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1151.5" y="7946.9" width="2506.0" height="593.5" as="geometry"/></mxCell><mxCell id="m3_cluster_27" value="H｜历史性能数字与任务工程约束：必须带证据标签" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2940.0" y="7967.9" width="688.0" height="551.5" as="geometry"/></mxCell><mxCell id="m3_cluster_46" value="G｜你需要掌握到什么程度：不是全写代码，而是能独立定义和验收一条闭环" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1181.0" y="8057.9" width="1700.0" height="371.5" as="geometry"/></mxCell><mxCell id="m3_cluster_75" value="" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="57.5" y="7576.9" width="4694.0" height="336.0" as="geometry"/></mxCell><mxCell id="m3_cluster_84" value="E｜七类指标：每类都要有分母、场景、版本、车型和端到端追踪" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="87.0" y="7599.4" width="2647.0" height="291.0" as="geometry"/></mxCell><mxCell id="m3_cluster_91" value="" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="108.0" y="7641.4" width="1107.0" height="207.0" as="geometry"/></mxCell><mxCell id="m3_cluster_108" value="" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1237.0" y="7641.4" width="1476.0" height="207.0" as="geometry"/></mxCell><mxCell id="m3_cluster_129" value="F｜评审时必须追问的十个关键问题" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2793.0" y="7597.9" width="1929.0" height="294.0" as="geometry"/></mxCell><mxCell id="m3_cluster_136" value="" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2835.0" y="7618.9" width="1845.0" height="252.0" as="geometry"/></mxCell><mxCell id="m3_cluster_161" value="" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1045.8" y="6870.4" width="2717.5" height="672.5" as="geometry"/></mxCell><mxCell id="m3_cluster_170" value="D｜四路并行输出：分别有自己的成功证据" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2701.8" y="6891.4" width="1032.0" height="630.5" as="geometry"/></mxCell><mxCell id="m3_cluster_209" value="C｜异常恢复：每个失败都要变成下一轮可用的证据" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1075.3" y="6897.9" width="1567.5" height="617.5" as="geometry"/></mxCell><mxCell id="m3_cluster_274" value="" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="8.0" y="6309.1" width="4793.1" height="527.2" as="geometry"/></mxCell><mxCell id="m3_cluster_283" value="B｜复合目标完成判定：用状态机而不是看动作清单是否为空" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2933.2" y="6340.1" width="1838.4" height="465.4" as="geometry"/></mxCell><mxCell id="m3_cluster_358" value="A｜语音用户界面（VUI）生命周期：输入、推理、播报和打断必须是同一个状态机【当前/待链路验真】" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="37.5" y="6330.1" width="2836.7" height="485.2" as="geometry"/></mxCell><mxCell id="m3_node_0" value="【历史预算，不是当前服务承诺】&lt;br&gt;在线语音识别约 200–300毫秒&lt;br&gt;决策规划器思考：中位约500毫秒 / 九成约800毫秒&lt;br&gt;应答首字：中位约350毫秒 / 九成约500毫秒&lt;br&gt;自然语言生成中位约200毫秒&lt;br&gt;语音合成首音中位约400毫秒&lt;br&gt;端到端语音到语音九成约1300毫秒" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F5F5F5;strokeColor=#64748B;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2982.0" y="7988.9" width="260.0" height="277.5" as="geometry"/></mxCell><mxCell id="m3_node_1" value="使用历史数字的前置条件&lt;br&gt;注明来源文档、日期、车型、网络、测试集、样本量和统计口径&lt;br&gt;没有当前运行记录，不得写成“现在线上就是这个值”" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="3326.0" y="8045.1" width="260.0" height="165.0" as="geometry"/></mxCell><mxCell id="m3_node_2" value="【任务工程约束：建设中/待验真】&lt;br&gt;同一回调不重复建运行；创建失败有回滚；取消同时停规则/视觉/运行/通知；结果钩子可靠写回；发件箱保证消息不丢；非法状态迁移被拦截和告警" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F2E8FF;strokeColor=#7C3AED;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2982.0" y="8288.4" width="260.0" height="210.0" as="geometry"/></mxCell><mxCell id="m3_node_3" value="验收所需证据&lt;br&gt;同一条请求编号贯穿：用户请求→动作编号→工具结果→真实状态→目标/任务/运行→语音/界面&lt;br&gt;预生产通过 ≠ 正式生产通过；必须在目标车型和环境重新回归" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="3326.0" y="8288.4" width="260.0" height="210.0" as="geometry"/></mxCell><mxCell id="m3_node_4" value="L0 名词层&lt;br&gt;能认出模块名&lt;br&gt;但说不清输入、输出和异常&lt;br&gt;不足以独立评审" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F5F5F5;strokeColor=#64748B;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1223.0" y="8178.0" width="240.0" height="120.0" as="geometry"/></mxCell><mxCell id="m3_node_5" value="L1 链路层&lt;br&gt;能从用户语音讲到真实结果&lt;br&gt;逐模块说清谁负责、输入、判断、输出、失败处理" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F5F5F5;strokeColor=#64748B;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1547.0" y="8178.0" width="260.0" height="120.0" as="geometry"/></mxCell><mxCell id="m3_node_6" value="L2 运行记录诊断层&lt;br&gt;拿一条坏例定位断点&lt;br&gt;区分输入、路由、上下文、模型、工具、端侧和时序问题" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F5F5F5;strokeColor=#64748B;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1891.0" y="8178.0" width="260.0" height="120.0" as="geometry"/></mxCell><mxCell id="m3_node_7" value="L3 负责人层&lt;br&gt;独立定义测试集、指标、阈值&lt;br&gt;推动跨模块修复并用回归/实验证明收益" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF1D6;strokeColor=#D97706;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2235.0" y="8178.0" width="260.0" height="120.0" as="geometry"/></mxCell><mxCell id="m3_node_8" value="L4 架构与策略层&lt;br&gt;能取舍端云、模型/规则、质量/时延/成本&lt;br&gt;建立跨车型可复用平台与治理机制" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF1D6;strokeColor=#D97706;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2579.0" y="8078.9" width="260.0" height="142.5" as="geometry"/></mxCell><mxCell id="m3_node_9" value="两年内值得形成的硬成果&lt;br&gt;至少达到 L2；在一个核心方向形成 L3&lt;br&gt;交付：一套评测集 + 一次跨链路改造 + 可量化收益 + 风险边界" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF1D6;strokeColor=#D97706;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2579.0" y="8243.4" width="260.0" height="165.0" as="geometry"/></mxCell><mxCell id="m3_node_10" value="5 工具与执行&lt;br&gt;已接收/已调用/已生效/已完成四段成功率；超时/重试/取消；幂等；重复副作用；执行反馈完整；真实状态回读" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="162.5" y="7673.6" width="260.0" height="142.5" as="geometry"/></mxCell><mxCell id="m3_node_11" value="6 长期任务与主动服务&lt;br&gt;目标/任务创建；孤儿规则；误/漏/重复触发；触发延迟；顾问建议采纳/打扰/冲突；视觉匹配准确；终态与清理" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="531.5" y="7673.6" width="260.0" height="142.5" as="geometry"/></mxCell><mxCell id="m3_node_12" value="7 端到端体验与安全&lt;br&gt;完整任务可用率；复合目标全成；首确认/首动作/总耗时；部分失败恢复；虚假成功；语音/界面/真实状态一致；安全事故" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900.5" y="7662.4" width="260.0" height="165.0" as="geometry"/></mxCell><mxCell id="m3_node_13" value="1 语音输入&lt;br&gt;误/漏唤醒；语义字错率；否定/数字/时间/地点保真；端点早截/尾噪；说话人/座位准确；输入时延" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1291.5" y="7673.6" width="260.0" height="142.5" as="geometry"/></mxCell><mxCell id="m3_node_14" value="2 路由与拒识&lt;br&gt;简单任务端侧命中准确；复杂任务上云召回；误拒/漏拒；双执行；迟到云结果覆盖；高风险误放行=0" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1660.5" y="7673.6" width="260.0" height="142.5" as="geometry"/></mxCell><mxCell id="m3_node_15" value="3 上下文与记忆&lt;br&gt;必要事实覆盖；缺失/过期事实命中；来源/时间/有效期完整；冲突裁决；记忆命中；隐私越权=0；输入长度" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2029.5" y="7673.6" width="260.0" height="142.5" as="geometry"/></mxCell><mxCell id="m3_node_16" value="4 决策规划器&lt;br&gt;意图/任务分型；工具与参数正确；原子拆解；依赖顺序；首动作正确；澄清；失败后重规划；同题稳定性；完整目标成功" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2398.5" y="7662.4" width="260.0" height="165.0" as="geometry"/></mxCell><mxCell id="m3_node_17" value="01 用户完整目标是什么？&lt;br&gt;成功分母按动作数还是按用户目标？&lt;br&gt;&lt;br&gt;02 当前系统已知什么、未知什么？&lt;br&gt;动态值谁写、何时写、何时过期、属于谁？" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2889.5" y="7639.9" width="260.0" height="210.0" as="geometry"/></mxCell><mxCell id="m3_node_18" value="03 为什么走这条路由？&lt;br&gt;迟到云结果如何取消，怎样避免双执行？&lt;br&gt;&lt;br&gt;04 为什么选这个工具、参数和依赖顺序？&lt;br&gt;运行记录能否解释？" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3258.5" y="7651.1" width="260.0" height="187.5" as="geometry"/></mxCell><mxCell id="m3_node_19" value="05 工具“成功”指接口成功、执行成功，还是设备真的改变？&lt;br&gt;&lt;br&gt;06 执行反馈是否作为新输入触发下一轮决策？&lt;br&gt;还是只当日志丢掉？" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3627.5" y="7651.1" width="260.0" height="187.5" as="geometry"/></mxCell><mxCell id="m3_node_20" value="07 谁维护依赖、幂等、超时、取消和迟到结果？&lt;br&gt;谁阻止错误并发？&lt;br&gt;&lt;br&gt;08 条件/持续任务如何创建、更新、取消、跨重启恢复和清理？" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3996.5" y="7651.1" width="260.0" height="187.5" as="geometry"/></mxCell><mxCell id="m3_node_21" value="09 顾问建议、触发回调和用户新请求冲突时，谁排队、打断、丢弃？&lt;br&gt;&lt;br&gt;10 最终“搞定了”依赖哪条真实证据？&lt;br&gt;能否一键回放全链？" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4365.5" y="7651.1" width="260.0" height="187.5" as="geometry"/></mxCell><mxCell id="m3_node_22" value="决策结果&lt;br&gt;是否说话、回复内容、动作清单、目标更新" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2743.8" y="7075.6" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m3_node_23" value="语音路&lt;br&gt;回复文本→语音合成→扬声器&lt;br&gt;证据：首音/播报完成/被打断" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3089.9" y="7360.9" width="255.7" height="97.5" as="geometry"/></mxCell><mxCell id="m3_node_24" value="界面路&lt;br&gt;回复/任务状态→卡片/任务岛&lt;br&gt;证据：展示成功、点击/关闭/超时回调" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3087.8" y="7218.9" width="260.0" height="120.0" as="geometry"/></mxCell><mxCell id="m3_node_25" value="形象路&lt;br&gt;表情/动作命令→机器人/头像/云台/口型&lt;br&gt;证据：端侧接收与呈现状态" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3087.8" y="7076.9" width="260.0" height="120.0" as="geometry"/></mxCell><mxCell id="m3_node_26" value="实体动作路&lt;br&gt;动作→工具→协议→车辆执行器&lt;br&gt;证据：执行回执 + 真实车态回读" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3087.8" y="6912.4" width="260.0" height="142.5" as="geometry"/></mxCell><mxCell id="m3_node_27" value="用户感知结果" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3486.8" y="7120.6" width="150.0" height="52.5" as="geometry"/></mxCell><mxCell id="m3_node_28" value="责任边界&lt;br&gt;任务中心（Task Center）≠ 任务服务（Task Service）&lt;br&gt;任务中心：入口、列表、启停、展示/通知容器&lt;br&gt;任务服务：任务/运行/事件事实、生命周期、恢复与清理" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="3431.8" y="7313.4" width="260.0" height="187.5" as="geometry"/></mxCell><mxCell id="m3_node_29" value="异常类型" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1173.5" y="7094.1" width="112.5" height="112.5" as="geometry"/></mxCell><mxCell id="m3_node_30" value="输入异常&lt;br&gt;拒识、早截断、否定词丢失、错座位" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1313.8" y="6918.9" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m3_node_31" value="上下文异常&lt;br&gt;缺事实、事实过期、冲突、越权" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1313.8" y="7038.4" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m3_node_32" value="决策异常&lt;br&gt;工具选错、参数错、依赖顺序错" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1313.8" y="7157.9" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m3_node_33" value="执行异常&lt;br&gt;拒绝、超时、部分成功、设备忙、车辆离线" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1313.8" y="7277.4" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m3_node_34" value="时序异常&lt;br&gt;迟到结果、重复回调、取消后仍执行" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1313.8" y="7396.9" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m3_node_35" value="重听 / 澄清 / 明确拒绝" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1680.9" y="6941.4" width="213.8" height="52.5" as="geometry"/></mxCell><mxCell id="m3_node_36" value="刷新状态 / 查询事实 / 降级为未知" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1657.8" y="7049.6" width="260.0" height="75.0" as="geometry"/></mxCell><mxCell id="m3_node_37" value="重新规划 / 修参数 / 改串并行" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1658.4" y="7180.4" width="258.8" height="52.5" as="geometry"/></mxCell><mxCell id="m3_node_38" value="安全重试 / 换工具 / 等待 / 降级 / 结束" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1657.8" y="7288.6" width="260.0" height="75.0" as="geometry"/></mxCell><mxCell id="m3_node_39" value="动作编号幂等 / 版本检查 / 丢弃迟到结果" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1657.8" y="7408.1" width="260.0" height="75.0" as="geometry"/></mxCell><mxCell id="m3_node_40" value="标准执行反馈&lt;br&gt;结果、说明、错误码、是否可重试、真实状态、时间" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2001.8" y="7157.9" width="260.0" height="97.5" as="geometry"/></mxCell><mxCell id="m3_node_41" value="作为新的输入事件&lt;br&gt;重新组装上下文→下一次决策" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2345.8" y="7169.1" width="255.0" height="75.0" as="geometry"/></mxCell><mxCell id="m3_node_42" value="用户完整目标&lt;br&gt;拆成子目标和必要动作" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2975.2" y="6641.9" width="210.0" height="75.0" as="geometry"/></mxCell><mxCell id="m3_node_43" value="待处理" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3269.2" y="6653.2" width="105.0" height="52.5" as="geometry"/></mxCell><mxCell id="m3_node_44" value="运行中" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3458.2" y="6653.2" width="105.0" height="52.5" as="geometry"/></mxCell><mxCell id="m3_node_45" value="等待工具" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3647.2" y="6500.7" width="120.0" height="52.5" as="geometry"/></mxCell><mxCell id="m3_node_46" value="等待条件" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3647.2" y="6580.8" width="120.0" height="52.5" as="geometry"/></mxCell><mxCell id="m3_node_47" value="等待用户" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3647.2" y="6655.3" width="120.0" height="52.5" as="geometry"/></mxCell><mxCell id="m3_node_48" value="已完成子目标" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3851.2" y="6383.6" width="150.0" height="52.5" as="geometry"/></mxCell><mxCell id="m3_node_49" value="部分成功" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3866.2" y="6458.1" width="120.0" height="52.5" as="geometry"/></mxCell><mxCell id="m3_node_50" value="失败" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4111.4" y="6541.4" width="90.0" height="52.5" as="geometry"/></mxCell><mxCell id="m3_node_51" value="超时" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4111.4" y="6628.4" width="90.0" height="52.5" as="geometry"/></mxCell><mxCell id="m3_node_52" value="已取消" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3654.7" y="6729.8" width="105.0" height="52.5" as="geometry"/></mxCell><mxCell id="m3_node_53" value="三个完成门槛" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4156.4" y="6304.6" width="142.5" height="142.5" as="geometry"/></mxCell><mxCell id="m3_node_54" value="最终完成" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4539.6" y="6367.6" width="120.0" height="52.5" as="geometry"/></mxCell><mxCell id="m3_node_55" value="继续决策 / 恢复 / 说明部分结果" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4469.6" y="6530.2" width="260.0" height="75.0" as="geometry"/></mxCell><mxCell id="m3_node_56" value="禁止捷径&lt;br&gt;动作清单为空 ≠ 完成&lt;br&gt;工具返回成功 ≠ 真实生效&lt;br&gt;模型说“已完成” ≠ 证据" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="4486.1" y="6664.4" width="226.9" height="120.0" as="geometry"/></mxCell><mxCell id="m3_node_57" value="待机" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="79.5" y="6463.9" width="90.0" height="52.5" as="geometry"/></mxCell><mxCell id="m3_node_58" value="唤醒 / 免唤醒命中" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="253.5" y="6463.9" width="181.9" height="52.5" as="geometry"/></mxCell><mxCell id="m3_node_59" value="聆听中&lt;br&gt;接收语音、说话人和座位" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="519.4" y="6452.6" width="225.0" height="75.0" as="geometry"/></mxCell><mxCell id="m3_node_60" value="识别中&lt;br&gt;生成部分文本与最终文本" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="888.4" y="6452.6" width="225.0" height="75.0" as="geometry"/></mxCell><mxCell id="m3_node_61" value="理解/决策中" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1197.4" y="6463.9" width="142.9" height="52.5" as="geometry"/></mxCell><mxCell id="m3_node_62" value="准备回复&lt;br&gt;文本、动作、卡片就绪" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1484.3" y="6581.0" width="210.0" height="75.0" as="geometry"/></mxCell><mxCell id="m3_node_63" value="语音合成排队" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1778.3" y="6592.2" width="150.0" height="52.5" as="geometry"/></mxCell><mxCell id="m3_node_64" value="播报中" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2012.3" y="6592.2" width="105.0" height="52.5" as="geometry"/></mxCell><mxCell id="m3_node_65" value="播报完成&lt;br&gt;进入下一轮或待机" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2652.2" y="6621.5" width="180.0" height="75.0" as="geometry"/></mxCell><mxCell id="m3_node_66" value="停止当前播报&lt;br&gt;保留被打断内容与任务状态&lt;br&gt;新请求进入输入治理" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2318.2" y="6351.1" width="240.0" height="97.5" as="geometry"/></mxCell><mxCell id="m3_node_67" value="当前口径：停止播报且不自动恢复&lt;br&gt;记录被打断内容和无效原因&lt;br&gt;是否恢复需产品重新定义【当前】" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5EDD6;strokeColor=#172033;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2308.2" y="6470.6" width="260.0" height="142.5" as="geometry"/></mxCell><mxCell id="m3_node_68" value="不能混淆&lt;br&gt;语音播放完 ≠ 工具执行完&lt;br&gt;卡片消失 ≠ 任务结束&lt;br&gt;停止播报 ≠ 取消实体动作" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="2324.7" y="6635.1" width="226.9" height="120.0" as="geometry"/></mxCell><mxCell id="m3_node_69" value="05｜状态、输出、指标与产品掌握度&lt;br&gt;动作清单不等于完成；一句“搞定了”必须能追到真实状态证据" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2274.5" y="5933.6" width="260.0" height="142.5" as="geometry"/></mxCell><mxCell id="m3_node_70" value="证据标签：【当前】 当前材料明确　【待链路验真】 需同一条运行记录确认　【历史预算】 旧设计参考，不能当当前服务目标（SLA）　【建设中】 目标方案" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#6B2030;fontSize=14;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="2274.5" y="6110.1" width="260.0" height="165.0" as="geometry"/></mxCell><mxCell id="m3_edge_0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#78909C;fontColor=#475467;fontSize=12;" edge="1" parent="1" source="m3_node_69" target="m3_node_70"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m3_edge_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#78909C;fontColor=#475467;fontSize=12;"