pan style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;按本次请求选相关事实&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="7203" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;316&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="316" sourceBaselineY="23228" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="7202"><mxGeometry x="26" y="103" width="300" height="30" as="geometry"/></mxCell><mxCell id="v15_6344" parent="v15_6339" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;例如空调已开、外面下雨&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="7204" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;316&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="316" sourceBaselineY="23262" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="7202"><mxGeometry x="26" y="137" width="330" height="30" as="geometry"/></mxCell><mxCell id="v15_6345" parent="v15_6339" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&am