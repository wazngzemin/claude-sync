4&quot;}" vertex="1" sourceBaselineX="11786" sourceBaselineY="11274" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="5838"><mxGeometry x="26" y="369" width="960" height="30" as="geometry"/></mxCell><mxCell id="v15_5281" parent="v15_5268" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;action_content 必须能被当前项目实现承接。若模型说开&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="5843" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;11786&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="11786" sourceBaselineY="11308" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="5838"><mxGeometry x="26" y="403" width="990" height="30" as="geometry"/></mxCell><mxCell id="v15_5282" parent="v15_5268" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;三档却参数写两档，就是说做不一致，不能等用户抱怨后才&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="5844" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;11786&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex=