,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:18px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;交出 → O08&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=18;fontColor=#2463C5;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4158" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;5656&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="5656" sourceBaselineY="5526" sourceFontSize="18" sourceFontWeight="400" sourceTextIndex="4157"><mxGeometry x="26" y="738" width="172.8" height="21.6" as="geometry"/></mxCell><mxCell id="v15_3978" parent="1" value="" style="group;connectable=0;recursiveResize=0;collapsible=0;" sourceIndex="4159" sourceTag="g" sourceAttributes="{&quot;class&quot;:&quot;node&quot;,&quot;data-node&quot;:&quot;R18&quot;,&quot;role&quot;:&quot;button&quot;,&quot;tabindex&quot;:&quot;0&quot;,&quot;aria-label&quot;:&quot;本地也不会：限次提示，不谎报完成&quot;}" vertex="1" connectable="0"><mxGeometry x="5630" y="5780" width="720" height="780" as="geometry"/></mxCell><mxCell id="v15_3979" parent="v15_3978" value="" style="shape=rectangle;rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#F4F8FE;strokeColor=#ABC2E0;strokeWidth=2;" sourceIndex="4160" sourceTag="rect" sourceAttributes="{&quot;x&quot;:&quot;5630&quot;,&quot;y&quot;:&quot;5780&quot;,&quot;width&quot;:&quot;720&quot;,&quot;height&quot;:&quot;780&quot;,&quot;rx&quot;:&quot;9&quot;,&quot;fill&quot;:&quot;#F4F8FE&quot;,&quot;stroke&quot;:&quot;#ABC2E0&quot;,&quot;stroke-width&quot;:&quot;2&quot;}" vertex="1"><mxGeometry x="0" y="0" width="720" height="780" as="geometry"/></mxCell><mxCell id="v15_3980" parent="v15_3978" value="&lt;span style=&quot;font-family:-ap