parent="v15_5223" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;场景推理体现在排除错误动作，而不是机械把舒适功能全开&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="5782" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;11786&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="11786" sourceBaselineY="10162" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="5781"><mxGeometry x="26" y="267" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_5233" parent="v15_5223" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;。下雨且车闷，不能按通用例子开窗；空调已最低，不能再&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="5783" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;11786&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="11786" sourceBaselineY="10196" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="5781"><mxGeometry x="26" y="301" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_5234" parent="v15_5223" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;降温；用户怕直吹、后排有宝宝，要控制风量与方向。动态&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="5784" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;11786&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="11786" sourceBaselineY="10230" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="5781"><mxGeometry x="26" y="335" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_5235" parent="v15_5223" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;示例只是参考，当前端状态、明确指令和安全限制要一起判&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="5785" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;11786&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="11786" sourceBaselineY="10264" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="5781"><mxGeometry x="26" y="369" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_5236" parent="v15_5223" value="&lt;span style=&quot;fon