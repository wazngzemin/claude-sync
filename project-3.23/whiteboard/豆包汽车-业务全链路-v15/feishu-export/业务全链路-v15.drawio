g=0;" sourceIndex="7725" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;8266&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="8266" sourceBaselineY="22348" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7724"><mxGeometry x="26" y="233" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_6746" parent="v15_6737" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;景是否启用、相关用户开关是否允许。比如平台规则已开启&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7726" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;8266&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="8266" sourceBaselineY="22382" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7724"><mxGeometry x="26" y="267" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_6747" parent="v15_6737" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;，但用户在任务中心关闭了本车场景，仍不能触发。10 月平&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7727" so