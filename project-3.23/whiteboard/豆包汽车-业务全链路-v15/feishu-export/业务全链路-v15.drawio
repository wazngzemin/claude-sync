ry x="26" y="137" width="360" height="30" as="geometry"/></mxCell><mxCell id="v15_4418" parent="v15_4412" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;保留原问题和已发出的工具&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4727" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="8046" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4724"><mxGeometry x="26" y="171" width="360" height="30" as="geometry"/></mxCell><mxCell id="v15_4419" parent="v15_4412" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;若误停过声音再按版本处理&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4728" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="8080" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4724"><mxGeometry x="26" y="205" width="360" height="30" as="geometry"/></mxCell><mxCell id="v15_4420" parent="v15_4412" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="4729" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;1226&quot;,&quot;y1&quot;:&quot;8109&quot;,&quot;x2&quot;:&quot;1894&quot;,&quot;y2&quot;:&quot;8109&quot;,&quot;stroke&quot;:&quot;#CAD8E6&quot;,&quot;stroke-width&quot;:&quot;1&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="259" as="sourcePoint"/><mxPoint x="694" y="259" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_4421" parent="v15_4412" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;主驾正在查天气时，副驾说“你晚上吃什么”给朋友听，这&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4731" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="8142" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4730"><mxGeometry x="26" y="267" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_4422" parent="v15_4412" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;句话即使被 ASR 写出，也不能取消主驾的有效请求。多人 &lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4732" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="8176" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4730"><mxGeometry x="26" y="301" width="870" height="30" as="geometry"/></mxCell><mxCell id="v15_4423" parent="v15_4412" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;PRD 明确拒识新话不应影响原任务，历史走查也出现拒识导&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4733" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="8210" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4730"><mxGeometry x="26" y="335" width="840" height="30" as="geometry"/></mxCell><mxCell id="v15_4424" parent="v15_4412" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;致天气无回答的故障。产品应分别看原推理、已发出的工具&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4734" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="8244" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4730"><mxGeometry x="26" y="369" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_4425" parent="v15_4412" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;和声音是否被误停；若声音已经停了，再按目标车型的恢复&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4735" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="8278" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4730"><mxGeometry x="26" y="403" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_4426" parent="v15_4412" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;规则处理，不要把“拒识成功”误当整个交互成功。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4736" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="8312" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4730"><mxGeometry x="26" y="437" width="690" height="30" as="geometry"/></mxCell><mxCell id="v15_4427" parent="1" value="" style="group;connectable=0;recursiveResize=0;collapsible=0;" sourceIndex="4737" sourceTag="g" sourceAttributes="{&quot;class&quot;:&quot;node&quot;,&quot;data-node&quot;:&quot;I15&quot;,&quot;role&quot;:&quot;button&quot;,&quot;tabindex&quot;:&quot;0&quot;,&quot;aria-label&quot;:&quot;工具已发出：新话可以接，旧结果仍要收&quot;}" vertex="1" connectable="0"><mxGeometry x="2110" y="7850" width="720" height="780" as="geometry"/></mxCell><mxCell id="v15_4428" parent="v15_4427" value="" style="shape=rectangle;rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#F4F8FE;strokeColor=#ABC2E0;strokeWidth=2;" sourceIndex="4738" sourceTag="rect" sourceAttributes="{&quot;x&quot;:&quot;2110&quot;,&quot;y&quot;:&quot;7850&quot;,&quot;width&quot;:&quot;720&quot;,&quot;height&quot;:&quot;780&quot;,&quot;rx&quot;:&quot;9&quot;,&quot;fill&quot;:&quot;#F4F8FE&quot;,&quot;stroke&quot;:&quot;#ABC2E0&quot;,&quot;stroke-width&quot;:&quot;2&quot;}" vertex="1"><mxGeometry x="0" y="0" width="720" height="780" as="geometry"/></mxCell><mxCell id="v15_4429" parent="v15_4427" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:18px;font-weight:600;line-height:1;white-space:pre;&quot;&gt;I15&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=18;fontColor=#62758A;fontStyle=1;fontWeight=600;labelPadding=0;" sourceIndex="4740" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="7882" sourceFontSize="18" sourceFontWeight="600" sourceTextIndex="4739"><mxGeometry x="26" y="14" width="64.8" height="21.6" as="geometry"/></mxCell><mxCell id="v15_4430" parent="v15_4427" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:30px;font-weight:600;line-height:1;white-space:pre;&quot;&gt;工具已发出：新话可以接，旧结果仍要收&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=30;fontColor=#163352;fontStyle=1;fontWeight=600;labelPadding=0;" sourceIndex="4742" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="7926" sourceFontSize="30" sourceFontWeight="600" sourceTextIndex="4741"><mxGeometry x="26" y="46" width="648" height="36" as="geometry"/></mxCell><mxCell id="v15_4431" parent="v15_4427" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;工具在执行时 Director 可接新输入&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4744" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="7978" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4743"><mxGeometry x="26" y="103" width="630" height="30" as="geometry"/></mxCell><mxCell id="v15_4432" parent="v15_4427" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;执行方继续返回真实结果&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4745" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="8012" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4743"><mxGeometry x="26" y="137" width="330" height="30" as="geometry"/></mxCell><mxCell id="v15_4433" parent="v15_4427" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;反馈按原 request/轮次关联&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4746" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="8046" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4743"><mxGeometry x="26" y="171" width="510" height="30" as="geometry"/></mxCell><mxCell id="v15_4434" parent="v15_4427" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;取消必须另有执行方或任务回执&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4747" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="8080" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4743"><mxGeometry x="26" y="205" width="420" height="30" as="geometry"/></mxCell><mxCell id="v15_4435" parent="v15_4427" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="4748" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;2136&quot;,&quot;y1&quot;:&quot;8109&quot;,&quot;x2&quot;:&quot;2804&quot;,&quot;y2&quot;:&quot;8109&quot;,&quot;stroke&quot;:&quot;#CAD8E6&quot;,&quot;stroke-width&quot;:&quot;1&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="259" as="sourcePoint"/><mxPoint x="694" y="259" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_4436" parent="v15_4427" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;工具调用已经发出后，Director 可能空闲，可以处理新的 &lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4750" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="8142" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4749"><mxGeometry x="26" y="267" width="930" height="30" as="geometry"/></mxCell><mxCell id="v15_4437" parent="v15_4427" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;Query；但旧工具不因此消失。车控、搜索或导航后来返回&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4751" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="8176" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4749"><mxGeometry x="26" y="301" width="840" height="30" as="geometry"/></mxCell><mxCell id="v15_4438" parent="v15_4427" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;时，需要按原请求关联，并由输入管理安排是否合并或再回&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4752" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="8210" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4749"><mxGeometry x="26" y="335" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_4439" parent="v15_4427" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;答。10 月 19 日讨论明确这种在途反馈处理，长任务自动&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4753" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="8244" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4749"><mxGeometry x="26" y="369" width="870" height="30" as="geometry"/></mxCell><mxCell id="v15_4440" parent="v15_4427" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;恢复主线却尚未全部完成。例如开窗动作已下发，此时用户&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4754" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="8278" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4749"><mxGeometry x="26" y="403" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_4441" parent="v15_4427" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;插话问天气，不能通过停止旧推理就宣称窗户没有打开。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4755" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;2136&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="2136" sourceBaselineY="8312" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4749"><mxGeometry x="26" y="437" width="750" height="30" as="geometry"/></mxCell><mxCell id="v15_4442" parent="v15_4427" value="&lt;span style=&quot;font-fami