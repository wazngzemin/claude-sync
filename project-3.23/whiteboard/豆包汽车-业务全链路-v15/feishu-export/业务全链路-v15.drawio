" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="6881"><mxGeometry x="26" y="267" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_6096" parent="v15_6086" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;车辆状态满足条件，或视觉描述符合观察目标。它同时保存&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="6883" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;11786&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="11786" sourceBaselineY="17316" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="6881"><mxGeometry x="26" y="301" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_6097" parent="v15_6086" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;规则与用户任务的对应关系。例如“后排宝宝哭了告诉我”&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="6884" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;11786&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="11786" sourceBaselineY="17350" sourceFontSize="25" so