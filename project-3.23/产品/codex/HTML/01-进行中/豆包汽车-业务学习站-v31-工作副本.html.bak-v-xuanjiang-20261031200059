t x=\"408\" y=\"1665\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"408\" y=\"1692\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">接口需要点位身份与位置；“设置完成”说明停靠意图已登记。</text></g><g data-page=\"DR\" data-flow=\"DR-poi-flow\" data-step=\"DR-poi-7\" role=\"link\" tabindex=\"0\" aria-label=\"App 同步最新路线\"><rect x=\"384\" y=\"1838\" width=\"660\" height=\"184\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"408\" y=\"1875\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">App 同步最新路线</text><text x=\"408\" y=\"1922\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">系统导航把路线和停靠属性同步给智驾。</text><text x=\"408\" y=\"1949\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"408\" y=\"1976\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">新增途经点、重新算路后核对旧停靠要求，避免路线保住了、属性丢失。</text></g><g data-page=\"DR\" data-flow=\"DR-poi-flow\" data-step=\"DR-poi-8\" role=\"link\" tabindex=\"0\" aria-label=\"智驾到达后执行停靠\"><rect x=\"384\" y=\"2122\" width=\"660\" height=\"184\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"408\" y=\"2159\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">智驾到达后执行停靠</text><text x=\"408\" y=\"2206\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">智驾到达对应点并满足当前执行条件后完成停靠。</text><text x=\"408\" y=\"2233\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"408\" y=\"2260\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">不能把导航属性设置成功提前说成车辆已停车。</text></g><g data-page=\"DR\" data-flow=\"DR-poi-flow\" data-step=\"DR-poi-9\" role=\"link\" tabindex=\"0\" aria-label=\"结果交回 Director\"><rect x=\"384\" y=\"2406\" width=\"660\" height=\"184\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"408\" y=\"2443\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">结果交回 Director</text><text x=\"408\" y=\"2490\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">将最新路线、停靠设置及真实执行结果回报。</text><text x=\"408\" y=\"2517\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"408\" y=\"2544\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">用户继续改口时，以这份有效任务状态判断，保留尚未完成事项。</text></g><g data-page=\"DR\" data-flow=\"DR-poi-flow\" data-step=\"DR-poi-10\" role=\"link\" tabindex=\"0\" aria-label=\"保留失败所在步骤\"><rect x=\"384\" y=\"2690\" width=\"660\" height=\"253\" rx=\"9\" fill=\"#f0f8f6\" stroke=\"#80aaa6\" stroke-width=\"1.4\"/><text x=\"408\" y=\"2727\" font-size=\"22\" fill=\"#183b49\" font-weight=\"650\">保留失败所在步骤</text><text x=\"408\" y=\"2774\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">分别保留路线点添加失败、属性设置失败或结果未确认。</text><text x=\"408\" y=\"2801\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\"></text><text x=\"408\" y=\"2828\" font-size=\"18\" fill=\"#30485c\" font-weight=\"400\">停止依赖该结果的后续步骤，把仍未实现的停靠条件交回 Director。</text></g></svg>",
