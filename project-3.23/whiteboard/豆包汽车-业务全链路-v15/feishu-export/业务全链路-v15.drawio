pace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="5019" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="13028" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="5018"><mxGeometry x="26" y="103" width="360" height="30" as="geometry"/></mxCell><mxCell id="v15_4647" parent="v15_4642" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;重要独立信息自然接回&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="5020" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="13062" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="5018"><mxGeometry x="26" y="137" width="300" height="30" as="geometry"/></mxCell><mxCell id="v15_4648" parent="v15_4642" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;跨音区时说明正在回答谁&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="5021" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="13096" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="5018"><mxGeometry x="26" y="171" width="330" height="30" as="geometry"/></mxCell><mxCell id="v15_4649" parent="v15_4642" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;新话术再走统一合成与播放&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="5022" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="13130" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="5018"><mxGeometry x="26" y="205" width="360" height="30" as="geometry"/></mxCell><mxCell id="v15_4650" parent="v15_4642" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="5023" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;1226&quot;,&quot;y1&quot;:&quot;13159&quot;,&quot;x2&quot;:&quot;1894&quot;,&quot;y2&quot;:&quot;13159&quot;,&quot;stroke&quot;:&quot;#CAD8E6&quot;,&quot;stroke-width&quot;:&quot;1&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="259" as="sourcePoint"/><mxPoint x="694" y="259" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_4651" parent="v15_4642" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;仍值得说的内容，由 Director 按新情境重新组织。与新诉&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="5025" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="13192" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="5024"><mxGeometry x="26" y="267" width="930" height="30" as="geometry"/></mxCell><mxCell id="v15_4652" parent="v15_4642" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;求重合时合并，长内容做摘要，跨音区时说明是在答复谁，&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="5026" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="13226" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="5024"><mxGeometry x="26" y="301" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_4653" parent="v15_4642" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;例如“明骏，刚才你问的天气，下午可能下雨”。目标是自&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="5027" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="13260" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="5024"><mxGeometry x="26" y="335" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_4654" parent="v15_4642" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;然衔接且少重复，不能简单从原音频开头重放。新的话术再&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="5028" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="13294" sourceFontSize="25" sourceFontWeight="400" sour