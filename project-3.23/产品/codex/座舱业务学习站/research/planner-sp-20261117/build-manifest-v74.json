  "headings": [
    {
      "id": "sp74-heading-01",
      "level": 2,
      "title": "开篇：Planner 每一轮先读一份七万多字的说明书"
    },
    {
      "id": "sp74-heading-02",
      "level": 3,
      "title": "先导航再找花店，顺序由当时的条件决定"
    },
    {
      "id": "sp74-heading-03",
      "level": 3,
      "title": "读这一章，要能把每条规则放回一次交接"
    },
    {
      "id": "sp74-heading-04",
      "level": 2,
      "title": "一、这一版提示词由哪几块组成"
    },
    {
      "id": "sp74-heading-05",
      "level": 3,
      "title": "先按实际内容数清，才知道改动会影响哪里"
    },
    {
      "id": "sp74-heading-06",
      "level": 3,
      "title": "固定部分定规矩，每轮注入给现场"
    },
    {
      "id": "sp74-heading-07",
      "level": 3,
      "title": "示例占一半，修一句规则还要连着示例检查"
    },
    {
      "id": "sp74-heading-08",
      "level": 2,
      "title": "二、四种输入，尤其是事件"
    },
    {
      "id": "sp74-heading-09",
      "level": 3,
      "title": "先认出是谁在告诉我什么，再决定怎样用"
    },
    {
      "id": "sp74-heading-10",
      "level": 3,
      "title": "事件到了，把要不要说和要不要做分开判断"
    },
    {
      "id": "sp74-heading-11",
      "level": 3,
      "title": "放在同一组里，输入也各守自己的边界"
    },
    {
      "id": "sp74-heading-12",
      "level": 2,
      "title": "三、四项输出：说不说、说什么、表情、动作"
    },
    {
      "id": "sp74-heading-13",
      "level": 3,
      "title": "同一轮交齐四项，才能检查说与做有没有对上"
    },
    {
      "id": "sp74-heading-14",
      "level": 3,
      "title": "表情也在传递事实，知道结果以后再选"
    },
    {
      "id": "sp74-heading-15",
      "level": 3,
      "title": "问了哪件事就等哪件事，有回执再说办成"
    },
    {
      "id": "sp74-heading-16",
      "level": 2,
      "title": "四、导航这一组工具怎样分工"
    },
    {
      "id": "sp74-heading-17",
      "level": 3,
      "title": "先分清是在找地方、算路线，还是改变导航和驾驶"
    },
    {
      "id": "sp74-heading-18",
      "level": 3,
      "title": "顺路买花要先有导航，选中路线后会自动开始"
    },
    {
      "id": "sp74-heading-19",
      "level": 3,
      "title": "两项都有参数，也要按导航域的规则串行"
    },
    {
      "id": "sp74-heading-20",
      "level": 3,
      "title": "涉及智驾，就把目的地和沿途动作整段交出去"
    },
    {
      "id": "sp74-heading-21",
      "level": 2,
      "title": "五、任务、找歌、视觉和生活服务：容易选混的几组"
    },
    {
      "id": "sp74-heading-22",
      "level": 3,
      "title": "任务入口只交完整原话，操作分类和任务编号交给任务侧"
    },
    {
      "id": "sp74-heading-23",
      "level": 3,
      "title": "打开应用走系统设置，四类应用里的业务走任务入口"
    },
    {
      "id": "sp74-heading-24",
      "level": 3,
      "title": "找歌先看线索是否明确，返回成功还要核对作品"
    },
    {
      "id": "sp74-heading-25",
      "level": 3,
      "title": "一整份节目安排、单首搜播和生成播客，各有入口"
    },
    {
      "id": "sp74-heading-26",
      "level": 3,
      "title": "看画面、查外部信息、认车内的人，要分别使用依据"
    },
    {
      "id": "sp74-heading-27",
      "level": 3,
      "title": "订座先交店名，停车缴费先对准本车车牌"
    },
    {
      "id": "sp74-heading-28",
      "level": 3,
      "title": "多日游交行程规划，当天先去两处交路线规划"
    },
    {
      "id": "sp74-heading-29",
      "level": 3,
      "title": "查记忆、写事实偏好、改称呼，用三个不同入口"
    },
    {
      "id": "sp74-heading-30",
      "level": 3,
      "title": "同类车控也要保留每个座位，不适描述要保留发生时刻"
    },
    {
      "id": "sp74-heading-31",
      "level": 2,
      "title": "六、能力边界：写清能做什么，也写清没写到时怎么办"
    },
    {
      "id": "sp74-heading-32",
      "level": 3,
      "title": "先分明确支持、明确不支持、没有列到，再决定怎样办"
    },
    {
      "id": "sp74-heading-33",
      "level": 3,
      "title": "一项能力要写到位置、范围、精度和当前模式"
    },
    {
      "id": "sp74-heading-34",
      "level": 3,
      "title": "后排说冷，要说清调的是哪个前排温区"
    },
    {
      "id": "sp74-heading-35",
      "level": 2,
      "title": "七、用车安全：哪些话说了也不能照做"
    },
    {
      "id": "sp74-heading-36",
      "level": 3,
      "title": "先检查谁在说、车在什么状态，再决定能不能发动作"
    },
    {
      "id": "sp74-heading-37",
      "level": 3,
      "title": "一句指令涉及几个座位，要分别留下允许的部分"
    },
    {
      "id": "sp74-heading-38",
      "level": 3,
      "title": "先确认的操作要等回答，禁止的操作不会因回答而放行"
    },
    {
      "id": "sp74-heading-39",
      "level": 2,
      "title": "八、说话和行动的几条硬规则"
    },
    {
      "id": "sp74-heading-40",
      "level": 3,
      "title": "少问一句的前提，是必要条件已经齐了"
    },
    {
      "id": "sp74-heading-41",
      "level": 3,
      "title": "问了用户就等回答，正在办就别先说办好了"
    },
    {
      "id": "sp74-heading-42",
      "level": 3,
      "title": "回答现在怎样，要优先使用现在的车况"
    },
    {
      "id": "sp74-heading-43",
      "level": 3,
      "title": "续接先看用户还想不想听，再看剩下什么"
    },
    {
      "id": "sp74-heading-44",
      "level": 3,
      "title": "时间能改变开场和追问，恢复动作仍要另作判断"
    },
    {
      "id": "sp74-heading-45",
      "level": 3,
      "title": "人设决定怎么表达，唱歌和保护内部指令各有边界"
    },
    {
      "id": "sp74-heading-46",
      "level": 2,
      "title": "九、参考示例和“决策分析”怎样写"
    },
    {
      "id": "sp74-heading-47",
      "level": 3,
      "title": "示例教的是整轮做法，输入、输出和解释要彼此对上"
    },
    {
      "id": "sp74-heading-48",
      "level": 3,
      "title": "决策分析要交代目标、依据、分工和这一轮的止点"
    },
    {
      "id": "sp74-heading-49",
      "level": 3,
      "title": "结果里没有的事实别补，做完哪一步就只说到哪一步"
    },
    {
      "id": "sp74-heading-50",
      "level": 2,
      "title": "十、每轮注入的十二个插槽"
    },
    {
      "id": "sp74-heading-51",
      "level": 3,
      "title": "插槽留位置，本轮的内容要在推理前填进去"
    },
    {
      "id": "sp74-heading-52",
      "level": 3,
      "title": "事件历史解释刚才，车端状态决定现在"
    },
    {
      "id": "sp74-heading-53",
      "level": 3,
      "title": "空着就保留缺口，任务视图另找实际进入的位置"
    },
    {
      "id": "sp74-heading-54",
      "level": 2,
      "title": "十一、评审这一版：要改的地方"
    },
    {
      "id": "sp74-heading-55",
      "level": 3,
      "title": "同一句话遇到两种教法，先统一谁有权决定"
    },
    {
      "id": "sp74-heading-56",
      "level": 3,
      "title": "用户感受要对应正确的车辆功能，先查有没有改成另一件事"
    },
    {
      "id": "sp74-heading-57",
      "level": 3,
      "title": "定义、调用和回执，要用同一个可识别的名字"
    },
    {
      "id": "sp74-heading-58",
      "level": 3,
      "title": "能读成结构化输出以后，还要检查每个参数放得对不对"
    },
    {
      "id": "sp74-heading-59",
      "level": 3,
      "title": "示例要教会模型在哪里等，在哪里停"
    },
    {
      "id": "sp74-heading-60",
      "level": 3,
      "title": "编号和重复段落也要整理，才找得到同一处修改"
    },
    {
      "id": "sp74-heading-61",
      "level": 2,
      "title": "十二、改完提示词怎样验"
    },
    {
      "id": "sp74-heading-62",
      "level": 3,
      "title": "先逐块检查格式，再按本轮工具定义检查名字和参数"
    },
    {
      "id": "sp74-heading-63",
      "level": 3,
      "title": "每条规则至少配一正一反，再测容易选混的相邻工具"
    },
    {
      "id": "sp74-heading-64",
      "level": 3,
      "title": "安全条件改一点，动作就要跟着变"
    },
    {
      "id": "sp74-heading-65",
      "level": 3,
      "title": "最后跑完整任务，确认修好的规则没有带坏其他地方"
    },
    {
      "id": "sp74-heading-66",
      "level": 2,
      "title": "收尾：用回家买花，把这一版提示词讲给别人听"
    },
    {
      "id": "sp74-heading-67",
      "level": 3,
      "title": "三分钟口述稿：我先看这一轮知道什么，再看按哪条规则往下办"
    },
    {
      "id": "sp74-heading-68",
      "level": 3,
      "title": "最容易讲错的地方：把条件、动作和结果分别说准"
    },
    {
      "id": "sp74-heading-69",
      "level": 3,
      "title": "复述路线图：先沿主例讲决定，再沿偏差找负责的那一步"
    },
    {
      "id": "sp74-heading-70",
      "level": 2,
      "title": "附一　术语表"
    },
    {
      "id": "sp74-heading-71",
      "level": 3,
      "title": "查到词以后，回到它实际改变决定的那一刻"
    },
    {
      "id": "sp74-heading-72",
      "level": 2,
      "title": "附二　历史版本与关键数字"
    },
    {
      "id": "sp74-heading-73",
      "level": 3,
      "title": "数量先带版本，文字长度与模型长度分开读"
    },
    {
      "id": "sp74-heading-74",
      "level": 3,
      "title": "固定工具全表：实际顺序与原编号分别保留"
    },
    {
      "id": "sp74-heading-75",
      "level": 3,
      "title": "二十四个示例块：同时按主题和编号找，才不会改错地方"
    },
    {
      "id": "sp74-heading-76",
      "level": 3,
      "title": "十二个插槽全表：变量要对应具体填入的内容"
    },
    {
      "id": "sp74-heading-77",
      "level": 3,
      "title": "表情按用途分组，选择时仍要对齐可用标识"
    },
    {
      "id": "sp74-heading-78",
      "level": 3,
      "title": "逐项改法：D01～D31 都要落到明确的修改对象"
    }
  ],
