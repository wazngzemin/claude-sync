p;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="8660" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="32368" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="8659"><mxGeometry x="26" y="103" width="360" height="30" as="geometry"/></mxCell><mxCell id="v15_7473" parent="v15_7468" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;云侧是否取消按渠道仲裁&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="8661" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="32402" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="8659"><mxGeometry x="26" y="137" width="330" height="30" as="geometry"/></mxCell><mxCell id="v15_7474" parent="v15_7468" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;不能凭无网直接推定全本地&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="8662" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="32436" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="8659"><mxGeometry x="26" y="171" width="360" height="30" as="geometry"/></mxCell><mxCell id="v15_7475" parent="v15_7468" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;同一场景需验重复/迟到结果&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="8663" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="32470" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="8659"><mxGeometry x="26" y="205" width="390" height="30" as="geometry"/></mxCell><mxCell id="v15_7476" parent="v15_7468" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="8664" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;4746&quot;,&quot;y1&quot;:&quot;32499&quot;,&quot;x2&quot;:&quot;5414&quot;,&quot;y2&quot;:&quot;32499&quot;,&quot;stroke&quot;:&quot;#CAD8E6&quot;,&quot;stroke-width&quot;:&quot;1&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="259" as="sourcePoint"/><mxPoint x="694" y="259" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_7477" parent="v15_7468" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;有端侧规则或 VLM，不代表所有任务已具备离线端到端闭环&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="8666" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="32532" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="8665"><mxGeometry x="26" y="267" width="840" height="30" as="geometry"/></mxCell><mxCell id="v15_7478" parent="v15_7468" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;。需要分别核对本地信号、模型资源、卡片词条、车控能力&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="8667" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="32566" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="8665"><mxGeometry x="26" y="301" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_7479" parent="v15_7468" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;和结果回读。若同一业务还存在云侧建议，必须确认端侧结&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="8668" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="32600" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="8665"><mxGeometry x="26" y="335" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_7480" parent="v15_7468" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;果如何参与仲裁，避免用户只确认一次却执行两遍。Task &lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="8669" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="32634" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="8665"><mxGeometry x="26" y="369" width="840" height="30" as="geometry"/></mxCell><mxCell id="v15_7481" parent="v15_7468" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;技术方案把进一步端云仲裁列为后续规划，不应虚构已有统&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="8670" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="32668" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="8665"><mxGeometry x="26" y="403" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_7482" parent="v15_7468" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;一幂等字段或完成回报协议；应把它画成边界与专项测试项&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="8671" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="32702" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="8665"