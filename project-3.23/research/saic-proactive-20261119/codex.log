    quotes = re.findall(r'"'`?('"\\d\\d:\\d\\d:\\d\\d)"'`?'"\\s*「(["'^」]+)」'"', data)
    for stamp, quote in quotes:
        if len(quote) > 30 or not any(quote in speech for speech in spoken[stamp]):
            bad.append((path, stamp, len(quote), quote, spoken.get(stamp)))
    timestamps = set(re.findall(r'(?<"'!'"\\d)\\d\\d:\\d\\d:\\d\\d(?"'!'"\\d)', data))
    assert timestamps <= set(spoken), (path, timestamps - set(spoken))
    print(f'{path}: {len(quotes)} quotations, {len(timestamps)} distinct transcript anchors')
assert not bad, bad
print('All quoted spans match the transcript exactly and are no longer than 30 characters.')
