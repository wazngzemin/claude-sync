 style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="8494" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="29502" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="8493"><mxGeometry x="26" y="267" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_7347" parent="v15_7337" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;例如天气路况保护可以按项目开发本地判断和卡片交互。10 &lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="8495" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="29536" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="8493"><mxGeometry x="26" y="301" width="840" height="30" as="geometry"/></mxCell><mxCell id="v15_7348" parent="v15_7337" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;月系统预设任务 PRD 明确，端侧现阶段按任务需求开发，&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="8496" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="29570" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="8493"><mxGeometry x="26" y="335" width="840" height="30" as="geometry"/></mxCell><mxCell id="v15_7349" parent="v15_7337" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;端云统一配置与下发后续建设。因此后台保存一个云端场景&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="8497" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;4746&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="4746" sourceBaselineY="29604" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="8493"><mxGeometry x="26" y="369" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_7350" parent="v15_7337" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;，不代表端侧自动获得同样能力。必须核对目标车辆版本和&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whit