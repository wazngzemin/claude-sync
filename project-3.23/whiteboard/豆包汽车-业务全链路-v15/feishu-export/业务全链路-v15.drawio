 YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;长期任务按规则继续等待&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="8625" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;5656&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="5656" sourceBaselineY="31426" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="8622"><mxGeometry x="26" y="171" width="330" height="30" as="geometry"/></mxCell><mxCell id="v15_7446" parent="v15_7439" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="8626" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;5656&quot;,&quot;y1&quot;:&quot;31455&quot;,&quot;x2&quot;:&quot;6324&quot;,&quot;y2&quot;:&quot;31455&quot;,&quot;stroke&quot;:&quot;#CAD8E6&quot;,&quot;stroke-width&quot;:&quot;1&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="225" as="sourcePoint"/><mxPoint x="694" y="225" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_7447" parent="v15_7439" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;本次成功、失败、拒绝、超时或条件失效后，原业务更新卡&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="8628" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;5656&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="5656" sourceBaselineY="31488" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="8627"><mxGeometry x="26" y="233" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_7448" parent="v15_7439" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;片与运行记录，再按任务规则进入冷却或等待下一次。比如&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="8629" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;5656&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="5656" sourceBaselineY="31522" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="8627"><mxGeometry x="26" y="267" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_7449" parent="v15_7439" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;用户拒绝本次湿滑模式建议，不能立刻重复弹同一张卡；但&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="8630" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;5656&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="5656" sourceBaselineY="31556" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="8627"><mxGeometry x="26" y="301" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_7450" parent="v15_7439" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;这也不一定代表关闭整条长期服务。具体拒绝后的频次、恢&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="8631" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;5656&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="5656" sourceBaselineY="31590" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="8627"><mxGeometry x="26" y="335" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_7451" parent="v15_7439" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;复和结束规则需要任务规格明确。不可统一假定。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="8632" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;5656&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="5656" sourceBaselineY="31624" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="8627"><mxGeometry x="26" y="369" width="660" height="30" as="geometry"/></mxCell><mxCell id="v15_7452" parent="1" value="" style="group;connectable=0;recursiveResize=0;collapsible=0;" sourceIndex="8633" sourceTag="g" sourceAttributes="{&quot;class&quot;:&quot;node&quot;,&quot;data-node&quot;:&quot;L10&quot;,&quot;role&quot;:&quot;button&quot;,&quot;tabindex&quot;:&quot;0&quot;,&quot;aria-label&quot;:&quot;本地卡片终止，不等于关闭服务&quot;}" vertex="1" connectable="0"><mxGeometry x="5630" y="32240" width="720" height="780" as="geometry"/></mxCell><mxCell id="v15_7453" parent="v15_7452" value="" style="shape=rectangle;rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#FFF8E8;strokeColor=#D6B577;strokeWidth=2;" sourceIndex="8634" sourceTag="rect" sourceAttributes="{&quot;x&quot;:&quot;5630&quot;,&quot;y&quot;:&quot;32240&quot;,&quot;width&quot;:&quot;720&quot;,&quot;height&quot;:&quot;780&quot;,&quot;rx&quot;:&quot;9&quot;,&quot;fill&quot;:&quot;#FFF8E8&quot;,&quot;stroke&quot;:&quot;#D6B577&quot;,&quot;stroke-width&quot;:&quot;2&quot;}" vertex="1"><mxGeometry x="0" y="0" width="720" height="780" as="geometry"/></mxCell><mxCell id="v15_7454" parent="v15_7452" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:18px;font-weight:600;line-height:1;white-space:pre;&quot;&gt;L10&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=18;fontColor=#62758A;fontStyle=1;fontWeigh