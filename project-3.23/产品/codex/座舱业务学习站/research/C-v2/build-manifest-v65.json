  "headings": [
    {
      "id": "c65-heading-01",
      "level": 2,
      "title": "开篇、Planner 答错，常常是因为手里的背景不对"
    },
    {
      "id": "c65-heading-02",
      "level": 3,
      "title": "同一句“我有点冷”，拿到的背景决定怎样帮忙"
    },
    {
      "id": "c65-heading-03",
      "level": 2,
      "title": "一、一次推理的输入，分成哪几块"
    },
    {
      "id": "c65-heading-04",
      "level": 3,
      "title": "固定说明、每轮背景、过去对话和本轮输入，各有自己的位置"
    },
    {
      "id": "c65-heading-05",
      "level": 3,
      "title": "同样一句话，标成原话、建议或工具结果，含义就不同"
    },
    {
      "id": "c65-heading-06",
      "level": 2,
      "title": "二、背景先送一部分，缺的再查"
    },
    {
      "id": "c65-heading-07",
      "level": 3,
      "title": "上下文服务先备齐常用背景，让第一遍判断就有依据"
    },
    {
      "id": "c65-heading-08",
      "level": 3,
      "title": "缺哪项就查哪项，查回来的仍然是办理依据"
    },
    {
      "id": "c65-heading-09",
      "level": 3,
      "title": "各来源自己筛，避免有用信息在最后一道筛选里被挤掉"
    },
    {
      "id": "c65-heading-10",
      "level": 2,
      "title": "三、现在的车况，和刚才做过的事"
    },
    {
      "id": "c65-heading-11",
      "level": 3,
      "title": "设备状态、车内情景和外部世界，分别回答不同的问题"
    },
    {
      "id": "c65-heading-12",
      "level": 3,
      "title": "先保证留下的是新车况，再让 Planner 优先采用它"
    },
    {
      "id": "c65-heading-13",
      "level": 3,
      "title": "车况可以贴着本轮的话，也可以放在系统提示词末尾"
    },
    {
      "id": "c65-heading-14",
      "level": 3,
      "title": "屏幕上的卡片与整屏画面，要按实际接入范围使用"
    },
    {
      "id": "c65-heading-15",
      "level": 2,
      "title": "四、过去几轮怎么挑、怎么摆"
    },
    {
      "id": "c65-heading-16",
      "level": 3,
      "title": "先限定最近的有效交互，再保留每件事的来回"
    },
    {
      "id": "c65-heading-17",
      "level": 3,
      "title": "按发生时间摆好话和结果，手动操作只挑有关的带"
    },
    {
      "id": "c65-heading-18",
      "level": 3,
      "title": "长工具结果逐步收短，旧背景随轮次退出"
    },
    {
      "id": "c65-heading-19",
      "level": 3,
      "title": "正常筛空就返回空，兜底也要守住同一条过滤规则"
    },
    {
      "id": "c65-heading-20",
      "level": 2,
      "title": "五、记忆和摘要怎样进入这一轮"
    },
    {
      "id": "c65-heading-21",
      "level": 3,
      "title": "摘要放在记忆最前面，补近期原话退出后的空档"
    },
    {
      "id": "c65-heading-22",
      "level": 3,
      "title": "在场人的画像先带上，具体经历再按这一句话找"
    },
    {
      "id": "c65-heading-23",
      "level": 3,
      "title": "先限定谁能用，再把相关记忆交进本轮"
    },
    {
      "id": "c65-heading-24",
      "level": 3,
      "title": "关闭记忆时拿掉记忆和摘要，普通历史照常承接"
    },
    {
      "id": "c65-heading-25",
      "level": 2,
      "title": "六、教 Planner 怎么做：示例、场景知识和能力说明"
    },
    {
      "id": "c65-heading-26",
      "level": 3,
      "title": "动态示例按这句话找相近做法，先过车型筛选"
    },
    {
      "id": "c65-heading-27",
      "level": 3,
      "title": "能提炼成共性规则的，放进常驻的静态示例"
    },
    {
      "id": "c65-heading-28",
      "level": 3,
      "title": "场景知识把步骤和边界一起带来"
    },
    {
      "id": "c65-heading-29",
      "level": 3,
      "title": "能力说明限定本车能做什么，示例也要守这个边界"
    },
    {
      "id": "c65-heading-30",
      "level": 2,
      "title": "七、上下文越长，越慢越贵"
    },
    {
      "id": "c65-heading-31",
      "level": 3,
      "title": "多带一条背景，要能帮这一轮少错一步"
    },
    {
      "id": "c65-heading-32",
      "level": 3,
      "title": "前缀缓存复用相同开头，变化越靠后越容易省计算"
    },
    {
      "id": "c65-heading-33",
      "level": 3,
      "title": "先分清慢在取背景，还是慢在模型计算"
    },
    {
      "id": "c65-heading-34",
      "level": 2,
      "title": "八、演进：从尽量多带，到按这一轮挑选"
    },
    {
      "id": "c65-heading-35",
      "level": 3,
      "title": "先把背景接起来，还要保证接到的是用户眼前那一刻"
    },
    {
      "id": "c65-heading-36",
      "level": 3,
      "title": "从统一精筛改成各源自己筛，常用的先带、缺的再查"
    },
    {
      "id": "c65-heading-37",
      "level": 3,
      "title": "再补做事方法和车型能力，让“知道情况”接上“会办事”"
    },
    {
      "id": "c65-heading-38",
      "level": 3,
      "title": "下一步继续补连续性，同时收住长度和隐私边界"
    },
    {
      "id": "c65-heading-39",
      "level": 2,
      "title": "九、怎么评估、怎么排查"
    },
    {
      "id": "c65-heading-40",
      "level": 3,
      "title": "先取出当轮实际输入，再查缺了什么、旧在哪里"
    },
    {
      "id": "c65-heading-41",
      "level": 3,
      "title": "背景送到了还要查是否被正确使用，异常路径也要一起走"
    },
    {
      "id": "c65-heading-42",
      "level": 3,
      "title": "用一组指标看取对没有、够用没有、用户多等了多久"
    },
    {
      "id": "c65-heading-43",
      "level": 3,
      "title": "半模拟一次只换一路，才知道偏差跟着谁走"
    },
    {
      "id": "c65-heading-44",
      "level": 2,
      "title": "收尾、沿着“我有点冷”，把这一轮的依据讲清楚"
    },
    {
      "id": "c65-heading-45",
      "level": 3,
      "title": "三分钟口述稿：从一句话讲到动作依据"
    },
    {
      "id": "c65-heading-46",
      "level": 3,
      "title": "最容易讲错的地方：八句话守住边界"
    },
    {
      "id": "c65-heading-47",
      "level": 3,
      "title": "复述路线图：先说怎么走，再用真实问题检验"
    },
    {
      "id": "c65-heading-48",
      "level": 2,
      "title": "附一　术语表"
    },
    {
      "id": "c65-heading-49",
      "level": 3,
      "title": "按一次判断中的用途查词，再回到对应段落"
    },
    {
      "id": "c65-heading-50",
      "level": 2,
      "title": "附二　历史版本与关键数字"
    },
    {
      "id": "c65-heading-51",
      "level": 3,
      "title": "历史数字要带着版本和统计对象一起读"
    },
    {
      "id": "c65-heading-52",
      "level": 3,
      "title": "变量和交换格式用来定位内容，中文含义才决定怎样理解"
    },
    {
      "id": "c65-heading-53",
      "level": 3,
      "title": "轮次结束标记说明怎样结束，工具结果说明办成了什么"
    }
  ],
