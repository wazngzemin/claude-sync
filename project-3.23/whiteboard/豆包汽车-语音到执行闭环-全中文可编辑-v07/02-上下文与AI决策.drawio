<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" modified="2026-09-03T00:00:00.000Z" agent="Codex" version="26.0.0"><diagram id="driver-agent-v07" name="02-05 详细链路"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="m1_cluster_10" value="" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1784.0" y="1626.0" width="5365.0" height="1822.4" as="geometry"/></mxCell><mxCell id="m1_cluster_19" value="五｜产品验收：用例＋追踪记录＋量化指标" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="5415.5" y="2435.7" width="1700.0" height="203.0" as="geometry"/></mxCell><mxCell id="m1_cluster_44" value="四｜复合计划验证＋AI 能力问题判定门" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1817.5" y="1648.0" width="3531.0" height="1778.4" as="geometry"/></mxCell><mxCell id="m1_cluster_51" value="4.2｜什么时候才叫 AI 能力问题：按证据顺序排查" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1863.5" y="1670.0" width="3439.0" height="972.4" as="geometry"/></mxCell><mxCell id="m1_cluster_120" value="4.1｜一句话同时包含并行、串行、异步" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="3165.0" y="2666.4" width="836.0" height="738.0" as="geometry"/></mxCell><mxCell id="m1_cluster_149" value="" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="8.0" y="8.0" width="8917.0" height="1576.0" as="geometry"/></mxCell><mxCell id="m1_cluster_162" value="三｜真实字段缺口：不补齐就难公平归因模型" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="8583.5" y="30.0" width="308.0" height="1532.0" as="geometry"/></mxCell><mxCell id="m1_cluster_195" value="02｜上下文与 AI 决策全景" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="41.5" y="288.8" width="292.0" height="1014.5" as="geometry"/></mxCell><mxCell id="m1_cluster_228" value="一｜上下文：先把事实做对" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="400.5" y="432.4" width="5053.0" height="727.2" as="geometry"/></mxCell><mxCell id="m1_cluster_230" value="1.4｜动态知识旁路：决策前检索，不是第五类输入" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="3367.5" y="888.6" width="1360.0" height="251.0" as="geometry"/></mxCell><mxCell id="m1_cluster_232" value="1.3｜筛选治理链" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2641.5" y="475.0" width="2086.0" height="393.6" as="geometry"/></mxCell><mxCell id="m1_cluster_234" value="1.2｜四类记忆：不能混成一锅历史文本" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="843.5" y="758.4" width="1706.0" height="180.5" as="geometry"/></mxCell><mxCell id="m1_cluster_236" value="1.1｜十二类事实来源" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="446.5" y="452.4" width="2103.0" height="286.0" as="geometry"/></mxCell><mxCell id="m1_cluster_238" value="任务、外部事实与能力边界" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="492.5" y="605.4" width="2011.0" height="113.0" as="geometry"/></mxCell><mxCell id="m1_cluster_240" value="当前交互与车内事实" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="492.5" y="472.4" width="2011.0" height="113.0" as="geometry"/></mxCell><mxCell id="m1_cluster_367" value="二｜决策规划器：Planner 与 Director 是同一个模块" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="5520.5" y="505.4" width="2996.0" height="581.2" as="geometry"/></mxCell><mxCell id="m1_cluster_369" value="2.3｜当前系统提示词：四个输出字段" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="7790.5" y="588.8" width="680.0" height="420.1" as="geometry"/></mxCell><mxCell id="m1_cluster_371" value="2.2｜十二个产品验收检查点" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="6338.5" y="568.9" width="1360.0" height="438.6" as="geometry"/></mxCell><mxCell id="m1_cluster_373" value="2.1｜当前系统提示词：四类输入" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;fontColor=#475467;fontSize=15;" vertex="1" parent="1"><mxGeometry x="5566.5" y="543.8" width="680.0" height="504.5" as="geometry"/></mxCell><mxCell id="m1_node_0" value="上下文指标&lt;br&gt;必要事实覆盖率、关键事实保留率、来源／时间／有效期完整率&lt;br&gt;陈旧事实命中率、冲突裁决准确率、跨用户越权率＝0" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E9F8F0;strokeColor=#51A878;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5461.5" y="2457.7" width="248.0" height="159.0" as="geometry"/></mxCell><mxCell id="m1_node_1" value="理解与计划指标&lt;br&gt;目标识别、必要澄清、任务分类、原子拆解完整率&lt;br&gt;冗余动作率、依赖违规率、非必要串行率" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E9F8F0;strokeColor=#51A878;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5801.5" y="2468.9" width="248.0" height="136.5" as="geometry"/></mxCell><mxCell id="m1_node_2" value="工具与安全指标&lt;br&gt;工具／参数正确率、能力边界拒绝与确认准确率&lt;br&gt;危险误执行＝0、同名并发错配率、重复下发率" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E9F8F0;strokeColor=#51A878;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6141.5" y="2468.9" width="248.0" height="136.5" as="geometry"/></mxCell><mxCell id="m1_node_3" value="闭环与稳定指标&lt;br&gt;同例多跑方差、上下文变化后改计划、失败后再规划成功率&lt;br&gt;完整目标成功率、虚假成功率、部分成功恢复率" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E9F8F0;strokeColor=#51A878;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6481.5" y="2468.9" width="248.0" height="136.5" as="geometry"/></mxCell><mxCell id="m1_node_4" value="你要能独立回答&lt;br&gt;为何选这个工具？为何先后／并行？未知为何问或不问？&lt;br&gt;失败后为何重试／降级？凭什么判断完整目标已完成？" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E9F8F0;strokeColor=#51A878;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6821.5" y="2468.9" width="248.0" height="136.5" as="geometry"/></mxCell><mxCell id="m1_node_5" value="先拿完整追踪记录&lt;br&gt;原始请求＋上下文快照＋提示词版本＋模型输出&lt;br&gt;动作下发＋工具执行＋回读与反馈" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF7E6;strokeColor=#D6A02E;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1922.0" y="1791.5" width="248.0" height="136.5" as="geometry"/></mxCell><mxCell id="m1_node_6" value="① 是否走对模块？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF7E6;strokeColor=#D6A02E;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2372.5" y="1688.7" width="171.0" height="171.0" as="geometry"/></mxCell><mxCell id="m1_node_7" value="链路／分流问题&lt;br&gt;查拒识、快路、云端升级、输入分类、端云唯一裁决" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2600.5" y="1711.9" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_8" value="② 工具定义、能力和参数是否清楚？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF7E6;strokeColor=#D6A02E;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2724.5" y="1692.9" width="269.0" height="269.0" as="geometry"/></mxCell><mxCell id="m1_node_9" value="工具契约问题&lt;br&gt;修描述、参数、车型能力、前置条件与边界" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3001.5" y="1814.0" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_10" value="③ 必要事实是否采到并进入快照？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF7E6;strokeColor=#D6A02E;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3125.5" y="1795.0" width="269.0" height="269.0" as="geometry"/></mxCell><mxCell id="m1_node_11" value="上下文问题&lt;br&gt;没采到、过期、错过滤、身份串线、冲突裁决错误" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3402.5" y="1916.1" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_12" value="④ 模型看到的事实是否正确且无矛盾？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF7E6;strokeColor=#D6A02E;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3526.5" y="1897.1" width="269.0" height="269.0" as="geometry"/></mxCell><mxCell id="m1_node_13" value="注入／提示词问题&lt;br&gt;动态知识、示例、规则或上下文拼装错误" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3803.5" y="2018.3" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_14" value="⑤ 模型是否理解错目标、动作、工具、参数或依赖？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF7E6;strokeColor=#D6A02E;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3927.5" y="1999.3" width="269.0" height="269.0" as="geometry"/></mxCell><mxCell id="m1_node_15" value="优先判为 AI 决策能力问题&lt;br&gt;再做同例多跑、换上下文、加失败反馈的稳定性验证" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#EAF7EE;strokeColor=#48A36D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4204.5" y="2120.4" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_16" value="⑥ 正确动作是否正确下发、执行、回读并关联？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF7E6;strokeColor=#D6A02E;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4328.5" y="2101.4" width="269.0" height="269.0" as="geometry"/></mxCell><mxCell id="m1_node_17" value="工程／工具／时序问题&lt;br&gt;查校验、调度、安全、超时、竞态、执行器、action_id" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4605.5" y="2222.5" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_18" value="⑦ 新反馈到来后能否正确恢复／收口？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF7E6;strokeColor=#D6A02E;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4729.5" y="2203.5" width="269.0" height="269.0" as="geometry"/></mxCell><mxCell id="m1_node_19" value="AI 再规划能力问题&lt;br&gt;查换工具、补槽、降级、保留部分成功、停止机械重试" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#EAF7EE;strokeColor=#48A36D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4996.0" y="2324.6" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_20" value="闭环成立&lt;br&gt;用户完整目标有证据；不能只看单轮 JSON 或单个工具成功" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#EAF7EE;strokeColor=#48A36D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4996.0" y="2484.5" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_21" value="副驾：有点闷，去昨天游泳的地方&lt;br&gt;沿途找 4.5 分川菜，10 分钟后关座椅加热，再放舒缓音乐" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0E8;strokeColor=#E27B45;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3459.0" y="2724.9" width="248.0" height="114.0" as="geometry"/></mxCell><mxCell id="m1_node_22" value="即时并行&lt;br&gt;A 查温度／空调／车窗 → 改善副驾闷热并回读&lt;br&gt;B 播舒缓音乐；与 A 独立，可同时执行" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0E8;strokeColor=#E27B45;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3187.0" y="2955.9" width="248.0" height="136.5" as="geometry"/></mxCell><mxCell id="m1_node_23" value="复合目标状态&lt;br&gt;即时分支分别取证；十分钟任务现在只能说‘已设置’&lt;br&gt;真正执行并回读后才从等待中变为已完成" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0E8;strokeColor=#E27B45;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3459.0" y="3209.4" width="248.0" height="136.5" as="geometry"/></mxCell><mxCell id="m1_node_24" value="导航串行&lt;br&gt;C1 查记忆得到地点 → C2 规划路线并导航&lt;br&gt;→ C3 路线存在后再沿途搜 4.5 分川菜" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0E8;strokeColor=#E27B45;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3459.0" y="2955.9" width="248.0" height="136.5" as="geometry"/></mxCell><mxCell id="m1_node_25" value="十分钟异步&lt;br&gt;D1 保存对象、座位、时间、退出条件 → 等待&lt;br&gt;→ 到时唤醒 → 关闭座椅加热并回读" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0E8;strokeColor=#E27B45;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3731.0" y="2955.9" width="248.0" height="136.5" as="geometry"/></mxCell><mxCell id="m1_node_26" value="① 请求追踪缺口&lt;br&gt;用户请求缺 request_id／trace_id／turn_id&lt;br&gt;多人、多轮、端云竞态难串起同一次请求" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="8613.5" y="76.0" width="248.0" height="136.5" as="geometry"/></mxCell><mxCell id="m1_node_27" value="② 顾问来源缺口&lt;br&gt;advisor 仅文本，缺类型、来源、时间、关联目标、置信度、有效期" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="8613.5" y="304.5" width="248.0" height="114.0" as="geometry"/></mxCell><mxCell id="m1_node_28" value="③ 工具反馈关联缺口&lt;br&gt;仅 tool_name＋文本，缺 action_id；同名并发难确认返回归属" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="8613.5" y="510.5" width="248.0" height="114.0" as="geometry"/></mxCell><mxCell id="m1_node_29" value="④ 事件来源缺口&lt;br&gt;仅描述＋时间，缺类型、传感器来源、置信度、作用域、去重号" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="8613.5" y="716.5" width="248.0" height="114.0" as="geometry"/></mxCell><mxCell id="m1_node_30" value="⑤ 动作依赖缺口&lt;br&gt;有动作号、工具、参数，无 depends_on／并行组／超时／重试／取消" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="8613.5" y="922.5" width="248.0" height="114.0" as="geometry"/></mxCell><mxCell id="m1_node_31" value="⑥ 形象字段矛盾&lt;br&gt;示例使用 listening_music，但可用表情清单未列出&lt;br&gt;‘文字不得用 Emoji’不等于可省略形象字段契约" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="8613.5" y="1128.5" width="248.0" height="136.5" as="geometry"/></mxCell><mxCell id="m1_node_32" value="⑦ 长期目标更新缺口&lt;br&gt;goal_list_update 名为更新，参数只定义 add_goal／delete_goal&lt;br&gt;补充、改条件、改频率、暂停恢复缺结构" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0F2;strokeColor=#D35D78;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="8613.5" y="1357.0" width="248.0" height="159.0" as="geometry"/></mxCell><mxCell id="m1_node_33" value="真正的 AI 产品判断&lt;br&gt;先确认事实与链路，再判断模型能力" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="63.5" y="334.8" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_34" value="① 形成上下文快照" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="101.2" y="518.2" width="172.5" height="46.5" as="geometry"/></mxCell><mxCell id="m1_node_35" value="② 同一决策规划器判断" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="86.2" y="656.8" width="202.5" height="46.5" as="geometry"/></mxCell><mxCell id="m1_node_36" value="③ 核对输入／输出契约" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="86.2" y="795.2" width="202.5" height="46.5" as="geometry"/></mxCell><mxCell id="m1_node_37" value="④ 用复合请求验证计划" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="86.2" y="933.8" width="202.5" height="46.5" as="geometry"/></mxCell><mxCell id="m1_node_38" value="⑤ 用完整追踪记录归因" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="86.2" y="1072.2" width="202.5" height="46.5" as="geometry"/></mxCell><mxCell id="m1_node_39" value="⑥ 用用户完整目标量化验收" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="71.2" y="1210.8" width="232.5" height="46.5" as="geometry"/></mxCell><mxCell id="m1_node_40" value="检索触发&lt;br&gt;当前请求＋上下文＋车型／环境＋候选任务" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3413.5" y="967.1" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_41" value="① 当前输入&lt;br&gt;请求／建议／反馈／事件" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="538.5" y="494.4" width="213.0" height="69.0" as="geometry"/></mxCell><mxCell id="m1_node_42" value="② 近期对话&lt;br&gt;原话／表达／动作／反馈" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="889.5" y="494.4" width="213.0" height="69.0" as="geometry"/></mxCell><mxCell id="m1_node_43" value="③ 端侧状态&lt;br&gt;车／导航／媒体／应用" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1219.5" y="494.4" width="198.0" height="69.0" as="geometry"/></mxCell><mxCell id="m1_node_44" value="④ 视觉情境&lt;br&gt;场景／观察主题／置信度" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1552.0" y="494.4" width="213.0" height="69.0" as="geometry"/></mxCell><mxCell id="m1_node_45" value="⑤ 事件日志&lt;br&gt;传感／手动／拒识／触发" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1889.5" y="494.4" width="213.0" height="69.0" as="geometry"/></mxCell><mxCell id="m1_node_46" value="⑥ 身份关系&lt;br&gt;账号／人脸／座位／隐私" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2227.0" y="494.4" width="213.0" height="69.0" as="geometry"/></mxCell><mxCell id="m1_node_47" value="⑦ 当前目标／任务&lt;br&gt;状态／进度／等待条件" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="546.0" y="627.4" width="198.0" height="69.0" as="geometry"/></mxCell><mxCell id="m1_node_48" value="⑧ 联网新事实&lt;br&gt;天气／网页／地点／路况" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="889.5" y="627.4" width="213.0" height="69.0" as="geometry"/></mxCell><mxCell id="m1_node_49" value="⑨ 参考知识&lt;br&gt;车书／技巧／车型／规则" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1212.0" y="627.4" width="213.0" height="69.0" as="geometry"/></mxCell><mxCell id="m1_node_50" value="⑩ 可用工具&lt;br&gt;参数／能力／版本／取消" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1552.0" y="627.4" width="213.0" height="69.0" as="geometry"/></mxCell><mxCell id="m1_node_51" value="⑪ 助手自我认知&lt;br&gt;角色／风格／价值边界" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1897.0" y="627.4" width="198.0" height="69.0" as="geometry"/></mxCell><mxCell id="m1_node_52" value="⑫ 时间位置设备&lt;br&gt;日期／位置／车型／网络" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2227.0" y="627.4" width="213.0" height="69.0" as="geometry"/></mxCell><mxCell id="m1_node_53" value="瞬时记忆｜秒到分钟&lt;br&gt;本轮声音、视觉与输入" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E9F8F0;strokeColor=#51A878;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="897.0" y="814.1" width="198.0" height="69.0" as="geometry"/></mxCell><mxCell id="m1_node_54" value="短期记忆｜当前会话&lt;br&gt;近期对话、任务、临时对象、最新反馈" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E9F8F0;strokeColor=#51A878;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1194.5" y="802.9" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_55" value="长期情景记忆｜具体经历&lt;br&gt;地点、同行人、时间与事件关系" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E9F8F0;strokeColor=#51A878;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1534.5" y="802.9" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_56" value="长期语义记忆｜稳定事实&lt;br&gt;偏好、习惯、关系与用户画像" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E9F8F0;strokeColor=#51A878;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1874.5" y="814.1" width="243.0" height="69.0" as="geometry"/></mxCell><mxCell id="m1_node_57" value="共同约束&lt;br&gt;按用户／车辆／会话隔离；读写有权限与来源&lt;br&gt;空结果如实说未找到，不能用猜测补记忆" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E9F8F0;strokeColor=#51A878;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2209.5" y="780.4" width="248.0" height="136.5" as="geometry"/></mxCell><mxCell id="m1_node_58" value="① 来源与身份隔离&lt;br&gt;谁写入，属于哪个用户／车辆／会话／任务" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2687.5" y="616.1" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_59" value="② 新鲜度检查&lt;br&gt;发生时间、写入时间、有效期、是否陈旧" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3027.5" y="616.1" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_60" value="③ 相关性筛选&lt;br&gt;本轮完整目标真正需要哪些事实" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3413.5" y="616.1" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_61" value="④ 冲突裁决&lt;br&gt;最新端态优先旧对话；无法裁决保持未知" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3753.5" y="616.1" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_62" value="⑤ 事实分型&lt;br&gt;事实／建议／结果／假设不能同等可信" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4093.5" y="616.1" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_63" value="⑥ 摘要与预算&lt;br&gt;按人物、场景、任务选择后压缩；关键事实不丢" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4433.5" y="616.1" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_64" value="知识与示例选择&lt;br&gt;专业知识、车型规则、工具技巧、相似正反例" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="3753.5" y="967.1" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_65" value="版本与质量门&lt;br&gt;来源、版本、车企×环境、得分、过期、冲突去重" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4093.5" y="910.6" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_66" value="注入系统提示词动态区&lt;br&gt;〈动态专业知识〉＋〈场景示例〉" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4433.5" y="910.6" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_67" value="无命中／低分／冲突&lt;br&gt;允许覆盖面下降；不得编造知识，不得放宽安全规则" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4433.5" y="1026.1" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_68" value="本轮上下文快照&lt;br&gt;当前输入＋身份座位＋端侧状态＋视觉情境＋相关记忆&lt;br&gt;目标进度＋工具能力＋参考知识＋最新结果" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="4819.5" y="888.1" width="248.0" height="136.5" as="geometry"/></mxCell><mxCell id="m1_node_69" value="每个动态值必须回答&lt;br&gt;谁写的？何时写？何时过期？属于谁？来源可信度？" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E7F8F7;strokeColor=#42A7A2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5159.5" y="910.6" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_70" value="是否说话｜talk_or_not&lt;br&gt;yes／no" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF4D9;strokeColor=#D8A93D;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7860.2" y="616.4" width="200.6" height="69.0" as="geometry"/></mxCell><mxCell id="m1_node_71" value="用户请求｜user_query&lt;br&gt;query、speaker_name、speaker_position、timestamp" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5612.5" y="565.8" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_72" value="本轮用户提示词&lt;br&gt;近期对话＋当前输入数组＋上下文快照＋目标＋历史反馈" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5952.5" y="744.6" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_73" value="顾问建议｜advisor&lt;br&gt;一段建议文本；建议不是用户命令" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5612.5" y="681.2" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_74" value="工具执行反馈｜tool_feedback&lt;br&gt;feedback＋tool_name；到来后开启新一轮判断" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5612.5" y="796.8" width="248.0" height="114.0" as="geometry"/></mxCell><mxCell id="m1_node_75" value="系统事件｜event&lt;br&gt;事件自然语言描述＋timestamp" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E8F3FF;strokeColor=#4B8FE2;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="5612.5" y="934.8" width="248.0" height="91.5" as="geometry"/></mxCell><mxCell id="m1_node_76" value="① 输入类型解码｜分清请求、建议、结果、事件&lt;br&gt;② 身份／指代／空间｜人、座位、否定、时间、地点、‘我／他／这边’&lt;br&gt;③ 目标与已知未知｜可推断、可查询、必须追问" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F1EAFE;strokeColor=#8B6CD9;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6384.5" y="699.6" width="248.0" height="181.5" as="geometry"/></mxCell><mxCell id="m1_node_77" value="④ 能力／安全／拒识｜车型、设备、权限、车速档位；允许／确认／拒绝／降级&lt;br&gt;⑤ 任务类型｜单步、多动作、多步、条件／定时、持续&lt;br&gt;⑥ 原子动作拆解｜不漏目标、不添动作" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F1EAFE;strokeColor=#8B6CD9;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="6724.5" y="699.6" width="248.0" height="181.5" as="geometry"/></mxCell><mxCell id="m1_node_78" value="⑦ 依赖与并发｜独立则并行，有结果依赖才串行，条件动作转长期目标&lt;br&gt;⑧ 工具／任务代理与参数｜选对能力，参数可执行，必要时先查后写&lt;br&gt;⑨ 说话决策｜确认／澄清／进度／最终，不提前承诺结果" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F1EAFE;strokeColor=#8B6CD9;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7064.5" y="688.4" width="248.0" height="204.0" as="geometry"/></mxCell><mxCell id="m1_node_79" value="⑩ 目标／任务持久化｜保存状态、期限与退出条件&lt;br&gt;⑪ 输出自检与去重｜结构合法、白名单、无冲突、无重复下发&lt;br&gt;⑫ 下一轮策略｜继续、改计划、等待、追问或结束" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F1EAFE;strokeColor=#8B6CD9;fontColor=#172033;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="7404.5" y="699.6" width="248.0" height="181.5" as="geometry"/></mxCell><mxCell id="m1_node_80" value="动作清单只是候选计划&lt;br&gt;不等于已下发、工具成功、真实