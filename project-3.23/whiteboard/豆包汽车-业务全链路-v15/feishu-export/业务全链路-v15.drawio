t;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7840" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;8266&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="8266" sourceBaselineY="24402" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7839"><mxGeometry x="26" y="267" width="900" height="30" as="geometry"/></mxCell><mxCell id="v15_6834" parent="v15_6824" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;，或只显示闪念和 PHUD，不能全部拐进任务系统。10/21 &lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7841" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;8266&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="8266" sourceBaselineY="24436" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7839"><mxGeometry x="26" y="301" width="930" height="30" as="geometry"/></mxCell><mxCell id="v15_6835" parent="v15_6824" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;新技术方案要求推理成功从固定 TaskService 回调改为统&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7842" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;8266&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="8266" sourceBaselineY="24470" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7839"><mxGeometry x="26" y="335" width="960" height="30" as="geometry"/></mxCell><mxCell id="v15_6836" parent="v15_6824" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;一 Action Dispatcher，按配置派发动作。这是改造要求&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7843" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;8266&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="8266" sourceBaselineY="24504" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7839"><mxGeometry x="26" y="369" width="1020" height="30" as="geometry"/></mxCell><mxCell id="v15_6837" parent="v15_6824" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;，不是已经全上线。充电等预设的前置通过仍不证明设备已&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7844" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;8266&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="8266" sourceBaselineY="24538" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7839"><mxGeometry x="26" y="403" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_6838" parent="v15_6824" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;识别；显示出口也只证明一次下发，必须继续核用户真实曝&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7845" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;8266&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="8266" sourceBaselineY="24572" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7839"><mxGeometry x="26" y="437" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_6839" parent="v15_6824" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;光或工具真实结果。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7846" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;8266&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="8266" sourceBaselineY="24606" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="7839"><mxGeometry x="26" y="471" width="270" height="30" as="geometry"/></mxCell><mxCell id="v15_6840" parent="v15_6824" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:18px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;交出 → S02 / H06&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=18;fontColor=#2463C5;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="7848" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;8266&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="8266" sourceBaselineY="24866" sourceFontSize="18" sourceFontWeight="400" sourceTextIndex="7847"><mxGeometry x="26" y="738" width="302.4" height="21.6" as="geometry"/></mxCell><mxCell id="v15_6841" parent="1" value="" style="group;connectable=0;recursiveResize=0;collapsible=0;" sourceIndex="7849" sourceTag="g" sourceAttributes="{&quot;class&quot;:&quot;node&quot;,&quot;data-node&quot;:&quot;G09&quot;,&quot;role&quot;:&quot;button&quot;,&quot;tabindex&quot;:&quot;0&quot;,&quot;aria-label&quot;:&quot;不触发也要知道原因&quot;}" vertex="1" connectable="0"><mxGeometry x="9150" y="24110" width="720" height="780" as="geometry"/></mxCel