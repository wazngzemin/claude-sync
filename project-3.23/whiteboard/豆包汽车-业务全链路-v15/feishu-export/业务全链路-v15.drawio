ometry x="26" y="171" width="360" height="30" as="geometry"/></mxCell><mxCell id="v15_7816" parent="v15_7809" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="9098" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;10876&quot;,&quot;y1&quot;:&quot;30445&quot;,&quot;x2&quot;:&quot;11544&quot;,&quot;y2&quot;:&quot;30445&quot;,&quot;stroke&quot;:&quot;#CAD8E6&quot;,&quot;stroke-width&quot;:&quot;1&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="225" as="sourcePoint"/><mxPoint x="694" y="225" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_7817" parent="v15_7809" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;业务卡片可能经过注册、下发、排队和最终显示几个阶段。&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="9100" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;10876&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="10876" sourceBaselineY="30478" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="9099"><mxGeometry x="26" y="233" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_7818" parent="v15_7809" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;用户点击时要确认卡片仍有效，并且关联的是当前任务、车&lt;/span&gt;" style="text;html=1;align=left;v