0" sourceTextIndex="4398"><mxGeometry x="26" y="46" width="396" height="36" as="geometry"/></mxCell><mxCell id="v15_4166" parent="v15_4162" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;STARTED：已实际出声&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4401" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;9176&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="9176" sourceBaselineY="3888" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4400"><mxGeometry x="26" y="103" width="390" height="30" as="geometry"/></mxCell><mxCell id="v15_4167" parent="v15_4162" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;PROGRESS：真实播放位置&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4402" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;9176&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="9176" sourceBaselineY="3922" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4400"><mxGeometry x="26" y="137" width="450" height="30" as="geometry"/></mxCell><mxCell id="v15_4168" parent="v15_4162" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;FINISHED：轮结束且队列清空&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4403" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;9176&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="9176" sourceBaselineY="3956" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4400"><mxGeometry x="26" y="171" width="510" height="30" as="geometry"/></mxCell><mxCell id="v15_4169" parent="v15_4162" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;ABORTED：本播放实例已终止&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4404" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;9176&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="9176" sourceBaselineY="3990" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4400"><mxGeometry x="26" y="205" width="480" height="30" as="geometry"/></mxCell><mxCell id="v15_4170" parent="v15_4162" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="4405" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;9176&quot;,&quot;y1&quot;:&quot;4019&quot;,&quot;x2&quot;:&quot;9844&quot;,&quot;y2&quot;:&quot;4019&quot;,&quot;stroke&quot;:&quot;#CAD8E6&quot;,&quot;stroke-width&quot;:&quot;1&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="259" as="sourcePoint"/><mxPoint x="694" y="259" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_4171" parent="v15_4162" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;播放状态来自客户端，不是模型自行说已完成。开始要以真&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4407" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;9176&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="9176" sourceBaselineY="4052" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4406"><mxGeometry x="26" y="267" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_4172" parent="v15_4162" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;实出声为准，进度要单调对应实际音频，结束必须同时满足&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4408" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;9176&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="9176" sourceBaselineY="4086" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4406"><mxGeometry x="26" y="301" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_4173" parent="v15_4162" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;服务端轮结束与本地待播队列清空。被真实新 query 终止&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4409" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;9176&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="9176" sourceBaselineY="4120" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4406"><mxGeometry x="26" y="335" width="870" height="30" as="geometry"/></mxCell><mxCell id="v15_4174" parent="v15_4162" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;的实例不能复活；若是临时人声触发暂停且最终被拒识，能&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spa