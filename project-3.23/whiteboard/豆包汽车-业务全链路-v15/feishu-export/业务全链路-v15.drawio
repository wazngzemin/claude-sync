Geometry x="26" y="233" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_7832" parent="v15_7823" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;提醒点一次。需要确认的儿童锁等场景，确认前不能声称已&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="9120" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;10876&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="10876" sourceBaselineY="31522" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="9118"><mxGeometry x="26" y="267" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_7833" parent="v15_7823" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;锁；用户拒绝或不操作，应按场景结束或保留，而不是自动&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="9121" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;10876&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="10876" sourceBaselineY="31556" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="9118"><mxGeometry x="26" y="301" 