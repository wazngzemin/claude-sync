34&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="10066" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4841"><mxGeometry x="26" y="171" width="510" height="30" as="geometry"/></mxCell><mxCell id="v15_4510" parent="v15_4503" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:500;line-height:1;white-space:pre;&quot;&gt;不同预期不能互判为偶发故障&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=500;labelPadding=0;" sourceIndex="4845" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="10100" sourceFontSize="25" sourceFontWeight="500" sourceTextIndex="4841"><mxGeometry x="26" y="205" width="390" height="30" as="geometry"/></mxCell><mxCell id="v15_4511" parent="v15_4503" value="" style="edgeStyle=none;noEdgeStyle=1;rounded=0;curved=0;startArrow=none;endArrow=none;strokeColor=#CAD8E6;strokeWidth=1;dashed=0;html=0;" sourceIndex="4846" sourceTag="line" sourceAttributes="{&quot;x1&quot;:&quot;1226&quot;,&quot;y1&quot;:&quot;10129&quot;,&quot;x2&quot;:&quot;1894&quot;,&quot;y2&quot;:&quot;10129&quot;,&quot;stroke&quot;:&quot;#CAD8E6&quot;,&quot;stroke-width&quot;:&quot;1&quot;}" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="26" y="259" as="sourcePoint"/><mxPoint x="694" y="259" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v15_4512" parent="v15_4503" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;通用 OnePager 描述最终拒识后以 event 把剩余播报交回&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4848" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;0&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="10162" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4847"><mxGeometry x="26" y="267" width="1020" height="30" as="geometry"/></mxCell><mxCell id="v15_4513" parent="v15_4503" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt; Director，而 AIVA VUI 的 9 月条款写流式打断后最终&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4849" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="10196" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4847"><mxGeometry x="26" y="301" width="1080" height="30" as="geometry"/></mxCell><mxCell id="v15_4514" parent="v15_4503" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;拒识不恢复。二者都在当前资料中出现，不能靠挑喜欢的方&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4850" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="10230" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4847"><mxGeometry x="26" y="335" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_4515" parent="v15_4503" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space:pre;&quot;&gt;案抹平差异。验收前先确认目标车型和软件版本，图据此分&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;fillColor=none;strokeColor=none;fontFamily=-apple-system,BlinkMacSystemFont,&quot;PingFang SC&quot;,&quot;Microsoft YaHei&quot;,sans-serif;fontSize=25;fontColor=#163352;fontStyle=0;fontWeight=400;labelPadding=0;" sourceIndex="4851" sourceTag="tspan" sourceAttributes="{&quot;x&quot;:&quot;1226&quot;,&quot;dy&quot;:&quot;34&quot;}" vertex="1" sourceBaselineX="1226" sourceBaselineY="10264" sourceFontSize="25" sourceFontWeight="400" sourceTextIndex="4847"><mxGeometry x="26" y="369" width="780" height="30" as="geometry"/></mxCell><mxCell id="v15_4516" parent="v15_4503" value="&lt;span style=&quot;font-family:-apple-system,BlinkMacSystemFont,&amp;quot;PingFang SC&amp;quot;,&amp;quot;Microsoft YaHei&amp;quot;,sans-serif;font-size:25px;font-weight:400;line-height:1;white-space